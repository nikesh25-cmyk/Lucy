index 0000000..590559e
--- /dev/null
+++ b/nemo-link-proto/src/atlas.rs
@@ -0,0 +1,456 @@
+//! Pure logic of the NemoWorld atlas (map, travel), kept free of any game types so it is quick to
+//! test. The server module `server/src/nemo/atlas` wires it to the ECS.
+//!
+//! What is decided here, and why it is safe:
+//! * The **allow-list** is the atlas file (`veloren-atlas-server-v1`), exported from NemoWorld's
+//!   manifest. A travel command names a `place_id`; the server looks it up in this list and in
+//!   nothing else. The file holds place *names* (a site and a plot kind), never coordinates: the
+//!   server resolves positions from world generation itself.
+//! * Command arguments are parsed **strictly**: only the keys the command kind defines are allowed,
+//!   and anything that looks like a coordinate is refused by name, even though the whole argument
+//!   text is already covered by the command's HMAC.
+//! * A [`Limiter`] bounds how often one player, and the whole server, may be teleported.
+
+use serde::Deserialize;
+use std::collections::{HashMap, HashSet, VecDeque};
+
+pub const FORMAT: &str = "veloren-atlas-server-v1";
+pub const MAX_PLACES: usize = 200;
+/// Minimum seconds between two accepted travel commands for one player.
+pub const TELEPORT_COOLDOWN_SECS: f64 = 20.0;
+/// Minimum seconds between two accepted "where am I / what is near me" commands for one player.
+pub const LOOK_COOLDOWN_SECS: f64 = 5.0;
+/// At most this many teleports are carried out in a window of [`GLOBAL_WINDOW_SECS`] on the whole server.
+pub const GLOBAL_MAX_TELEPORTS: usize = 30;
+pub const GLOBAL_WINDOW_SECS: f64 = 60.0;
+/// At most this many atlas commands are processed in one pass; the rest are refused (not dropped silently).
+pub const MAX_COMMANDS_PER_PASS: usize = 4;
+/// Longest accepted argument text of an atlas command.
+pub const MAX_ARGS_LEN: usize = 160;
+/// Places closer than this many blocks count as "near" in a description.
+pub const NEAR_BLOCKS: f32 = 1500.0;
+
+/// One entry of the allow-list.
+#[derive(Debug, Clone, PartialEq, Deserialize)]
+pub struct PlaceSpec {
+    pub id: String,
+    pub name: String,
+    pub short: String,
+    /// `site` = the origin of a named site (what the `/site` command uses); `plot` = a plot of a site.
+    pub kind: String,
+    pub site: String,
+    #[serde(default)]
+    pub plot: Option<String>,
+    #[serde(default)]
+    pub nth: usize,
+    pub arrive_radius: f32,
+    /// The NemoWorld landmark id this place stands for (quest objectives), if any.
+    #[serde(default)]
+    pub landmark_id: Option<String>,
+}
+
+#[derive(Debug, Clone, PartialEq, Deserialize)]
+pub struct AtlasFile {
+    pub format: String,
+    pub manifest_hash: String,
+    pub world_seed: u64,
+    pub places: Vec<PlaceSpec>,
+}
+
+fn is_slug(text: &str) -> bool {
+    !text.is_empty()
+        && text.len() <= 40
+        && text.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+        && !text.starts_with('-')
+}
+
+fn clean_text(text: &str, max_chars: usize) -> bool {
+    let count = text.chars().count();
+    count > 0 && count <= max_chars && !text.chars().any(char::is_control) && text == text.trim()
+}
+
+/// Parse and validate an atlas file. Everything that goes wrong is a reason a human can read.
+pub fn parse_atlas(text: &str) -> Result<AtlasFile, String> {
+    let file: AtlasFile = serde_json::from_str(text).map_err(|e| format!("not a valid atlas file: {e}"))?;
+    if file.format != FORMAT {
+        return Err(format!("unsupported atlas format '{}'", file.format));
+    }
+    if file.manifest_hash.len() != 64 || !file.manifest_hash.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("manifest_hash must be 64 hex characters".into());
+    }
+    if file.places.is_empty() || file.places.len() > MAX_PLACES {
+        return Err(format!("an atlas holds 1 to {MAX_PLACES} places"));
+    }
+    let mut ids = HashSet::new();
+    let mut hosts = HashSet::new();
+    for place in &file.places {
+        if !is_slug(&place.id) {
+            return Err(format!("bad place id '{}'", place.id));
+        }
+        if !ids.insert(place.id.clone()) {
+            return Err(format!("duplicate place id '{}'", place.id));
+        }
+        if !clean_text(&place.name, 60) || !clean_text(&place.short, 160) || !clean_text(&place.site, 60) {
+            return Err(format!("place '{}' has a bad name, description or site", place.id));
+        }
+        match (place.kind.as_str(), place.plot.as_deref()) {
+            ("site", None) => {},
+            ("plot", Some(plot))
+                if !plot.is_empty() && plot.len() <= 30 && plot.bytes().all(|b| b.is_ascii_alphanumeric()) => {},
+            _ => return Err(format!("place '{}' has a bad host kind", place.id)),
+        }
+        if place.nth > 50 || !(3.0..=200.0).contains(&place.arrive_radius) {
+            return Err(format!("place '{}' has a bad index or radius", place.id));
+        }
+        if let Some(landmark) = &place.landmark_id
+            && !is_slug(landmark)
+        {
+            return Err(format!("place '{}' has a bad landmark id", place.id));
+        }
+        // Two places on the same spot would make "where am I" ambiguous.
+        if !hosts.insert((place.site.clone(), place.plot.clone(), place.nth)) {
+            return Err(format!("place '{}' shares its host with another place", place.id));
+        }
+    }
+    Ok(file)
+}
+
+/// Why a command was refused. These strings are what the acknowledgement carries.
+pub type Reason = &'static str;
+
+const COORDINATE_KEYS: [&str; 14] = [
+    "x", "y", "z", "xy", "xyz", "pos", "position", "wpos", "coords", "coordinates", "lat", "lon", "lng", "height",
+];
+
+fn object(args: &str) -> Result<serde_json::Map<String, serde_json::Value>, Reason> {
+    if args.len() > MAX_ARGS_LEN {
+        return Err("bad_args");
+    }
+    match serde_json::from_str::<serde_json::Value>(args) {
+        Ok(serde_json::Value::Object(map)) => Ok(map),
+        _ => Err("bad_args"),
+    }
+}
+
+/// Only these keys may appear. A coordinate-like key is refused by name, anything else as unexpected.
+fn only_keys(map: &serde_json::Map<String, serde_json::Value>, allowed: &[&str]) -> Result<(), Reason> {
+    for key in map.keys() {
+        if allowed.contains(&key.as_str()) {
+            continue;
+        }
+        return Err(if COORDINATE_KEYS.contains(&key.to_ascii_lowercase().as_str()) {
+            "coordinates_not_accepted"
+        } else {
+            "unexpected_field"
+        });
+    }
+    Ok(())
+}
+
+fn text_field(map: &serde_json::Map<String, serde_json::Value>, key: &str) -> Result<String, Reason> {
+    match map.get(key) {
+        Some(serde_json::Value::String(text)) if is_slug(text) => Ok(text.clone()),
+        _ => Err("bad_args"),
+    }
+}
+
+fn check_hash(map: &serde_json::Map<String, serde_json::Value>, manifest_hash: &str) -> Result<(), Reason> {
+    match map.get("m") {
+        Some(serde_json::Value::String(m)) if m.len() == 16 && manifest_hash.starts_with(m.as_str()) => Ok(()),
+        _ => Err("manifest_mismatch"),
+    }
+}
+
+/// `teleport`: exactly `{"place_id": "<id>", "m": "<first 16 hex of the manifest hash>"}`.
+pub fn parse_teleport_args(args: &str, manifest_hash: &str) -> Result<String, Reason> {
+    let map = object(args)?;
+    only_keys(&map, &["place_id", "m"])?;
+    let place = text_field(&map, "place_id")?;
+    check_hash(&map, manifest_hash)?;
+    Ok(place)
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum LookMode {
+    Where,
+    Near,
+}
+
+/// `atlas_look`: exactly `{"mode": "where"|"near", "m": "..."}`.
+pub fn parse_look_args(args: &str, manifest_hash: &str) -> Result<LookMode, Reason> {
+    let map = object(args)?;
+    only_keys(&map, &["mode", "m"])?;
+    check_hash(&map, manifest_hash)?;
+    match map.get("mode").and_then(serde_json::Value::as_str) {
+        Some("where") => Ok(LookMode::Where),
+        Some("near") => Ok(LookMode::Near),
+        _ => Err("bad_args"),
+    }
+}
+
+/// `atlas_mark`: exactly `{"place_id": "<id>"|"clear", "m": "..."}`. `None` means clear the marker.
+pub fn parse_mark_args(args: &str, manifest_hash: &str) -> Result<Option<String>, Reason> {
+    let map = object(args)?;
+    only_keys(&map, &["place_id", "m"])?;
+    let place = text_field(&map, "place_id")?;
+    check_hash(&map, manifest_hash)?;
+    Ok(if place == "clear" { None } else { Some(place) })
+}
+
+/// Bounds how often a player (and the server as a whole) may be teleported. Time is passed in, so
+/// tests need no clock.
+#[derive(Debug, Default)]
+pub struct Limiter {
+    last: HashMap<String, f64>,
+    recent: VecDeque<f64>,
+}
+
+impl Limiter {
+    /// Record an accepted action, or refuse it. `cooldown` is per `key`; `global` limits the number of
+    /// accepted actions across all keys in `window` seconds (`None` = unlimited).
+    pub fn check(
+        &mut self,
+        key: &str,
+        now: f64,
+        cooldown: f64,
+        global: Option<(usize, f64)>,
+    ) -> Result<(), Reason> {
+        if let Some(&at) = self.last.get(key)
+            && (now - at).abs() < cooldown
+        {
+            // A clock that steps back by less than the cooldown does not open the gate either.
+            return Err("cooldown");
+        }
+        if let Some((max, window)) = global {
+            while self.recent.front().is_some_and(|&t| now - t >= window || t > now) {
+                self.recent.pop_front();
+            }
+            if self.recent.len() >= max {
+                return Err("rate_limited");
+            }
+            self.recent.push_back(now);
+        }
+        if self.last.len() > 2048 {
+            self.last.retain(|_, &mut at| now >= at && now - at < 3600.0);
+        }
+        self.last.insert(key.to_owned(), now);
+        Ok(())
+    }
+}
+
+/// A resolved place, as far as describing is concerned.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Spot {
+    pub id: String,
+    pub name: String,
+    pub x: f32,
+    pub y: f32,
+    pub radius: f32,
+}
+
+/// Eight-point compass. Veloren's +y is north and +x is east.
+pub fn compass(dx: f32, dy: f32) -> &'static str {
+    if dx.abs() < 1.0 && dy.abs() < 1.0 {
+        return "here";
+    }
+    let angle = dx.atan2(dy).to_degrees(); // 0 = north, 90 = east
+    let index = (((angle + 360.0 + 22.5) % 360.0) / 45.0) as usize % 8;
+    ["north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west"][index]
+}
+
+fn distance(pos: (f32, f32), spot: &Spot) -> f32 { ((spot.x - pos.0).powi(2) + (spot.y - pos.1).powi(2)).sqrt() }
+
+fn nearest_first(pos: (f32, f32), spots: &[Spot]) -> Vec<(f32, &Spot)> {
+    let mut found: Vec<_> = spots.iter().map(|s| (distance(pos, s), s)).collect();
+    found.sort_by(|a, b| a.0.total_cmp(&b.0).then_with(|| a.1.id.cmp(&b.1.id)));
+    found
+}
+
+/// "Where am I": the nearest place, said plainly.
+pub fn describe_where(pos: (f32, f32), spots: &[Spot]) -> String {
+    match nearest_first(pos, spots).first() {
+        None => "The atlas has no places loaded.".into(),
+        Some(&(d, spot)) if d <= spot.radius => format!("You are at {}.", spot.name),
+        Some(&(d, spot)) => format!(
+            "You are in open country, {:.0} blocks {} of {}.",
+            d,
+            compass(pos.0 - spot.x, pos.1 - spot.y),
+            spot.name
+        ),
+    }
+}
+
+/// "What is near me": up to `limit` places, nearest first, each with distance and direction.
+pub fn describe_near(pos: (f32, f32), spots: &[Spot], limit: usize) -> String {
+    let found = nearest_first(pos, spots);
+    let parts: Vec<String> = found
+        .iter()
+        .take(limit.clamp(1, 6))
+        .map(|&(d, spot)| {
+            if d <= spot.radius {
+                format!("{} (you are here)", spot.name)
+            } else {
+                format!("{} ({:.0} blocks {})", spot.name, d, compass(spot.x - pos.0, spot.y - pos.1))
+            }
+        })
+        .collect();
+    if parts.is_empty() {
+        "The atlas has no places loaded.".into()
+    } else {
+        format!("Nearest NemoWorld places: {}.", parts.join("; "))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const HASH: &str = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+    const M: &str = "0123456789abcdef";
+
+    fn atlas_text(extra: &str) -> String {
+        format!(
+            r#"{{"format":"{FORMAT}","manifest_hash":"{HASH}","world_seed":130626853,"places":[
+            {{"id":"commons","name":"The Commons","short":"Harr, the start.","kind":"site","site":"Harr","arrive_radius":12}},
+            {{"id":"library","name":"The Lantern Library","short":"Reading.","kind":"plot","site":"Harr","plot":"House","nth":0,"arrive_radius":8,"landmark_id":"lyra-house"}}
+            {extra}]}}"#
+        )
+    }
+
+    #[test]
+    fn a_good_atlas_parses() {
+        let atlas = parse_atlas(&atlas_text("")).expect("valid");
+        assert_eq!(atlas.places.len(), 2);
+        assert_eq!(atlas.places[1].landmark_id.as_deref(), Some("lyra-house"));
+    }
+
+    #[test]
+    fn a_bad_atlas_is_refused() {
+        assert!(parse_atlas("{}").is_err());
+        assert!(parse_atlas(&atlas_text("").replace(FORMAT, "other")).is_err());
+        assert!(parse_atlas(&atlas_text("").replace(HASH, "abc")).is_err());
+        // duplicate id
+        let dup = r#",{"id":"commons","name":"Again","short":"x","kind":"site","site":"Elsewhere","arrive_radius":9}"#;
+        assert!(parse_atlas(&atlas_text(dup)).unwrap_err().contains("duplicate"));
+        // two places on one host
+        let same = r#",{"id":"twin","name":"Twin","short":"x","kind":"site","site":"Harr","arrive_radius":9}"#;
+        assert!(parse_atlas(&atlas_text(same)).unwrap_err().contains("shares"));
+        // bad slug, control characters, bad radius, bad host kind
+        let slug = r#",{"id":"Bad Id","name":"N","short":"x","kind":"site","site":"A","arrive_radius":9}"#;
+        assert!(parse_atlas(&atlas_text(slug)).is_err());
+        let ctrl = r#",{"id":"ok","name":"N\u0007","short":"x","kind":"site","site":"A","arrive_radius":9}"#;
+        assert!(parse_atlas(&atlas_text(ctrl)).is_err());
+        let radius = r#",{"id":"ok","name":"N","short":"x","kind":"site","site":"A","arrive_radius":900}"#;
+        assert!(parse_atlas(&atlas_text(radius)).is_err());
+        let kind = r#",{"id":"ok","name":"N","short":"x","kind":"plot","site":"A","arrive_radius":9}"#;
+        assert!(parse_atlas(&atlas_text(kind)).is_err());
+        // A coordinate field in the file is simply not part of the format: serde ignores it, and
+        // nothing ever reads it. The exporter never writes one (NemoWorld test).
+    }
+
+    #[test]
+    fn teleport_arguments_are_strict() {
+        assert_eq!(parse_teleport_args(&format!(r#"{{"place_id":"library","m":"{M}"}}"#), HASH), Ok("library".into()));
+        // coordinates are refused by name, whatever the case
+        for key in ["x", "Y", "z", "pos", "position", "wpos", "coords", "coordinates", "lat", "height"] {
+            let args = format!(r#"{{"place_id":"library","m":"{M}","{key}":15200}}"#);
+            assert_eq!(parse_teleport_args(&args, HASH), Err("coordinates_not_accepted"), "{key}");
+        }
+        assert_eq!(parse_teleport_args(&format!(r#"{{"place_id":"library","m":"{M}","note":"hi"}}"#), HASH), Err("unexpected_field"));
+        // a place id must be a slug: no path tricks, no spaces, no numbers-as-coordinates objects
+        for bad in ["../x", "Library", "a b", "", "x=1,y=2"] {
+            assert_eq!(parse_teleport_args(&format!(r#"{{"place_id":"{bad}","m":"{M}"}}"#), HASH), Err("bad_args"), "{bad}");
+        }
+        assert_eq!(parse_teleport_args(r#"{"place_id":{"x":1},"m":"0123456789abcdef"}"#, HASH), Err("bad_args"));
+        assert_eq!(parse_teleport_args(&format!(r#"{{"place_id":7,"m":"{M}"}}"#), HASH), Err("bad_args"));
+        // wrong manifest, missing manifest
+        assert_eq!(parse_teleport_args(r#"{"place_id":"library","m":"ffffffffffffffff"}"#, HASH), Err("manifest_mismatch"));
+        assert_eq!(parse_teleport_args(r#"{"place_id":"library"}"#, HASH), Err("manifest_mismatch"));
+        // not an object, garbage, too long
+        for bad in ["[]", "\"library\"", "library", "", "{", "null"] {
+            assert_eq!(parse_teleport_args(bad, HASH), Err("bad_args"), "{bad}");
+        }
+        let long = format!(r#"{{"place_id":"library","m":"{M}","pad":"{}"}}"#, "a".repeat(MAX_ARGS_LEN));
+        assert_eq!(parse_teleport_args(&long, HASH), Err("bad_args"));
+    }
+
+    #[test]
+    fn look_and_mark_arguments_are_strict() {
+        assert_eq!(parse_look_args(&format!(r#"{{"mode":"where","m":"{M}"}}"#), HASH), Ok(LookMode::Where));
+        assert_eq!(parse_look_args(&format!(r#"{{"mode":"near","m":"{M}"}}"#), HASH), Ok(LookMode::Near));
+        assert_eq!(parse_look_args(&format!(r#"{{"mode":"teleport","m":"{M}"}}"#), HASH), Err("bad_args"));
+        assert_eq!(parse_look_args(&format!(r#"{{"mode":"near","m":"{M}","x":1}}"#), HASH), Err("coordinates_not_accepted"));
+        assert_eq!(parse_mark_args(&format!(r#"{{"place_id":"clear","m":"{M}"}}"#), HASH), Ok(None));
+        assert_eq!(parse_mark_args(&format!(r#"{{"place_id":"library","m":"{M}"}}"#), HASH), Ok(Some("library".into())));
+        assert_eq!(parse_mark_args(&format!(r#"{{"place_id":"library","m":"{M}","pos":[1,2]}}"#), HASH), Err("coordinates_not_accepted"));
+    }
+
+    #[test]
+    fn the_cooldown_cannot_be_bypassed() {
+        let mut limiter = Limiter::default();
+        assert_eq!(limiter.check("p1", 100.0, 20.0, None), Ok(()));
+        assert_eq!(limiter.check("p1", 100.0, 20.0, None), Err("cooldown"));
+        assert_eq!(limiter.check("p1", 119.9, 20.0, None), Err("cooldown"));
+        // a refused attempt does not extend or reset the cooldown
+        assert_eq!(limiter.check("p1", 120.0, 20.0, None), Ok(()));
+        // another player is independent
+        assert_eq!(limiter.check("p2", 100.5, 20.0, None), Ok(()));
+        // a clock that moves backwards does not open the gate for the same player
+        assert_eq!(limiter.check("p2", 100.4, 20.0, None), Err("cooldown"), "a small step back in time is no bypass");
+    }
+
+    #[test]
+    fn the_global_rate_is_bounded() {
+        let mut limiter = Limiter::default();
+        for i in 0..3 {
+            assert_eq!(limiter.check(&format!("p{i}"), 10.0 + i as f64, 20.0, Some((3, 60.0))), Ok(()));
+        }
+        assert_eq!(limiter.check("p9", 20.0, 20.0, Some((3, 60.0))), Err("rate_limited"));
+        // a refusal by the global limit must not record the player's cooldown
+        assert_eq!(limiter.check("p9", 71.0, 20.0, Some((3, 60.0))), Ok(()));
+    }
+
+    #[test]
+    fn compass_points_follow_veloren_axes() {
+        assert_eq!(compass(0.0, 100.0), "north");
+        assert_eq!(compass(100.0, 100.0), "north-east");
+        assert_eq!(compass(100.0, 0.0), "east");
+        assert_eq!(compass(100.0, -100.0), "south-east");
+        assert_eq!(compass(0.0, -100.0), "south");
+        assert_eq!(compass(-100.0, -100.0), "south-west");
+        assert_eq!(compass(-100.0, 0.0), "west");
+        assert_eq!(compass(-100.0, 100.0), "north-west");
+        assert_eq!(compass(0.2, 0.2), "here");
+    }
+
+    fn spots() -> Vec<Spot> {
+        vec![
+            Spot { id: "commons".into(), name: "The Commons".into(), x: 1000.0, y: 1000.0, radius: 30.0 },
+            Spot { id: "library".into(), name: "The Lantern Library".into(), x: 1010.0, y: 990.0, radius: 8.0 },
+            Spot { id: "far".into(), name: "Highlands".into(), x: 5000.0, y: 6000.0, radius: 60.0 },
+        ]
+    }
+
+    #[test]
+    fn where_am_i_names_the_nearest_place() {
+        assert_eq!(describe_where((1010.0, 990.0), &spots()), "You are at The Lantern Library.");
+        assert_eq!(describe_where((1000.0, 1010.0), &spots()), "You are at The Commons.");
+        assert_eq!(
+            describe_where((1000.0, 1200.0), &spots()),
+            "You are in open country, 200 blocks north of The Commons."
+        );
+        assert_eq!(describe_where((0.0, 0.0), &[]), "The atlas has no places loaded.");
+    }
+
+    #[test]
+    fn what_is_near_me_lists_nearest_first_with_directions() {
+        let text = describe_near((1000.0, 1200.0), &spots(), 2);
+        assert_eq!(
+            text,
+            "Nearest NemoWorld places: The Commons (200 blocks south); The Lantern Library (210 blocks south)."
+        );
+        let here = describe_near((1000.0, 1000.0), &spots(), 1);
+        assert_eq!(here, "Nearest NemoWorld places: The Commons (you are here).");
+        assert_eq!(describe_near((0.0, 0.0), &[], 3), "The atlas has no places loaded.");
+    }
+}
