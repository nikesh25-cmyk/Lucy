+    fn planned() -> Planned {
+        let manifest = Manifest::parse(MANIFEST).expect("the test manifest is valid");
+        let mut plans = manifest::plan(&manifest, &Sites).expect("it plans against the fake world");
+        plans.pop().expect("one group")
