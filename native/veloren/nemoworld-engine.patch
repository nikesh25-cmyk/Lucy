+#[derive(Default, Clone)]
+pub struct HarrData {
+    pub is_reachable: bool,
+    pub last_updated: Option<Instant>,
+    pub overview: Option<Value>,
+    pub tasks: Option<Value>,
+}
+
+static HARR_STORE: OnceLock<Arc<Mutex<HarrData>>> = OnceLock::new();
+
+fn get_harr_store() -> Arc<Mutex<HarrData>> {
+    HARR_STORE
+        .get_or_init(|| {
+            let store = Arc::new(Mutex::new(HarrData::default()));
+            let store_clone = Arc::clone(&store);
+            thread::Builder::new()
+                .name("harr-poller".into())
+                .spawn(move || {
+                    let ports = [3100, 3218];
+                    loop {
+                        let mut success = false;
+                        for &port in &ports {
+                            if let (Some(overview), tasks) = (
+                                fetch_http_json(port, "/api/v1/veloren/harr/overview"),
+                                fetch_http_json(port, "/api/v1/veloren/harr/tasks"),
+                            ) {
+                                if let Ok(mut lock) = store_clone.lock() {
+                                    lock.is_reachable = true;
+                                    lock.last_updated = Some(Instant::now());
+                                    lock.overview = Some(overview);
+                                    lock.tasks = tasks;
+                                }
+                                success = true;
+                                break;
+                            }
+                        }
+
+                        if !success {
+                            if let Ok(mut lock) = store_clone.lock() {
+                                lock.is_reachable = false;
+                            }
+                        }
+
+                        thread::sleep(Duration::from_secs(5));
+                    }
+                })
+                .ok();
+            store
+        })
+        .clone()
+}
+
+pub fn parse_http_json_body(raw_response: &str) -> Option<Value> {
+    let (_, body) = raw_response.split_once("\r\n\r\n")?;
+    let trimmed = body.trim();
+    if let Ok(val) = serde_json::from_str::<Value>(trimmed) {
+        return Some(val);
+    }
+    // Fallback for chunked transfer encoding: slice from first '{' to last '}'
+    let start = trimmed.find('{')?;
+    let end = trimmed.rfind('}')?;
+    if start <= end {
+        serde_json::from_str::<Value>(&trimmed[start..=end]).ok()
+    } else {
+        None
+    }
+}
+
+fn fetch_http_json(port: u16, path: &str) -> Option<Value> {
+    let addr = format!("127.0.0.1:{}", port);
+    let mut stream = TcpStream::connect_timeout(
+        &addr.parse().ok()?,
+        Duration::from_millis(450),
+    )
+    .ok()?;
+
+    let _ = stream.set_read_timeout(Some(Duration::from_millis(600)));
+    let _ = stream.set_write_timeout(Some(Duration::from_millis(450)));
+
+    // Use HTTP/1.0 so Node.js sends an unchunked response body closed on EOF
+    let request = format!(
+        "GET {} HTTP/1.0\r\nHost: 127.0.0.1:{}\r\nConnection: close\r\nAccept: application/json\r\n\r\n",
+        path, port
+    );
+    stream.write_all(request.as_bytes()).ok()?;
+
+    let mut response_bytes = Vec::new();
+    stream.read_to_end(&mut response_bytes).ok()?;
+
+    let response_str = String::from_utf8_lossy(&response_bytes);
+    parse_http_json_body(&response_str)
+}
