@@ -0,0 +1,167 @@
+//! NemoWorld is a peaceful world: scholars, research, cooperation, growth, discovery, abundance.
+//!
+//! This system keeps hostile creatures out of it. While the NemoWorld link is on, every couple of
+//! seconds it removes any non-player creature that is built to attack: monsters and bandits
+//! (`Alignment::Enemy`) and wild animals that hunt people (a `Wild` agent with an aggro distance).
+//! Gentle animals, villagers, residents and pets are left alone. Removal is silent (no loot, no
+//! death event), and an NPC-simulation actor is told it died so the simulation does not keep a
+//! phantom twin. The simulation may later spawn another one; the next pass removes it again.
+//!
+//! It is the server-side half of the peace rule (the other half is the world setting
+//! `battle_mode: Global(PvE)`, which stops players harming each other). Off when the link is off.
+
+use crate::{rtsim::RtSim, sys::nemo_link::NemoLinkState};
+use common::{
+    comp::{Agent, Alignment, Health, Player, Pos},
+    event::{DeleteEvent, EmitExt},
+    event_emitters,
+    resources::Time,
+    rtsim::ActorId,
+};
+use common_ecs::{Job, Origin, Phase, System};
+use specs::{Entities, Join, LendJoin, Read, ReadExpect, ReadStorage, WriteExpect, WriteStorage};
+use std::sync::Arc;
+use tracing::info;
+use world::{IndexOwned, World};
+
+/// Seconds of game time between passes.
+const EVERY: f64 = 2.0;
+/// Only creatures this close to a person are looked at (blocks); far-away ones are not a danger and
+/// will be reached when somebody gets near.
+const NEAR: f32 = 600.0;
+
+event_emitters! {
+    struct Events[Emitters] {
+        delete: DeleteEvent,
+    }
+}
+
+/// True for a creature that exists to attack people.
+pub fn is_hostile(alignment: Option<&Alignment>, aggro_dist: Option<f32>) -> bool {
+    match alignment {
+        Some(Alignment::Enemy) => true,
+        Some(Alignment::Wild) => aggro_dist.is_some(),
+        _ => false,
+    }
+}
+
+#[derive(Default)]
+pub struct Sys {
+    next: f64,
+    removed: u64,
+}
+
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Entities<'a>,
+        Events<'a>,
+        Read<'a, Time>,
+        Option<Read<'a, NemoLinkState>>,
+        ReadStorage<'a, Pos>,
+        WriteStorage<'a, Health>,
+        ReadStorage<'a, Player>,
+        ReadStorage<'a, Alignment>,
+        ReadStorage<'a, Agent>,
+        ReadStorage<'a, ActorId>,
+        WriteExpect<'a, RtSim>,
+        ReadExpect<'a, Arc<World>>,
+        ReadExpect<'a, IndexOwned>,
+    );
+
+    const NAME: &'static str = "nemo_peace";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(
+        job: &mut Job<Self>,
+        (
+            entities,
+            events,
+            time,
+            link,
+            positions,
+            mut healths,
+            players,
+            alignments,
+            agents,
+            actors,
+            mut rtsim,
+            world,
+            index,
+        ): Self::SystemData,
+    ) {
+        if !link.as_ref().map_or(false, |l| l.is_on()) {
+            return;
+        }
+        let now = time.0;
+        if now < job.own.next {
+            return;
+        }
+        job.own.next = now + EVERY;
+
+        let people: Vec<_> = (&positions, &players).join().map(|(p, _)| p.0).collect();
+        if people.is_empty() {
+            return;
+        }
+        let near2 = NEAR * NEAR;
+        let mut emit = events.get_emitters();
+        let mut count = 0u64;
+        let mut joined = (
+            &entities,
+            &positions,
+            healths.maybe(),
+            !&players,
+            alignments.maybe(),
+            agents.maybe(),
+        )
+            .lend_join();
+        while let Some((entity, pos, _health, (), alignment, agent)) = joined.next() {
+            let aggro = agent.and_then(|a| a.psyche.aggro_dist);
+            if !is_hostile(alignment, aggro) {
+                continue;
+            }
+            if !people.iter().any(|p| p.distance_squared(pos.0) <= near2) {
+                continue;
+            }
+            if let Some(actor) = actors.get(entity).copied() {
+                rtsim.hook_rtsim_actor_death(&world, index.as_index_ref(), actor, Some(pos.0), None);
+            }
+            emit.emit(DeleteEvent(entity));
+            count += 1;
+        }
+        if count > 0 {
+            job.own.removed += count;
+            info!(count, total = job.own.removed, "NemoWorld peace: removed hostile creatures near people");
+        }
+
+        // Residents are the village's own. No fall, hunger or drowning may end them: death protection is
+        // refreshed every pass, so a blow that would kill a resident leaves it at one health instead. The
+        // link owns the resident list (the same exact-alias test `project.helped` uses to tell residents
+        // from visitors).
+        if let Some(link) = link {
+            for (entity, player) in (&entities, &players).join() {
+                if link.is_resident(&player.alias) {
+                    if let Some(mut health) = healths.get_mut(entity) {
+                        health.refresh_death_protection();
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn monsters_and_hunters_are_hostile_everyone_else_is_not() {
+        assert!(is_hostile(Some(&Alignment::Enemy), None));
+        assert!(is_hostile(Some(&Alignment::Wild), Some(20.0)));
+        assert!(!is_hostile(Some(&Alignment::Wild), None)); // a deer
+        assert!(!is_hostile(Some(&Alignment::Npc), Some(10.0))); // a villager
+        assert!(!is_hostile(Some(&Alignment::Tame), None));
+        assert!(!is_hostile(Some(&Alignment::Passive), None));
+        assert!(!is_hostile(None, Some(5.0)));
+    }
+}
