+/// The greeting used while the resident holds a `work` order: it names the live fact that a stage is
+/// waiting for its crew. Scripted and true — the order itself came from the works board.
+fn work_greetings(calling: &str) -> &'static [&'static str] {
+    match calling {
+        "builder" | "artisan" | "maker" => &[
+            "Welcome. This stage is waiting for its crew; if you have a moment, stand with us.",
+            "Hello. Two hands are all it takes to raise the next stage — yours would be welcome.",
+        ],
+        "researcher" | "scholar" | "keeper" => &[
+            "Welcome. The next page is ready to be written; come see what we are learning.",
+            "Hello. The works wait on knowledge — this one is nearly learned.",
+        ],
+        _ => &[
+            "Welcome. There is work being raised at the site; come stand with the crew.",
+            "Hello. The village is building; there is room for another pair of hands.",
+        ],
+    }
+}
+
+/// The calendar day (UTC, seconds / 86400), for "once per person per day".
+fn unix_day() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs() / 86_400)
+        .unwrap_or(0)
+}
+
+/// The nearest online human (never a resident) within `radius` blocks, by alias and distance.
+fn nearby_human(
+    client: &Client,
+    resident_names: &[String],
+    pos: Vec3<f32>,
+    radius: f32,
+) -> Option<(String, f32)> {
+    client
+        .player_list()
+        .iter()
+        .filter(|(_, info)| {
+            info.is_online && !resident_names.iter().any(|n| n == &info.player_alias)
+        })
+        .filter_map(|(uid, info)| {
+            let entity = client.state().ecs().entity_from_uid(*uid)?;
+            let p = client.state().read_storage::<comp::Pos>().get(entity)?.0;
+            let gap = (p.xy() - pos.xy()).magnitude();
+            (gap <= radius).then_some((info.player_alias.clone(), gap))
+        })
+        .min_by(|a, b| a.1.total_cmp(&b.1))
+}
