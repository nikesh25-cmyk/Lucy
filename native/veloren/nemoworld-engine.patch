+                    { "op": "sprite", "at": [0, 0, 1], "sprite": "BenchWoodWoodland" },
+                    { "op": "sprite", "at": [2, 0, 1], "sprite": "Lantern(Ori(2))" },
+                    { "op": "fill", "from": [0, 0, 0], "to": [2, 0, 0], "kind": "Wood", "rgb": [120, 88, 60] },
+                    { "op": "foundation", "from": [0, 0], "to": [2, 0], "kind": "Earth", "rgb": [110, 84, 60], "depth": 2 }
