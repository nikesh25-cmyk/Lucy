+    fn matches_the_nemoworld_test_vector() {
+        let text = canonical(
+            "local-dev",
+            42,
+            "landmark.together",
+            "lw-lyra",
+            "0b6f4f0e-2d5a-4c1a-9a53-6a3a1d2b7c10",
+            "Tester",
+            "lyra-survey",
+            1_760_572_800_000,
+        );
+        assert_eq!(
+            text,
+            "1\nlocal-dev\n42\nlandmark.together\nlw-lyra\n0b6f4f0e-2d5a-4c1a-9a53-6a3a1d2b7c10\n\
+             Tester\nlyra-survey\n1760572800000"
+        );
+        assert_eq!(
+            sign(b"nemo-test-key-nemo-test-key-1234", &text),
+            "17a38c9966e4c61f25034d0cdb39136243f48fd515f501c3067abd955f33ce0e"
+        );
+    }
+
+    #[test]
+    fn matches_the_nemoworld_command_vector() {
+        let text = canonical_command(
+            "9c1f0f9e-0b0e-4e0e-9a5a-0123456789ab",
+            "echo",
+            "0b6f4f0e-2d5a-4c1a-9a53-6a3a1d2b7c10",
+            "{\"text\":\"hi\"}",
+            1_760_572_800_000,
+            1_760_572_860_000,
+        );
+        let key = b"nemo-test-key-nemo-test-key-1234";
+        let sig = sign(key, &text);
+        assert_eq!(sig, "67783eaced1e4dccb0a5f256dd0366fe0d0b50e236a85ba5a951e94c7ab4ce68");
+        assert!(verify(key, &text, &sig));
+        assert!(!verify(key, &text, &"0".repeat(64)));
+        assert!(!verify(key, &format!("{text}x"), &sig));
+        assert!(!verify(b"another-key-another-key-another-1", &text, &sig));
+        assert!(!verify(key, &text, "not hex"));
+    }
+
+    #[test]
+    fn a_changed_field_changes_the_signature() {
+        let a = canonical("s", 1, "resident.met", "lw-lyra", "u", "A", "", 1);
+        let b = canonical("s", 1, "resident.met", "lw-lyra", "u", "B", "", 1);
+        assert_ne!(sign(b"k", &a), sign(b"k", &b));
+    }
+
+    #[test]
+    fn keys_follow_nemoworld_parsing() {
+        assert_eq!(parse_key("short text"), b"short text".to_vec());
+        let hex = "ab".repeat(32);
+        assert_eq!(parse_key(&hex), vec![0xab; 32]);
+    }
+}
