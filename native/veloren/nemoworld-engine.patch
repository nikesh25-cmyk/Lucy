@@ -0,0 +1,644 @@
+//! NemoWorld homes in Veloren: the pure rules (no game types), so they can be tested in seconds.
+//!
+//! A *home* is a claimed NemoWorld plot shown in Veloren as a flat green pad with a small cottage on it.
+//! This module owns:
+//! * the plot address (`plot:<sx>:<sy>:<px>:<py>`, the same canonical text NemoWorld uses) and the
+//!   mapping from a plot to a place in the world;
+//! * the strict form of the arguments of the signed `home_*` commands (nothing but a plot address and
+//!   a style number is ever accepted, so a command can never carry a coordinate);
+//! * the cottage blueprint (what to put where), including its guarantees: the shell is sealed, the
+//!   spawn point is free, nothing is placed outside the plot's own cell;
+//! * the choice of ground height, with the reasons a plot is refused (steep or wet).
+//!
+//! The Veloren server system (`server/src/sys/nemo_home.rs`) translates [`Mat`] and [`Spr`] to game
+//! blocks and sprites and does the I/O. Everything that decides *what is allowed* lives here.
+
+/// Blocks per plot cell. A NemoWorld parcel is 6 x 6 cells; one parcel is one 14 x 14 cell here.
+pub const SPACING: i32 = 14;
+/// Plots per side of one NemoWorld area.
+pub const PLOT_GRID: i32 = 8;
+/// Number of roof colours; `style` is `0..STYLES`.
+pub const STYLES: u8 = 8;
+/// Most a plot's ground may rise or fall over its pad and still be built on.
+pub const MAX_RELIEF: i32 = 6;
+/// How far below the floor the foundation is filled where the ground is lower.
+pub const FOUNDATION_DEPTH: i32 = 6;
+/// Highest layer cleared above the floor (trees, hills).
+pub const CLEAR_TOP: i32 = 11;
+/// The origin must stay inside this box so arithmetic can never overflow.
+pub const ORIGIN_LIMIT: i32 = 4_000_000;
+
+/// Why a request was refused. The text is for logs; NemoWorld only learns "rejected".
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Reject {
+    BadArgs,
+    BadPlot,
+    NotInCommons,
+    BadStyle,
+    Steep,
+    Wet,
+    NoGround,
+}
+
+impl Reject {
+    pub fn code(self) -> &'static str {
+        match self {
+            Reject::BadArgs => "bad_args",
+            Reject::BadPlot => "bad_plot",
+            Reject::NotInCommons => "not_in_commons",
+            Reject::BadStyle => "bad_style",
+            Reject::Steep => "ground_too_steep",
+            Reject::Wet => "ground_is_water",
+            Reject::NoGround => "no_ground",
+        }
+    }
+}
+
+/// A NemoWorld land plot address.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct Plot {
+    pub sx: i32,
+    pub sy: i32,
+    pub px: i32,
+    pub py: i32,
+}
+
+fn canonical_int(text: &str) -> Option<i32> {
+    // Exactly what `Number(x).toString()` would print: no sign other than '-', no leading zeros, no "-0".
+    if text.is_empty() || text.len() > 3 {
+        return None;
+    }
+    let value: i32 = text.parse().ok()?;
+    (value.to_string() == text).then_some(value)
+}
+
+impl Plot {
+    /// Parses only the canonical form `plot:<sx>:<sy>:<px>:<py>` (sector -8..=7, plot 0..=7).
+    pub fn parse(text: &str) -> Result<Self, Reject> {
+        if text.len() > 32 || !text.is_ascii() {
+            return Err(Reject::BadPlot);
+        }
+        let rest = text.strip_prefix("plot:").ok_or(Reject::BadPlot)?;
+        let parts: Vec<&str> = rest.split(':').collect();
+        if parts.len() != 4 {
+            return Err(Reject::BadPlot);
+        }
+        let mut numbers = [0i32; 4];
+        for (slot, part) in numbers.iter_mut().zip(&parts) {
+            *slot = canonical_int(part).ok_or(Reject::BadPlot)?;
+        }
+        let [sx, sy, px, py] = numbers;
+        if !(-8..=7).contains(&sx) || !(-8..=7).contains(&sy) || !(0..PLOT_GRID).contains(&px) || !(0..PLOT_GRID).contains(&py) {
+            return Err(Reject::BadPlot);
+        }
+        Ok(Self { sx, sy, px, py })
+    }
+
+    pub fn id(&self) -> String { format!("plot:{}:{}:{}:{}", self.sx, self.sy, self.px, self.py) }
+
+    /// Plots Veloren builds on: the central NemoWorld area, without the two reserved crossroads rows.
+    pub fn in_commons(&self) -> bool {
+        self.sx == 0 && self.sy == 0 && ![3, 4].contains(&self.px) && ![3, 4].contains(&self.py)
+    }
+}
+
+/// Where the commons lie in the Veloren world: the south-west corner of plot (0, 0).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Layout {
+    pub origin_x: i32,
+    pub origin_y: i32,
+}
+
+impl Layout {
+    pub fn new(origin_x: i32, origin_y: i32) -> Option<Self> {
+        (origin_x.unsigned_abs() <= ORIGIN_LIMIT as u32 && origin_y.unsigned_abs() <= ORIGIN_LIMIT as u32).then_some(Self { origin_x, origin_y })
+    }
+
+    /// South-west corner of a plot's cell, only for plots Veloren builds on.
+    pub fn cell_origin(&self, plot: &Plot) -> Result<(i32, i32), Reject> {
+        if !plot.in_commons() {
+            return Err(Reject::NotInCommons);
+        }
+        Ok((self.origin_x + plot.px * SPACING, self.origin_y + plot.py * SPACING))
+    }
+
+    /// Centre of the whole commons (where the steward stands).
+    pub fn centre(&self) -> (i32, i32) {
+        (self.origin_x + PLOT_GRID * SPACING / 2, self.origin_y + PLOT_GRID * SPACING / 2)
+    }
+}
+
+/// Arguments of every `home_*` command, in the one exact form NemoWorld signs:
+/// `{"plot":"plot:0:0:1:2"}` or `{"plot":"plot:0:0:1:2","style":3}`. Anything else is refused, so a
+/// command cannot smuggle a coordinate, a path or a second field.
+pub fn parse_args(text: &str, allow_style: bool) -> Result<(Plot, u8), Reject> {
+    let rest = text.strip_prefix("{\"plot\":\"").ok_or(Reject::BadArgs)?;
+    let close = rest.find('"').ok_or(Reject::BadArgs)?;
+    let (plot_text, tail) = rest.split_at(close);
+    if !plot_text.bytes().all(|b| b.is_ascii_alphanumeric() || b == b':' || b == b'-') {
+        return Err(Reject::BadArgs);
+    }
+    let tail = &tail[1..];
+    let style = if tail == "}" {
+        0
+    } else {
+        let digits = tail.strip_prefix(",\"style\":").and_then(|t| t.strip_suffix('}')).ok_or(Reject::BadArgs)?;
+        if !allow_style || digits.is_empty() || digits.len() > 2 || !digits.bytes().all(|b| b.is_ascii_digit()) || (digits.len() > 1 && digits.starts_with('0')) {
+            return Err(Reject::BadArgs);
+        }
+        let value: u8 = digits.parse().map_err(|_| Reject::BadArgs)?;
+        if value >= STYLES {
+            return Err(Reject::BadStyle);
+        }
+        value
+    };
+    Ok((Plot::parse(plot_text)?, style))
+}
+
+// ---- ground ------------------------------------------------------------------------------------
+
+/// The top of the natural ground in one column of the pad.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Ground {
+    /// z of the highest solid ground block.
+    pub top: i32,
+    /// The highest thing found there was liquid.
+    pub liquid: bool,
+}
+
+/// The `z` of the lowest air layer above the floor (`dz == 0`), from samples over the pad.
+pub fn choose_base(samples: &[Ground]) -> Result<i32, Reject> {
+    if samples.is_empty() {
+        return Err(Reject::NoGround);
+    }
+    if samples.iter().any(|g| g.liquid) {
+        return Err(Reject::Wet);
+    }
+    let mut tops: Vec<i32> = samples.iter().map(|g| g.top).collect();
+    tops.sort_unstable();
+    if tops[tops.len() - 1] - tops[0] > MAX_RELIEF {
+        return Err(Reject::Steep);
+    }
+    // The median keeps one tall tree-stump or hollow from deciding the floor.
+    Ok(tops[tops.len() / 2] + 1)
+}
+
+// ---- the cottage -------------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Mat {
+    Air,
+    Earth,
+    Grass,
+    Path,
+    Floor,
+    Rug,
+    /// The doormat. Its exact colour is also the marker that tells a restart the cottage still stands.
+    DoorMat,
+    Wall,
+    Trim,
+    Door,
+    Glass,
+    Roof(u8),
+    Spr(Spr),
+}
+
+impl Mat {
+    /// A full block a player cannot walk through. Sprites count as open (the conservative reading).
+    pub fn solid(self) -> bool { !matches!(self, Mat::Air | Mat::Spr(_)) }
+
+    /// Block colour (sprites and air have none).
+    pub fn color(self) -> Option<(u8, u8, u8)> {
+        Some(match self {
+            Mat::Air | Mat::Spr(_) => return None,
+            Mat::Earth => (112, 84, 58),
+            Mat::Grass => (86, 140, 58),
+            Mat::Path => (176, 164, 140),
+            Mat::Floor => (176, 134, 88),
+            Mat::Rug => (120, 150, 132),
+            Mat::DoorMat => (179, 48, 49),
+            Mat::Wall => (226, 214, 188),
+            Mat::Trim => (112, 78, 50),
+            Mat::Door => (84, 54, 34),
+            Mat::Glass => (150, 196, 224),
+            Mat::Roof(style) => ROOFS[usize::from(style) % ROOFS.len()],
+        })
+    }
+}
+
+pub const ROOFS: [(u8, u8, u8); STYLES as usize] = [
+    (160, 64, 48),
+    (70, 96, 150),
+    (86, 120, 70),
+    (150, 110, 60),
+    (110, 70, 120),
+    (60, 120, 120),
+    (170, 140, 60),
+    (120, 60, 60),
+];
+
+/// Sprites the cottage uses; the server maps each to a Veloren `SpriteKind`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Spr {
+    Lantern,
+    Candle,
+    BedHead,
+    BedMiddle,
+    BedTail,
+    BookshelfMiddle,
+    BookshelfEnd,
+    TableCorner,
+    TableBody,
+    Bench,
+    Chair,
+    Hearth,
+    CookingPot,
+    /// The vault chest. It is decoration and a pointer: it holds nothing.
+    VaultChest,
+    Flowerpot,
+    Drawer,
+    Fence,
+    FencePost,
+    RedFlower,
+    YellowFlower,
+    WhiteFlower,
+}
+
+/// One block to set, in plot-cell coordinates: `x`, `y` in `0..SPACING`, `dz` relative to the floor
+/// layer (`dz == 0` is the first air layer, the floor itself is `dz == -1`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Put {
+    pub x: i32,
+    pub y: i32,
+    pub dz: i32,
+    pub mat: Mat,
+}
+
+// Layout of the cell (south is low y; the door faces south).
+pub const PAD_X: (i32, i32) = (1, 12);
+pub const PAD_Y: (i32, i32) = (1, 12);
+pub const SHELL_X: (i32, i32) = (2, 10);
+pub const SHELL_Y: (i32, i32) = (3, 9);
+pub const INT_X: (i32, i32) = (3, 9);
+pub const INT_Y: (i32, i32) = (4, 8);
+pub const RIDGE_Y: i32 = 6;
+pub const DOOR_X: i32 = 6;
+pub const WALL_TOP: i32 = 4;
+/// The doormat just inside the door; standing on it leaves the cottage.
+pub const MAT_CELL: (i32, i32) = (6, 4);
+
+/// Where a visitor appears inside (cell coordinates, centre of a block, standing on the floor).
+pub const SPAWN: (f32, f32) = (6.5, 6.5);
+/// Where a visitor appears after leaving: in front of the door, on the path.
+pub const DOORSTEP: (f32, f32) = (6.5, 1.5);
+
+fn put(out: &mut Vec<Put>, x: i32, y: i32, dz: i32, mat: Mat) { out.push(Put { x, y, dz, mat }); }
+
+/// Every block of the cottage plot, clearing first, in the order they must be applied (later wins).
+pub fn blueprint(style: u8) -> Vec<Put> {
+    let style = style % STYLES;
+    let mut out = Vec::with_capacity(3000);
+    // 1. Clear the whole pad volume.
+    for x in PAD_X.0..=PAD_X.1 {
+        for y in PAD_Y.0..=PAD_Y.1 {
+            for dz in 0..=CLEAR_TOP {
+                put(&mut out, x, y, dz, Mat::Air);
+            }
+        }
+    }
+    // 2. The grass pad and the path to the door.
+    for x in PAD_X.0..=PAD_X.1 {
+        for y in PAD_Y.0..=PAD_Y.1 {
+            put(&mut out, x, y, -1, Mat::Grass);
+        }
+    }
+    for x in (DOOR_X - 1)..=(DOOR_X + 1) {
+        for y in PAD_Y.0..SHELL_Y.0 {
+            put(&mut out, x, y, -1, Mat::Path);
+        }
+    }
+    // 3. Floor, rug and doormat.
+    for x in SHELL_X.0..=SHELL_X.1 {
+        for y in SHELL_Y.0..=SHELL_Y.1 {
+            put(&mut out, x, y, -1, Mat::Floor);
+        }
+    }
+    for x in 5..=7 {
+        for y in 5..=7 {
+            put(&mut out, x, y, -1, Mat::Rug);
+        }
+    }
+    put(&mut out, MAT_CELL.0, MAT_CELL.1, -1, Mat::DoorMat);
+    // 4. Walls: a closed ring, trim at the corners, a door and glass panes (panes are solid blocks:
+    //    Veloren window sprites can be walked through, so they would open the shell).
+    for dz in 0..=WALL_TOP {
+        for x in SHELL_X.0..=SHELL_X.1 {
+            for y in SHELL_Y.0..=SHELL_Y.1 {
+                let edge = x == SHELL_X.0 || x == SHELL_X.1 || y == SHELL_Y.0 || y == SHELL_Y.1;
+                if !edge {
+                    continue;
+                }
+                let corner = (x == SHELL_X.0 || x == SHELL_X.1) && (y == SHELL_Y.0 || y == SHELL_Y.1);
+                let mat = if corner { Mat::Trim } else { Mat::Wall };
+                put(&mut out, x, y, dz, mat);
+            }
+        }
+    }
+    for dz in 0..=3 {
+        for x in (DOOR_X - 1)..=(DOOR_X + 1) {
+            put(&mut out, x, SHELL_Y.0, dz, Mat::Trim);
+        }
+    }
+    for dz in 0..=2 {
+        put(&mut out, DOOR_X, SHELL_Y.0, dz, Mat::Door);
+    }
+    for dz in 1..=2 {
+        for y in [5, 7] {
+            put(&mut out, SHELL_X.0, y, dz, Mat::Glass);
+            put(&mut out, SHELL_X.1, y, dz, Mat::Glass);
+        }
+        for x in [4, 5, 7, 8] {
+            put(&mut out, x, SHELL_Y.1, dz, Mat::Glass);
+        }
+        for x in [3, 9] {
+            put(&mut out, x, SHELL_Y.0, dz, Mat::Glass);
+        }
+    }
+    // 5. Ceiling and gable roof: every column from the ceiling layer up to the roof surface is solid.
+    for x in SHELL_X.0..=SHELL_X.1 {
+        for y in (SHELL_Y.0 - 1)..=(SHELL_Y.1 + 1) {
+            let top = 9 - (y - RIDGE_Y).abs();
+            for dz in (WALL_TOP + 1)..=top {
+                let mat = if dz == top { Mat::Roof(style) } else { Mat::Wall };
+                put(&mut out, x, y, dz, mat);
+            }
+        }
+    }
+    // 6. Furniture, mirroring NemoWorld's Garden Cottage: bed, bookshelf, table, benches, flowers,
+    //    lamps, kitchen. Plus the vault chest.
+    let inside = [
+        (3, 8, Spr::BedHead), (3, 7, Spr::BedMiddle), (3, 6, Spr::BedTail),
+        (4, 8, Spr::Drawer), (5, 8, Spr::BookshelfEnd), (6, 8, Spr::BookshelfMiddle),
+        (7, 8, Spr::BookshelfMiddle), (8, 8, Spr::BookshelfEnd),
+        (9, 7, Spr::Hearth), (9, 6, Spr::CookingPot),
+        (7, 5, Spr::TableCorner), (8, 5, Spr::TableBody),
+        (7, 4, Spr::Bench), (8, 4, Spr::Bench), (8, 6, Spr::Chair),
+        (3, 4, Spr::VaultChest), (4, 4, Spr::Lantern), (9, 4, Spr::Lantern),
+        (4, 6, Spr::Flowerpot), (9, 5, Spr::Flowerpot), (4, 7, Spr::Candle),
+    ];
+    for (x, y, sprite) in inside {
+        put(&mut out, x, y, 0, Mat::Spr(sprite));
+    }
+    // 7. The garden: lanterns by the door, a fence with a gap for the path, flowers.
+    put(&mut out, DOOR_X - 2, 2, 0, Mat::Spr(Spr::Lantern));
+    put(&mut out, DOOR_X + 2, 2, 0, Mat::Spr(Spr::Lantern));
+    for (x, y) in [(PAD_X.0, PAD_Y.0), (PAD_X.1, PAD_Y.0), (PAD_X.0, PAD_Y.1), (PAD_X.1, PAD_Y.1)] {
+        put(&mut out, x, y, 0, Mat::Spr(Spr::FencePost));
+    }
+    for x in (PAD_X.0 + 1)..PAD_X.1 {
+        if !((DOOR_X - 1)..=(DOOR_X + 1)).contains(&x) {
+            put(&mut out, x, PAD_Y.0, 0, Mat::Spr(Spr::Fence));
+        }
+        put(&mut out, x, PAD_Y.1, 0, Mat::Spr(Spr::Fence));
+    }
+    for y in (PAD_Y.0 + 1)..PAD_Y.1 {
+        put(&mut out, PAD_X.0, y, 0, Mat::Spr(Spr::Fence));
+        put(&mut out, PAD_X.1, y, 0, Mat::Spr(Spr::Fence));
+    }
+    for (x, y, sprite) in [
+        (3, 2, Spr::RedFlower), (9, 2, Spr::YellowFlower), (11, 3, Spr::WhiteFlower),
+        (11, 5, Spr::RedFlower), (11, 8, Spr::YellowFlower), (3, 11, Spr::WhiteFlower),
+        (9, 11, Spr::RedFlower), (2, 11, Spr::YellowFlower),
+    ] {
+        put(&mut out, x, y, 0, Mat::Spr(sprite));
+    }
+    out
+}
+
+/// The final material at each position after applying `blueprint` in order.
+pub fn resolve(puts: &[Put]) -> std::collections::HashMap<(i32, i32, i32), Mat> {
+    puts.iter().map(|p| ((p.x, p.y, p.dz), p.mat)).collect()
+}
+
+/// The block whose exact value tells whether a cottage still stands (the doormat).
+pub fn sentinel() -> (i32, i32, i32, Mat) { (MAT_CELL.0, MAT_CELL.1, -1, Mat::DoorMat) }
+
+/// Cell coordinates of a point, given the plot's cell origin; `dz` is relative to the floor layer.
+pub fn to_local(cell: (i32, i32), x: f32, y: f32, z: f32, base: i32) -> (f32, f32, f32) {
+    (x - cell.0 as f32, y - cell.1 as f32, z - base as f32)
+}
+
+/// True when a point (cell coordinates) is inside the room.
+pub fn inside_room(x: f32, y: f32, dz: f32) -> bool {
+    x >= INT_X.0 as f32 && x < (INT_X.1 + 1) as f32 && y >= INT_Y.0 as f32 && y < (INT_Y.1 + 1) as f32 && (-1.0..(WALL_TOP + 1) as f32).contains(&dz)
+}
+
+/// True when a point stands on the doormat.
+pub fn on_mat(x: f32, y: f32, dz: f32) -> bool {
+    x >= MAT_CELL.0 as f32 && x < (MAT_CELL.0 + 1) as f32 && y >= MAT_CELL.1 as f32 && y < (MAT_CELL.1 + 1) as f32 && (-1.0..2.5).contains(&dz)
+}
