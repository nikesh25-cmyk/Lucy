@@ -0,0 +1,878 @@
+//! The world manifest: what NemoWorld wants placed in a Veloren world, validated before anything
+//! touches the terrain.
+//!
+//! A manifest is data, never code. It can only say "put this block, this sprite, or air here",
+//! relative to a named anchor (a plot of a named site), and only from short allow-lists. Everything
+//! outside those lists, outside the allowed area or over a size limit makes the WHOLE manifest
+//! invalid: nothing from a bad manifest is applied, not even its good parts.
+
+use serde::Deserialize;
+use std::collections::{BTreeMap, BTreeSet};
+
+pub const FORMAT: &str = "veloren-world-v1";
+
+/// Hard limits. A manifest may ask for less, never more.
+pub const MAX_AREA_RADIUS: f32 = 400.0;
+pub const MAX_GROUPS: usize = 600;
+pub const MAX_OPS_PER_GROUP: usize = 600;
+/// Largest offset of any op from its group's anchor, on each horizontal axis.
+pub const MAX_EXTENT: i32 = 48;
+/// Lowest and highest op height relative to the ground at the group's anchor.
+pub const MIN_DZ: i32 = -12;
+pub const MAX_DZ: i32 = 24;
+pub const MAX_FILL_VOLUME: i64 = 4096;
+pub const MAX_BLOCKS_PER_GROUP: usize = 6000;
+pub const MAX_BLOCKS_TOTAL: usize = 60_000;
+/// The longest a stage may wait for its turn: a week of real time.
+pub const MAX_RELEASE_MINUTES: u32 = 7 * 24 * 60;
+/// The largest crew a stage may ask for.
+pub const MAX_CREW: u8 = 8;
+pub const MAX_FOUNDATION_DEPTH: u8 = 12;
+pub const MAX_FOUNDATION_COLUMNS: usize = 1200;
+pub const MAX_SPRITE_TEXT: usize = 64;
+
+/// Block kinds a manifest may place. Not Water, Lava, Ice, Snow, Leaves or anything that flows,
+/// burns, spreads, hurts or can be blown up.
+pub const ALLOWED_KINDS: &[&str] = &["Rock", "Wood", "Misc", "Earth", "Sand", "Grass"];
+
+/// Sprites a manifest may place (names of `SpriteKind`). Furniture, lights, signs and windows.
+/// Plants are left out on purpose: players can pick them, which would fight the reconciler.
+pub const ALLOWED_SPRITES: &[&str] = &[
+    // lights
+    "Lantern", "StreetLamp", "StreetLampTall", "FireBowlGround", "LanternpostWoodLantern", "MesaLantern",
+    "LampTerracotta", "LampMetalShinglesRed", "LampMetalShinglesCyan",
+    "WallLamp", "WallLampSmall", "WallSconce", "Candle", "BonfireMLit",
+    // posts
+    "LanternpostWoodUpper", "LanternpostWoodBase", "LampMetalBase",
+    // seating and tables
+    "BenchWoodEnd", "BenchWoodMiddle", "BenchWoodWoodland", "BenchWoodWoodlandGreen1", "BenchWoodWoodlandGreen2",
+    "BenchWoodWoodlandGreen3", "BenchWood2Middle", "BenchWood2Side", "BenchWood2Middle2", "BenchCoastal",
+    "ChairWoodWoodland", "ChairWoodWoodland2", "SeatWoodBlueMiddle", "SeatWoodBlueSide",
+    "DiningtableWoodCorner", "DiningtableWoodBody", "DiningtableWoodWoodlandRound", "DiningtableWoodWoodlandSquare",
+    "TableWoodFancyWoodlandCorner", "TableWoodFancyWoodlandBody", "TableCoastalLarge", "TableArabicLarge",
+    "TableArabicSmall", "CarpenterTable", "CounterWoodEnd", "CounterWoodMiddle",
+    "CushionArabic", "CanapeArabic",
+    // storage and shelves
+    "BookshelfEnd", "BookshelfMiddle", "BookshelfArabic", "Shelf", "CupboardArabic", "CupboardMesa",
+    "DrawerWoodWoodlandL1", "DrawerWoodWoodlandL2", "DrawerWoodWoodlandM1", "DrawerWoodWoodlandM2",
+    "DrawerWoodWoodlandS", "WardrobeSingleMesa", "WardrobeDoubleMesa", "WardrobedoubleWoodWoodland",
+    "WardrobesingleWoodWoodland", "Barrel", "CrateBlock", "BarrelWoodCoal", "BarrelWoodWater",
+    "BasketWovenL", "BasketWovenM", "BasketWovenS", "CarpenterCrateWoodS", "CarpenterCrateWoodL",
+    "SackLeatherM", "BucketWoodM", "JugClayM", "Hay",
+    // beds
+    "BedMesa", "BedWoodWoodlandHead", "BedWoodWoodlandMiddle", "BedWoodWoodlandTail",
+    // crafting and hearth
+    "CraftingBench", "Forge", "Cauldron", "Anvil", "CookingPot", "SpinningWheel", "TanningRack", "Loom",
+    "RepairBench", "DismantlingBench", "BlacksmithBellows", "Hearth", "CrystalBall",
+    // signs, decor, small things
+    "Sign", "HangingSign", "HangingBasket", "Planter", "FlowerpotWoodWoodlandS", "CoatrackWoodWoodland",
+    "MirrorMesa", "MirrorWoodM", "WallTableMesa", "WallTableArabic", "Scarecrow", "RopeCoilM", "Ladder",
+    "FenceWoodGateWoodland", "FenceWoodWoodland", "FencePost", "HandCartWoodHead", "HandCartWoodMiddle",
+    "HandCartWoodTail", "BroomWoodWoodlandBlue", "RakeWoodWoodland",
+    // windows
+    "Window1", "Window2", "Window3", "Window4",
+];
+
+/// Sprites that emit light on the client (Veloren's `Block::get_glow`). Used to count and report
+/// the lit props; the list is checked against the game source by a test in NemoWorld.
+pub const LIGHT_SPRITES: &[&str] = &[
+    "Lantern", "StreetLamp", "StreetLampTall", "FireBowlGround", "LanternpostWoodLantern", "MesaLantern",
+    "LampTerracotta", "LampMetalShinglesRed", "LampMetalShinglesCyan", "WallLamp", "WallLampSmall",
+    "WallSconce", "Candle", "BonfireMLit",
+];
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Area {
+    /// Blocks from the site origin (a circle). Nothing outside it is ever touched.
+    pub radius: f32,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Atmosphere {
+    /// Follow NemoWorld's shared day cycle (set the Veloren time of day once a second).
+    #[serde(default = "yes")]
+    pub time: bool,
+    /// Follow NemoWorld's deterministic weather slots.
+    #[serde(default = "yes")]
+    pub weather: bool,
+    #[serde(default = "d_dawn")]
+    pub dawn_hour: f64,
+    #[serde(default = "d_day")]
+    pub day_hour: f64,
+    #[serde(default = "d_dusk")]
+    pub dusk_hour: f64,
+    #[serde(default = "d_night")]
+    pub night_hour: f64,
+    /// Radius of the weather zone around the site, in blocks.
+    #[serde(default = "d_weather_radius")]
+    pub weather_radius: f32,
+}
+
+fn yes() -> bool { true }
+fn d_dawn() -> f64 { 5.0 }
+fn d_day() -> f64 { 9.0 }
+fn d_dusk() -> f64 { 16.0 }
+fn d_night() -> f64 { 20.0 }
+fn d_weather_radius() -> f32 { 1500.0 }
+
+impl Default for Atmosphere {
+    fn default() -> Self {
+        Self {
+            time: true,
+            weather: true,
+            dawn_hour: 5.0,
+            day_hour: 9.0,
+            dusk_hour: 16.0,
+            night_hour: 20.0,
+            weather_radius: 1500.0,
+        }
+    }
+}
+
+impl Atmosphere {
+    pub fn sky_hours(&self) -> crate::sky::SkyHours {
+        crate::sky::SkyHours {
+            dawn: self.dawn_hour,
+            day: self.day_hour,
+            dusk: self.dusk_hour,
+            night: self.night_hour,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Anchor {
+    /// A plot kind of the site (`Plaza`, `House`, `Workshop`, `FarmField`...). Absent = the site origin.
+    #[serde(default)]
+    pub plot: Option<String>,
+    /// Which plot of that kind, nearest the site origin first.
+    #[serde(default)]
+    pub nth: usize,
+    #[serde(default)]
+    pub dx: i32,
+    #[serde(default)]
+    pub dy: i32,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(tag = "op", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Op {
+    /// A solid box of one block kind and colour.
+    Fill { from: [i32; 3], to: [i32; 3], kind: String, rgb: [u8; 3] },
+    /// A box of air (carves rooms, doorways and clears grass and bushes).
+    Clear { from: [i32; 3], to: [i32; 3] },
+    /// One sprite, as `Name` or `Name(Ori(2))`, in an otherwise empty cell.
+    Sprite { at: [i32; 3], sprite: String },
+    /// Fills the air under a rectangle, from the level below the floor downwards, until the ground.
+    Foundation { from: [i32; 2], to: [i32; 2], kind: String, rgb: [u8; 3], depth: u8 },
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Group {
+    pub id: String,
+    #[serde(default)]
+    pub anchor: Anchor,
+    /// Where (relative to the anchor) the ground height is measured. Default: the anchor itself.
+    #[serde(default)]
+    pub ground_at: [i32; 2],
+    pub ops: Vec<Op>,
+    /// Free text for humans (what this is, where to find it). Not used by the game.
+    #[serde(default)]
+    pub note: String,
+    /// Construction: real minutes after the works clock started before this group may be built. A group with 0 is
+    /// built at once (everything older than construction). Groups with the same `project` are the stages of one public
+    /// work, built in order of their release time.
+    #[serde(default)]
+    pub release_after_minutes: u32,
+    /// The public work this group is a stage of (a plain id such as `well`); empty for plain dressing.
+    #[serde(default)]
+    pub project: String,
+    /// Human name of the stage (shown on the works board), e.g. `The well: foundation ring`.
+    #[serde(default)]
+    pub title: String,
+    /// Cooperation: how many people (residents or visitors) must be standing near the site for this stage to be
+    /// built. 0 = none. A stage is never built before the previous stage of its project.
+    #[serde(default)]
+    pub crew: u8,
+    /// The `site-*` landmark this stage is built at — the place a visitor's `project.helped` fact names. Required
+    /// for a crew-gated stage: a crew that can earn a fact must be attributable to a place. Empty for plain dressing
+    /// and for stages no crew is needed for.
+    #[serde(default)]
+    pub site: String,
+    /// Research gates works: a technology NemoWorld must have learned before this stage may be built. Empty means
+    /// no gate. NemoWorld issues a signed `works_unlock` for the technology; until the server acknowledges it the
+    /// stage is only "waiting for research", never built.
+    #[serde(default)]
+    pub needs_tech: String,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Manifest {
+    pub format: String,
+    /// The named Veloren site everything is anchored to, e.g. `Harr`.
+    pub site: String,
+    pub area: Area,
+    #[serde(default)]
+    pub atmosphere: Atmosphere,
+    pub groups: Vec<Group>,
+    #[serde(default)]
+    pub note: String,
+}
+
+fn valid_id(id: &str) -> bool {
+    !id.is_empty() && id.len() <= 48 && id.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+}
+
+fn valid_plot(plot: &str) -> bool {
+    !plot.is_empty() && plot.len() <= 32 && plot.bytes().all(|b| b.is_ascii_alphanumeric())
+}
+
+fn valid_site(site: &str) -> bool {
+    !site.is_empty() && site.len() <= 40 && site.chars().all(|c| c.is_alphanumeric() || c == ' ' || c == '\'' || c == '-')
+}
+
+/// A `site-*` landmark id, as `veloren-landmarks-extra.json` names the plots public works are built at.
+fn valid_site_landmark(id: &str) -> bool {
+    id.strip_prefix("site-").is_some_and(valid_id)
+}
+
+/// `Name` or `Name(Attr(value), Attr(value))`: letters, digits, brackets, commas, spaces, minus and
+/// `true`/`false` words only. The game parses the text again with its own parser; this keeps the
+/// text small and free of anything surprising before it gets there.
+pub fn sprite_name(text: &str) -> Option<&str> {
+    if text.is_empty() || text.len() > MAX_SPRITE_TEXT {
+        return None;
+    }
+    if !text.bytes().all(|b| b.is_ascii_alphanumeric() || matches!(b, b'(' | b')' | b',' | b' ' | b'-')) {
+        return None;
+    }
+    let name = text.split('(').next()?;
+    if name.is_empty() || !name.bytes().all(|b| b.is_ascii_alphanumeric()) {
+        return None;
+    }
+    let rest = &text[name.len()..];
+    if !rest.is_empty() {
+        // Brackets must balance and nest at most two deep: `Name(Ori(2), MirrorX(true))`.
+        let mut depth = 0i32;
+        for b in rest.bytes() {
+            match b {
+                b'(' => depth += 1,
+                b')' => depth -= 1,
+                _ => {},
+            }
+            if !(0..=2).contains(&depth) {
+                return None;
+            }
+        }
+        if depth != 0 || !rest.ends_with(')') {
+            return None;
+        }
+    }
+    Some(name)
+}
+
+/// How many cells a box covers, saturating instead of wrapping.
+///
+/// This is the check that stops a hostile manifest: computing the span in `i32` (as the draft did) made
+/// `i32::MIN` wrap, so `-2147483648` measured as *negative*, passed both the extent check and the volume
+/// check, and `plan` then expanded 2^31 cells until the machine died. Every step here is in `i64` and
+/// saturating, so an absurd box measures as absurd rather than as small.
+fn cell_count(from: [i32; 3], to: [i32; 3]) -> i64 {
+    (0..3).fold(1i64, |acc, i| {
+        let span = (i64::from(to[i]) - i64::from(from[i])).abs().saturating_add(1);
+        acc.saturating_mul(span)
+    })
+}
+
+/// Is this value further from the anchor than a manifest may reach? `i32::MIN.abs()` is itself `i32::MIN`,
+/// so the comparison has to leave `i32` first.
+fn too_far(value: i32) -> bool {
+    i64::from(value).abs() > i64::from(MAX_EXTENT)
+}
+
+impl Manifest {
+    /// Parse and validate. Any problem means the manifest is refused as a whole.
+    pub fn parse(text: &str) -> Result<Manifest, Vec<String>> {
+        let manifest: Manifest = serde_json::from_str(text).map_err(|e| vec![format!("not a valid manifest: {e}")])?;
+        manifest.validate()?;
+        Ok(manifest)
+    }
+
+    /// Every problem found, so an author sees all of them at once.
+    pub fn validate(&self) -> Result<(), Vec<String>> {
+        let mut errors = Vec::new();
+        if self.format != FORMAT {
+            errors.push(format!("format must be '{FORMAT}'"));
+        }
+        if !valid_site(&self.site) {
+            errors.push("site must be a short site name".into());
+        }
+        if !(self.area.radius.is_finite() && self.area.radius >= 5.0 && self.area.radius <= MAX_AREA_RADIUS) {
+            errors.push(format!("area.radius must be between 5 and {MAX_AREA_RADIUS}"));
+        }
+        if let Err(e) = self.atmosphere.sky_hours().validate() {
+            errors.push(format!("atmosphere: {e}"));
+        }
+        let w = self.atmosphere.weather_radius;
+        if !(w.is_finite() && (100.0..=6000.0).contains(&w)) {
+            errors.push("atmosphere.weather_radius must be between 100 and 6000".into());
+        }
+        if self.groups.is_empty() {
+            errors.push("a manifest needs at least one group".into());
+        }
+        if self.groups.len() > MAX_GROUPS {
+            errors.push(format!("at most {MAX_GROUPS} groups"));
+        }
+        let mut seen = BTreeSet::new();
+        let mut total = 0usize;
+        for (gi, group) in self.groups.iter().enumerate() {
+            let at = format!("groups[{gi}] '{}'", group.id);
+            if !valid_id(&group.id) {
+                errors.push(format!("{at}: id must be 1-48 characters of a-z, 0-9 and '-'"));
+            }
+            if !seen.insert(group.id.clone()) {
+                errors.push(format!("{at}: duplicate group id"));
+            }
+            if group.release_after_minutes > MAX_RELEASE_MINUTES {
+                errors.push(format!("{at}: release_after_minutes is at most {MAX_RELEASE_MINUTES} (one week)"));
+            }
+            if !group.project.is_empty() && !valid_id(&group.project) {
+                errors.push(format!("{at}: project must be a plain id of a-z, 0-9 and '-'"));
+            }
+            if group.crew > MAX_CREW || (group.crew > 0 && group.project.is_empty()) {
+                errors.push(format!("{at}: crew is at most {MAX_CREW} and only for a stage of a project"));
+            }
+            if !group.site.is_empty() && !valid_site_landmark(&group.site) {
+                errors.push(format!("{at}: site must be a site-* landmark id of a-z, 0-9 and '-'"));
+            }
+            if !group.site.is_empty() && group.project.is_empty() {
+                errors.push(format!("{at}: site names the place of a project's stage"));
+            }
+            if group.crew > 0 && group.site.is_empty() {
+                errors.push(format!("{at}: a crew-gated stage must name its site (site-*)"));
+            }
+            if !group.needs_tech.is_empty() && (!valid_id(&group.needs_tech) || group.project.is_empty()) {
+                errors.push(format!("{at}: needs_tech is a plain technology id and only for a stage of a project"));
+            }
+            if group.release_after_minutes > 0 && group.project.is_empty() {
+                errors.push(format!("{at}: a staged group needs a project"));
+            }
+            if group.title.len() > 80 || group.title.chars().any(char::is_control) {
+                errors.push(format!("{at}: title must be at most 80 characters of plain text"));
+            }
+            if let Some(plot) = &group.anchor.plot
+                && !valid_plot(plot)
+            {
+                errors.push(format!("{at}: anchor.plot must be a plot kind such as Plaza"));
+            }
+            if group.anchor.nth > 20 {
+                errors.push(format!("{at}: anchor.nth is too large"));
+            }
+            let limit = i64::from(self.area.radius.ceil() as i32);
+            if i64::from(group.anchor.dx).abs() > limit || i64::from(group.anchor.dy).abs() > limit {
+                errors.push(format!("{at}: anchor offset is outside the allowed area"));
+            }
+            if group.ground_at.iter().any(|v| too_far(*v)) {
+                errors.push(format!("{at}: ground_at is too far from the anchor"));
+            }
+            if group.ops.is_empty() || group.ops.len() > MAX_OPS_PER_GROUP {
+                errors.push(format!("{at}: needs 1-{MAX_OPS_PER_GROUP} ops"));
+            }
+            match expand_group(group) {
+                Ok(planned) => {
+                    if planned.pieces.len() > MAX_BLOCKS_PER_GROUP {
+                        errors.push(format!("{at}: places {} blocks, at most {MAX_BLOCKS_PER_GROUP}", planned.pieces.len()));
+                    }
+                    total += planned.pieces.len() + planned.foundation.len();
+                },
+                Err(mut group_errors) => errors.append(&mut group_errors.iter().map(|e| format!("{at}: {e}")).collect()),
+            }
+        }
+        if total > MAX_BLOCKS_TOTAL {
+            errors.push(format!("places {total} blocks in total, at most {MAX_BLOCKS_TOTAL}"));
+        }
+        if errors.is_empty() { Ok(()) } else { Err(errors) }
+    }
+}
+
+/// One thing at one cell.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Piece {
+    Block { kind: String, rgb: [u8; 3] },
+    Air,
+    Sprite(String),
+}
+
+/// A column of the foundation to be filled when the ground is known.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FoundationColumn {
+    pub dx: i32,
+    pub dy: i32,
+    pub kind: String,
+    pub rgb: [u8; 3],
+    pub depth: u8,
+}
+
+/// A group reduced to cells relative to its anchor (x, y) and its ground height (z).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Expanded {
+    /// Later ops win over earlier ones at the same cell. Ordered, so the result is deterministic.
+    pub pieces: BTreeMap<[i32; 3], Piece>,
+    pub foundation: Vec<FoundationColumn>,
+}
+
+fn check_box(errors: &mut Vec<String>, label: &str, from: [i32; 3], to: [i32; 3]) -> bool {
+    let mut ok = true;
+    for axis in 0..2 {
+        if too_far(from[axis]) || too_far(to[axis]) {
+            errors.push(format!("{label}: reaches more than {MAX_EXTENT} blocks from the anchor"));
+            ok = false;
+            break;
+        }
+    }
+    if from[2] < MIN_DZ || to[2] < MIN_DZ || from[2] > MAX_DZ || to[2] > MAX_DZ {
+        errors.push(format!("{label}: height must be between {MIN_DZ} and {MAX_DZ} relative to the ground"));
+        ok = false;
+    }
+    if ok && cell_count(from, to) > MAX_FILL_VOLUME {
+        errors.push(format!("{label}: larger than {MAX_FILL_VOLUME} blocks"));
+        ok = false;
+    }
+    ok
+}
+
+fn check_kind(errors: &mut Vec<String>, label: &str, kind: &str) -> bool {
+    if ALLOWED_KINDS.contains(&kind) {
+        true
+    } else {
+        errors.push(format!("{label}: block kind '{kind}' is not allowed (allowed: {})", ALLOWED_KINDS.join(", ")));
+        false
+    }
+}
+
+fn each_cell(from: [i32; 3], to: [i32; 3], mut f: impl FnMut([i32; 3])) {
+    for x in from[0].min(to[0])..=from[0].max(to[0]) {
+        for y in from[1].min(to[1])..=from[1].max(to[1]) {
+            for z in from[2].min(to[2])..=from[2].max(to[2]) {
+                f([x, y, z]);
+            }
+        }
+    }
+}
+
+/// Reduce a group's ops to cells. Checks every limit before it expands anything.
+pub fn expand_group(group: &Group) -> Result<Expanded, Vec<String>> {
+    let mut errors = Vec::new();
+    let mut pieces = BTreeMap::new();
+    let mut foundation = Vec::new();
+    for (oi, op) in group.ops.iter().enumerate() {
+        let label = format!("ops[{oi}]");
+        match op {
+            Op::Fill { from, to, kind, .. } => {
+                let kind_ok = check_kind(&mut errors, &label, kind);
+                if check_box(&mut errors, &label, *from, *to)
+                    && kind_ok
+                    && let Op::Fill { kind, rgb, .. } = op
+                {
+                    each_cell(*from, *to, |cell| {
+                        pieces.insert(cell, Piece::Block { kind: kind.clone(), rgb: *rgb });
+                    });
+                }
+            },
+            Op::Clear { from, to } => {
+                if check_box(&mut errors, &label, *from, *to) {
+                    each_cell(*from, *to, |cell| {
+                        pieces.insert(cell, Piece::Air);
+                    });
+                }
+            },
+            Op::Sprite { at, sprite } => {
+                match sprite_name(sprite) {
+                    None => errors.push(format!("{label}: '{sprite}' is not a well-formed sprite")),
+                    Some(name) if !ALLOWED_SPRITES.contains(&name) => {
+                        errors.push(format!("{label}: sprite '{name}' is not allowed"));
+                    },
+                    Some(_) => {
+                        if check_box(&mut errors, &label, *at, *at) {
+                            pieces.insert(*at, Piece::Sprite(sprite.clone()));
+                        }
+                    },
+                }
+            },
+            Op::Foundation { from, to, kind, rgb, depth } => {
+                let kind_ok = check_kind(&mut errors, &label, kind);
+                if *depth == 0 || *depth > MAX_FOUNDATION_DEPTH {
+                    errors.push(format!("{label}: foundation depth must be 1-{MAX_FOUNDATION_DEPTH}"));
+                } else if (0..2).any(|a| too_far(from[a]) || too_far(to[a])) {
+                    errors.push(format!("{label}: reaches more than {MAX_EXTENT} blocks from the anchor"));
+                } else {
+                    // The column count is measured in `i64` and saturating for the same reason as `cell_count`:
+                    // `i32` arithmetic on an absurd box wraps, and a wrapped count slips under the limit.
+                    let columns = (0..2).fold(1i64, |acc, a| {
+                        acc.saturating_mul((i64::from(to[a]) - i64::from(from[a])).abs().saturating_add(1))
+                    });
+                    if columns.saturating_add(foundation.len() as i64) > MAX_FOUNDATION_COLUMNS as i64 {
+                        errors.push(format!("{label}: too many foundation columns (at most {MAX_FOUNDATION_COLUMNS} per group)"));
+                    } else if kind_ok {
+                        for x in from[0].min(to[0])..=from[0].max(to[0]) {
+                            for y in from[1].min(to[1])..=from[1].max(to[1]) {
+                                foundation.push(FoundationColumn { dx: x, dy: y, kind: kind.clone(), rgb: *rgb, depth: *depth });
+                            }
+                        }
+                    }
+                }
+            },
+        }
+        if pieces.len() > MAX_BLOCKS_PER_GROUP * 2 {
+            errors.push("group is far too large".into());
+            break;
+        }
+    }
+    if errors.is_empty() { Ok(Expanded { pieces, foundation }) } else { Err(errors) }
+}
+
+/// Where the game says things are. The server implements this from world generation; tests fake it.
+pub trait Resolver {
+    /// Origin of the named site (x, y), or `None` if the world has no such site.
+    fn site_origin(&self, site: &str) -> Option<(i32, i32)>;
+    /// Centre of the `nth` plot of this kind of the named site, nearest the origin first.
+    fn plot_centre(&self, site: &str, plot: &str, nth: usize) -> Option<(i32, i32)>;
+}
+
+/// A group placed in the world: its anchor resolved, every cell checked against the allowed area.
+#[derive(Clone, Debug)]
+pub struct Planned {
+    pub id: String,
+    pub anchor: (i32, i32),
+    pub ground_at: (i32, i32),
+    pub expanded: Expanded,
+}
+
+impl Planned {
+    /// Cells with their absolute horizontal position, still relative in height.
+    pub fn columns(&self) -> impl Iterator<Item = (i32, i32)> + '_ {
+        self.expanded
+            .pieces
+            .keys()
+            .map(|c| (self.anchor.0 + c[0], self.anchor.1 + c[1]))
+            .chain(self.expanded.foundation.iter().map(|f| (self.anchor.0 + f.dx, self.anchor.1 + f.dy)))
+    }
+}
+
+/// Resolve anchors and enforce the allowed area on every single cell. Returns the planned groups,
+/// or every reason the manifest cannot be applied here.
+pub fn plan(manifest: &Manifest, resolver: &dyn Resolver) -> Result<Vec<Planned>, Vec<String>> {
+    manifest.validate()?;
+    let Some(origin) = resolver.site_origin(&manifest.site) else {
+        return Err(vec![format!("this world has no site named '{}'", manifest.site)]);
+    };
+    let radius = f64::from(manifest.area.radius);
+    let inside = |x: i32, y: i32| {
+        let (dx, dy) = (f64::from(x - origin.0), f64::from(y - origin.1));
+        dx * dx + dy * dy <= radius * radius
+    };
+    let mut errors = Vec::new();
+    let mut planned = Vec::new();
+    for group in &manifest.groups {
+        let at = format!("group '{}'", group.id);
+        let base = match &group.anchor.plot {
+            Some(plot) => resolver.plot_centre(&manifest.site, plot, group.anchor.nth),
+            None => Some(origin),
+        };
+        let Some(base) = base else {
+            errors.push(format!("{at}: site '{}' has no {} plot number {}", manifest.site, group.anchor.plot.as_deref().unwrap_or("?"), group.anchor.nth));
+            continue;
+        };
+        let anchor = (base.0 + group.anchor.dx, base.1 + group.anchor.dy);
+        let expanded = match expand_group(group) {
+            Ok(e) => e,
+            Err(e) => {
+                errors.extend(e.into_iter().map(|m| format!("{at}: {m}")));
+                continue;
+            },
+        };
+        let ground_at = (anchor.0 + group.ground_at[0], anchor.1 + group.ground_at[1]);
+        let item = Planned { id: group.id.clone(), anchor, ground_at, expanded };
+        if !inside(ground_at.0, ground_at.1) {
+            errors.push(format!("{at}: its ground reference point is outside the allowed area"));
+        }
+        if let Some((x, y)) = item.columns().find(|(x, y)| !inside(*x, *y)) {
+            errors.push(format!("{at}: places something at ({x}, {y}), outside the allowed area (radius {} around {} at {:?})", manifest.area.radius, manifest.site, origin));
+        }
+        planned.push(item);
+    }
+    if errors.is_empty() { Ok(planned) } else { Err(errors) }
+}
+
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct Summary {
+    pub groups: usize,
+    pub blocks: usize,
+    pub sprites: usize,
+    pub lit_sprites: usize,
+    pub foundation_columns: usize,
+}
+
+impl Manifest {
+    pub fn summary(&self) -> Summary {
+        let mut summary = Summary { groups: self.groups.len(), ..Summary::default() };
+        for group in &self.groups {
+            if let Ok(expanded) = expand_group(group) {
+                for piece in expanded.pieces.values() {
+                    match piece {
+                        Piece::Block { .. } => summary.blocks += 1,
+                        Piece::Sprite(text) => {
+                            summary.sprites += 1;
+                            if sprite_name(text).is_some_and(|n| LIGHT_SPRITES.contains(&n)) {
+                                summary.lit_sprites += 1;
+                            }
+                        },
+                        Piece::Air => {},
+                    }
+                }
+                summary.foundation_columns += expanded.foundation.len();
+            }
+        }
+        summary
+    }
+}
