+    #[test]
+    fn a_cleared_cell_is_not_a_sentinel_while_the_group_has_anything_else() {
+        // If stage one watched a cleared cell, the walls stage two builds there would make stage one look
+        // "not standing", and it would be written again over them.
+        let manifest = Manifest::parse(CLEARED).expect("the test manifest is valid");
+        let plans = manifest::plan(&manifest, &Sites).expect("it plans against the fake world");
+        let picked = sentinel(&plans[0], 8);
+        assert_eq!(picked.len(), 3, "the three floor cells and no cleared cell: {picked:?}");
+        assert!(picked.iter().all(|cell| cell[2] == 0), "{picked:?}");
+        // A group that only clears has nothing else to be judged by.
+        assert_eq!(sentinel(&plans[1], 8).len(), 2);
+    }
+
+    #[test]
+    fn a_cell_the_game_keeps_removing_stops_being_checked_and_the_rest_of_the_group_is_kept() {
+        // The rule this models, from the game itself: a sprite written where its adjacency
+        // requirement is not met is turned back into air in the same tick it is written
+        // (`common/src/terrain/state.rs`, the "indirectly modified" pass; the requirements are
+        // `common/src/terrain/sprite/mod.rs:925-945` — a lanternpost's lantern needs a wall beside
+        // it), so it can never be part of the world however often it is written.
+        let plan = planned();
+        let mut world = generated();
+        let vetoed = [0, 0, 1];                       // the bench: pretend the game refuses this cell
+        let wanted = plan.expanded.pieces[&vetoed].clone();
+        let mut misses: BTreeMap<[i32; 3], u32> = BTreeMap::new();
+        let mut gone = BTreeSet::new();
+        let mut written = Vec::new();
+
+        for _ in 0..GONE_AFTER {
+            written.push(stamp(&plan, 100, &mut world).written);
+            world.set([plan.anchor.0, plan.anchor.1, 101], Block::empty());   // the game removes it
+            let absent = missing(&plan, 100, &world, &gone);
+            assert_eq!(absent, vec![vetoed], "the vetoed cell is the one that is missing");
+            gone.extend(count_misses(&mut misses, &absent));
+        }
+
+        assert!(written[0] > 0 && written[1] == 1 && written[2] == 1, "one cell is rewritten: {written:?}");
+        assert_eq!(misses[&vetoed], GONE_AFTER);
+        assert!(gone.contains(&vetoed), "after {GONE_AFTER} tries the cell is given up on");
+        assert!(missing(&plan, 100, &world, &gone).is_empty(), "and it is not checked any more");
+        assert!(standing_without(&plan, 100, &world, &gone), "so the rest of the group stands");
+        assert_eq!(sentinel_without(&plan, 8, &gone).len(), 4, "the other four cells are still checked");
+        assert!(!standing(&plan, 100, &world), "without that knowledge the group would look broken for ever");
+        // What the manifest wanted there is still known, so the record can name it and a human can see
+        // exactly which cell the game refused.
+        assert_eq!(plan.expanded.pieces.get(&vetoed), Some(&wanted));
+        assert_eq!(sentinel(&plan, 8).len(), 5, "the full group still has five cells");
+    }
