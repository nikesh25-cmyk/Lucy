--- /dev/null
+++ b/server/src/sys/nemo_hud.rs
@@ -0,0 +1,287 @@
+//! A quest-flag map marker, on request from NemoWorld.
+//!
+//! The NemoWorld guide (Selene) can offer to mark a player's current objective on their map. NemoWorld
+//! signs a `hud_marker` command naming a LANDMARK ID (never coordinates). This system, which only
+//! ever sees commands whose HMAC verified and which are unexpired and unclaimed (see
+//! [`NemoLinkState::poll_commands`]), looks the landmark up in the positions the server itself
+//! resolved from world generation, and sends that one player the same `Dialogue::Marker` message the
+//! game's own quest givers send. The stock client shows it as a quest flag on the map and minimap, so
+//! no client change is needed.
+//!
+//! * Allow-list: only the landmarks the server resolved (`<outbox>.landmarks.json`) can be marked.
+//! * Bounded: the label is cleaned and cut to [`LABEL_CHARS`] characters; one marker per player per
+//!   [`PLAYER_GAP_SECS`] seconds.
+//! * Honest: the command is acknowledged as applied only when a marker was really sent to a player who
+//!   is online; otherwise it is acknowledged as rejected with a reason. A command nobody picks up is
+//!   "unconfirmed" in NemoWorld, never "done".
+//! * Nothing here grants anything. A marker is a picture on a map.
+
+use crate::{client::Client, sys::nemo_link::NemoLinkState};
+use common::{
+    comp::{Content, Player},
+    map::Marker,
+    resources::Time,
+    rtsim::{Dialogue, DialogueId, DialogueKind},
+    uid::Uid,
+};
+use common_ecs::{Job, Origin, Phase, System};
+use common_net::msg::ServerGeneral;
+use hashbrown::HashMap;
+use specs::{Entities, Join, Read, ReadStorage, Write};
+use tracing::warn;
+
+/// Longest label shown on the map, in characters.
+pub const LABEL_CHARS: usize = 60;
+/// A player gets at most one marker per this many seconds, whatever NemoWorld asks.
+pub const PLAYER_GAP_SECS: f64 = 5.0;
+/// The command kind this system handles.
+pub const KIND: &str = "hud_marker";
+
+/// What a valid `hud_marker` command asks for.
+#[derive(Debug, PartialEq, Eq)]
+pub struct MarkerRequest {
+    pub landmark_id: String,
+    pub label: String,
+}
+
+fn valid_landmark_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= 40
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(b, b'.' | b'_' | b'-'))
+}
+
+/// Make text safe to put on a map: no control or formatting characters, no brackets, one line,
+/// collapsed spaces, at most [`LABEL_CHARS`] characters.
+pub fn clean_label(text: &str) -> String {
+    let cleaned: String = text
+        .chars()
+        .map(|c| {
+            if c.is_control()
+                || matches!(c, '[' | ']' | '{' | '}' | '<' | '>' | '|' | '`' | '\\')
+                || ('\u{200b}'..='\u{200f}').contains(&c)
+                || ('\u{2028}'..='\u{202e}').contains(&c)
+                || ('\u{2060}'..='\u{206f}').contains(&c)
+                || ('\u{e0000}'..='\u{e007f}').contains(&c)
+                || c == '\u{feff}'
+            {
+                ' '
+            } else {
+                c
+            }
+        })
+        .collect();
+    let mut one_line = cleaned.split_whitespace().collect::<Vec<_>>().join(" ");
+    if one_line.chars().count() > LABEL_CHARS {
+        one_line = one_line.chars().take(LABEL_CHARS - 1).collect::<String>() + "…";
+    }
+    one_line
+}
+
+/// Parse the signed argument text. Only `landmark_id` (required) and `label` (optional) are allowed.
+pub fn parse_marker_args(args: &str) -> Result<MarkerRequest, &'static str> {
+    if args.len() > 600 {
+        return Err("bad_args");
+    }
+    let value: serde_json::Value = serde_json::from_str(args).map_err(|_| "bad_args")?;
+    let object = value.as_object().ok_or("bad_args")?;
+    if object.keys().any(|k| k != "landmark_id" && k != "label") {
+        return Err("bad_args");
+    }
+    let landmark_id = object
+        .get("landmark_id")
+        .and_then(|v| v.as_str())
+        .filter(|id| valid_landmark_id(id))
+        .ok_or("bad_args")?
+        .to_owned();
+    let label = match object.get("label") {
+        None => String::new(),
+        Some(v) => v.as_str().ok_or("bad_args")?.to_owned(),
+    };
+    let label = clean_label(&label);
+    Ok(MarkerRequest {
+        landmark_id,
+        label: if label.is_empty() { "NemoWorld objective".to_owned() } else { label },
+    })
+}
+
+/// The position of a landmark in the file the server writes at startup (`<outbox>.landmarks.json`).
+pub fn landmark_position(file_text: &str, id: &str) -> Option<(f32, f32)> {
+    let value: serde_json::Value = serde_json::from_str(file_text).ok()?;
+    let entry = value
+        .get("landmarks")?
+        .as_array()?
+        .iter()
+        .find(|l| l.get("id").and_then(|v| v.as_str()) == Some(id))?;
+    let x = entry.get("x")?.as_f64()? as f32;
+    let y = entry.get("y")?.as_f64()? as f32;
+    (x.is_finite() && y.is_finite()).then_some((x, y))
+}
+
+/// Where the server wrote its resolved landmarks: next to the outbox named in the link config.
+fn landmarks_path() -> Option<String> {
+    let config = std::env::var("NEMO_LINK_CONFIG").ok()?;
+    let text = std::fs::read_to_string(config).ok()?;
+    let value: serde_json::Value = serde_json::from_str(&text).ok()?;
+    Some(format!("{}.landmarks.json", value.get("outbox")?.as_str()?))
+}
+
+/// The marker the stock client draws as a quest flag.
+fn quest_marker(x: f32, y: f32, label: &str) -> Marker {
+    Marker::at(vek::Vec2::new(x, y))
+        .with_id("nemo-hud-objective")
+        .with_label(Content::Plain(label.to_owned()))
+        .with_quest_flag(true)
+}
+
+#[derive(Default)]
+pub struct Sys {
+    last_run: f64,
+    /// Player uuid -> time of the last marker sent.
+    last_marker: HashMap<String, f64>,
+}
+
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Entities<'a>,
+        ReadStorage<'a, Player>,
+        ReadStorage<'a, Client>,
+        ReadStorage<'a, Uid>,
+        Read<'a, Time>,
+        Write<'a, NemoLinkState>,
+    );
+
+    const NAME: &'static str = "nemo_hud";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(
+        job: &mut Job<Self>,
+        (entities, players, clients, uids, time, mut link): Self::SystemData,
+    ) {
+        let now = time.0;
+        if now - job.own.last_run < 1.0 {
+            return;
+        }
+        job.own.last_run = now;
+        if !link.is_on() {
+            return;
+        }
+        for command in link.poll_commands(&[KIND]) {
+            let outcome = (|| -> Result<(), &'static str> {
+                let request = parse_marker_args(&command.args)?;
+                let file = landmarks_path()
+                    .and_then(|path| std::fs::read_to_string(path).ok())
+                    .ok_or("no_landmarks")?;
+                let (x, y) =
+                    landmark_position(&file, &request.landmark_id).ok_or("unknown_landmark")?;
+                if job
+                    .own
+                    .last_marker
+                    .get(&command.player_uuid)
+                    .is_some_and(|&at| now - at < PLAYER_GAP_SECS)
+                {
+                    return Err("too_soon");
+                }
+                let (client, uid) = (&entities, &players, &clients, &uids)
+                    .join()
+                    .find(|(_, player, _, _)| player.uuid().to_string() == command.player_uuid)
+                    .map(|(_, _, client, uid)| (client, *uid))
+                    .ok_or("player_offline")?;
+                // The sender slot is only used by the client to look up an entity; the player's own
+                // uid always exists on their client.
+                let dialogue = Dialogue::<false> {
+                    id: DialogueId(0),
+                    kind: DialogueKind::Marker(quest_marker(x, y, &request.label)),
+                }
+                .into_validated_unchecked();
+                client.send_fallible(ServerGeneral::Dialogue(uid, dialogue));
+                job.own.last_marker.insert(command.player_uuid.clone(), now);
+                Ok(())
+            })();
+            match outcome {
+                Ok(()) => link.ack(&command, true, "hud_marker"),
+                Err(reason) => {
+                    warn!(cmd_id = %command.cmd_id, reason, "hud_marker rejected");
+                    link.ack(&command, false, reason);
+                },
+            }
+        }
+        // Forget old throttle entries so the map cannot grow without bound.
+        job.own.last_marker.retain(|_, at| now - *at < 3600.0);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_valid_request_is_accepted_and_its_label_cleaned() {
+        let ok = parse_marker_args(r#"{"landmark_id":"lyra-field","label":"The Quiet Survey: Harr's farm field"}"#)
+            .unwrap();
+        assert_eq!(ok.landmark_id, "lyra-field");
+        assert_eq!(ok.label, "The Quiet Survey: Harr's farm field");
+        // No label is allowed: a neutral one is used.
+        assert_eq!(parse_marker_args(r#"{"landmark_id":"a"}"#).unwrap().label, "NemoWorld objective");
+    }
+
+    #[test]
+    fn anything_but_the_two_known_fields_is_refused() {
+        for bad in [
+            "",
+            "not json",
+            "[]",
+            "null",
+            r#"{"landmark_id":"lyra-field","x":1}"#,
+            r#"{"landmark_id":"lyra-field","y":1,"label":"x"}"#,
+            r#"{"landmark_id":42}"#,
+            r#"{"label":"no id"}"#,
+            r#"{"landmark_id":"LYRA"}"#,
+            r#"{"landmark_id":"../etc/passwd"}"#,
+            r#"{"landmark_id":"a b"}"#,
+            r#"{"landmark_id":""}"#,
+            r#"{"landmark_id":"lyra-field","label":42}"#,
+        ] {
+            assert!(parse_marker_args(bad).is_err(), "should refuse {bad:?}");
+        }
+        let long_id = format!(r#"{{"landmark_id":"{}"}}"#, "a".repeat(41));
+        assert!(parse_marker_args(&long_id).is_err());
+        let huge = format!(r#"{{"landmark_id":"a","label":"{}"}}"#, "x".repeat(700));
+        assert!(parse_marker_args(&huge).is_err(), "oversized arguments are refused outright");
+    }
+
+    #[test]
+    fn labels_cannot_carry_control_characters_brackets_or_hidden_text() {
+        assert_eq!(clean_label("Line one\nLine two\t\u{7}end"), "Line one Line two end");
+        assert_eq!(clean_label("[AI] fake <b>bold</b> {x} `y` | \\"), "AI fake b bold /b x y");
+        assert_eq!(clean_label("a\u{200b}b\u{202e}c\u{e0041}d\u{feff}e"), "a b c d e");
+        assert_eq!(clean_label("   "), "");
+        let long = clean_label(&"é".repeat(200));
+        assert_eq!(long.chars().count(), LABEL_CHARS);
+        assert!(long.ends_with('…'));
+    }
+
+    #[test]
+    fn only_landmarks_the_server_resolved_can_be_marked() {
+        let file = r#"{"landmarks":[{"id":"lyra-field","x":15231.0,"y":16025.5,"radius":9},
+                                    {"id":"lyra-house","x":15225,"y":16007}]}"#;
+        assert_eq!(landmark_position(file, "lyra-field"), Some((15231.0, 16025.5)));
+        assert_eq!(landmark_position(file, "lyra-house"), Some((15225.0, 16007.0)));
+        assert_eq!(landmark_position(file, "elsewhere"), None);
+        assert_eq!(landmark_position("{}", "lyra-field"), None);
+        assert_eq!(landmark_position("garbage", "lyra-field"), None);
+        assert_eq!(landmark_position(r#"{"landmarks":[{"id":"a","x":"1","y":2}]}"#, "a"), None);
+    }
+
+    #[test]
+    fn the_marker_is_a_labelled_quest_flag_at_the_landmark() {
+        let marker = quest_marker(10.0, 20.0, "Somewhere");
+        assert_eq!(marker.wpos, vek::Vec2::new(10.0, 20.0));
+        assert!(marker.flags.contains(common::map::MarkerFlags::IS_QUEST));
+        assert!(matches!(marker.label, Some(Content::Plain(ref text)) if text == "Somewhere"));
+        // The same objective always replaces itself on the map instead of piling up.
+        assert!(marker.is_same(&quest_marker(30.0, 40.0, "Elsewhere")));
+    }
+}
diff --git a/server/src/sys/nemo_link.rs b/server/src/sys/nemo_link.rs
new file mode 100644
index 0000000..f23af8e
--- /dev/null
+++ b/server/src/sys/nemo_link.rs
@@ -0,0 +1,712 @@
+//! Signed facts for NemoWorld.
+//!
+//! When configured, this system watches where a NemoWorld resident (a player character whose name
+//! is listed in the config) and other players are standing, and appends signed events to an outbox
+//! file. A relay forwards them to NemoWorld. The events come from server-side positions only; nothing
+//! a client says or claims is ever turned into an event.
+//!
+//! Enable it with two environment variables:
+//! * `NEMO_LINK_CONFIG`: path to a JSON file (see [`Config`]).
+//! * `NEMO_LINK_EVENT_KEY`: the secret shared with NemoWorld; events are HMAC-signed with it.
+//!
+//! With neither set this system does nothing.
+
+use common::{
+    comp::{Player, Pos},
+    resources::Time,
+};
+use common_ecs::{Job, Origin, Phase, System};
+use hashbrown::{HashMap, HashSet};
+use nemo_link_proto::{canonical, canonical_command, parse_key, sign, verify};
+use serde::Deserialize;
+use specs::{Join, Read, ReadExpect, ReadStorage, Write};
+use world::IndexOwned;
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{Read as _, Seek as _, SeekFrom, Write as _},
+    path::Path,
+    time::{SystemTime, UNIX_EPOCH},
+};
+use tracing::{info, warn};
+
+/// A landmark as written in the config. Give either a position (`x`, `y`) or a real structure of
+/// a named world site (`site` + `plot`), which is resolved from world generation at startup.
+#[derive(Deserialize)]
+struct LandmarkSpec {
+    id: String,
+    /// The NemoWorld place this stands for (e.g. "Library"); copied to the resolved file.
+    #[serde(default)]
+    label: String,
+    /// Display name shown to NemoWorld players, e.g. "Harr Plaza".
+    #[serde(default)]
+    name: String,
+    site: Option<String>,
+    /// A plot kind such as `Plaza`, `Tavern`, `Workshop`, `House`.
+    plot: Option<String>,
+    /// Which plot of that kind, nearest the site's origin first.
+    #[serde(default)]
+    nth: usize,
+    x: Option<f32>,
+    y: Option<f32>,
+    /// Offset from the plot's centre, so a place can be named relative to a building.
+    #[serde(default)]
+    dx: f32,
+    #[serde(default)]
+    dy: f32,
+    radius: f32,
+    /// A place worth finding: standing alone in it long enough records a `landmark.visited` fact.
+    #[serde(default)]
+    discovery: bool,
+}
+
+struct Landmark {
+    id: String,
+    x: f32,
+    y: f32,
+    radius: f32,
+    discovery: bool,
+}
+
+fn default_meet_radius() -> f32 { 8.0 }
+fn default_meet_secs() -> f64 { 3.0 }
+fn default_together_secs() -> f64 { 5.0 }
+fn default_meet_cooldown() -> f64 { 60.0 }
+fn default_together_cooldown() -> f64 { 120.0 }
+fn default_vertical() -> f32 { 25.0 }
+fn default_visit_secs() -> f64 { 4.0 }
+fn default_visit_cooldown() -> f64 { 1800.0 }
+
+#[derive(Deserialize)]
+struct Config {
+    server_id: String,
+    /// File that signed events are appended to, one JSON object per line.
+    outbox: String,
+    /// Character name -> NemoWorld resident id, e.g. `{"Lyra": "lw-lyra"}`.
+    residents: HashMap<String, String>,
+    landmarks: Vec<LandmarkSpec>,
+    #[serde(default = "default_meet_radius")]
+    meet_radius: f32,
+    #[serde(default = "default_meet_secs")]
+    meet_secs: f64,
+    #[serde(default = "default_together_secs")]
+    together_secs: f64,
+    #[serde(default = "default_meet_cooldown")]
+    meet_cooldown_secs: f64,
+    #[serde(default = "default_together_cooldown")]
+    together_cooldown_secs: f64,
+    /// Seconds a person must stay inside a discovery place before it is recorded.
+    #[serde(default = "default_visit_secs")]
+    visit_secs: f64,
+    #[serde(default = "default_visit_cooldown")]
+    visit_cooldown_secs: f64,
+    /// Where NemoWorld writes signed commands. Default: `<outbox>.commands.jsonl`.
+    #[serde(default)]
+    commands: Option<String>,
+    /// Largest height difference that still counts as standing together.
+    #[serde(default = "default_vertical")]
+    vertical_tolerance: f32,
+    /// The NemoWorld resident id that command acknowledgements are signed for. NemoWorld accepts
+    /// an event only through a relay credential scoped to the event's resident, so with several
+    /// residents the acknowledgements must name the one the relay's credential belongs to. Default:
+    /// the first resident of the list (which is arbitrary when there is more than one, so name it).
+    #[serde(default)]
+    ack_resident: Option<String>,
+}
+
+/// A verified, unexpired command from NemoWorld. Apply it at most once, then call `ack`.
+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
+pub struct Command {
+    pub cmd_id: String,
+    pub kind: String,
+    pub player_uuid: String,
+    /// The signed JSON text of the arguments (parse it yourself).
+    pub args: String,
+    pub expires_at: u64,
+}
+
+struct Active {
+    cfg: Config,
+    landmarks: Vec<Landmark>,
+    commands_path: std::path::PathBuf,
+    commands_offset: u64,
+    pending: Vec<Command>,
+    /// Ids already taken, persisted in `<outbox>.claimed` BEFORE acting, so a crash can never apply a
+    /// command twice (it may leave one unconfirmed, which NemoWorld shows as such).
+    claimed: HashSet<String>,
+    claimed_file: File,
+    ack_resident: String,
+    key: Vec<u8>,
+    out: File,
+    seq: u64,
+    /// (player uuid, resident id) -> time they first stood close.
+    near: HashMap<(String, String), f64>,
+    /// (player uuid, resident id, landmark id) -> time they were first both inside it.
+    together: HashMap<(String, String, String), f64>,
+    /// (player uuid, landmark id) -> time they first stood inside a discovery place.
+    visiting: HashMap<(String, String), f64>,
+    /// Cooldown key -> time the event was last emitted.
+    last: HashMap<String, f64>,
+}
+
+#[derive(Default)]
+pub struct NemoLinkState {
+    loaded: bool,
+    last_run: f64,
+    active: Option<Active>,
+}
+
+impl NemoLinkState {
+    /// Take the verified, unexpired commands of these kinds. Each command is returned once; after
+    /// acting on it, call [`NemoLinkState::ack`]. Returns nothing while the link is off.
+    pub fn poll_commands(&mut self, kinds: &[&str]) -> Vec<Command> {
+        self.active.as_mut().map_or_else(Vec::new, |a| a.poll_commands(kinds))
+    }
+
+    /// Report the outcome of a command to NemoWorld (signed `command.applied` / `command.rejected`).
+    pub fn ack(&mut self, command: &Command, applied: bool, reason: &str) {
+        if let Some(active) = self.active.as_mut() {
+            active.ack(command, applied, reason);
+        }
+    }
+
+    /// Emit a signed event for another feature (kind and fields follow NemoWorld's event rules).
+    pub fn emit_event(
+        &mut self,
+        kind: &str,
+        resident_id: &str,
+        player_uuid: &str,
+        player_alias: &str,
+        landmark_id: Option<&str>,
+    ) {
+        if let Some(active) = self.active.as_mut() {
+            active.emit(kind, resident_id, player_uuid, player_alias, landmark_id);
+        }
+    }
+
+    /// Coordinates resolved by this server from its configured landmarks.
+    pub fn landmark_position(&self, id: &str) -> Option<(f32, f32)> {
+        self.active.as_ref()?.landmarks.iter().find(|l| l.id == id).map(|l| (l.x, l.y))
+    }
+
+    pub fn is_on(&self) -> bool { self.active.is_some() }
+
+    /// The resident acknowledgements and witness-less facts are signed under — the relay's own resident
+    /// (`ack_resident` in the config, or the first configured one). Empty when the link is off.
+    pub fn ack_resident(&self) -> String {
+        self.active.as_ref().map(|a| a.ack_resident.clone()).unwrap_or_default()
+    }
+
+    /// Is this character alias one of the configured residents? The link owns that list; other systems
+    /// ask it rather than keeping a copy.
+    pub fn is_resident(&self, alias: &str) -> bool {
+        self.active.as_ref().is_some_and(|a| a.cfg.residents.contains_key(alias))
+    }
+
+    /// A file next to the outbox (`<outbox>.<suffix>`) for another feature's persistent state.
+    pub fn sidecar_path(&self, suffix: &str) -> Option<String> {
+        self.active.as_ref().map(|a| format!("{}.{suffix}", a.cfg.outbox))
+    }
+}
+
+fn unix_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis() as u64)
+}
+
+/// The highest sequence number already in the outbox, so ids never repeat after a restart.
+fn last_seq(path: &Path) -> u64 {
+    let Ok(text) = fs::read_to_string(path) else {
+        return 0;
+    };
+    text.lines()
+        .rev()
+        .find_map(|line| serde_json::from_str::<serde_json::Value>(line).ok())
+        .and_then(|value| value["seq"].as_u64())
+        .unwrap_or(0)
+}
+
+/// Turns the configured landmarks into positions. Structures come from world generation, so the
+/// positions are the ones the server (and every client) really has. The result is also written next
+/// to the outbox as `<outbox>.landmarks.json` for the bridge, and every plot of each named site is
+/// logged once so landmarks can be chosen from real buildings.
+fn resolve_landmarks(cfg: &Config, index: &IndexOwned, outbox: &Path) -> Vec<Landmark> {
+    let index = index.as_index_ref();
+    let mut resolved = Vec::new();
+    let mut report = Vec::new();
+    let mut described = Vec::<String>::new();
+    for spec in &cfg.landmarks {
+        if let Some(site_name) = spec.site.as_deref()
+            && !described.iter().any(|name| name == site_name)
+            && let Some(site) = index.sites.values().find(|s| s.name() == Some(site_name))
+        {
+            described.push(site_name.to_owned());
+            let mut plots: Vec<_> = site
+                .plots()
+                .map(|plot| (plot.kind().to_string(), site.tile_center_wpos(plot.root_tile())))
+                .collect();
+            plots.sort_by_key(|(_, wpos)| (wpos - site.origin).magnitude_squared());
+            info!(
+                "site {site_name} (origin {:?}) has {} plots: {}",
+                site.origin,
+                plots.len(),
+                plots
+                    .iter()
+                    .map(|(kind, wpos)| format!("{kind}@({},{})", wpos.x, wpos.y))
+                    .collect::<Vec<_>>()
+                    .join(" ")
+            );
+        }
+        let position = match (spec.x, spec.y, spec.site.as_deref(), spec.plot.as_deref()) {
+            (Some(x), Some(y), ..) => Some((x, y)),
+            (_, _, Some(site_name), Some(plot_kind)) => index
+                .sites
+                .values()
+                .find(|s| s.name() == Some(site_name))
+                .and_then(|site| {
+                    let mut plots: Vec<_> = site
+                        .plots()
+                        .filter(|plot| plot.kind().to_string() == plot_kind)
+                        .map(|plot| site.tile_center_wpos(plot.root_tile()))
+                        .collect();
+                    plots.sort_by_key(|wpos| (wpos - site.origin).magnitude_squared());
+                    plots
+                        .get(spec.nth)
+                        .map(|wpos| (wpos.x as f32 + spec.dx, wpos.y as f32 + spec.dy))
+                }),
+            _ => None,
+        };
+        match position {
+            Some((x, y)) => {
+                info!("landmark {} ('{}') is at ({x:.0}, {y:.0})", spec.id, spec.name);
+                report.push(serde_json::json!({
+                    "id": spec.id, "label": spec.label, "name": spec.name,
+                    "x": x, "y": y, "radius": spec.radius,
+                    "site": spec.site, "plot": spec.plot, "nth": spec.nth,
+                    "discovery": spec.discovery,
+                }));
+                resolved.push(Landmark {
+                    id: spec.id.clone(),
+                    x,
+                    y,
+                    radius: spec.radius,
+                    discovery: spec.discovery,
+                });
+            },
+            None => warn!(
+                "landmark {} could not be resolved (site {:?}, plot {:?}); it is left out",
+                spec.id, spec.site, spec.plot
+            ),
+        }
+    }
+    let path = format!("{}.landmarks.json", outbox.display());
+    let text = serde_json::json!({ "landmarks": report }).to_string();
+    if let Err(e) = fs::write(&path, text) {
+        warn!("could not write {path}: {e}");
+    }
+    resolved
+}
+
+impl Active {
+    fn from_environment(index: &IndexOwned) -> Option<Self> {
+        let config_path = std::env::var("NEMO_LINK_CONFIG").ok()?;
+        let Ok(key_text) = std::env::var("NEMO_LINK_EVENT_KEY") else {
+            warn!("NEMO_LINK_CONFIG is set but NEMO_LINK_EVENT_KEY is not; the NemoWorld link is off");
+            return None;
+        };
+        let key = parse_key(&key_text);
+        if key.len() < 32 {
+            warn!("NEMO_LINK_EVENT_KEY must be at least 32 bytes; the NemoWorld link is off");
+            return None;
+        }
+        let cfg: Config = match fs::read_to_string(&config_path)
+            .map_err(|e| e.to_string())
+            .and_then(|text| serde_json::from_str(&text).map_err(|e| e.to_string()))
+        {
+            Ok(cfg) => cfg,
+            Err(e) => {
+                warn!("cannot read {config_path}: {e}; the NemoWorld link is off");
+                return None;
+            },
+        };
+        let outbox = Path::new(&cfg.outbox);
+        if let Some(parent) = outbox.parent() {
+            let _ = fs::create_dir_all(parent);
+        }
+        let out = match OpenOptions::new().create(true).append(true).open(outbox) {
+            Ok(file) => file,
+            Err(e) => {
+                warn!("cannot open the outbox {}: {e}; the NemoWorld link is off", cfg.outbox);
+                return None;
+            },
+        };
+        // Starting from the clock keeps ids unique even if the outbox was deleted.
+        let seq = last_seq(outbox).max(unix_ms() / 1000);
+        let landmarks = resolve_landmarks(&cfg, index, outbox);
+        let commands_path = std::path::PathBuf::from(
+            cfg.commands
+                .clone()
+                .unwrap_or_else(|| format!("{}.commands.jsonl", cfg.outbox)),
+        );
+        let claimed_path = format!("{}.claimed", cfg.outbox);
+        let claimed: HashSet<String> = fs::read_to_string(&claimed_path)
+            .unwrap_or_default()
+            .lines()
+            .map(str::to_owned)
+            .collect();
+        let claimed_file = match OpenOptions::new().create(true).append(true).open(&claimed_path) {
+            Ok(file) => file,
+            Err(e) => {
+                warn!("cannot open {claimed_path}: {e}; the NemoWorld link is off");
+                return None;
+            },
+        };
+        let ack_resident = cfg
+            .ack_resident
+            .clone()
+            .or_else(|| cfg.residents.values().next().cloned())
+            .unwrap_or_default();
+        info!(
+            server_id = %cfg.server_id,
+            residents = cfg.residents.len(),
+            landmarks = landmarks.len(),
+            "NemoWorld link is on, writing signed events to {}",
+            cfg.outbox
+        );
+        Some(Self {
+            cfg,
+            landmarks,
+            commands_path,
+            commands_offset: 0,
+            pending: Vec::new(),
+            claimed,
+            claimed_file,
+            ack_resident,
+            key,
+            out,
+            seq,
+            near: HashMap::new(),
+            together: HashMap::new(),
+            visiting: HashMap::new(),
+            last: HashMap::new(),
+        })
+    }
+
+    fn claim(&mut self, cmd_id: &str) {
+        if self.claimed.insert(cmd_id.to_owned()) {
+            let line = format!("{cmd_id}\n");
+            if let Err(e) = self.claimed_file.write_all(line.as_bytes()).and_then(|()| self.claimed_file.flush()) {
+                warn!("could not record claimed command {cmd_id}: {e}");
+            }
+        }
+    }
+
+    /// Read new complete lines of the commands file; keep the verified, unexpired, unclaimed ones.
+    fn ingest_commands(&mut self) {
+        let Ok(mut file) = File::open(&self.commands_path) else {
+            return;
+        };
+        if file.seek(SeekFrom::Start(self.commands_offset)).is_err() {
+            return;
+        }
+        let mut text = String::new();
+        if file.read_to_string(&mut text).is_err() {
+            return;
+        }
+        let Some(complete) = text.rfind('\n').map(|i| i + 1) else {
+            return;
+        };
+        self.commands_offset += complete as u64;
+        let now = unix_ms();
+        for line in text[..complete].lines().filter(|l| !l.trim().is_empty()) {
+            let Ok(value) = serde_json::from_str::<serde_json::Value>(line) else {
+                warn!("ignoring a malformed command line");
+                continue;
+            };
+            let text_of = |key: &str| value[key].as_str().map(str::to_owned);
+            let (Some(cmd_id), Some(kind), Some(player_uuid), Some(args), Some(sig)) = (
+                text_of("cmd_id"),
+                text_of("kind"),
+                text_of("player_uuid"),
+                text_of("args"),
+                text_of("sig"),
+            ) else {
+                warn!("ignoring a command with missing fields");
+                continue;
+            };
+            let (Some(issued_at), Some(expires_at)) =
+                (value["issued_at"].as_u64(), value["expires_at"].as_u64())
+            else {
+                continue;
+            };
+            let signed = canonical_command(&cmd_id, &kind, &player_uuid, &args, issued_at, expires_at);
+            if value["v"].as_u64() != Some(u64::from(nemo_link_proto::VERSION))
+                || !verify(&self.key, &signed, &sig)
+            {
+                // Unsigned or forged: say nothing back, so a forger learns nothing and cannot cause noise.
+                warn!(%cmd_id, "ignoring a command whose signature does not verify");
+                continue;
+            }
+            if self.claimed.contains(&cmd_id) || self.pending.iter().any(|c| c.cmd_id == cmd_id) {
+                continue;
+            }
+            let command = Command {
+                cmd_id,
+                kind,
+                player_uuid,
+                args,
+                expires_at,
+            };
+            if now > expires_at {
+                self.claim(&command.cmd_id);
+                self.ack(&command, false, "expired");
+            } else {
+                self.pending.push(command);
+            }
+        }
+    }
+
+    /// Take (and claim) the pending commands of the given kinds; expire the stale ones.
+    fn poll_commands(&mut self, kinds: &[&str]) -> Vec<Command> {
+        self.ingest_commands();
+        let now = unix_ms();
+        let (stale, live): (Vec<_>, Vec<_>) =
+            std::mem::take(&mut self.pending).into_iter().partition(|c| now > c.expires_at);
+        self.pending = live;
+        for command in stale {
+            self.claim(&command.cmd_id);
+            self.ack(&command, false, "expired");
+        }
+        let (taken, kept): (Vec<_>, Vec<_>) = std::mem::take(&mut self.pending)
+            .into_iter()
+            .partition(|c| kinds.contains(&c.kind.as_str()));
+        self.pending = kept;
+        for command in &taken {
+            self.claim(&command.cmd_id);
+        }
+        taken
+    }
+
+    /// Tell NemoWorld what happened to a command, as a signed event (the cmd_id rides in `landmark_id`).
+    fn ack(&mut self, command: &Command, applied: bool, reason: &str) {
+        let kind = if applied { "command.applied" } else { "command.rejected" };
+        info!(cmd_id = %command.cmd_id, kind = %command.kind, applied, reason, "NemoWorld command result");
+        let resident = self.ack_resident.clone();
+        self.emit(kind, &resident, &command.player_uuid, "", Some(&command.cmd_id));
+    }
+
+    fn cooled_down(&mut self, key: String, now: f64, cooldown: f64) -> bool {
+        match self.last.get(&key) {
+            Some(&at) if now - at < cooldown => false,
+            _ => {
+                self.last.insert(key, now);
+                true
+            },
+        }
+    }
+
+    fn emit(
+        &mut self,
+        kind: &str,
+        resident_id: &str,
+        player_uuid: &str,
+        player_alias: &str,
+        landmark_id: Option<&str>,
+    ) {
+        self.seq += 1;
+        let occurred_at = unix_ms();
+        let text = canonical(
+            &self.cfg.server_id,
+            self.seq,
+            kind,
+            resident_id,
+            player_uuid,
+            player_alias,
+            landmark_id.unwrap_or(""),
+            occurred_at,
+        );
+        let line = serde_json::json!({
+            "v": nemo_link_proto::VERSION,
+            "server_id": self.cfg.server_id,
+            "seq": self.seq,
+            "kind": kind,
+            "resident_id": resident_id,
+            "player_uuid": player_uuid,
+            "player_alias": player_alias,
+            "landmark_id": landmark_id,
+            "occurred_at": occurred_at,
+            "sig": sign(&self.key, &text),
+        });
+        // One write call per line so a reader never sees half an event.
+        let mut bytes = line.to_string().into_bytes();
+        bytes.push(b'\n');
+        if let Err(e) = self.out.write_all(&bytes).and_then(|()| self.out.flush()) {
+            warn!("could not write a NemoWorld event: {e}");
+        } else {
+            info!(seq = self.seq, kind, resident_id, player_alias, ?landmark_id, "NemoWorld event");
+        }
+    }
+}
+
+#[derive(Default)]
+pub struct Sys;
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        ReadStorage<'a, Pos>,
+        ReadStorage<'a, Player>,
+        Read<'a, Time>,
+        Write<'a, NemoLinkState>,
+        ReadExpect<'a, IndexOwned>,
+    );
+
+    const NAME: &'static str = "nemo_link";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(_job: &mut Job<Self>, (positions, players, time, mut state, index): Self::SystemData) {
+        let state = &mut *state;
+        if !state.loaded {
+            state.loaded = true;
+            state.active = Active::from_environment(&index);
+        }
+        let Some(active) = state.active.as_mut() else {
+            return;
+        };
+        let now = time.0;
+        // Positions change slowly compared with these thresholds; once a second is plenty.
+        if now - state.last_run < 1.0 {
+            return;
+        }
+        state.last_run = now;
+
+        // Built-in test command: proves the channel end to end without changing the game.
+        for command in active.poll_commands(&["echo"]) {
+            active.ack(&command, true, "echo");
+        }
+
+        // (resident id, position) and (uuid, alias, position).
+        let mut residents = Vec::new();
+        let mut visitors = Vec::new();
+        for (pos, player) in (&positions, &players).join() {
+            match active.cfg.residents.get(&player.alias) {
+                Some(resident_id) => residents.push((resident_id.clone(), pos.0)),
+                None => visitors.push((
+                    player.uuid().to_string(),
+                    player.alias.clone(),
+                    pos.0,
+                )),
+            }
+        }
+
+        let within = |a: vek::Vec3<f32>, b: vek::Vec3<f32>, radius: f32, vertical: f32| {
+            a.xy().distance_squared(b.xy()) <= radius * radius && (a.z - b.z).abs() <= vertical
+        };
+        let mut still_near = Vec::new();
+        let mut still_together = Vec::new();
+
+        for (resident_id, resident_pos) in &residents {
+            // The landmark the resident is standing in, if any.
+            let resident_landmark = active
+                .landmarks
+                .iter()
+                .find(|l| {
+                    resident_pos.xy().distance_squared(vek::Vec2::new(l.x, l.y)) <= l.radius * l.radius
+                })
+                .map(|l| l.id.clone());
+
+            for (uuid, alias, pos) in &visitors {
+                let pair = (uuid.clone(), resident_id.clone());
+                if within(*pos, *resident_pos, active.cfg.meet_radius, active.cfg.vertical_tolerance) {
+                    let since = *active.near.entry(pair.clone()).or_insert(now);
+                    still_near.push(pair.clone());
+                    if now - since >= active.cfg.meet_secs {
+                        let cooldown = active.cfg.meet_cooldown_secs;
+                        let key = format!("met|{uuid}|{resident_id}|{resident_landmark:?}");
+                        if active.cooled_down(key, now, cooldown) {
+                            active.emit(
+                                "resident.met",
+                                resident_id,
+                                uuid,
+                                alias,
+                                resident_landmark.as_deref(),
+                            );
+                        }
+                    }
+                }
+
+                // Resident and visitor both inside the same landmark.
+                let landmarks: Vec<(String, f32, f32, f32)> = active
+                    .landmarks
+                    .iter()
+                    .map(|l| (l.id.clone(), l.x, l.y, l.radius))
+                    .collect();
+                for (landmark_id, x, y, radius) in landmarks {
+                    let centre = vek::Vec2::new(x, y);
+                    let both = resident_pos.xy().distance_squared(centre) <= radius * radius
+                        && pos.xy().distance_squared(centre) <= radius * radius
+                        && (pos.z - resident_pos.z).abs() <= active.cfg.vertical_tolerance;
+                    if both {
+                        let triple = (uuid.clone(), resident_id.clone(), landmark_id.clone());
+                        let since = *active.together.entry(triple.clone()).or_insert(now);
+                        still_together.push(triple);
+                        if now - since >= active.cfg.together_secs {
+                            let cooldown = active.cfg.together_cooldown_secs;
+                            let key = format!("together|{uuid}|{resident_id}|{landmark_id}");
+                            if active.cooled_down(key, now, cooldown) {
+                                active.emit(
+                                    "landmark.together",
+                                    resident_id,
+                                    uuid,
+                                    alias,
+                                    Some(&landmark_id),
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        // Discovery places: a person standing inside one for long enough has found it. The fact is
+        // recorded once per person and place per cooldown, under the village's witness resident.
+        let discoveries: Vec<(String, f32, f32, f32)> = active
+            .landmarks
+            .iter()
+            .filter(|l| l.discovery)
+            .map(|l| (l.id.clone(), l.x, l.y, l.radius))
+            .collect();
+        let mut still_visiting = Vec::new();
+        for (uuid, alias, pos) in &visitors {
+            for (landmark_id, x, y, radius) in &discoveries {
+                if pos.xy().distance_squared(vek::Vec2::new(*x, *y)) > radius * radius {
+                    continue;
+                }
+                let pair = (uuid.clone(), landmark_id.clone());
+                let since = *active.visiting.entry(pair.clone()).or_insert(now);
+                still_visiting.push(pair);
+                if now - since >= active.cfg.visit_secs {
+                    let cooldown = active.cfg.visit_cooldown_secs;
+                    let key = format!("visited|{uuid}|{landmark_id}");
+                    if active.cooled_down(key, now, cooldown) {
+                        let witness = active.ack_resident.clone();
+                        active.emit("landmark.visited", &witness, uuid, alias, Some(landmark_id));
+                    }
+                }
+            }
+        }
+        active.visiting.retain(|pair, _| still_visiting.contains(pair));
+
+        // A cooldown entry older than the longest cooldown can never suppress anything again; without this the
+        // map keeps one key per (person, resident, place) for as long as the server runs.
+        let longest = active
+            .cfg
+            .meet_cooldown_secs
+            .max(active.cfg.together_cooldown_secs)
+            .max(active.cfg.visit_cooldown_secs);
+        active.last.retain(|_, at| now - *at < longest);
+
+        // Forget pairs that are no longer close, so the timers measure unbroken presence.
+        active.near.retain(|pair, _| still_near.contains(pair));
+        active.together.retain(|triple, _| still_together.contains(triple));
+    }
+}
