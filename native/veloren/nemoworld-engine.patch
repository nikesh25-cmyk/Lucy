+fn main() {
+    // The guards flush the log on drop, so they must live as long as main.
+    let _log_guards = common_frontend::init_stdout(None);
+    let args = parse_args();
+
+    let roster: Roster = serde_json::from_str(
+        &fs::read_to_string(&args.roster).unwrap_or_else(|e| panic!("cannot read roster: {e}")),
+    )
+    .expect("roster.json is not valid");
+    let resident_names: Vec<String> = roster.residents.iter().map(|r| first_name(r).to_owned()).collect();
+    let resident = roster
+        .residents
+        .into_iter()
+        .find(|r| r.id == args.resident)
+        .unwrap_or_else(|| panic!("no resident {} in the roster", args.resident));
+    let landmarks: Vec<Landmark> = if args.list_sites || args.probe.is_some() {
+        Vec::new()
+    } else {
+        serde_json::from_str::<LandmarkFile>(
+            &fs::read_to_string(&args.landmarks)
+                .unwrap_or_else(|e| panic!("cannot read {}: {e}", args.landmarks)),
+        )
+        .expect("landmarks.json is not valid")
+        .landmarks
+    };
+    let nemo = args.nemo_url.as_ref().map(|url| {
+        let token = std::env::var("NEMO_LINK_TOKEN").unwrap_or_default();
+        Nemo::new(url, token).unwrap_or_else(|e| panic!("{e}"))
+    });
+
+    let mut backoff = RECONNECT_MIN;
+    loop {
+        let started = Instant::now();
+        match run_session(&args, &resident, &resident_names, &landmarks, nemo.as_ref()) {
+            Ok(()) => info!("session ended"),
+            Err(e) => warn!("session failed: {e}"),
+        }
+        if args.probe.is_some() || args.list_sites {
+            // A probe or a listing is a one-shot run.
+            std::process::exit(1);
+        }
+        if started.elapsed() > Duration::from_secs(60) {
+            backoff = RECONNECT_MIN;
+        }
+        warn!("reconnecting in {}s", backoff.as_secs());
+        thread::sleep(backoff);
+        backoff = (backoff * 2).min(RECONNECT_MAX);
+    }
+}
+
+fn run_session(
+    args: &Args,
+    resident: &Resident,
+    resident_names: &[String],
+    landmarks: &[Landmark],
+    nemo: Option<&Nemo>,
+) -> Result<(), String> {
+    let addressed = first_name(resident).to_owned();
+    let alias = args.probe.clone().unwrap_or_else(|| addressed.clone());
+    let is_probe = args.probe.is_some();
+    info!(
+        "Connecting {}'{}' to {}",
+        if is_probe { "probe " } else { "resident " },
+        alias,
+        args.server
+    );
+
+    let runtime = Arc::new(Runtime::new().map_err(|e| e.to_string())?);
+    let provider = StaticCredentialProvider {
+        credentials_by_auth: [(None, Credentials::Username(alias.clone()))].into(),
+    };
+    let mut client = runtime
+        .block_on(Client::new(
+            ConnectionArgs::Tcp {
+                prefer_ipv6: false,
+                hostname: args.server.clone(),
+            },
+            Arc::clone(&runtime),
+            None,
+            &provider,
+            &|_| {},
+            |_| {},
+            Default::default(),
+            ClientType::Game,
+        ))
+        .map_err(|e| format!("could not connect (is the server running with --no-auth?): {e:?}"))?;
+    info!("connected");
+
+    let body: comp::Body = default_body().into();
+    let mut clock = Clock::new(Duration::from_secs_f64(1.0 / args.tps));
+    let mut rng = Rng::new();
+    let mut navigator = Navigator::new();
+    let (tx, rx) = mpsc::channel::<Msg>();
+    // Account linking in chat ("link my account", "unlink", "who am I"): see chat_link.rs.
+    let mut link_chat = nemo
+        .filter(|_| !is_probe)
+        .map(|n| chat_link::LinkChat::new(n.clone(), chat_link::page_url(args.nemo_url.as_deref())));
+
+    client.load_character_list();
+    let mut requested_create = false;
+    let mut joined = false;
+    // Veloren refuses a quick re-login ("recently logged out"); wait and ask again.
+    let mut join_after = Instant::now();
+    let mut join_errors = 0u32;
+    let mut in_world = false;
+    let mut in_world_since = Instant::now();
+    let mut greeted = false;
+    let mut last_bark = Instant::now();
+    let mut next_bark = Duration::from_secs(rng.range(BARK_INTERVAL_SECS.0, BARK_INTERVAL_SECS.1));
+    let mut last_reply = Instant::now() - REPLY_COOLDOWN;
+    let mut last_status = Instant::now();
+    let mut last_say = Instant::now() - SAY_GAP;
+    let mut say_queue: VecDeque<String> = VecDeque::new();
+    // Role behaviour at a works site: one pose cycle per resident, and one short line per site visit
+    // whispered to a nearby human when there is one (public chat is the fallback).
+    let mut visited_site: Option<String> = None;
+    let mut pose_index = 0usize;
+    let mut next_pose = Instant::now();
+    let mut whisper_queue: VecDeque<(String, String)> = VecDeque::new();
+    let mut last_whisper = Instant::now() - SAY_GAP;
+    // One role-true greeting per human per calendar day; a session never repeats it.
+    let mut greeted_humans: HashMap<String, u64> = HashMap::new();
+    let mut last_greet = Instant::now() - Duration::from_secs(60);
+    let mut director: Option<Director> = None;
+    let mut director_in_flight = false;
+    let mut director_retry_at = Instant::now();
+    let mut director_failures = 0u32;
+
+    // Probe script: a prompt, then the prefix its reply must start with (None = any reply).
+    let probe_script: Vec<(String, Option<String>)> = vec![
+        (
+            format!("Hello {addressed}, who are you?"),
+            Some(format!("I am {}", resident.name)),
+        ),
+        (
+            format!("{addressed}, where are you right now?"),
+            Some("At this hour you will find me".into()),
+        ),
+        (
+            format!("{addressed}, what are your limits?"),
+            Some(resident.limitations.clone()),
+        ),
+        (format!("{addressed}, tell me something."), None),
+    ];
+    let mut probe_sent = 0usize;
+    let mut probe_matched = vec![false; probe_script.len()];
+    let mut probe_last = Instant::now();
+    let probe_started = Instant::now();
+    let mut quest_done = false;
+    // Shopkeeper talk (Kael) and the scripted stand-in player used to test it.
+    let mut shop = (args.shop && !is_probe)
+        .then(|| nemo.map(|n| chat_shop::ShopChat::new(n.clone(), &resident.id, &addressed)))
+        .flatten();
+    let mut script = args.script.as_ref().filter(|_| is_probe).map(|text| {
+        chat_shop::Script::new(
+            chat_shop::parse_script(text).unwrap_or_else(|e| panic!("bad --script: {e}")),
+            &addressed,
+        )
+    });
+    // The in-game guide (chat_hud.rs): short commands answered with private, paged text. One guide
+    // process, no client change; a probe never runs it.
+    // Newcomers: players already online when the guide arrives are not greeted again; later arrivals are.
+    let mut welcomed = std::collections::HashSet::new();
+    let mut pending_welcome: Vec<(Instant, String)> = Vec::new();
+    let mut hud = (args.guide && !is_probe).then(|| chat_hud::Hud::new(nemo.cloned(), &resident.name));
+    // The cottage keeper (chat_home.rs): plot and cottage talk answered out of NemoWorld's own records.
+    let mut home_chat = (args.home && !is_probe)
+        .then(|| nemo.map(|n| chat_home::HomeChat::new(n.clone(), &resident.id, &addressed)))
+        .flatten();
+    // The atlas keeper (chat_atlas.rs): where a player is, and travel to a place on NemoWorld's map.
+    let mut atlas_chat = (args.atlas && !is_probe)
+        .then(|| nemo.map(|n| chat_atlas::AtlasChat::new(n.clone(), &resident.id, &addressed)))
+        .flatten();
+
+    loop {
+        let mut inputs = comp::ControllerInputs::default();
+        let phase = args
+            .phase
+            .as_deref()
+            .unwrap_or_else(|| phase_name(client.state().get_day_period()))
+            .to_owned();
+
+        if !joined {
+            let list = client.character_list();
+            if !list.loading && Instant::now() >= join_after {
+                if let Some(id) = list.characters.first().and_then(|c| c.character.id) {
+                    client.request_character(id, ViewDistances {
+                        terrain: 8,
+                        entity: 6,
+                    });
+                    joined = true;
+                    info!("requested to join the world with the existing character");
+                } else if !requested_create {
+                    info!("no character yet, creating '{alias}'");
+                    // Empty hands: a NemoWorld resident is never created holding a weapon.
+                    client.create_character(
+                        alias.clone(),
+                        None,
+                        None,
+                        default_body().into(),
+                        false,
+                        None,
+                    );
+                    requested_create = true;
+                }
+            }
+        } else if let Some(pos) = client.position() {
+            if !in_world {
+                in_world = true;
+                in_world_since = Instant::now();
+                info!("{alias} is in the world at {:.1?}", pos);
+            }
+
+            if args.list_sites {
+                if in_world_since.elapsed() >= Duration::from_secs(4) {
+                    let mut sites: Vec<_> = client
+                        .sites()
+                        .values()
+                        .map(|site| {
+                            let wpos = site.marker.wpos;
+                            (
+                                (wpos - pos.xy()).magnitude(),
+                                format!("{:?}", site.marker.kind),
+                                site_text(&site.marker.label),
+                                wpos,
+                            )
+                        })
+                        .collect();
+                    sites.sort_by(|a, b| a.0.total_cmp(&b.0));
+                    println!("SITES from ({:.0},{:.0}):", pos.x, pos.y);
+                    for (distance, kind, name, wpos) in sites {
+                        println!("  {kind:<12} {name:<28} x={:.0} y={:.0} distance={distance:.0}", wpos.x, wpos.y);
+                    }
+                    std::process::exit(0);
+                }
+            } else if is_probe && (args.survey.is_some() || args.dump.is_some()) {
+                // Look at the terrain once the chunks have arrived, print it, and stop.
+                if in_world_since.elapsed() >= Duration::from_secs(5) {
+                    let report = match (&args.survey, &args.dump) {
+                        (Some(spec), _) => survey_report(&client, spec),
+                        (_, Some(spec)) => dump_report(&client, spec),
+                        _ => None,
+                    };
+                    match report {
+                        Some(lines) => {
+                            for line in lines {
+                                println!("{line}");
+                            }
+                            std::process::exit(0);
+                        },
+                        None if in_world_since.elapsed() >= Duration::from_secs(60) => {
+                            println!("PROBE_SURVEY_FAIL the chunks of that area did not arrive");
+                            std::process::exit(1);
+                        },
+                        None => {},
+                    }
+                }
+            } else if is_probe && args.goto.is_some() {
+                // A stand-in human who really walks to a place and stands there. Nothing here reports
+                // anything; the server observes the position, exactly as it observes a real player's.
+                let (gx, gy) = args.goto.expect("checked above");
+                let target = vek::Vec2::new(gx, gy);
+                if let Some((direction, look)) = navigator.steer(&mut client, target, 1.5, &body) {
+                    inputs.move_dir = direction;
+                    inputs.look_dir = look;
+                }
+                if last_status.elapsed() >= STATUS_EVERY {
+                    last_status = Instant::now();
+                    info!(
+                        "PROBE going to ({gx:.0},{gy:.0}): me=({:.0},{:.0}) gap={:.1}",
+                        pos.x,
+                        pos.y,
+                        (target - pos.xy()).magnitude()
+                    );
+                }
+            } else if is_probe && args.quest {
+                // A stand-in human: walk to the resident, then stay with her until she says the
+                // quest is complete. Nothing here reports progress; the server observes positions.
+                let lyra = client
+                    .player_list()
+                    .iter()
+                    .find(|(_, info)| info.player_alias == addressed)
+                    .map(|(uid, _)| *uid)
+                    .and_then(|uid| client.state().ecs().entity_from_uid(uid))
+                    .and_then(|entity| client.state().read_storage::<comp::Pos>().get(entity).map(|p| p.0));
+                if let Some(lyra) = lyra {
+                    if let Some((direction, look)) = navigator.steer(&mut client, lyra.xy(), 2.5, &body) {
+                        inputs.move_dir = direction;
+                        inputs.look_dir = look;
+                    }
+                    if last_status.elapsed() >= STATUS_EVERY {
+                        last_status = Instant::now();
+                        info!(
+                            "PROBE following {addressed}: me=({:.0},{:.0}) her=({:.0},{:.0}) gap={:.1}",
+                            pos.x, pos.y, lyra.x, lyra.y, (lyra - pos).magnitude()
+                        );
+                    }
+                } else if last_status.elapsed() >= STATUS_EVERY {
+                    last_status = Instant::now();
+                    info!("PROBE cannot see {addressed} yet");
+                }
+                if quest_done {
+                    info!("PROBE PASS: {addressed} said the quest is complete");
+                    std::process::exit(0);
+                }
+                if probe_started.elapsed() >= QUEST_DEADLINE {
+                    warn!("PROBE FAIL: the quest was not completed in time");
+                    std::process::exit(1);
+                }
+            } else if is_probe && script.is_some() {
+                if in_world_since.elapsed() >= PROBE_GAP
+                    && let Some(script) = script.as_mut()
+                {
+                    match script.tick(&mut client) {
+                        chat_shop::ScriptState::Running => {},
+                        chat_shop::ScriptState::Passed => {
+                            info!("PROBE PASS: the script finished");
+                            std::process::exit(0);
+                        },
+                        chat_shop::ScriptState::Failed(why) => {
+                            warn!("PROBE FAIL: {why}");
+                            std::process::exit(1);
+                        },
+                    }
+                }
+            } else if is_probe && args.say.is_some() {
+                // Say one line, then listen. Used to look at free-form replies.
+                if probe_sent == 0 && in_world_since.elapsed() >= PROBE_GAP {
+                    let line = args.say.clone().unwrap_or_default();
+                    info!("PROBE says: {line}");
+                    chat_link::probe_say(&mut client, &addressed, line, args.tell);
+                    probe_sent = 1;
+                    probe_last = Instant::now();
+                }
+                if probe_sent == 1 && probe_last.elapsed() >= Duration::from_secs(25) {
+                    info!("PROBE done listening");
+                    std::process::exit(0);
+                }
+            } else if is_probe {
+                let now = Instant::now();
+                if probe_sent < probe_script.len()
+                    && now.duration_since(probe_last) >= PROBE_GAP
+                    && (probe_sent > 0 || now.duration_since(probe_started) >= PROBE_GAP)
+                {
+                    let (line, _) = &probe_script[probe_sent];
+                    info!("PROBE says: {line}");
+                    client.send_chat(line.clone());
+                    probe_sent += 1;
+                    probe_last = now;
+                }
+                if probe_matched.iter().all(|m| *m) {
+                    info!("PROBE PASS: all {} scripted replies received", probe_script.len());
+                    std::process::exit(0);
+                }
+                if now.duration_since(probe_started) >= PROBE_DEADLINE {
+                    warn!("PROBE FAIL: replies matched = {probe_matched:?}");
+                    std::process::exit(1);
+                }
+            } else {
+                // Ask NemoWorld where she should be. A shopkeeper's credential carries only the shop
+                // scope, so he never asks: without this the server would log a 403 every few seconds.
+                if let Some(nemo) = nemo
+                    && shop.is_none()
+                    && !director_in_flight
+                    && Instant::now() >= director_retry_at
+                {
+                    director_in_flight = true;
+                    nemo.fetch_director(tx.clone());
+                }
+                let escorted = director
+                    .as_ref()
+                    .filter(|d| {
+                        d.mode == "escort"
+                            || d.mode == "return"
+                            || d.mode == "gather"
+                            || d.mode == "work"
+                    })
+                    .and_then(|d| d.target_landmark_id.as_deref())
+                    .and_then(|id| landmarks.iter().find(|l| l.id == id));
+                let scheduled_label = resident
+                    .destinations
+                    .get(&phase)
+                    .or_else(|| resident.destinations.values().next())
+                    .map(|d| d.label.as_str());
+                let target = escorted.or_else(|| {
+                    scheduled_label.and_then(|label| landmarks.iter().find(|l| l.label == label))
+                });
+                if let Some(target) = target {
+                    let arrive = (target.radius * 0.35).clamp(3.0, 9.0);
+                    if let Some((direction, look)) =
+                        navigator.steer(&mut client, Vec2::new(target.x, target.y), arrive, &body)
+                    {
+                        inputs.move_dir = direction;
+                        inputs.look_dir = look;
+                    }
+                    let distance = (Vec2::new(target.x, target.y) - pos.xy()).magnitude();
+                    // Work is visible. At a works site (the `site-*` places the manifest names) the resident
+                    // holds its calling's peaceful pose, faces the work and says one short line per visit.
+                    // Away from a site it walks as before; nothing here changes where anyone stands.
+                    let at_site = target.id.starts_with("site-") && distance <= target.radius + 2.0;
+                    if at_site {
+                        if visited_site.as_deref() != Some(target.id.as_str()) {
+                            visited_site = Some(target.id.clone());
+                            pose_index = 0;
+                            next_pose = Instant::now();
+                            let lines = work_lines(&resident.calling);
+                            if !lines.is_empty() && client.players().count() > 1 {
+                                let line =
+                                    lines[rng.pick_index(lines.len())].to_owned();
+                                // Whisper a nearby human when there is one; public chat is the fallback.
+                                let nearest = client
+                                    .player_list()
+                                    .iter()
+                                    .filter(|(_, info)| {
+                                        info.is_online
+                                            && !resident_names
+                                                .iter()
+                                                .any(|n| n == &info.player_alias)
+                                    })
+                                    .filter_map(|(uid, info)| {
+                                        let entity = client.state().ecs().entity_from_uid(*uid)?;
+                                        let p = client
+                                            .state()
+                                            .read_storage::<comp::Pos>()
+                                            .get(entity)?
+                                            .0;
+                                        let gap = (p.xy() - pos.xy()).magnitude();
+                                        (gap <= 24.0).then_some((gap, info.player_alias.clone()))
+                                    })
+                                    .min_by(|a, b| a.0.total_cmp(&b.0));
+                                match nearest {
+                                    Some((_, alias)) => whisper_queue.push_back((alias, line)),
+                                    None => say_queue.push_back(line),
+                                }
+                            }
+                        }
+                        let poses = role_poses(&resident.calling);
+                        if !poses.is_empty() {
+                            if Instant::now() >= next_pose {
+                                let pose = poses[pose_index % poses.len()];
+                                pose_index += 1;
+                                next_pose = Instant::now()
+                                    + Duration::from_secs(rng.range(
+                                        POSE_EVERY_SECS.0,
+                                        POSE_EVERY_SECS.1,
+                                    ));
+                                let action = match pose {
+                                    Pose::Crouch => comp::ControlAction::Sneak,
+                                    Pose::Sit => comp::ControlAction::Sit,
+                                    Pose::Stand => comp::ControlAction::Stand,
+                                    Pose::Dance => comp::ControlAction::Dance,
+                                };
+                                client.send_control_action(action);
+                                info!(
+                                    "work: {} holds {pose:?} at '{}'",
+                                    resident.name, target.label
+                                );
+                            }
+                            let to_work = Vec2::new(target.x - pos.x, target.y - pos.y);
+                            if to_work.magnitude() > 0.01 {
+                                inputs.look_dir = Dir::from_unnormalized(Vec3::new(to_work.x, to_work.y, 0.0))
+                                    .unwrap_or_default();
+                            }
+                        }
+                    } else if visited_site.take().is_some() {
+                        // Leaving the site ends the visit: returning earns one fresh line, and the
+                        // resident stands up rather than carrying a working crouch down the road.
+                        client.send_control_action(comp::ControlAction::Stand);
+                    }
+                    if last_status.elapsed() >= STATUS_EVERY {
+                        last_status = Instant::now();
+                        info!(
+                            "status: phase={phase} mode={} going to '{}' ({}) pos=({:.0},{:.0}) \
+                             distance={distance:.0} nav[{}]",
+                            director.as_ref().map_or("schedule", |d| d.mode.as_str()),
+                            target.label,
+                            target.id,
+                            pos.x,
+                            pos.y,
+                            navigator.note
+                        );
+                    }
+                } else if last_status.elapsed() >= STATUS_EVERY {
+                    last_status = Instant::now();
+                    warn!("no landmark for phase {phase} ({scheduled_label:?}); standing still");
+                }
+
+                // P4: a role-true greeting for a nearby human, once per calendar day, never repeated
+                // within a session, paced by the whisper queue. Scripted (no `[AI]`).
+                if last_greet.elapsed() >= Duration::from_secs(3)
+                    && let Some((alias, _)) = nearby_human(&client, &resident_names, pos, 24.0)
+                {
+                    let day = unix_day();
+                    if greeted_humans.get(&alias) != Some(&day) {
+                        greeted_humans.insert(alias.clone(), day);
+                        let at_work = director
+                            .as_ref()
+                            .is_some_and(|d| d.mode == "work" && !d.target_landmark_id.as_deref().unwrap_or("").is_empty());
+                        let table = if at_work { work_greetings(&resident.calling) } else { role_greetings(&resident.calling) };
+                        let line = table[rng.pick_index(table.len())].to_owned();
+                        info!("greets {alias} ({resident_calling}): {line}", resident_calling = resident.calling);
+                        whisper_queue.push_back((alias, line));
+                        last_greet = Instant::now();
+                    }
+                }
+
+                if !greeted {
+                    say_queue.push_back(format!(
+                        "Greetings. I am {}, a NemoWorld resident. My lines are scripted unless they \
+                         start with [AI].",
+                        resident.name
+                    ));
+                    if let Some(shop) = &shop {
+                        say_queue.push_back(shop.intro());
+                    }
+                    if let Some(hud) = hud.as_ref() {
+                        // The guide says one line of her own with the arrival greeting, so a player knows
+                        // she can be whispered to. (She is the only resident that does this.)
+                        if let Some(line) = chat_hud::welcome_lines().first() {
+                            say_queue.push_back(line.clone());
+                        }
+                    }
+                    greeted = true;
+                }
+                if last_bark.elapsed() >= next_bark {
+                    last_bark = Instant::now();
+                    next_bark =
+                        Duration::from_secs(rng.range(BARK_INTERVAL_SECS.0, BARK_INTERVAL_SECS.1));
+                    // Stay quiet when nobody else is online.
+                    if client.players().count() > 1
+                        && let Some(line) = rng.pick(&resident.barks).cloned()
+                    {
+                        say_queue.push_back(line);
+                    }
+                }
+            }
+        }
+
+        // Replies and announcements from NemoWorld.
+        while let Ok(message) = rx.try_recv() {
+            match message {
+                Msg::Director(result) => {
+                    director_in_flight = false;
+                    match result {
+                        Ok(plan) => {
+                            director_failures = 0;
+                            director_retry_at = Instant::now() + DIRECTOR_EVERY;
+                            for item in &plan.announcements {
+                                info!("announcement {}: {}", item.id, item.text);
+                                say_queue.push_back(item.text.clone());
+                            }
+                            if director.as_ref().map(|d| (&d.mode, &d.target_landmark_id))
+                                != Some((&plan.mode, &plan.target_landmark_id))
+                            {
+                                info!(
+                                    "director: mode={} target={:?} player={:?}",
+                                    plan.mode, plan.target_landmark_id, plan.player_uuid
+                                );
+                            }
+                            director = Some(plan);
+                        },
+                        Err(e) => {
+                            director_failures += 1;
+                            // Back off, and after a few failures drop any stale escort order so she
+                            // returns to her own schedule.
+                            director_retry_at = Instant::now()
+                                + Duration::from_secs((1u64 << director_failures.min(5)).min(30));
+                            if director_failures == 1 || director_failures % 5 == 0 {
+                                warn!("director unavailable ({director_failures}): {e}");
+                            }
+                            if director_failures >= 3 && director.take().is_some() {
+                                warn!("no word from NemoWorld; returning to her own schedule");
+                            }
+                        },
+                    }
+                },
+                Msg::Talk { alias, text, result } => match result {
+                    Ok(reply) => {
+                        info!("NemoWorld reply for {alias} (source={}): {}", reply.source, reply.reply);
+                        let line = if reply.source == "model" {
+                            format!("[AI] {}", reply.reply)
+                        } else {
+                            reply.reply
+                        };
+                        say_queue.push_back(line);
+                    },
+                    // A 429 means the same player spoke again too quickly; stay quiet.
+                    Err(e) if e.contains("429") => {},
+                    Err(e) => {
+                        warn!("NemoWorld talk failed ({e}); answering from the local script");
+                        let label = resident
+                            .destinations
+                            .get(&phase)
+                            .map_or("village", |d| d.label.as_str());
+                        say_queue.push_back(reply_for(resident, &text, label, &mut rng));
+                    },
+                },
+            }
+        }
+        if !say_queue.is_empty() && last_say.elapsed() >= SAY_GAP && in_world {
+            if let Some(line) = say_queue.pop_front() {
+                info!("SAYS: {line}");
+                client.send_chat(line);
+                last_say = Instant::now();
+            }
+        }
+        if !whisper_queue.is_empty() && last_whisper.elapsed() >= SAY_GAP && in_world {
+            if let Some((alias, line)) = whisper_queue.pop_front() {
+                info!("WHISPERS {alias}: {line}");
+                client.send_command("tell".into(), vec![alias, line]);
+                // `/tell` leaves the sender's chat mode on that player; `/say` puts her back in public chat.
+                client.send_command("say".into(), Vec::new());
+                last_whisper = Instant::now();
+            }
+        }
+
+        if in_world && let Some(link_chat) = link_chat.as_mut() {
+            link_chat.tick(&mut client);
+        }
+        if let Some(shop) = shop.as_mut() {
+            shop.tick(&mut client, in_world);
+        }
+        if in_world && let Some(hud) = hud.as_mut() {
+            // Proactive welcome: a person who arrives gets a private greeting after a few seconds. Residents
+            // never do, and nobody is greeted twice in one run.
+            let armed = in_world_since.elapsed() >= Duration::from_secs(25);
+            for (uid, info) in client.player_list() {
+                if info.is_online && Some(*uid) != client.uid() && welcomed.insert(*uid) && armed
+                    && !resident_names.iter().any(|n| n == &info.player_alias)
+                {
+                    pending_welcome.push((Instant::now() + Duration::from_secs(8), info.player_alias.clone()));
+                }
+            }
+            let now = Instant::now();
+            pending_welcome.retain(|(due, alias)| {
+                if now >= *due {
+                    hud.welcome(alias);
+                    false
+                } else {
+                    true
+                }
+            });
+            hud.poll();
+            if hud.queued() > 64 {
+                warn!("the guide has {} lines waiting to be spoken; answers may be delayed", hud.queued());
+            }
+            // One line at a time, paced by the guide itself; `/say` puts her back in public chat, since
+            // `/tell` leaves the sender's chat mode on that player.
+            while let Some((alias, line)) = hud.next_outgoing(Instant::now()) {
+                client.send_command("tell".into(), vec![alias, line]);
+                client.send_command("say".into(), Vec::new());
+            }
+        }
+        if let Some(home_chat) = home_chat.as_mut() {
+            home_chat.tick(&mut client, in_world);
+        }
+        if let Some(atlas_chat) = atlas_chat.as_mut() {
+            atlas_chat.tick(&mut client, in_world);
+        }
+
+        let events = client
+            .tick(inputs, clock.game_dt())
+            .map_err(|e| format!("connection lost: {e:?}"))?;
+
+        for event in events {
+            match event {
+                Event::Chat(msg) => {
+                    let from_self = msg.uid().is_some() && msg.uid() == client.uid();
+                    let comp::Content::Plain(raw_text) = msg.content() else {
+                        continue;
+                    };
+                    if from_self {
+                        continue;
+                    }
+                    // Residents never answer each other. A reply that names a neighbour ("Welcome, Selene") would
+                    // otherwise wake that neighbour, whose reply names the first one, and the village would talk
+                    // to itself forever, calling the model each time.
+                    if !is_probe
+                        && let Some(sender) = msg.uid().and_then(|uid| client.player_list().get(&uid))
+                        && resident_names.iter().any(|n| n == &sender.player_alias)
+                    {
+                        continue;
+                    }
+                    if is_probe {
+                        chat_link::probe_capture(raw_text, &args.code_file);
+                    }
+                    // Link codes are removed from everything below (logs, the model prompt); a code
+                    // spoken in chat is reported so NemoWorld cancels it.
+                    let (scrubbed, codes) = chat_link::scrub(raw_text);
+                    let text = &scrubbed;
+                    if let Some(link_chat) = link_chat.as_mut() {
+                        let speaker = msg.uid().and_then(|uid| {
+                            client
+                                .player_list()
+                                .get(&uid)
+                                .map(|info| (info.uuid.to_string(), info.player_alias.clone()))
+                        });
+                        let private = matches!(&msg.chat_type, comp::ChatType::Tell(_, to) if Some(*to) == client.uid());
+                        if link_chat.on_chat(speaker.as_ref(), private, text, &codes, &addressed) {
+                            continue;
+                        }
+                    }
+                    if let Some(shop) = shop.as_mut() {
+                        shop.on_chat(&client, &msg);
+                        continue;
+                    }
+                    if let Some(script) = script.as_mut() {
+                        script.on_heard(text);
+                        continue;
+                    }
+                    // The guide answers short commands (passport, quests, next, karma, help ...) privately,
+                    // a page at a time. It returns false for a line that is not a command, so ordinary
+                    // conversation still reaches the talk path below.
+                    if let Some(hud) = hud.as_mut() {
+                        let kind = match &msg.chat_type {
+                            comp::ChatType::Tell(_, to) if Some(*to) == client.uid() => Some(chat_hud::Kind::Whisper),
+                            comp::ChatType::Tell(..) => None,
+                            comp::ChatType::Say(_) | comp::ChatType::Region(_) | comp::ChatType::World(_)
+                            | comp::ChatType::Group(..) | comp::ChatType::Faction(..) => Some(chat_hud::Kind::Say),
+                            _ => None,
+                        };
+                        if let Some(kind) = kind
+                            && let Some((uuid, alias)) = msg.uid().and_then(|uid| {
+                                client
+                                    .player_list()
+                                    .get(&uid)
+                                    .map(|info| (info.uuid.to_string(), info.player_alias.clone()))
+                            })
+                            && hud.on_chat(
+                                chat_hud::Heard { kind, uuid, alias, text: text.to_owned() },
+                                Instant::now(),
+                            )
+                        {
+                            continue;
+                        }
+                    }
+                    // The cottage keeper answers plot and cottage talk; a line that is not for him returns
+                    // false and is left to the ordinary talk path below.
+                    if let Some(home_chat) = home_chat.as_mut()
+                        && home_chat.on_chat(&client, &msg)
+                    {
+                        continue;
+                    }
+                    // The atlas keeper answers where-am-I and travel; a line that is not for him returns
+                    // false and is left to the ordinary talk path below.
+                    if let Some(atlas_chat) = atlas_chat.as_mut()
+                        && atlas_chat.on_chat(&client, &msg)
+                    {
+                        continue;
+                    }
+                    if is_probe && args.quest {
+                        info!("PROBE heard: {text}");
+                        if text.contains("is complete and I have written it") {
+                            quest_done = true;
+                        }
+                    } else if is_probe {
+                        info!("PROBE heard: {text}");
+                        for (i, (_, expect)) in probe_script.iter().enumerate() {
+                            if i < probe_sent && !probe_matched[i] {
+                                let ok = match expect {
+                                    Some(prefix) => text.starts_with(prefix.as_str()),
+                                    None => !text.starts_with("Greetings"),
+                                };
+                                if ok {
+                                    probe_matched[i] = true;
+                                    break;
+                                }
+                            }
+                        }
+                    } else if joined
+                        && last_reply.elapsed() >= REPLY_COOLDOWN
+                        && text.to_lowercase().contains(&addressed.to_lowercase())
+                    {
+                        last_reply = Instant::now();
+                        info!("HEARD: {text}");
+                        let speaker = msg.uid().and_then(|uid| {
+                            client
+                                .player_list()
+                                .get(&uid)
+                                .map(|info| (info.uuid.to_string(), info.player_alias.clone()))
+                        });
+                        match (nemo, speaker) {
+                            (Some(nemo), Some((uuid, speaker_alias))) => {
+                                nemo.talk(tx.clone(), &resident.id, &uuid, &speaker_alias, text);
+                            },
+                            _ => {
+                                let label = resident
+                                    .destinations
+                                    .get(&phase)
+                                    .map_or("village", |d| d.label.as_str());
+                                say_queue.push_back(reply_for(resident, text, label, &mut rng));
+                            },
+                        }
+                    }
+                },
+                Event::CharacterCreated(_) => client.load_character_list(),
+                Event::CharacterError(e) => {
+                    join_errors += 1;
+                    warn!("character error ({join_errors}): {e}; will ask again shortly");
+                    if join_errors > 12 {
+                        return Err(format!("could not enter the world: {e}"));
+                    }
+                    joined = false;
+                    in_world = false;
+                    join_after = Instant::now() + Duration::from_secs(5);
+                    client.load_character_list();
+                },
+                Event::Disconnect => return Err("disconnected by the server".into()),
+                _ => {},
+            }
+        }
+
+        client.cleanup();
+        clock.tick();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WORKING_CALLINGS: [&str; 8] =
+        ["builder", "artisan", "researcher", "scholar", "keeper", "host", "mediator", "steward"];
+
+    #[test]
+    fn every_working_calling_has_a_peaceful_pose_and_no_other_does() {
+        for calling in WORKING_CALLINGS {
+            assert!(!role_poses(calling).is_empty(), "{calling} should hold a pose at a works site");
+        }
+        // Cultivators and explorers work by walking their rounds, not by standing still.
+        assert!(role_poses("cultivator").is_empty());
+        assert!(role_poses("explorer").is_empty());
+        assert!(role_poses("builder").contains(&Pose::Crouch));
+        assert!(role_poses("scholar").contains(&Pose::Sit));
+        // The pose table is closed: every value maps to Sneak, Sit, Stand or Dance — never Wield.
+        for calling in WORKING_CALLINGS {
+            for pose in role_poses(calling) {
+                assert!(matches!(pose, Pose::Crouch | Pose::Sit | Pose::Stand | Pose::Dance));
+            }
+        }
+    }
+
+    #[test]
+    fn work_lines_are_short_varied_and_peaceful() {
+        const VIOLENT: [&str; 12] = [
+            "kill", "fight", "attack", "slay", "weapon", "enemy", "battle", "blood", "loot",
+            "raid", "war", "steal",
+        ];
+        for calling in WORKING_CALLINGS {
+            let lines = work_lines(calling);
+            assert!(!lines.is_empty(), "{calling} should have a work line");
+            assert!(lines.len() >= 2, "{calling} should have varied lines");
+            for line in lines {
+                assert!(line.len() <= 140, "{calling}: {line:?} is too long for one chat line");
+                let words: Vec<String> = line
+                    .to_lowercase()
+                    .split(|c: char| !c.is_alphanumeric())
+                    .filter(|w| !w.is_empty())
+                    .map(str::to_owned)
+                    .collect();
+                for banned in VIOLENT {
+                    assert!(!words.iter().any(|w| w == banned), "{calling}: {line:?} says {banned:?}");
+                }
+            }
+        }
+        assert!(work_lines("cultivator").is_empty());
+    }
+
+    #[test]
+    fn greetings_are_short_varied_peaceful_and_cover_every_calling() {
+        const VIOLENT: [&str; 12] = [
+            "kill", "fight", "attack", "slay", "weapon", "enemy", "battle", "blood", "loot",
+            "raid", "war", "steal",
+        ];
+        for calling in [
+            "builder", "artisan", "cultivator", "researcher", "scholar", "keeper", "host",
+            "mediator", "steward", "explorer",
+        ] {
+            let lines = role_greetings(calling);
+            assert!(!lines.is_empty(), "{calling} should have a greeting");
+            for line in lines.iter().chain(work_greetings(calling)) {
+                assert!(line.len() <= 140, "{calling}: {line:?} is too long");
+                let words: Vec<String> = line
+                    .to_lowercase()
+                    .split(|c: char| !c.is_alphanumeric())
+                    .filter(|w| !w.is_empty())
+                    .map(str::to_owned)
+                    .collect();
+                for banned in VIOLENT {
+                    assert!(!words.iter().any(|w| w == banned), "{calling}: {line:?} says {banned:?}");
+                }
+            }
+        }
+        // A builder at an active works site invites the human to join the crew — the P4 example.
+        assert!(work_greetings("builder").iter().any(|l| l.contains("crew")));
+    }
+}
diff --git a/nemo-bridge/src/nemo.rs b/nemo-bridge/src/nemo.rs
new file mode 100644
index 0000000..e9b484e
--- /dev/null
+++ b/nemo-bridge/src/nemo.rs
@@ -0,0 +1,195 @@
+//! A tiny blocking HTTP client for the NemoWorld link API.
+//!
+//! It speaks plain HTTP/1.1 and only to a loopback address, so the link credential never crosses a
+//! network. Calls run on short-lived threads and report back over a channel so the game loop never
+//! waits on NemoWorld or its model.
+
+use serde::Deserialize;
+use std::{
+    io::{Read, Write},
+    net::{TcpStream, ToSocketAddrs},
+    sync::mpsc::Sender,
+    thread,
+    time::Duration,
+};
+
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(3);
+// Longer than NemoWorld's own model timeout, so a slow model degrades to a scripted reply there.
+const IO_TIMEOUT: Duration = Duration::from_secs(14);
+
+#[derive(Clone)]
+pub struct Nemo {
+    host: String,
+    port: u16,
+    token: String,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct Announcement {
+    pub id: String,
+    pub text: String,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct Director {
+    /// `schedule` (follow the roster), `escort` (go to the survey landmark) or `return`.
+    pub mode: String,
+    pub target_landmark_id: Option<String>,
+    pub player_uuid: Option<String>,
+    #[serde(default)]
+    pub announcements: Vec<Announcement>,
+}
+
+#[derive(Debug, Deserialize)]
+pub struct TalkReply {
+    pub reply: String,
+    /// `model` or `scripted`.
+    pub source: String,
+}
+
+pub enum Msg {
+    Director(Result<Director, String>),
+    Talk {
+        alias: String,
+        /// What the player said, kept so a failed call can fall back to the local script.
+        text: String,
+        result: Result<TalkReply, String>,
+    },
+}
+
+impl Nemo {
+    pub fn new(url: &str, token: String) -> Result<Self, String> {
+        let rest = url
+            .strip_prefix("http://")
+            .ok_or("the NemoWorld URL must start with http:// (this bridge only talks to a local NemoWorld)")?;
+        let authority = rest.trim_end_matches('/');
+        let (host, port) = match authority.rsplit_once(':') {
+            Some((host, port)) => (host.to_owned(), port.parse::<u16>().map_err(|e| e.to_string())?),
+            None => (authority.to_owned(), 80),
+        };
+        if !["127.0.0.1", "localhost", "[::1]"].contains(&host.as_str()) {
+            return Err("the link credential is only sent to a local NemoWorld (127.0.0.1)".into());
+        }
+        if token.len() != 64 || !token.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err("NEMO_LINK_TOKEN must be the 64-character link credential".into());
+        }
+        Ok(Self { host, port, token })
+    }
+
+    pub(crate) fn request(&self, method: &str, path: &str, body: Option<&str>) -> Result<(u16, String), String> {
+        let address = format!("{}:{}", self.host.trim_matches(['[', ']']), self.port)
+            .to_socket_addrs()
+            .map_err(|e| e.to_string())?
+            .next()
+            .ok_or("no address")?;
+        let mut stream =
+            TcpStream::connect_timeout(&address, CONNECT_TIMEOUT).map_err(|e| e.to_string())?;
+        stream.set_read_timeout(Some(IO_TIMEOUT)).ok();
+        stream.set_write_timeout(Some(IO_TIMEOUT)).ok();
+        let payload = body.unwrap_or("");
+        let content_type = if body.is_some() {
+            "Content-Type: application/json\r\n"
+        } else {
+            ""
+        };
+        let request = format!(
+            "{method} {path} HTTP/1.1\r\nHost: {}:{}\r\nAuthorization: Bearer {}\r\nAccept: \
+             application/json\r\nConnection: close\r\n{content_type}Content-Length: {}\r\n\r\n{payload}",
+            self.host,
+            self.port,
+            self.token,
+            payload.len()
+        );
+        stream.write_all(request.as_bytes()).map_err(|e| e.to_string())?;
+        let mut raw = Vec::new();
+        stream.read_to_end(&mut raw).map_err(|e| e.to_string())?;
+        parse_response(&raw)
+    }
+
+    pub fn fetch_director(&self, tx: Sender<Msg>) {
+        let nemo = self.clone();
+        thread::spawn(move || {
+            let result = nemo
+                .request("GET", "/api/v1/veloren/director", None)
+                .and_then(|(status, body)| {
+                    if status == 200 {
+                        serde_json::from_str::<Director>(&body).map_err(|e| e.to_string())
+                    } else {
+                        Err(format!("director answered {status}: {body}"))
+                    }
+                });
+            let _ = tx.send(Msg::Director(result));
+        });
+    }
+
+    pub fn talk(
+        &self,
+        tx: Sender<Msg>,
+        resident_id: &str,
+        player_uuid: &str,
+        alias: &str,
+        text: &str,
+    ) {
+        let nemo = self.clone();
+        let body = serde_json::json!({
+            "resident_id": resident_id,
+            "player_uuid": player_uuid,
+            "player_alias": alias,
+            "text": text,
+        })
+        .to_string();
+        let alias = alias.to_owned();
+        let text = text.to_owned();
+        thread::spawn(move || {
+            let result = nemo
+                .request("POST", "/api/v1/veloren/talk", Some(&body))
+                .and_then(|(status, body)| {
+                    if status == 200 {
+                        serde_json::from_str::<TalkReply>(&body).map_err(|e| e.to_string())
+                    } else {
+                        Err(format!("talk answered {status}"))
+                    }
+                });
+            let _ = tx.send(Msg::Talk { alias, text, result });
+        });
+    }
+}
+
+fn find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
+    haystack.windows(needle.len()).position(|window| window == needle)
+}
+
+fn dechunk(mut data: &[u8]) -> Vec<u8> {
+    let mut out = Vec::new();
+    while let Some(line_end) = find(data, b"\r\n") {
+        let size = std::str::from_utf8(&data[..line_end])
+            .ok()
+            .and_then(|line| usize::from_str_radix(line.split(';').next()?.trim(), 16).ok());
+        let Some(size) = size else { break };
+        data = &data[line_end + 2..];
+        if size == 0 || data.len() < size {
+            break;
+        }
+        out.extend_from_slice(&data[..size]);
+        data = data.get(size + 2..).unwrap_or(&[]);
+    }
+    out
+}
+
+fn parse_response(raw: &[u8]) -> Result<(u16, String), String> {
+    let split = find(raw, b"\r\n\r\n").ok_or("malformed HTTP response")?;
+    let head = String::from_utf8_lossy(&raw[..split]).to_lowercase();
+    let status = head
+        .lines()
+        .next()
+        .and_then(|line| line.split_whitespace().nth(1))
+        .and_then(|code| code.parse::<u16>().ok())
+        .ok_or("malformed HTTP status")?;
+    let body = &raw[split + 4..];
+    let body = if head.contains("transfer-encoding: chunked") {
+        dechunk(body)
+    } else {
+        body.to_vec()
+    };
+    Ok((status, String::from_utf8_lossy(&body).into_owned()))
+}
