new file mode 100644
index 0000000..1b0e503
--- /dev/null
+++ b/server/src/nemo/atlas/mod.rs
@@ -0,0 +1,373 @@
+//! The atlas on the Veloren side: travel to a place on NemoWorld's map.
+//!
+//! NemoWorld signs a `teleport` command naming a **place id** from the atlas file it exported, plus the
+//! first 16 hex of that file's manifest hash. This system, which only ever sees commands whose HMAC
+//! verified and which are unexpired and unclaimed (see [`NemoLinkState::poll_commands`]):
+//!
+//! * looks the place up in the atlas file the server was given — a file that names sites and plots, never
+//!   coordinates — and refuses a place or a manifest hash that is not in it (the rules are
+//!   `nemo_link_proto::atlas`, so NemoWorld's tests and the server agree on the shapes);
+//! * resolves each place to a position from **world generation** itself (`IndexOwned`), retrying on later
+//!   passes while the terrain around a site is still being generated, and writes what it resolved to
+//!   `<outbox>.atlas-resolved.json` so a human can read it;
+//! * moves only the player the command names, only if they are online, and only within the same 20-second
+//!   cooldown and global ceiling the proto defines;
+//! * acknowledges every command as `applied` or `rejected` with a reason; an unacknowledged command stays
+//!   "unconfirmed" in NemoWorld rather than "done".
+//!
+//! Nothing here grants, pays or persists anything: a teleport is a move, and the acknowledgement says only
+//! that the move was made. `atlas_look` and `atlas_mark` are part of the proto's vocabulary but are not
+//! implemented here, and NemoWorld does not issue them.
+
+use common::{
+    comp::{Player, Pos},
+    event::{EventBus, TeleportToPositionEvent},
+    resources::Time,
+    terrain::TerrainGrid,
+    vol::{FilledVox, ReadVol},
+};
+use common_ecs::{Job, Origin, Phase, System};
+use nemo_link_proto::atlas as proto;
+use specs::{Entities, Join, Read, ReadExpect, ReadStorage, Write};
+use std::{
+    collections::{HashMap, VecDeque},
+    fs,
+    path::PathBuf,
+    sync::Arc,
+};
+use tracing::{info, warn};
+use vek::{Vec2, Vec3};
+use world::{IndexOwned, World};
+
+/// How often the system looks for commands. Travel is a rare action.
+const EVERY: f64 = 0.5;
+
+/// The command kinds this system claims.
+const KINDS: [&str; 1] = ["teleport"];
+
+struct Config {
+    manifest_hash: String,
+    places: proto::AtlasFile,
+    outbox: PathBuf,
+}
+
+/// One place, resolved from world generation.
+#[derive(Debug, Clone, Copy)]
+struct Spot {
+    x: i32,
+    y: i32,
+    z: i32,
+}
+
+#[derive(Default)]
+pub struct AtlasState {
+    /// The config has been read (once).
+    loaded: bool,
+    last_run: f64,
+    /// The last time the missing places were looked for (they are retried, not resolved once).
+    last_resolve: f64,
+    cfg: Option<Config>,
+    /// place id -> resolved position; a place whose chunks are not loaded yet is retried next pass.
+    places: HashMap<String, Spot>,
+    names: HashMap<String, String>,
+    /// One line per place per reason, so a far place that stays unresolved does not fill the log.
+    reported: std::collections::HashSet<String>,
+    last_by_player: HashMap<String, f64>,
+    recent: VecDeque<f64>,
+}
+
+/// The atlas file the server reads: the link config's `atlas` section.
+fn load_config() -> Option<Config> {
+    let path = std::env::var("NEMO_LINK_CONFIG").ok()?;
+    load_config_from(&path)
+}
+
+/// The same, from a named file, so the tests can aim it at a config without touching the environment.
+fn load_config_from(path: &str) -> Option<Config> {
+    let value: serde_json::Value = serde_json::from_str(&fs::read_to_string(path).ok()?).ok()?;
+    let atlas = value.get("atlas")?;
+    if atlas.get("enabled").and_then(serde_json::Value::as_bool) == Some(false) {
+        return None;
+    }
+    let file = atlas.get("path").and_then(serde_json::Value::as_str)?;
+    let outbox = value.get("outbox").and_then(serde_json::Value::as_str)?;
+    let text = fs::read_to_string(file).ok()?;
+    let places = match proto::parse_atlas(&text) {
+        Ok(places) => places,
+        Err(why) => {
+            warn!("the atlas file at {file} is unusable: {why}");
+            return None;
+        },
+    };
+    Some(Config { manifest_hash: places.manifest_hash.clone(), places, outbox: PathBuf::from(outbox) })
+}
+
+/// Is the terrain around this cell generated? Sampling a chunk that is not loaded would read nonsense.
+fn chunk_loaded(terrain: &TerrainGrid, x: i32, y: i32) -> bool {
+    terrain.get_key_real(TerrainGrid::chunk_key(Vec2::new(x, y))).is_some()
+}
+
+/// The highest solid block near the world's own altitude estimate, as the home module does it.
+fn ground_z(terrain: &TerrainGrid, world: &World, x: i32, y: i32) -> Option<i32> {
+    let estimate = world.sim().get_alt_approx(Vec2::new(x, y))? as i32;
+    for z in ((estimate - 40)..=(estimate + 40)).rev() {
+        let Ok(block) = terrain.get(Vec3::new(x, y, z)) else { continue };
+        if block.is_filled() && !block.kind().is_liquid() {
+            return Some(z);
+        }
+    }
+    None
+}
+
+fn write_resolved(cfg: &Config, state: &AtlasState) {
+    let mut places: Vec<_> = state
+        .places
+        .iter()
+        .map(|(id, spot)| {
+            serde_json::json!({
+                "id": id,
+                "name": state.names.get(id).cloned().unwrap_or_default(),
+                "x": spot.x, "y": spot.y, "z": spot.z,
+            })
+        })
+        .collect();
+    places.sort_by(|a, b| a["id"].as_str().cmp(&b["id"].as_str()));
+    let body = serde_json::json!({
+        "format": "veloren-atlas-resolved-v1",
+        "manifest_hash": cfg.manifest_hash,
+        "places": places,
+    });
+    let path = PathBuf::from(format!("{}.atlas-resolved.json", cfg.outbox.display()));
+    if let Err(e) = fs::write(&path, serde_json::to_string_pretty(&body).unwrap_or_default()) {
+        warn!("could not write {}: {e}", path.display());
+    }
+}
+
+#[derive(Default)]
+pub struct Sys;
+
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Entities<'a>,
+        ReadStorage<'a, Pos>,
+        ReadStorage<'a, Player>,
+        Read<'a, Time>,
+        Write<'a, crate::sys::nemo_link::NemoLinkState>,
+        Write<'a, AtlasState>,
+        Read<'a, EventBus<TeleportToPositionEvent>>,
+        ReadExpect<'a, TerrainGrid>,
+        ReadExpect<'a, Arc<World>>,
+        ReadExpect<'a, IndexOwned>,
+    );
+
+    const NAME: &'static str = "nemo_atlas";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(
+        _job: &mut Job<Self>,
+        (entities, positions, players, time, mut link, mut state, teleports, terrain, world, index): Self::SystemData,
+    ) {
+        let now = time.0;
+        if !link.is_on() {
+            return;
+        }
+        if !state.loaded {
+            state.loaded = true;
+            state.cfg = load_config();
+            if let Some(cfg) = &state.cfg {
+                let hex = &cfg.manifest_hash[..16.min(cfg.manifest_hash.len())];
+                info!("the NemoWorld atlas is on: {} places, manifest {hex}", cfg.places.places.len());
+            }
+        }
+        // Take the config out while the places are filled in: `state` is mutated below, so it cannot be
+        // borrowed from `state.cfg` at the same time.
+        let Some(cfg) = state.cfg.take() else { return };
+
+        if state.places.len() < cfg.places.places.len() && now - state.last_resolve >= EVERY {
+            state.last_resolve = now;
+            let before = state.places.len();
+            let index = index.as_index_ref();
+            for place in &cfg.places.places {
+                if state.places.contains_key(&place.id) {
+                    continue;
+                }
+                let site = index.sites.values().find(|site| site.name() == Some(place.site.as_str()));
+                let cell = match (site, place.kind.as_str(), place.plot.as_deref()) {
+                    (Some(site), "site", _) => Some((site.origin.x as i32, site.origin.y as i32)),
+                    (Some(site), "plot", Some(plot_kind)) => {
+                        let mut plots: Vec<_> = site
+                            .plots()
+                            .filter(|plot| plot.kind().to_string() == plot_kind)
+                            .map(|plot| site.tile_center_wpos(plot.root_tile()))
+                            .collect();
+                        plots.sort_by_key(|wpos| (wpos - site.origin).magnitude_squared());
+                        plots.get(place.nth).map(|wpos| (wpos.x as i32, wpos.y as i32))
+                    },
+                    _ => None,
+                };
+                // One line per place per reason: a far place whose terrain nobody has generated would
+                // otherwise repeat itself every pass, for as long as the server runs.
+                let once = |state: &mut AtlasState, why: String, reason: &str| {
+                    if state.reported.insert(format!("{reason}:{}", place.id)) {
+                        why
+                    } else {
+                        String::new()
+                    }
+                };
+                match cell {
+                    Some((x, y)) if chunk_loaded(&terrain, x, y) => match ground_z(&terrain, world.as_ref(), x, y) {
+                        Some(z) => {
+                            state.places.insert(place.id.clone(), Spot { x, y, z });
+                            state.names.insert(place.id.clone(), place.name.clone());
+                            info!("atlas place {} ('{}') is at ({x}, {y}, {z})", place.id, place.name);
+                        },
+                        None => {
+                            let line = once(&mut state, format!("atlas place {} has no ground at ({x}, {y}) yet", place.id), "noground");
+                            if !line.is_empty() {
+                                warn!("{line}");
+                            }
+                        },
+                    },
+                    Some((x, y)) => {
+                        let line = once(&mut state, format!("atlas place {} waits for the terrain around ({x}, {y})", place.id), "waiting");
+                        if !line.is_empty() {
+                            info!("{line}");
+                        }
+                    },
+                    None => {
+                        let line = once(&mut state, format!("atlas place {} ('{}') names no site or plot this world has", place.id, place.name), "missing");
+                        if !line.is_empty() {
+                            warn!("{line}");
+                        }
+                    },
+                }
+            }
+            // The file a human reads is written whenever the set of resolved places grows, not only when
+            // every place is resolved — a place far from any generated terrain may never be.
+            if state.places.len() > before {
+                info!("{} of {} atlas places resolved", state.places.len(), cfg.places.places.len());
+                write_resolved(&cfg, &state);
+            }
+        }
+
+        if now - state.last_run >= EVERY {
+            state.last_run = now;
+            // The proto's own bounds: a per-player cooldown and a ceiling for the whole server.
+            while state.recent.front().is_some_and(|at| now - at >= proto::GLOBAL_WINDOW_SECS) {
+                state.recent.pop_front();
+            }
+            for (index_in_pass, command) in link.poll_commands(&KINDS).iter().enumerate() {
+                if index_in_pass >= proto::MAX_COMMANDS_PER_PASS {
+                    link.ack(command, false, "too_many_commands");
+                    continue;
+                }
+                let place_id = match proto::parse_teleport_args(&command.args, &cfg.manifest_hash) {
+                    Ok(id) => id,
+                    Err(reason) => {
+                        link.ack(command, false, reason);
+                        continue;
+                    },
+                };
+                let Some(spot) = state.places.get(&place_id).copied() else {
+                    link.ack(command, false, "place_not_in_atlas");
+                    continue;
+                };
+                if state
+                    .last_by_player
+                    .get(&command.player_uuid)
+                    .is_some_and(|last| now - last < proto::TELEPORT_COOLDOWN_SECS)
+                {
+                    link.ack(command, false, "cooldown");
+                    continue;
+                }
+                if state.recent.len() >= proto::GLOBAL_MAX_TELEPORTS {
+                    link.ack(command, false, "server_travel_limit");
+                    continue;
+                }
+                // The one player the (signed) command names, online.
+                let target = (&entities, &positions, &players)
+                    .join()
+                    .find(|(_, _, player)| player.uuid().to_string() == command.player_uuid)
+                    .map(|(entity, _, _)| entity);
+                let Some(entity) = target else {
+                    link.ack(command, false, "player_not_online");
+                    continue;
+                };
+                let to = Vec3::new(spot.x as f32 + 0.5, spot.y as f32 + 0.5, spot.z as f32 + 1.2);
+                teleports.emitter().emit(TeleportToPositionEvent { entity, position: to });
+                state.last_by_player.insert(command.player_uuid.clone(), now);
+                state.recent.push_back(now);
+                info!(place = %place_id, player = %command.player_uuid, "NemoWorld travel");
+                link.ack(command, true, "travelled");
+            }
+        }
+        state.cfg = Some(cfg);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_travel_is_claimed() {
+        assert_eq!(KINDS, ["teleport"]);
+    }
+
+    #[test]
+    fn the_bounds_are_the_proto_s_own() {
+        // This system must not invent its own policy: these are the numbers NemoWorld is told about.
+        assert!(proto::TELEPORT_COOLDOWN_SECS > 0.0);
+        assert!(proto::GLOBAL_MAX_TELEPORTS > 0);
+        assert!(proto::GLOBAL_WINDOW_SECS > 0.0);
+        assert!(proto::MAX_COMMANDS_PER_PASS > 0);
+    }
+
+    #[test]
+    fn a_config_without_an_atlas_section_is_off() {
+        let dir = std::env::temp_dir();
+        let no_section = dir.join("atlas-test-no-section.json");
+        fs::write(&no_section, r#"{"format":"localhost-local-v1","outbox":"/tmp/atlas-test"}"#)
+            .expect("a writable temp dir");
+        assert!(load_config_from(no_section.to_str().unwrap()).is_none());
+
+        let disabled = dir.join("atlas-test-disabled.json");
+        fs::write(
+            &disabled,
+            r#"{"outbox":"/tmp/atlas-test","atlas":{"enabled":false,"path":"/nonexistent/atlas.json"}}"#,
+        )
+        .expect("a writable temp dir");
+        assert!(load_config_from(disabled.to_str().unwrap()).is_none());
+
+        assert!(load_config_from("/nonexistent/veloren-link.json").is_none());
+
+        let _ = fs::remove_file(no_section);
+        let _ = fs::remove_file(disabled);
+    }
+
+    #[test]
+    fn the_resolved_file_names_every_place_it_found() {
+        let state = AtlasState::default();
+        let cfg = Config {
+            manifest_hash: "a".repeat(64),
+            places: proto::parse_atlas(
+                &serde_json::json!({
+                    "format": "veloren-atlas-server-v1",
+                    "manifest_hash": "a".repeat(64),
+                    "world_seed": 7,
+                    "places": [{"id": "commons", "name": "The Commons", "short": "Arrival.", "kind": "site", "site": "Harr", "arrive_radius": 12}]
+                })
+                .to_string(),
+            )
+            .expect("a valid atlas"),
+            outbox: std::env::temp_dir().join("atlas-test-outbox"),
+        };
+        write_resolved(&cfg, &state);
+        let path = std::env::temp_dir().join("atlas-test-outbox.atlas-resolved.json");
+        let text = fs::read_to_string(&path).expect("the resolved file");
+        assert!(text.contains("veloren-atlas-resolved-v1"));
+        assert!(text.contains(&"a".repeat(64)));
+        let _ = fs::remove_file(path);
+    }
+}
diff --git a/server/src/nemo/pantry/mod.rs b/server/src/nemo/pantry/mod.rs
new file mode 100644
index 0000000..92563d1
--- /dev/null
+++ b/server/src/nemo/pantry/mod.rs
@@ -0,0 +1,325 @@
+//! NemoWorld's shared pantry: plain food that anyone in Harr may take, never scarce for long, never earned.
+//!
+//! NemoWorld keeps the stock, the daily limit and the history; this system only does the one thing the
+//! game server must do: put a small, allow-listed amount of food into the bag of one online, linked-by-uuid
+//! player, once, and say so with a signed acknowledgement.
+//!
+//! The `pantry_give` command arrives already verified by `NemoLinkState` (HMAC, not expired, claimed once).
+//! Here: the arguments are strict (`order`, `item`, `qty`), the item is chosen by the server from a compiled-in
+//! allow-list by key, the quantity must equal the list's, the whole gift must fit the bag (tried on a copy first,
+//! so a full bag gets nothing), and one order is delivered at most once (written down before it is given).
+//! Nothing here reads chat. Nothing here can give anything that is not on the list.
+
+use crate::sys::nemo_link::{Command, NemoLinkState};
+use common::{
+    comp::{Inventory, InventoryUpdateBuffer, InventoryUpdateEvent, Item, Player},
+    resources::Time,
+};
+use common_ecs::{Job, Origin, Phase, System};
+use serde::Deserialize;
+use specs::{Entities, Join, Read, ReadStorage, Write, WriteStorage};
+use std::{
+    collections::HashSet,
+    fs::{self, File, OpenOptions},
+    io::Write as _,
+    sync::OnceLock,
+};
+use tracing::{info, warn};
+
+pub const MANIFEST_JSON: &str = include_str!("pantry.json");
+const HARD_MAX_QTY: u32 = 3;
+const MAX_ARGS_BYTES: usize = 200;
+const MAX_PER_PASS: usize = 8;
+
+#[derive(Debug, Deserialize)]
+struct ManifestFile {
+    format: String,
+    max_qty: u32,
+    items: Vec<Entry>,
+}
+
+#[derive(Debug, Deserialize, Clone, PartialEq, Eq)]
+pub struct Entry {
+    pub key: String,
+    pub item: String,
+    pub qty: u32,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Args {
+    order: String,
+    item: String,
+    qty: u32,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum Reject {
+    BadArgs,
+    UnknownItem,
+    QuantityMismatch,
+    AlreadyDelivered,
+    PlayerNotOnline,
+    NoInventory,
+    InventoryFull,
+    ItemUnavailable,
+    Busy,
+}
+
+impl Reject {
+    pub fn reason(&self) -> &'static str {
+        match self {
+            Reject::BadArgs => "bad_args",
+            Reject::UnknownItem => "unknown_item",
+            Reject::QuantityMismatch => "quantity_mismatch",
+            Reject::AlreadyDelivered => "already_delivered",
+            Reject::PlayerNotOnline => "player_not_online",
+            Reject::NoInventory => "no_inventory",
+            Reject::InventoryFull => "inventory_full",
+            Reject::ItemUnavailable => "item_unavailable",
+            Reject::Busy => "busy",
+        }
+    }
+}
+
+pub fn parse_manifest(text: &str) -> Result<Vec<Entry>, String> {
+    let file: ManifestFile = serde_json::from_str(text).map_err(|e| e.to_string())?;
+    if file.format != "nemo-pantry-manifest-v1" {
+        return Err("unsupported pantry manifest format".into());
+    }
+    if file.max_qty == 0 || file.max_qty > HARD_MAX_QTY {
+        return Err("max_qty out of range".into());
+    }
+    for entry in &file.items {
+        if entry.qty == 0 || entry.qty > file.max_qty {
+            return Err(format!("quantity of {} out of range", entry.key));
+        }
+        if !entry.item.starts_with("common.items.food.") {
+            return Err(format!("{} is not food", entry.key));
+        }
+    }
+    Ok(file.items)
+}
+
+fn manifest() -> &'static [Entry] {
+    static M: OnceLock<Vec<Entry>> = OnceLock::new();
+    M.get_or_init(|| parse_manifest(MANIFEST_JSON).expect("the pantry manifest compiled into the server is valid"))
+}
+
+fn is_uuid(text: &str) -> bool {
+    let b = text.as_bytes();
+    b.len() == 36
+        && b.iter().enumerate().all(|(i, c)| match i {
+            8 | 13 | 18 | 23 => *c == b'-',
+            _ => matches!(c, b'0'..=b'9' | b'a'..=b'f'),
+        })
+}
+
+/// Decide what a command may do, without touching the game. Pure.
+pub fn plan<'m>(entries: &'m [Entry], args_text: &str, delivered: &HashSet<String>) -> Result<(&'m Entry, String), Reject> {
+    if args_text.len() > MAX_ARGS_BYTES {
+        return Err(Reject::BadArgs);
+    }
+    let args: Args = serde_json::from_str(args_text).map_err(|_| Reject::BadArgs)?;
+    if !is_uuid(&args.order) {
+        return Err(Reject::BadArgs);
+    }
+    let entry = entries.iter().find(|e| e.key == args.item).ok_or(Reject::UnknownItem)?;
+    if args.qty != entry.qty {
+        return Err(Reject::QuantityMismatch);
+    }
+    if delivered.contains(&args.order) {
+        return Err(Reject::AlreadyDelivered);
+    }
+    Ok((entry, args.order))
+}
+
+fn items_for(entry: &Entry) -> Result<Vec<Item>, Reject> {
+    let mut first = Item::new_from_asset(&entry.item).map_err(|_| Reject::ItemUnavailable)?;
+    if first.is_stackable() {
+        first.set_amount(entry.qty).map_err(|_| Reject::ItemUnavailable)?;
+        Ok(vec![first])
+    } else {
+        let mut items = vec![first];
+        for _ in 1..entry.qty {
+            items.push(Item::new_from_asset(&entry.item).map_err(|_| Reject::ItemUnavailable)?);
+        }
+        Ok(items)
+    }
+}
+
+fn fits(inventory: &Inventory, items: Vec<Item>) -> bool {
+    let mut copy = inventory.clone();
+    items.into_iter().all(|item| copy.push(item).is_ok())
+}
+
+#[derive(Default)]
+pub struct Sys {
+    loaded: bool,
+    last_run: f64,
+    delivered: HashSet<String>,
+    file: Option<File>,
+}
+
+impl Sys {
+    fn load(&mut self, path: &str) {
+        self.delivered = fs::read_to_string(path).unwrap_or_default().lines().filter(|l| is_uuid(l)).map(str::to_owned).collect();
+        self.file = match OpenOptions::new().create(true).append(true).open(path) {
+            Ok(file) => Some(file),
+            Err(e) => {
+                warn!("cannot open {path}: {e}; pantry gifts will be refused");
+                None
+            },
+        };
+        info!(delivered = self.delivered.len(), "NemoWorld pantry is on");
+    }
+
+    fn record(&mut self, order: &str) -> bool {
+        let Some(file) = self.file.as_mut() else { return false };
+        if file.write_all(format!("{order}\n").as_bytes()).and_then(|()| file.flush()).is_err() {
+            return false;
+        }
+        self.delivered.insert(order.to_owned());
+        true
+    }
+}
+
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Entities<'a>,
+        ReadStorage<'a, Player>,
+        WriteStorage<'a, Inventory>,
+        WriteStorage<'a, InventoryUpdateBuffer>,
+        Read<'a, Time>,
+        Write<'a, NemoLinkState>,
+    );
+
+    const NAME: &'static str = "nemo_pantry";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(job: &mut Job<Self>, (entities, players, mut inventories, mut buffers, time, mut link): Self::SystemData) {
+        if !link.is_on() {
+            return;
+        }
+        let me = &mut job.own;
+        if time.0 - me.last_run < 0.5 {
+            return;
+        }
+        me.last_run = time.0;
+        if !me.loaded {
+            me.loaded = true;
+            if let Some(path) = link.sidecar_path("pantry-delivered") {
+                me.load(&path);
+            }
+        }
+        let commands = link.poll_commands(&["pantry_give"]);
+        for (index, command) in commands.iter().enumerate() {
+            let outcome = if index >= MAX_PER_PASS {
+                Err(Reject::Busy)
+            } else {
+                give(command, &entities, &players, &mut inventories, &mut buffers, me)
+            };
+            match outcome {
+                Ok(note) => {
+                    info!(cmd_id = %command.cmd_id, note, "pantry gift applied");
+                    link.ack(command, true, note);
+                },
+                Err(reject) => {
+                    warn!(cmd_id = %command.cmd_id, reason = reject.reason(), "pantry gift refused");
+                    link.ack(command, false, reject.reason());
+                },
+            }
+        }
+    }
+}
+
+fn give(
+    command: &Command,
+    entities: &Entities,
+    players: &ReadStorage<Player>,
+    inventories: &mut WriteStorage<Inventory>,
+    buffers: &mut WriteStorage<InventoryUpdateBuffer>,
+    me: &mut Sys,
+) -> Result<&'static str, Reject> {
+    let (entry, order) = plan(manifest(), &command.args, &me.delivered)?;
+    let entity = (entities, players)
+        .join()
+        .find(|(_, p)| p.uuid().to_string() == command.player_uuid)
+        .map(|(e, _)| e)
+        .ok_or(Reject::PlayerNotOnline)?;
+    let inventory = inventories.get(entity).ok_or(Reject::NoInventory)?;
+    if !fits(inventory, items_for(entry)?) {
+        return Err(Reject::InventoryFull);
+    }
+    let items = items_for(entry)?;
+    // Written down BEFORE the food changes hands: a crash can leave a gift unconfirmed, never doubled.
+    if !me.record(&order) {
+        return Err(Reject::Busy);
+    }
+    let mut inventory = inventories.get_mut(entity).ok_or(Reject::NoInventory)?;
+    for item in items {
+        if inventory.push(item).is_err() {
+            warn!(%order, "inventory changed during a pantry gift; the order is recorded as delivered");
+        }
+    }
+    if let Some(buffer) = buffers.get_mut(entity) {
+        buffer.push(InventoryUpdateEvent::Given);
+    }
+    Ok("delivered")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ORDER: &str = "0a1b2c3d-0000-4000-8000-000000000001";
+    fn args(item: &str, qty: u32) -> String { format!(r#"{{"order":"{ORDER}","item":"{item}","qty":{qty}}}"#) }
+
+    #[test]
+    fn the_compiled_list_is_valid_plain_food_in_small_amounts() {
+        let list = parse_manifest(MANIFEST_JSON).unwrap();
+        assert_eq!(list.len(), 4);
+        assert!(list.iter().all(|e| e.item.starts_with("common.items.food.") && e.qty <= 3));
+    }
+
+    /// Pinned together with NemoWorld's `tests/veloren-pantry.test.js`.
+    #[test]
+    fn the_list_is_pinned_with_nemoworld() {
+        let mut parts: Vec<String> = manifest().iter().map(|e| format!("{}={}*{}", e.key, e.item, e.qty)).collect();
+        parts.sort();
+        assert_eq!(
+            parts.join(";"),
+            "apple=common.items.food.apple*2;carrot=common.items.food.carrot*2;cheese=common.items.food.cheese*1;lettuce=common.items.food.lettuce*2"
+        );
+    }
+
+    #[test]
+    fn only_listed_food_in_the_listed_amount_once() {
+        let list = manifest();
+        let none = HashSet::new();
+        assert_eq!(plan(list, &args("apple", 2), &none).unwrap().0.item, "common.items.food.apple");
+        assert_eq!(plan(list, &args("sword", 1), &none).unwrap_err(), Reject::UnknownItem);
+        assert_eq!(plan(list, &args("apple", 3), &none).unwrap_err(), Reject::QuantityMismatch);
+        assert_eq!(plan(list, &args("apple", 200), &none).unwrap_err(), Reject::QuantityMismatch);
+        let mut seen = HashSet::new();
+        seen.insert(ORDER.to_owned());
+        assert_eq!(plan(list, &args("apple", 2), &seen).unwrap_err(), Reject::AlreadyDelivered);
+    }
+
+    #[test]
+    fn strange_arguments_are_refused() {
+        let list = manifest();
+        let none = HashSet::new();
+        for bad in [
+            "{}".to_owned(),
+            "not json".to_owned(),
+            format!(r#"{{"order":"{ORDER}","item":"apple","qty":2,"extra":1}}"#),
+            r#"{"order":"nope","item":"apple","qty":2}"#.to_owned(),
+            r#"{"order":"0A1B2C3D-0000-4000-8000-000000000001","item":"apple","qty":2}"#.to_owned(),
+            "x".repeat(500),
+        ] {
+            assert_eq!(plan(list, &bad, &none).unwrap_err(), Reject::BadArgs, "{bad}");
+        }
+    }
+}
