+//! Bounded native terrain projection for NemoWorld's authored public city paths.
+//! Building interiors keep their flat floor. Paths replace the natural surface per column.
+use std::collections::{BTreeMap,BTreeSet};
+use crate::manifest::{Planned,MIN_DZ,MAX_DZ};
+pub const MAX_GRADE: i32 = 12;
+/// The saved base is a terrain datum, not the highest roof at a later restart.
+pub fn saved_ground(anchor:(i32,i32),saved_anchor:[i32;2],ground:i32,estimate:i32)->Option<i32> {
+    (saved_anchor == [anchor.0,anchor.1] && (i64::from(ground)-i64::from(estimate)).abs()<=40).then_some(ground)
+}
+pub fn is_city_surface(id: &str) -> bool {
+    id.starts_with("city-approach-") || id.starts_with("city-avenue-") ||
+    matches!(id,"city-crossing"|"city-home-promenade"|"city-home-promenade-east"|"city-build-yard"|"city-park-garden") ||
+    ["city-office-path","city-school-path","city-university-path","city-farm-path","city-home-1-path","city-home-2-path","city-home-3-path","city-home-4-path"].contains(&id)
+}
+pub fn columns(plan:&Planned)->BTreeSet<(i32,i32)> {
+    plan.expanded.pieces.keys().map(|p|(p[0],p[1])).collect()
+}
+pub fn project(plan:&Planned, levels:&[[i32;3]])->Result<Planned,String> {
+    if !is_city_surface(&plan.id) { return Err("not an authored city surface".into()); }
+    let expected=columns(plan);
+    if levels.len()!=expected.len() || levels.len()>6000 { return Err("surface column count mismatch".into()); }
+    let mut heights=BTreeMap::new();
+    for &[x,y,dz] in levels {
+        if !(-MAX_GRADE..=MAX_GRADE).contains(&dz) || !expected.contains(&(x,y)) || heights.insert((x,y),dz).is_some() { return Err("invalid surface level".into()); }
+    }
+    let mut result=plan.clone(); result.expanded.pieces.clear();
+    for (point,piece) in &plan.expanded.pieces {
+        let z=point[2]+heights[&(point[0],point[1])];
+        if !(MIN_DZ..=MAX_DZ).contains(&z) { return Err("projected surface outside height bound".into()); }
+        result.expanded.pieces.insert([point[0],point[1],z],piece.clone());
+    }
+    // Each pavement tile rests on the sampled natural solid ground; no suspended flat foundation.
+    result.expanded.foundation.clear();
+    Ok(result)
+}
+#[cfg(test)] mod tests {
+    use super::*;use crate::manifest::{Expanded,Piece};
+    fn road()->Planned{Planned{id:"city-approach-1".into(),anchor:(1,2),ground_at:(1,2),expanded:Expanded{pieces:[([0,0,0],Piece::Block{kind:"Rock".into(),rgb:[1,2,3]}),([0,0,1],Piece::Air),([1,0,0],Piece::Block{kind:"Rock".into(),rgb:[1,2,3]})].into(),foundation:vec![]}}}
+    #[test]fn saved_base_survives_roofs_but_not_relocation_or_absurd_heights(){assert_eq!(saved_ground((1,2),[1,2],410,414),Some(410));assert_eq!(saved_ground((2,2),[1,2],410,414),None);assert_eq!(saved_ground((1,2),[1,2],i32::MIN,414),None);}
+    #[test]fn projects_actual_grade_without_growing_footprint_or_cell_count(){let p=road();let r=project(&p,&[[0,0,0],[1,0,1]]).unwrap();assert!(r.expanded.pieces.contains_key(&[1,0,1]));assert_eq!(r.expanded.pieces.len(),p.expanded.pieces.len());assert_eq!(columns(&r),columns(&p));assert!(p.expanded.pieces.contains_key(&[1,0,0]));}
+    #[test]fn refuses_missing_duplicate_excessive_or_nonroad_projection(){let p=road();for levels in [vec![[0,0,0]],vec![[0,0,0],[0,0,0]],vec![[0,0,0],[1,0,13]],vec![[0,0,0],[2,0,1]]]{assert!(project(&p,&levels).is_err());}let mut p=p;p.id="city-office-complete".into();assert!(project(&p,&[[0,0,0],[1,0,1]]).is_err());}
+    #[test]fn serialized_levels_recreate_same_plan_after_restart(){let levels=vec![[0,0,-2],[1,0,1]];let restored:Vec<[i32;3]>=serde_json::from_str(&serde_json::to_string(&levels).unwrap()).unwrap();assert_eq!(project(&road(),&levels).unwrap().expanded,project(&road(),&restored).unwrap().expanded);}
+}
