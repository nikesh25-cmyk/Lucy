+        assert_eq!(limits.check(id, t0), Verdict::Allow);
+        assert_eq!(limits.check(id, t0 + Duration::from_secs(1)), Verdict::Drop, "inside the gap");
+        let mut now = t0;
+        let mut allowed = 1;
+        let mut warned = 0;
+        for _ in 0..19 {
+            now += Duration::from_secs(3);
