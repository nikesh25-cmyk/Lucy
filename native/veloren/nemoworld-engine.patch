+/// SCRIPTED local reply, used only when NemoWorld cannot be reached.
+fn reply_for(resident: &Resident, text: &str, label: &str, rng: &mut Rng) -> String {
+    let text = text.to_lowercase();
+    let has = |words: &[&str]| words.iter().any(|w| text.contains(w));
+    if has(&["who", "what do you do", "calling", "role", "job"]) {
+        format!("I am {}, {}. {}", resident.name, resident.calling, resident.capabilities)
+    } else if has(&["limit", "cannot", "can't", "unable"]) {
+        resident.limitations.clone()
+    } else if has(&["where"]) {
+        format!("At this hour you will find me at the {label}.")
+    } else {
+        rng.pick(&resident.barks)
+            .cloned()
+            .unwrap_or_else(|| resident.capabilities.clone())
+    }
+}
