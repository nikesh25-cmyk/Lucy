@@ -0,0 +1,34 @@
+//! `nemo-world-check <manifest.json>`: validate a world manifest with exactly the rules the Veloren
+//! server applies (everything except resolving anchors in a real world). Exit 0 = valid.
+//! Prints one line per problem, then a summary. Used by NemoWorld's tests to cross-check its own validator.
+
+use nemo_world_core::manifest::Manifest;
+
+fn main() {
+    let Some(path) = std::env::args().nth(1) else {
+        eprintln!("usage: nemo-world-check <manifest.json>");
+        std::process::exit(2);
+    };
+    let text = match std::fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(e) => {
+            eprintln!("cannot read {path}: {e}");
+            std::process::exit(2);
+        },
+    };
+    match Manifest::parse(&text) {
+        Ok(manifest) => {
+            let s = manifest.summary();
+            println!(
+                "OK groups={} blocks={} sprites={} lit_sprites={} foundation_columns={}",
+                s.groups, s.blocks, s.sprites, s.lit_sprites, s.foundation_columns
+            );
+        },
+        Err(errors) => {
+            for e in errors {
+                println!("REJECTED {e}");
+            }
+            std::process::exit(1);
+        },
+    }
+}
