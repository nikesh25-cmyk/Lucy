+//! Runs one NemoWorld resident as a character on a Veloren server.
+//!
+//! The resident's identity, schedule and lines come from `roster.json` (exported from NemoWorld's
+//! `LIVING_ROSTER`). Where she stands comes from `landmarks.json`: real named Veloren sites. With
+//! `--nemo-url` the bridge also asks a local NemoWorld where she should go (`director`) and lets
+//! NemoWorld answer players who speak to her (`talk`, bounded, with a scripted fallback). Without it
+//! she runs fully scripted.
+//!
+//! Dialogue convention: replies generated by NemoWorld's model are prefixed `[AI]`. Everything else
+//! she says is scripted. The bridge never decides quest progress; NemoWorld derives that from signed
+//! server events.
+//!
+//! The link credential is read from `NEMO_LINK_TOKEN`, never from arguments. The server must run
+//! without auth (`veloren-server-cli --no-auth`), so keep it on localhost.
+//!
+//! Usage: nemo-bridge [--server host:port] [--resident lw-lyra] [--roster path] [--landmarks path]
+//!                    [--nemo-url http://127.0.0.1:3100] [--phase dawn|day|dusk|night]
+//!        nemo-bridge --probe NAME [--quest]    stand-in human player for tests (exit 0 = PASS)
+//!        nemo-bridge --list-sites              print the named sites this world has
+
+mod chat_link;
+mod chat_shop;
+mod chat_hud;
+mod chat_home;
+mod chat_atlas;
+mod nemo;
+
+use common::{
+    ViewDistances,
+    clock::Clock,
+    comp::{self, InputKind},
+    path::{Chaser, TraversalConfig},
+    resources::Time,
+    terrain::{BlockKind, TerrainGrid, sprite::{Category, SpriteKind}},
+    time::DayPeriod,
+    util::Dir,
+    vol::ReadVol,
+};
+use common_net::sync::WorldSyncExt;
+use nemo::{Director, Msg, Nemo};
+use serde::Deserialize;
+use std::{
+    collections::{HashMap, VecDeque},
+    fs,
+    sync::{Arc, mpsc},
+    thread,
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+use tokio::runtime::Runtime;
+use tracing::{info, warn};
+use vek::{Vec2, Vec3};
+use veloren_client::{
+    Client, ClientType, Credentials, Event, StaticCredentialProvider, addr::ConnectionArgs,
+};
+
+const TPS: f64 = 30.0;
+const MIN_TPS: f64 = 4.0;
+const MAX_TPS: f64 = 60.0;
+const BARK_INTERVAL_SECS: (u64, u64) = (60, 120);
+const REPLY_COOLDOWN: Duration = Duration::from_secs(4);
+const SAY_GAP: Duration = Duration::from_millis(2500);
+const DIRECTOR_EVERY: Duration = Duration::from_secs(2);
+const STATUS_EVERY: Duration = Duration::from_secs(5);
+const PROBE_GAP: Duration = Duration::from_secs(7);
+const PROBE_DEADLINE: Duration = Duration::from_secs(120);
+const QUEST_DEADLINE: Duration = Duration::from_secs(15 * 60);
+const RECONNECT_MIN: Duration = Duration::from_secs(2);
+const RECONNECT_MAX: Duration = Duration::from_secs(30);
+/// At a works site, how often a resident changes pose, and how long it stands before the next one.
+const POSE_EVERY_SECS: (u64, u64) = (4, 7);
+
+/// One peaceful pose a resident can hold while it works. Deliberately no `Wield`: a resident never
+/// draws a weapon, and no role animation may look like combat.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Pose {
+    /// Crouched low over the work: the closest the game has to a builder's stance.
+    Crouch,
+    /// Sitting: a scholar or keeper reading and noting.
+    Sit,
+    /// Standing up between actions.
+    Stand,
+    /// A few steps of a working dance, for hosts and mediators.
+    Dance,
+}
+
+/// The pose cycle for a calling, or an empty slice for roles whose work is walking itself.
+fn role_poses(calling: &str) -> &'static [Pose] {
+    match calling {
+        "builder" | "artisan" => &[Pose::Crouch, Pose::Stand, Pose::Crouch, Pose::Stand],
+        "researcher" | "scholar" | "keeper" => &[Pose::Sit, Pose::Stand, Pose::Sit],
+        "host" | "mediator" | "steward" => &[Pose::Dance, Pose::Stand],
+        _ => &[],
+    }
+}
+
+/// One short, role-true greeting, said once to a person the first time the resident sees them in a
+/// calendar day. Scripted, never a model. todo-words: the `words` stream may replace these.
+fn role_greetings(calling: &str) -> &'static [&'static str] {
+    match calling {
+        "builder" => &[
+            "Welcome. The next stage is waiting for its crew; stand with us a moment if you like.",
+            "Good to see a new face. There is always a beam to lift.",
+        ],
+        "artisan" => &[
+            "Welcome to Harr. If you need a bench to sit on, I know exactly which one is finished.",
+            "Hello. The joinery is coming along; have a look whenever you wish.",
+        ],
+        "cultivator" => &[
+            "Welcome. The beds are open and there is enough to share.",
+            "Hello. Mind the rows, and take what the field gives.",
+        ],
+        "researcher" | "scholar" => &[
+            "Welcome. Every find adds a page to the library, if you would share it.",
+            "Hello. The notes are open on the table; curiosity is always in season.",
+        ],
+        "keeper" => &[
+            "Welcome. The library is open, and nothing learned here is kept from you.",
+            "Hello. Ask me where anything is, and I will walk you to it.",
+        ],
+        "host" | "mediator" => &[
+            "Welcome. There is a place set for you; sit wherever you like.",
+            "Hello. You are expected, in the best sense.",
+        ],
+        "steward" => &[
+            "Welcome. The stores are shared; what we have, you may use.",
+            "Hello. If something is missing, I will help you find it.",
+        ],
+        "explorer" => &[
+            "Welcome. The far paths are best walked with company.",
+            "Hello. I have been to the quiet places; ask me and I will point the way.",
+        ],
+        _ => &["Welcome to Harr.", "Hello, traveller."],
+    }
+}
