+//! Account linking in chat: "link my account", "unlink", "who am I".
+//!
+//! The player stays in control and nothing is trusted from the text:
+//!
+//! * WHO is asking comes from the server's own player list (the uuid of the speaker's account), never
+//!   from words in the message.
+//! * The one-time code comes from NemoWorld (link credential, `director` scope) and is delivered with
+//!   Veloren's private `/tell`, never in public chat. It is never written to a log: it exists only inside
+//!   [`Outgoing`], whose `Debug` prints no text, and in the one `send_command` call that delivers it.
+//! * `/tell` also switches the sender's chat mode to "tell that player", so every delivery is followed by
+//!   `/say` with no text, which puts Lyra back into public speech. Without it her next public line would
+//!   go privately to the last person she wrote to.
+//! * The target of a tell is looked up again from the live player list by uuid at the moment of sending
+//!   and passed as a single argument, so a player name can neither redirect the message to somebody else
+//!   nor add words to the command.
+//! * A code that somebody speaks in chat is reported to NemoWorld, which cancels it, and it is replaced
+//!   by `[code]` in everything the rest of the bridge sees (logs, the model prompt).
+//!
+//! NemoWorld decides everything else (single use, 10 minutes, rate limits, who may redeem). This file is
+//! a courier.
+
+use crate::nemo::Nemo;
+use serde_json::{Value, json};
+use std::{
+    collections::{HashMap, VecDeque},
+    fmt,
+    sync::mpsc::{self, Receiver, Sender},
+    thread,
+    time::{Duration, Instant},
+};
+use tracing::{info, warn};
+use veloren_client::Client;
+
+/// A player may ask for a code this often (NemoWorld enforces its own, stricter limits).
+const ASK_GAP: Duration = Duration::from_secs(4);
+const MAX_IN_FLIGHT: usize = 6;
+const NOTICES_EVERY: Duration = Duration::from_secs(3);
+/// A private message for someone who is not online yet is kept this long, then dropped.
+const KEEP_UNDELIVERED: Duration = Duration::from_secs(120);
+/// Veloren refuses chat longer than 256 bytes.
+const MAX_TELL_BYTES: usize = 240;
+const MAX_REPORTS_PER_MESSAGE: usize = 2;
+const CODE_ALPHABET: &str = "23456789ABCDEFGHJKMNPQRSTVWXYZ";
+pub const PAGE_PATH: &str = "/veloren-link";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Intent {
+    Link,
+    Unlink,
+    WhoAmI,
+}
+
+/// A private message waiting to be sent. Its text can hold a code, so it is never printed.
+pub struct Outgoing {
+    uuid: String,
+    text: String,
+}
+
+impl fmt::Debug for Outgoing {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "Outgoing {{ to: {}, text: <{} bytes withheld> }}", self.uuid, self.text.len())
+    }
+}
+
+struct Notice {
+    uuid: String,
+    kind: String,
+    display_name: String,
+}
+
+enum Back {
+    Tell(Outgoing),
+    Notices(Result<Vec<Notice>, String>),
+}
+
+// ---- pure helpers (unit tested below) -------------------------------------------------------------
+
+fn words(text: &str) -> Vec<String> {
+    text.to_lowercase()
+        .split(|c: char| !(c.is_alphanumeric() || c == '\''))
+        .filter(|w| !w.is_empty())
+        .map(|w| w.replace('\'', ""))
+        .collect()
+}
+
+const FILLER: &[&str] = &[
+    "hey", "hi", "hello", "please", "pls", "can", "could", "would", "you", "i", "want", "like",
+    "need", "to", "kindly", "thanks", "thank", "now", "just", "will", "lets", "let", "us",
+];
+
+/// What the player is asking for, if it is exactly one of the three requests. The request has to be
+/// the whole message (apart from greetings and politeness), so "I do not want to link my account" or
+/// "how do I unlink" never triggers anything. In public chat the message must also name the resident;
+/// a private `/tell` to her needs no name.
+pub fn parse_intent(text: &str, name: &str, private_to_me: bool) -> Option<Intent> {
+    let name = name.to_lowercase();
+    let all = words(text);
+    if all.is_empty() || all.len() > 12 {
+        return None;
+    }
+    let addressed = private_to_me || all.iter().any(|w| *w == name);
+    if !addressed {
+        return None;
+    }
+    let core: Vec<&str> = all
+        .iter()
+        .map(String::as_str)
+        .filter(|w| *w != name && !FILLER.contains(w))
+        .collect();
+    match core.join(" ").as_str() {
+        "link my account" | "link account" | "link my nemoworld account" | "link nemoworld"
+        | "link my nemoworld" | "link me" | "link my veloren account" | "link my character"
+        | "link my identity" | "link" => Some(Intent::Link),
+        "unlink" | "unlink my account" | "unlink account" | "unlink me" | "unlink my nemoworld account"
+        | "unlink nemoworld" | "unlink my character" | "unlink my identity" => Some(Intent::Unlink),
+        "who am" | "whoami" | "who am linked as" | "am linked" | "check my link" | "link status"
+        | "my link" | "who am linked" => Some(Intent::WhoAmI),
+        _ => None,
+    }
+}
+
+fn in_alphabet(c: char) -> bool { CODE_ALPHABET.contains(c.to_ascii_uppercase()) && c.is_ascii() }
+
+/// Find link codes in a line (ten symbols from the code alphabet, written as `ABCDE-FGHJK` or run
+/// together) and return the line with each replaced by `[code]`, plus the codes (upper case, no dash).
+/// Ordinary words can look like a code; that only costs a harmless report that NemoWorld ignores.
+pub fn scrub(text: &str) -> (String, Vec<String>) {
+    // Runs of ASCII letters and digits, with their byte ranges.
+    let mut runs: Vec<(usize, usize)> = Vec::new();
+    let mut start: Option<usize> = None;
+    for (i, c) in text.char_indices() {
+        if c.is_ascii_alphanumeric() {
+            start.get_or_insert(i);
+        } else if let Some(s) = start.take() {
+            runs.push((s, i));
+        }
+    }
+    if let Some(s) = start {
+        runs.push((s, text.len()));
+    }
+    let all_code = |s: &str| s.chars().all(in_alphabet);
+    let mut spans: Vec<(usize, usize, String)> = Vec::new();
+    let mut i = 0;
+    while i < runs.len() {
+        let (a, b) = runs[i];
+        let first = &text[a..b];
+        if first.len() == 10 && all_code(first) {
+            spans.push((a, b, first.to_ascii_uppercase()));
+        } else if first.len() == 5 && all_code(first) && i + 1 < runs.len() {
+            let (c, d) = runs[i + 1];
+            let second = &text[c..d];
+            if second.len() == 5 && all_code(second) && &text[b..c] == "-" {
+                spans.push((a, d, format!("{}{}", first, second).to_ascii_uppercase()));
+                i += 1;
+            }
+        }
+        i += 1;
+    }
+    if spans.is_empty() {
+        return (text.to_owned(), Vec::new());
+    }
+    let mut out = String::with_capacity(text.len());
+    let mut at = 0;
+    let mut codes = Vec::new();
+    for (a, b, code) in spans {
+        out.push_str(&text[at..a]);
+        out.push_str("[code]");
+        at = b;
+        if codes.len() < MAX_REPORTS_PER_MESSAGE && !codes.contains(&code) {
+            codes.push(code);
+        }
+    }
+    out.push_str(&text[at..]);
+    (out, codes)
+}
+
+/// A name is only used as the target of a private message if it is plain, short and single-line.
+pub fn tell_safe(alias: &str) -> bool {
+    let n = alias.chars().count();
+    (1..=32).contains(&n)
+        && alias.trim() == alias
+        && !alias.chars().any(|c| {
+            c.is_control()
+                || matches!(c, '\u{200B}'..='\u{200F}' | '\u{2028}'..='\u{202E}' | '\u{2060}'..='\u{2069}' | '\u{FEFF}')
+        })
+}
+
+/// A name from NemoWorld, made safe to speak: no control characters or markup, bounded.
+pub fn sanitize_display(name: &str) -> String {
+    let cleaned: String = name
+        .chars()
+        .filter(|c| !c.is_control() && !matches!(c, '<' | '>' | '&' | '"' | '\'' | '`' | '\\'))
+        .collect();
+    let cleaned = cleaned.split_whitespace().collect::<Vec<_>>().join(" ");
+    cleaned.chars().take(40).collect()
+}
+
+fn well_formed_code(code: &str) -> bool {
+    let b = code.as_bytes();
+    b.len() == 11
+        && b[5] == b'-'
+        && code.chars().enumerate().all(|(i, c)| i == 5 || in_alphabet(c) && c.is_ascii_uppercase() || c.is_ascii_digit() && in_alphabet(c))
+}
+
+fn well_formed_uuid(s: &str) -> bool {
+    s.len() == 36
+        && s.chars().enumerate().all(|(i, c)| {
+            if [8, 13, 18, 23].contains(&i) { c == '-' } else { c.is_ascii_hexdigit() }
+        })
+}
+
+fn fit(text: String) -> String {
+    if text.len() <= MAX_TELL_BYTES {
+        return text;
+    }
+    let mut end = MAX_TELL_BYTES;
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    text[..end].to_owned()
+}
+
+fn code_message(code: &str, minutes: u64, page: &str) -> String {
+    fit(format!(
+        "Your NemoWorld link code is {code}. It works once and lasts {minutes} minutes. Signed in to \
+         NemoWorld, open {page} and type it there. Never say it in chat."
+    ))
+}
+
+const MSG_ALREADY: &str = "You are already linked to a NemoWorld account. Say \"unlink\" first if you want to link a different one.";
+const MSG_WAIT: &str = "Please wait a little before asking for another code.";
+const MSG_DOWN: &str = "I cannot reach NemoWorld just now. Please try again in a moment.";
+const MSG_LEAK: &str = "That looked like a link code. I cancelled it for safety: type codes only into NemoWorld, never in chat. Say \"link my account\" for a new one.";
+
+fn notice_message(kind: &str, display_name: &str) -> Option<String> {
+    let who = sanitize_display(display_name);
+    match kind {
+        "linked" => Some(fit(format!(
+            "You are now linked to the NemoWorld account of {who}. Say \"unlink\" to undo it. Your progress is shown to you in NemoWorld."
+        ))),
+        "unlinked_in_nemoworld" => Some("Your link to NemoWorld was removed in NemoWorld.".to_owned()),
+        _ => None,
+    }
+}
+
+/// Where the player types the code. `NEMO_PUBLIC_URL` overrides the address the bridge itself uses
+/// (which is a loopback address), for a deployment players can reach.
+pub fn page_url(nemo_url: Option<&str>) -> String {
+    let base = std::env::var("NEMO_PUBLIC_URL").ok().or_else(|| nemo_url.map(str::to_owned)).unwrap_or_default();
+    let base = base.trim().trim_end_matches('/');
+    if base.is_empty() || base.len() > 60 || base.chars().any(|c| c.is_control() || c.is_whitespace()) {
+        PAGE_PATH.to_owned()
+    } else {
+        format!("{base}{PAGE_PATH}")
+    }
+}
+
+// ---- NemoWorld calls (each on its own short thread; the game loop never waits) -------------------
+
+fn json_body(raw: &str) -> Value { serde_json::from_str(raw).unwrap_or(Value::Null) }
+
+fn answer_link(nemo: &Nemo, uuid: &str, alias: &str, page: &str) -> String {
+    let body = json!({"player_uuid": uuid, "player_alias": alias}).to_string();
+    match nemo.request("POST", "/api/v1/veloren/identity/code", Some(&body)) {
+        Ok((200, raw)) => {
+            let v = json_body(&raw);
+            let code = v["code"].as_str().unwrap_or("");
+            let minutes = v["expires_in_s"].as_u64().unwrap_or(600) / 60;
+            if well_formed_code(code) { code_message(code, minutes.clamp(1, 60), page) } else { MSG_DOWN.to_owned() }
+        },
+        Ok((409, _)) => MSG_ALREADY.to_owned(),
+        Ok((429, _)) => MSG_WAIT.to_owned(),
+        _ => MSG_DOWN.to_owned(),
+    }
+}
+
+fn answer_unlink(nemo: &Nemo, uuid: &str) -> String {
+    let body = json!({"player_uuid": uuid}).to_string();
+    match nemo.request("POST", "/api/v1/veloren/identity/unlink", Some(&body)) {
+        Ok((200, raw)) if json_body(&raw)["unlinked"].as_bool() == Some(true) => {
+            "Done. This character is no longer linked to a NemoWorld account.".to_owned()
+        },
+        Ok((200, _)) => "This character was not linked to a NemoWorld account.".to_owned(),
+        _ => MSG_DOWN.to_owned(),
+    }
+}
+
+fn answer_who(nemo: &Nemo, uuid: &str) -> String {
+    match nemo.request("GET", &format!("/api/v1/veloren/identity?player_uuid={uuid}"), None) {
+        Ok((200, raw)) => {
+            let v = json_body(&raw);
+            if v["linked"].as_bool() == Some(true) {
+                let who = sanitize_display(v["display_name"].as_str().unwrap_or(""));
+                fit(format!("You are linked to the NemoWorld account of {who}."))
+            } else {
+                "You are not linked to a NemoWorld account. Say \"link my account\" to start.".to_owned()
+            }
+        },
+        _ => MSG_DOWN.to_owned(),
+    }
+}
+
+// ---- the courier -----------------------------------------------------------------------------------
+
+pub struct LinkChat {
+    nemo: Nemo,
+    page: String,
+    tx: Sender<Back>,
+    rx: Receiver<Back>,
+    last_ask: HashMap<String, Instant>,
+    in_flight: usize,
+    notices_in_flight: bool,
+    next_notices: Instant,
+    waiting: VecDeque<(Instant, Outgoing)>,
+}
+
+impl LinkChat {
+    pub fn new(nemo: Nemo, page: String) -> Self {
+        let (tx, rx) = mpsc::channel();
+        Self {
+            nemo,
+            page,
+            tx,
+            rx,
+            last_ask: HashMap::new(),
+            in_flight: 0,
+            notices_in_flight: false,
+            next_notices: Instant::now(),
+            waiting: VecDeque::new(),
+        }
+    }
+
+    /// Look at one chat line (already passed through [`scrub`]). Returns true when it was a link
+    /// request, so the caller must not also treat it as conversation.
+    pub fn on_chat(
+        &mut self,
+        speaker: Option<&(String, String)>,
+        private_to_me: bool,
+        text: &str,
+        codes: &[String],
+        name: &str,
+    ) -> bool {
+        let Some((uuid, alias)) = speaker else { return false };
+        if !well_formed_uuid(uuid) {
+            return false;
+        }
+        for code in codes {
+            self.report_leak(uuid, code);
+        }
+        let Some(intent) = parse_intent(text, name, private_to_me) else { return false };
+        let now = Instant::now();
+        if self.last_ask.get(uuid).is_some_and(|t| now.duration_since(*t) < ASK_GAP) || self.in_flight >= MAX_IN_FLIGHT {
+            return true;
+        }
+        self.last_ask.insert(uuid.clone(), now);
+        if self.last_ask.len() > 512 {
+            self.last_ask.retain(|_, t| now.duration_since(*t) < Duration::from_secs(60));
+        }
+        if !tell_safe(alias) {
+            warn!("link: not answering {intent:?}: the player's name cannot be used safely as a private-message target");
+            return true;
+        }
+        info!("link: {intent:?} requested by '{}' ({uuid})", sanitize_display(alias));
+        let (nemo, tx, page) = (self.nemo.clone(), self.tx.clone(), self.page.clone());
+        let (uuid, alias) = (uuid.clone(), alias.clone());
+        self.in_flight += 1;
+        thread::spawn(move || {
+            let text = match intent {
+                Intent::Link => answer_link(&nemo, &uuid, &alias, &page),
+                Intent::Unlink => answer_unlink(&nemo, &uuid),
+                Intent::WhoAmI => answer_who(&nemo, &uuid),
+            };
+            let _ = tx.send(Back::Tell(Outgoing { uuid, text }));
+        });
+        true
+    }
+
+    fn report_leak(&mut self, uuid: &str, code: &str) {
+        if self.in_flight >= MAX_IN_FLIGHT {
+            return;
+        }
+        self.in_flight += 1;
+        let (nemo, tx, uuid, code) = (self.nemo.clone(), self.tx.clone(), uuid.to_owned(), code.to_owned());
+        thread::spawn(move || {
+            let body = json!({ "code": code }).to_string();
+            let revoked = matches!(
+                nemo.request("POST", "/api/v1/veloren/identity/leaked", Some(&body)),
+                Ok((200, raw)) if json_body(&raw)["revoked"].as_bool() == Some(true)
+            );
+            // Only the person who spoke a real code is told; a look-alike word gets no reply at all.
+            let _ = tx.send(Back::Tell(Outgoing { uuid, text: if revoked { MSG_LEAK.to_owned() } else { String::new() } }));
+        });
+    }
+
+    /// Once per game tick: collect answers, ask NemoWorld for notices, and deliver what is ready.
+    pub fn tick(&mut self, client: &mut Client) {
+        let now = Instant::now();
+        if !self.notices_in_flight && now >= self.next_notices {
+            self.notices_in_flight = true;
+            let (nemo, tx) = (self.nemo.clone(), self.tx.clone());
+            thread::spawn(move || {
+                let result = nemo.request("GET", "/api/v1/veloren/identity/notices", None).and_then(|(status, raw)| {
+                    if status != 200 {
+                        return Err(format!("notices answered {status}"));
+                    }
+                    let v = json_body(&raw);
+                    Ok(v["notices"]
+                        .as_array()
+                        .map(|list| {
+                            list.iter()
+                                .map(|n| Notice {
+                                    uuid: n["player_uuid"].as_str().unwrap_or("").to_owned(),
+                                    kind: n["kind"].as_str().unwrap_or("").to_owned(),
+                                    display_name: n["display_name"].as_str().unwrap_or("").to_owned(),
+                                })
+                                .collect()
+                        })
+                        .unwrap_or_default())
+                });
+                let _ = tx.send(Back::Notices(result));
+            });
+        }
+        while let Ok(back) = self.rx.try_recv() {
+            match back {
+                Back::Tell(out) => {
+                    self.in_flight = self.in_flight.saturating_sub(1);
+                    if !out.text.is_empty() {
+                        self.waiting.push_back((now + KEEP_UNDELIVERED, out));
+                    }
+                },
+                Back::Notices(result) => {
+                    self.notices_in_flight = false;
+                    self.next_notices = Instant::now() + NOTICES_EVERY;
+                    match result {
+                        Ok(list) => {
+                            for n in list {
+                                if well_formed_uuid(&n.uuid)
+                                    && let Some(text) = notice_message(&n.kind, &n.display_name)
+                                {
+                                    self.waiting.push_back((now + KEEP_UNDELIVERED, Outgoing { uuid: n.uuid, text }));
+                                }
+                            }
+                        },
+                        Err(e) => warn!("link notices unavailable: {e}"),
+                    }
+                },
+            }
+        }
+        self.waiting.retain(|(deadline, _)| now < *deadline);
+        let mut still: VecDeque<(Instant, Outgoing)> = VecDeque::new();
+        while let Some((deadline, out)) = self.waiting.pop_front() {
+            if !deliver(client, &out) {
+                still.push_back((deadline, out));
+            }
+        }
+        self.waiting = still;
+    }
+}
+
+/// The alias of the online player with this account uuid, from the live player list.
+fn online_alias(client: &Client, uuid: &str) -> Option<String> {
+    client
+        .player_list()
+        .values()
+        .find(|info| info.is_online && info.uuid.to_string() == uuid)
+        .map(|info| info.player_alias.clone())
+}
+
+/// Send one private message. Returns true when it is finished with (sent, or not sendable ever), false
+/// when the player is not online yet and it should be kept for a moment.
+fn deliver(client: &mut Client, out: &Outgoing) -> bool {
+    let Some(alias) = online_alias(client, &out.uuid) else { return false };
+    if !tell_safe(&alias) {
+        warn!("link: dropped a private message: the player's name cannot be used safely as a target");
+        return true;
+    }
+    // The name is one argument, so it cannot add words to the command; the text is one argument too.
+    client.send_command("tell".into(), vec![alias.clone(), out.text.clone()]);
+    // `/tell` leaves the sender in "tell this player" mode; go back to public speech.
+    client.send_command("say".into(), Vec::new());
+    info!("link: sent a private message to '{}' ({} bytes, contents withheld)", sanitize_display(&alias), out.text.len());
+    true
+}
+
+// ---- probe (stand-in human player used by tests) -----------------------------------------------------
+
+/// Used by `--probe NAME --say TEXT`: say the line in public, or with `--tell` send it privately to
+/// the resident. The probe is a stand-in for a person typing in the game.
+pub fn probe_say(client: &mut Client, resident: &str, line: String, tell: bool) {
+    if tell {
+        client.send_command("tell".into(), vec![resident.to_owned(), line]);
+        client.send_command("say".into(), Vec::new());
+    } else {
+        client.send_chat(line);
+    }
+}
+
+/// With `--code-file`, a probe stands in for the person who reads the code in game and types it in
+/// NemoWorld: the first code it hears is written to that file (owner-only) and never printed.
+pub fn probe_capture(raw_text: &str, code_file: &Option<String>) {
+    let Some(path) = code_file else { return };
+    let (_, codes) = scrub(raw_text);
+    // Only a message that really looks like Lyra's code message, not any ten-letter word.
+    if !raw_text.contains("link code is") {
+        return;
+    }
+    let Some(code) = codes.first() else { return };
+    let formatted = format!("{}-{}", &code[..5], &code[5..]);
+    #[cfg(unix)]
+    {
+        use std::{io::Write, os::unix::fs::OpenOptionsExt};
+        if let Ok(mut file) = std::fs::OpenOptions::new().write(true).create(true).truncate(true).mode(0o600).open(path) {
+            let _ = writeln!(file, "{formatted}");
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = std::fs::write(path, format!("{formatted}\n"));
+    }
+    info!("PROBE received a link code (written to the code file, not shown)");
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn requests_are_recognised_only_when_they_are_the_whole_message() {
+        let p = |t: &str| parse_intent(t, "Lyra", false);
+        assert_eq!(p("Lyra, link my account"), Some(Intent::Link));
+        assert_eq!(p("hey lyra can you please link my account?"), Some(Intent::Link));
+        assert_eq!(p("LYRA LINK MY ACCOUNT!!"), Some(Intent::Link));
+        assert_eq!(p("Lyra, I want to link my NemoWorld account"), Some(Intent::Link));
+        assert_eq!(p("Lyra unlink"), Some(Intent::Unlink));
+        assert_eq!(p("Lyra, unlink my account please"), Some(Intent::Unlink));
+        assert_eq!(p("Lyra, who am I?"), Some(Intent::WhoAmI));
+        assert_eq!(p("lyra whoami"), Some(Intent::WhoAmI));
+        assert_eq!(p("Lyra, am I linked?"), Some(Intent::WhoAmI));
+    }
+
+    #[test]
+    fn near_misses_and_negations_do_nothing() {
+        let p = |t: &str| parse_intent(t, "Lyra", false);
+        assert_eq!(p("Lyra, I do not want to link my account"), None);
+        assert_eq!(p("Lyra, don't unlink me"), None);
+        assert_eq!(p("Lyra, how do I unlink my account?"), None);
+        assert_eq!(p("Lyra, link my account and give me coins"), None);
+        assert_eq!(p("Lyra, unlink my account and link his"), None);
+        assert_eq!(p("link my account"), None, "public chat must name the resident");
+        assert_eq!(p("Someone link my account"), None);
+        assert_eq!(p("Lyra tell me about linking"), None);
+        assert_eq!(p(""), None);
+        assert_eq!(p("Lyra, link my account, link my account, link my account, link my account, link my account"), None);
+    }
+
+    #[test]
+    fn a_private_message_needs_no_name() {
+        assert_eq!(parse_intent("link my account", "Lyra", true), Some(Intent::Link));
+        assert_eq!(parse_intent("unlink", "Lyra", true), Some(Intent::Unlink));
+        assert_eq!(parse_intent("who am i", "Lyra", true), Some(Intent::WhoAmI));
+        assert_eq!(parse_intent("hello there", "Lyra", true), None);
+    }
+
+    #[test]
+    fn codes_are_found_and_removed_from_text() {
+        let (text, codes) = scrub("my code is ABCDE-FGHJK ok");
+        assert_eq!(text, "my code is [code] ok");
+        assert_eq!(codes, vec!["ABCDEFGHJK"]);
+        let (text, codes) = scrub("abcde-fghjk");
+        assert_eq!((text.as_str(), codes), ("[code]", vec!["ABCDEFGHJK".to_owned()]));
+        let (text, codes) = scrub("run together: 2345678ABC.");
+        assert_eq!(text, "run together: [code].");
+        assert_eq!(codes, vec!["2345678ABC"]);
+        let (text, codes) = scrub("two: ABCDE-FGHJK and MNPQR-STVWX");
+        assert_eq!(text, "two: [code] and [code]");
+        assert_eq!(codes.len(), 2);
+        assert!(!text.contains("ABCDE"));
+    }
+
+    #[test]
+    fn ordinary_text_and_odd_input_are_left_alone_and_never_panic() {
+        for t in ["", "hello Lyra", "1234567890", "ABCDE FGHJK", "ABCDE--FGHJK", "ABCDEFGHJ", "ABCDEFGHJKM", "ÄBCDE-FGHJK", "日本語のテキスト ABCDE-FGHJK 終わり", "a-b-c-d-e"] {
+            let (out, codes) = scrub(t);
+            if codes.is_empty() {
+                assert_eq!(out, t);
+            } else {
+                assert!(!out.contains(&codes[0]) && out.contains("[code]"));
+            }
+        }
+        let (_, none) = scrub("ABCDE FGHJK");
+        assert!(none.is_empty(), "a space is not the separator");
+        let long = "x".repeat(100_000);
+        assert!(scrub(&long).1.is_empty());
+        let many = "ABCDE-FGHJK ".repeat(50);
+        let (out, codes) = scrub(&many);
+        assert!(codes.len() <= MAX_REPORTS_PER_MESSAGE);
+        assert!(!out.contains("ABCDE"));
+    }
+
+    #[test]
+    fn only_plain_single_line_names_become_message_targets() {
+        assert!(tell_safe("Tester"));
+        assert!(tell_safe("Bob_the-Builder"));
+        assert!(tell_safe("Ünïcode Name"));
+        for bad in ["", " ", "Bob\n/say hello", "Bob\r", "a\u{1b}[31m", "x\u{202E}y", "zero\u{200B}width", " leading", "trailing ", &"n".repeat(33)] {
+            assert!(!tell_safe(bad), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn names_from_nemoworld_are_cleaned_before_they_are_spoken() {
+        assert_eq!(sanitize_display("Alice <b>Walker</b>\n"), "Alice bWalker/b");
+        assert_eq!(sanitize_display("A\u{1b}[31mB"), "A[31mB");
+        assert_eq!(sanitize_display(&"x".repeat(100)).chars().count(), 40);
+        assert_eq!(sanitize_display("  many   spaces  "), "many spaces");
+    }
+
+    #[test]
+    fn messages_fit_veloren_and_carry_what_the_player_needs() {
+        let m = code_message("ABCDE-FGHJK", 10, "http://127.0.0.1:3201/veloren-link");
+        assert!(m.contains("ABCDE-FGHJK") && m.contains("10 minutes") && m.contains("/veloren-link"));
+        assert!(m.len() <= MAX_TELL_BYTES && !m.contains('\n'));
+        let long = code_message("ABCDE-FGHJK", 10, &"h".repeat(500));
+        assert!(long.len() <= MAX_TELL_BYTES);
+        for m in [MSG_ALREADY, MSG_WAIT, MSG_DOWN, MSG_LEAK] {
+            assert!(m.len() <= MAX_TELL_BYTES, "{m}");
+        }
+        let linked = notice_message("linked", &"é".repeat(100)).unwrap();
+        assert!(linked.len() <= MAX_TELL_BYTES);
+        assert!(notice_message("anything else", "x").is_none());
+        assert!(fit("é".repeat(300)).len() <= MAX_TELL_BYTES, "cut on a character boundary");
+    }
+
+    #[test]
+    fn only_well_formed_codes_and_ids_are_accepted_from_the_network() {
+        assert!(well_formed_code("ABCDE-FGHJK"));
+        assert!(well_formed_code("23456-789AB"));
+        for bad in ["", "ABCDEFGHJK", "ABCDE-FGHJ", "ABCDE-FGHJKM", "abcde-fghjk", "ABCDE-FGHJ0", "ABCDE-FGHJO", "hello there!", "ABCDE-FGHJ\n"] {
+            assert!(!well_formed_code(bad), "{bad:?}");
+        }
+        assert!(well_formed_uuid("11111111-1111-4111-8111-111111111111"));
+        for bad in ["", "11111111111141118111111111111111", "zzzzzzzz-1111-4111-8111-111111111111", "11111111-1111-4111-8111-11111111111g", "../etc/passwd"] {
+            assert!(!well_formed_uuid(bad), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn a_pending_message_never_prints_its_text() {
+        let out = Outgoing { uuid: "11111111-1111-4111-8111-111111111111".into(), text: "Your NemoWorld link code is ABCDE-FGHJK.".into() };
+        let shown = format!("{out:?}");
+        assert!(!shown.contains("ABCDE") && !shown.contains("code is"));
+    }
+
+    #[test]
+    fn the_page_address_comes_from_the_bridge_url_or_the_public_override() {
+        // (The environment override is exercised by hand; here only the argument path.)
+        if std::env::var("NEMO_PUBLIC_URL").is_err() {
+            assert_eq!(page_url(Some("http://127.0.0.1:3201/")), "http://127.0.0.1:3201/veloren-link");
+            assert_eq!(page_url(None), "/veloren-link");
+            assert_eq!(page_url(Some("http://bad host")), "/veloren-link");
+        }
+    }
+}
