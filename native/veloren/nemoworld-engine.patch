+//! Strict native city plans and arrival accounting.
+use serde::{Deserialize, Serialize};
+
+pub const PRINCIPAL: &str = "00000000-0000-4000-8000-000000000001";
+pub const MAX_ACTORS: usize = 16;
+pub const LANDMARKS: &[&str] = &["city-arrival", "city-homes", "city-build", "city-office", "city-farm", "city-school", "city-university", "city-park"];
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct CityPlan {
+    pub id: String,
+    pub name: String,
+    pub stage: String,
+    pub target: String,
+    pub activity: String,
+    pub revision: u32,
+}
+
+pub fn parse(args: &str) -> Result<CityPlan, &'static str> {
+    if args.len() > 700 { return Err("bad_city_args"); }
+    let p: CityPlan = serde_json::from_str(args).map_err(|_| "bad_city_args")?;
+    let suffix = p.id.strip_prefix("city-").ok_or("bad_city_id")?;
+    if suffix.is_empty() || suffix.len() > 32 || !suffix.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-') {
+        return Err("bad_city_id");
+    }
+    if p.name.is_empty() || p.name.len() > 40 || p.name.trim().is_empty() || !p.name.bytes().all(|b| b.is_ascii_alphabetic() || b == b' ') {
+        return Err("bad_city_name");
+    }
+    if !matches!(p.stage.as_str(), "adult" | "child" | "student" | "apprentice") || !matches!(p.activity.as_str(), "build" | "office" | "farm" | "school" | "home" | "social") || !valid_target(&p.target) {
+        return Err("bad_city_plan");
+    }
+    Ok(p)
+}
+
+pub fn valid_target(target: &str) -> bool {
+    target.strip_prefix("city-").is_some_and(|suffix| !suffix.is_empty() && suffix.len() <= 32 && suffix.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-'))
+}
+
+pub fn parse_visit(kind: &str, args: &str) -> Result<&'static str, &'static str> {
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Visit { target: String }
+    if args.len() > 100 { return Err("bad_city_visit"); }
+    let visit: Visit = serde_json::from_str(args).map_err(|_| "bad_city_visit")?;
+    match (kind, visit.target.as_str()) {
+        ("city_visit", "city-arrival") => Ok("city-arrival"),
+        ("city_return", "lyra-plaza") => Ok("lyra-plaza"),
+        _ => Err("bad_city_visit"),
+    }
+}
+
+pub fn human_principal(uuid: &str) -> bool {
+    uuid != PRINCIPAL && uuid.len() == 36 && uuid.bytes().enumerate().all(|(i,b)| {
+        if [8,13,18,23].contains(&i) { b == b'-' } else { b.is_ascii_hexdigit() }
+    })
+}
+
+/// A bounded neighbourhood requested by a real native actor, never an extra client.
+pub fn chunk_offsets() -> [(i32, i32); 9] {
+    [(-1,-1), (-1,0), (-1,1), (0,-1), (0,0), (0,1), (1,-1), (1,0), (1,1)]
+}
+
+pub fn step_jump(from: f32, to: f32) -> Option<bool> {
+    let delta = to-from;
+    (from.is_finite() && to.is_finite() && (-1.2..=1.15).contains(&delta)).then_some(delta > 0.4)
+}
+
+pub const ROUTE_NODE_LIMIT: usize = 512;
+/// Bounded A* over server-supplied checked dry floor columns. Returns a short partial route
+/// toward distant targets if the search budget is exhausted. No synthetic positions are applied.
+pub fn ground_route(mut start: (i32,i32), height: f32, goal: (i32,i32), mut floor: impl FnMut(i32,i32,f32)->Option<f32>) -> Vec<(i32,i32)> {
+    use std::{cmp::Reverse, collections::{BinaryHeap, BTreeMap}};
+    let origin = start;
+    let heuristic = |at: (i32,i32)| {
+        let dx = (goal.0-at.0).unsigned_abs();
+        let dy = (goal.1-at.1).unsigned_abs();
+        dx.max(dy).saturating_mul(10).saturating_add(dx.min(dy).saturating_mul(4))
+    };
+    let mut nodes = BTreeMap::new();
+    nodes.insert(start,(height,0u32,None));
+    let mut open = BinaryHeap::new();
+    open.push(Reverse((heuristic(start),start)));
+    let mut best = start;
+    let mut expanded = 0;
+    while let Some(Reverse((_,at))) = open.pop() {
+        if expanded >= ROUTE_NODE_LIMIT { break; }
+        expanded += 1;
+        if heuristic(at) < heuristic(best) { best = at; }
+        if at == goal { best = at; break; }
+        let (z,cost,_) = nodes[&at];
+        for (dx,dy) in chunk_offsets().into_iter().filter(|p| *p != (0,0)) {
+            let next = (at.0+dx,at.1+dy);
+            if (next.0-origin.0).abs() > 80 || (next.1-origin.1).abs() > 80 { continue; }
+            let Some(next_z) = floor(next.0,next.1,z) else { continue; };
+            let Some(jump) = step_jump(z,next_z) else { continue; };
+            // A diagonal must have both side columns free too: never cut a solid corner.
+            if dx != 0 && dy != 0 && [(at.0+dx,at.1),(at.0,at.1+dy)].into_iter().any(|(x,y)| floor(x,y,z).and_then(|h| step_jump(z,h)).is_none()) { continue; }
+            let next_cost = cost + if dx != 0 && dy != 0 {14} else {10} + if jump {3} else {0};
+            if nodes.get(&next).is_some_and(|(_,old,_)| *old <= next_cost) { continue; }
+            nodes.insert(next,(next_z,next_cost,Some(at)));
+            open.push(Reverse((next_cost.saturating_add(heuristic(next)),next)));
+        }
+    }
+    let mut path = Vec::new();
+    start = best;
+    while let Some((_,_,Some(parent))) = nodes.get(&start) {
+        path.push(start);
+        start = *parent;
+    }
+    path.reverse();
+    path
+}
+
+/// Try expected support first, then alternating lower/higher offsets. A nearby roof must
+/// never replace the floor a saved citizen actually stood on.
+pub fn floor_offsets(range: i32) -> impl Iterator<Item=i32> {
+    (0..=range.clamp(0,40)*2).map(|n| if n == 0 {0} else if n%2 == 1 {-(n+1)/2} else {n/2})
+}
+
+pub fn newer_revision(previous: Option<u32>, revision: u32) -> bool {
+    previous.is_none_or(|old| revision > old)
+}
+
+/// Only observed continuous in-game presence counts. Never restore dwell across downtime.
+#[derive(Default, Serialize, Deserialize)]
+pub struct Arrival {
+    #[serde(skip)]
+    since: Option<f64>,
+    #[serde(skip)]
+    last: Option<f64>,
+}
+impl Arrival {
+    pub fn observe(&mut self, now: f64, near: bool) -> bool {
+        if !near || self.last.is_some_and(|last| now < last || now - last > 1.0) {
+            self.since = None;
+        }
+        self.last = Some(now);
+        if !near { return false; }
+        let since = *self.since.get_or_insert(now);
+        now - since >= 5.0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const GOOD: &str = r#"{"id":"city-ada","name":"Ada Vale","stage":"adult","target":"city-build","activity":"build","revision":3}"#;
+    #[test] fn strict_city_arguments() {
+        assert!(parse(GOOD).is_ok());
+        assert!(parse(&GOOD.replace("city-build", "city-home-4")).is_ok());
+        for bad in [GOOD.replace("city-ada", "human"), GOOD.replace("Ada Vale", "[AI] Ada"), GOOD.replace("city-build", "plaza"), GOOD.replace("3}", "-1}"), GOOD.replace("3}", "4294967296}"), GOOD.replace("3}", "3,\"x\":4}")] {
+            assert!(parse(&bad).is_err(), "{bad}");
+        }
+    }
+    #[test] fn visit_has_only_a_fixed_public_target_and_human_principal() {
+        assert_eq!(parse_visit("city_visit", r#"{"target":"city-arrival"}"#), Ok("city-arrival"));
+        assert_eq!(parse_visit("city_return", r#"{"target":"lyra-plaza"}"#), Ok("lyra-plaza"));
+        assert!(parse_visit("city_visit", r#"{"target":"city-home-1"}"#).is_err());
+        assert!(parse_visit("city_visit", r#"{"target":"city-arrival","player_uuid":"other"}"#).is_err());
+        assert!(parse_visit("city_visit", r#"{"target":"city-arrival","x":5}"#).is_err());
+        assert!(!human_principal(PRINCIPAL));
+        assert!(!human_principal("not-a-uuid"));
+        assert!(human_principal("10000000-0000-4000-8000-000000000001"));
+    }
+    #[test] fn terrain_requests_are_a_bounded_three_by_three_neighbourhood() {
+        let offsets = chunk_offsets();
+        assert_eq!(offsets.len(), 9);
+        let unique: std::collections::BTreeSet<_> = offsets.into_iter().collect();
+        assert_eq!(unique.len(), 9);
+        assert!(unique.iter().all(|(x,y)| (-1..=1).contains(x) && (-1..=1).contains(y)));
+        assert!(MAX_ACTORS * unique.len() <= 144);
+    }
+    #[test] fn native_steps_jump_one_block_and_refuse_cliffs() {
+        assert_eq!(step_jump(10.0,10.0), Some(false));
+        assert_eq!(step_jump(10.0,11.0), Some(true));
+        assert_eq!(step_jump(10.0,9.0), Some(false));
+        assert_eq!(step_jump(10.0,12.0), None);
+        assert_eq!(step_jump(10.0,8.0), None);
+    }
+    #[test] fn bounded_route_walks_around_a_rectangle() {
+        let route = ground_route((0,0),0.0,(14,0), |x,y,z| {
+            if (4..=8).contains(&x) && (-3..=3).contains(&y) { None } else { Some(z) }
+        });
+        assert!(!route.is_empty());
+        assert_eq!(route.last().copied(),Some((14,0)));
+        assert!(route.iter().any(|(_,y)| y.abs() > 3));
+        let mut checked = 0;
+        let _ = ground_route((0,0),0.0,(1000,1000), |_,_,z| { checked += 1; Some(z) });
+        assert!(checked <= ROUTE_NODE_LIMIT * 24);
+    }
+    #[test] fn restored_support_is_checked_nearest_first() {
+        assert_eq!(floor_offsets(2).collect::<Vec<_>>(),vec![0,-1,1,-2,2]);
+        assert_eq!(floor_offsets(0).collect::<Vec<_>>(),vec![0]);
+    }
+    #[test] fn revision_is_monotonic() {
+        assert!(newer_revision(Some(2), 3));
+        assert!(!newer_revision(Some(3), 3));
+        assert!(!newer_revision(Some(4), 3));
+        assert!(newer_revision(None, 0));
+    }
+    #[test] fn arrival_requires_continuous_actual_presence() {
+        let mut arrival = Arrival::default();
+        assert!(!arrival.observe(1.0, true));
+        for t in 2..=5 { assert!(!arrival.observe(t as f64, true)); }
+        assert!(!arrival.observe(5.9, true));
+        assert!(!arrival.observe(6.0, false));
+        assert!(!arrival.observe(9.0, true));
+        for t in 10..14 { assert!(!arrival.observe(t as f64, true)); }
+        assert!(arrival.observe(14.0, true));
+    }
+    #[test] fn restart_keeps_plan_and_forgets_unobserved_dwell() {
+        let plan = parse(GOOD).unwrap();
+        let restored: CityPlan = serde_json::from_str(&serde_json::to_string(&plan).unwrap()).unwrap();
+        assert_eq!(plan, restored);
+        let mut a = Arrival::default();
+        a.observe(10.0, true);
+        let mut restored: Arrival = serde_json::from_str(&serde_json::to_string(&a).unwrap()).unwrap();
+        assert!(!restored.observe(100.0, true));
+    }
+}
