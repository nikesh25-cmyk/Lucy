@@ -0,0 +1,520 @@
+//! Signed city plans projected as peaceful native NPCs. No account, inventory grants or combat AI.
+use crate::{ChunkRequest, client::Client};
+use super::nemo_link::{Command, NemoLinkState};
+use common::{
+    comp::{Alignment, Body, Content, Controller, Ori, Player, Pos, PhysicsState, Presence, PresenceKind, Scale, Stats},
+    event::{CreateNpcEvent, EventBus, NpcBuilder, TeleportToPositionEvent},
+    comp::controller::InputKind,
+    resources::Time,
+    terrain::{BlockKind, TerrainGrid},
+    vol::ReadVol,
+};
+use common_ecs::{Job, Origin, Phase, System};
+use nemo_link_proto::city::{self, Arrival, CityPlan};
+use serde::{Deserialize, Serialize};
+use specs::{Entities, Entity, Join, Read, ReadExpect, ReadStorage, Write, WriteStorage};
+use std::{collections::{BTreeMap, BTreeSet, VecDeque}, fs, sync::Arc, time::{SystemTime, UNIX_EPOCH}};
+use vek::{Vec2, Vec3};
+use world::World;
+
+// Movement settles inside the larger continuous-arrival acceptance circle.
+const ARRIVAL_RADIUS_SQUARED: f32 = 25.0;
+const APPROACH_RADIUS_SQUARED: f32 = 4.0;
+fn approach_needed(distance_squared: f32, grounded: bool) -> bool {
+    !(distance_squared <= APPROACH_RADIUS_SQUARED && grounded)
+}
+
+#[derive(Clone, Copy)]
+enum SupportMaterial { Terrain, Wood, Foliage }
+fn support_allowed(material: SupportMaterial, fresh_spawn: bool) -> bool {
+    matches!(material, SupportMaterial::Terrain) || (matches!(material, SupportMaterial::Wood) && !fresh_spawn)
+}
+/// Conservative circular bound of the actual scaled capsule; at most25 terrain columns.
+fn footprint_columns(x: f32, y: f32, radius: f32) -> Vec<(i32,i32)> {
+    let radius = radius.clamp(0.05,1.1);
+    let mut columns = Vec::new();
+    for nx in (x-radius).floor() as i32..=(x+radius).floor() as i32 {
+        for ny in (y-radius).floor() as i32..=(y+radius).floor() as i32 {
+            let dx = x-x.clamp(nx as f32,nx as f32+1.0);
+            let dy = y-y.clamp(ny as f32,ny as f32+1.0);
+            if dx*dx+dy*dy < radius*radius { columns.push((nx,ny)); }
+        }
+    }
+    columns
+}
+
+/// Startup-only recovery around the last observation, never around a job destination.
+fn local_restore(saved: [f32;3], mut clear: impl FnMut(f32,f32,i32)->Option<f32>) -> Option<[f32;3]> {
+    let mut offsets: Vec<(i32,i32)> = (-8_i32..=8).flat_map(|dx| (-8_i32..=8).map(move |dy| (dx,dy))).filter(|(dx,dy)| dx*dx+dy*dy<=64).collect();
+    offsets.sort_by_key(|&(dx,dy)| (dx*dx+dy*dy,dx,dy));
+    // Lowest local support wins over a nearby roof. Each candidate has real capsule clearance.
+    // At most197 horizontal probes at each of25 heights, only once every two seconds per actor.
+    for z in (saved[2]-12.0).ceil() as i32..=(saved[2]+12.0).floor() as i32 {
+        let mut best: Option<[f32;3]> = None;
+        for &(dx,dy) in &offsets {
+            let x=saved[0]+dx as f32*0.5; let y=saved[1]+dy as f32*0.5;
+            if let Some(floor)=clear(x,y,z).filter(|floor| floor.is_finite() && (*floor-saved[2]).abs()<=12.0) {
+                if best.is_none_or(|p| floor<p[2]) { best=Some([x,y,floor]); }
+            }
+        }
+        if best.is_some() { return best; }
+    }
+    None
+}
+
+/// Process-local stamps, never persisted timestamps, authorize local restore relocation.
+pub(crate) fn city_restore_ready<'a>(recorded: impl Iterator<Item=&'a str>, current: &BTreeSet<String>) -> bool {
+    recorded.filter(|id| id.starts_with("city-home-") && (id.ends_with("-foundation") || id.ends_with("-shell"))).all(|id| current.contains(id))
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RestoreRelocation { from: [f32;3], to: [f32;3], at: u64 }
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Actor {
+    plan: CityPlan,
+    pending: Option<Command>,
+    position: Option<[f32; 3]>,
+    /// Saved appearance is independent of age scale and survives native respawn/restart.
+    #[serde(default)]
+    body: Option<Body>,
+    /// Real wall time of the most recent observation of this process's owned NPC entity.
+    #[serde(default)]
+    observed_at: u64,
+    /// Explicit startup relocation, distinct from observed walking or job arrival.
+    #[serde(default)]
+    restore_relocation: Option<RestoreRelocation>,
+    #[serde(skip)]
+    next_spawn_check: f64,
+    #[serde(default)]
+    arrived: bool,
+    #[serde(skip)]
+    entity: Option<Entity>,
+    #[serde(skip)]
+    spawning: bool,
+    #[serde(skip)]
+    arrival: Arrival,
+    #[serde(skip)]
+    route: VecDeque<(i32,i32)>,
+    #[serde(skip)]
+    route_at: f64,
+}
+
+#[derive(Default)]
+pub struct NemoCityState {
+    loaded: bool,
+    actors: BTreeMap<String, Actor>,
+    /// Refreshed from real, system-owned NPC entities every tick; never from aliases or requests.
+    workers: Vec<Vec3<f32>>,
+    last_save: f64,
+    next_chunk_request: f64,
+    persistence_blocked: bool,
+    visitors: BTreeMap<String, (Command, f64, bool)>,
+}
+impl NemoCityState {
+    pub fn workers_near(&self, x: f32, y: f32, radius: f32) -> usize {
+        if !x.is_finite() || !y.is_finite() || !radius.is_finite() || radius <= 0.0 { return 0; }
+        self.workers.iter().filter(|p| (p.xy() - Vec2::new(x, y)).magnitude_squared() <= radius * radius).count()
+    }
+}
+
+fn unix_ms() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_millis() as u64)
+}
+fn label(plan: &CityPlan) -> String { format!("[City:{}] {} ({})", plan.id, plan.name, plan.stage) }
+fn stage_scale(stage: &str) -> f32 {
+    match stage { "child" => 0.62, "student" => 0.78, "apprentice" => 0.9, _ => 1.0 }
+}
+
+/// A solid dry floor, with three clear blocks overhead, in a loaded terrain column.
+fn floor(terrain: &TerrainGrid, x: i32, y: i32, estimate: i32, range: i32) -> Option<f32> {
+    floor_for(terrain,x,y,estimate,range,false)
+}
+fn floor_for(terrain: &TerrainGrid, x: i32, y: i32, estimate: i32, range: i32, fresh_spawn: bool) -> Option<f32> {
+    if terrain.get_key_real(TerrainGrid::chunk_key(Vec2::new(x, y))).is_none() { return None; }
+    for offset in city::floor_offsets(range) {
+        let z = estimate + offset;
+        let Ok(b) = terrain.get(Vec3::new(x,y,z)) else { continue; };
+        let material = match b.kind() {
+            BlockKind::Wood => SupportMaterial::Wood,
+            BlockKind::Leaves | BlockKind::ArtLeaves | BlockKind::GlowingMushroom => SupportMaterial::Foliage,
+            _ => SupportMaterial::Terrain,
+        };
+        if !b.is_solid() || b.kind().is_liquid() || !support_allowed(material,fresh_spawn) { continue; }
+        if (1..=3).all(|dz| terrain.get(Vec3::new(x,y,z+dz)).is_ok_and(|b| !b.is_solid() && !b.kind().is_liquid())) {
+            return Some((z+1) as f32);
+        }
+    }
+    None
+}
+
+/// Match capsule support: a neighbouring higher block can hold the feet above the centre floor.
+/// Check headroom across the whole footprint at that shared physical support height.
+fn walk_floor(terrain: &TerrainGrid, at: Vec2<f32>, radius: f32, estimate: i32, range: i32, fresh_spawn: bool) -> Option<f32> {
+    let columns = footprint_columns(at.x,at.y,radius);
+    let mut highest = f32::NEG_INFINITY;
+    for &(x,y) in &columns { highest = highest.max(floor_for(terrain,x,y,estimate,range,fresh_spawn)?); }
+    if !highest.is_finite() { return None; }
+    columns.iter().all(|&(x,y)| (0..3).all(|dz| terrain.get(Vec3::new(x,y,highest as i32+dz)).is_ok_and(|b| !b.is_solid() && !b.kind().is_liquid()))).then_some(highest)
+}
+
+/// Find actual dry support below the actor, including while a checked jump is airborne.
+fn below(terrain: &TerrainGrid, at: Vec3<f32>) -> Option<f32> {
+    let x = at.x.floor() as i32;
+    let y = at.y.floor() as i32;
+    // range0 visits exactly one column height, so a roof above the actor cannot replace support.
+    for z in ((at.z.floor() as i32-5)..=(at.z+0.1).floor() as i32-1).rev() {
+        if let Some(z) = floor(terrain,x,y,z,0) { return Some(z); }
+    }
+    None
+}
+
+/// Only issue physical walking/jumping along checked dry ground with clear headroom.
+fn steering(terrain: &TerrainGrid, at: Vec3<f32>, target: Vec2<f32>, grounded: bool, radius: f32) -> (Vec2<f32>, bool) {
+    let Some(base) = (if grounded { Some(at.z.round()) } else { below(terrain,at) }) else { return (Vec2::zero(),false); };
+    let Some(forward) = (target-at.xy()).try_normalized() else { return (Vec2::zero(),false); };
+    for angle in [0.0_f32, 0.5, -0.5, 1.0, -1.0, 1.57, -1.57] {
+        let (s,c) = angle.sin_cos();
+        let dir = Vec2::new(forward.x*c-forward.y*s, forward.x*s+forward.y*c);
+        let mut jump = false;
+        let mut previous = base;
+        let clear = [0.4, 0.8, 1.2, 1.5].iter().all(|distance| {
+            let p = at.xy()+dir * *distance;
+            let Some(z) = walk_floor(terrain,p,radius,previous as i32-1,2,false) else { return false; };
+            let Some(up) = city::step_jump(previous,z) else { return false; };
+            jump |= up;
+            previous = z;
+            true
+        });
+        if clear { return (dir * 0.45,jump && grounded); }
+    }
+    (Vec2::zero(),false)
+}
+
+fn save(path: &str, actors: &BTreeMap<String, Actor>) -> std::io::Result<()> {
+    let bytes = serde_json::to_vec(actors).map_err(std::io::Error::other)?;
+    let tmp = format!("{path}.tmp");
+    fs::write(&tmp, bytes)?;
+    fs::rename(tmp,path)
+}
+
+#[derive(Default)]
+pub struct Sys;
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Entities<'a>, ReadStorage<'a, Pos>, ReadStorage<'a, Player>, ReadStorage<'a, Client>,
+        WriteStorage<'a, Stats>, WriteStorage<'a, Scale>, WriteStorage<'a, Controller>,
+        Read<'a, Time>, Write<'a, NemoLinkState>, Write<'a, NemoCityState>,
+        Read<'a, EventBus<CreateNpcEvent>>, Read<'a, EventBus<TeleportToPositionEvent>>, Write<'a, Vec<ChunkRequest>>, ReadExpect<'a, TerrainGrid>, ReadExpect<'a, Arc<World>>, (WriteStorage<'a, Presence>, ReadStorage<'a, PhysicsState>, Read<'a, crate::sys::nemo_world::dress::NemoWorldState>),
+    );
+    const NAME: &'static str = "nemo_city";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+    fn run(_job: &mut Job<Self>, (entities, positions, players, clients, mut stats, mut scales, mut controllers, time, mut link, mut state, creates, teleports, mut chunk_requests, terrain, world, (mut presences, physics, dressing)): Self::SystemData) {
+        state.workers.clear();
+        if !link.is_on() { return; }
+        let Some(path) = link.sidecar_path("city.json") else { return; };
+        if !state.loaded {
+            // Refuse malformed or oversized state as a whole rather than partially inventing citizens.
+            if let Ok(bytes) = fs::read(&path) {
+                if bytes.len() > 100_000 { tracing::error!("city state oversized; city controller disabled"); return; }
+                let Ok(actors) = serde_json::from_slice::<BTreeMap<String, Actor>>(&bytes) else { tracing::error!("city state invalid; city controller disabled"); return; };
+                if actors.len() > city::MAX_ACTORS || actors.iter().any(|(id,a)| id != &a.plan.id || city::parse(&serde_json::to_string(&a.plan).unwrap_or_default()).is_err() || a.position.is_some_and(|p| p.iter().any(|n| !n.is_finite())) || a.body.is_some_and(|b| !matches!(b, Body::Humanoid(_)))) {
+                    tracing::error!("city state failed validation; city controller disabled"); return;
+                }
+                state.actors = actors;
+            }
+            let mut assigned_body = false;
+            for actor in state.actors.values_mut() {
+                if actor.body.is_none() {
+                    actor.body = Some(Body::Humanoid(common::comp::humanoid::Body::random()));
+                    assigned_body = true;
+                }
+            }
+            // Migrate old snapshots before an entity can use its appearance.
+            if assigned_body && save(&path,&state.actors).is_err() { return; }
+            state.loaded = true;
+        }
+        if state.persistence_blocked {
+            if save(&path,&state.actors).is_err() { return; }
+            state.persistence_blocked = false;
+        }
+        for command in link.poll_commands(&["city_visit", "city_return"]) {
+            if !city::human_principal(&command.player_uuid) || city::parse_visit(&command.kind,&command.args).is_err() {
+                link.ack(&command,false,"bad_city_visit");
+            } else if state.visitors.contains_key(&command.player_uuid) || state.visitors.len() >= 16 {
+                link.ack(&command,false,"city_visit_busy");
+            } else {
+                state.visitors.insert(command.player_uuid.clone(),(command,time.0-2.0,false));
+            }
+        }
+        let mut teleporter = teleports.emitter();
+        state.visitors.retain(|uuid,(command,last_request,queued)| {
+            if unix_ms() > command.expires_at { link.ack(command,false,"city_visit_expired"); return false; }
+            let Some((entity,player,pos)) = (&entities,&players,&positions,&clients).join()
+                .find(|(_,p,_,_)| p.uuid().to_string() == *uuid).map(|(e,p,pos,_)| (e,p,pos)) else {
+                link.ack(command,false,"player_offline"); return false;
+            };
+            if link.is_resident(&player.alias) || stats.get(entity).is_some_and(|s| matches!(&s.name, Content::Plain(name) if link.is_resident(name))) { link.ack(command,false,"city_human_required"); return false; }
+            let Ok(target) = city::parse_visit(&command.kind,&command.args) else { return false; };
+            let Some((x,y)) = link.landmark_position(target) else { link.ack(command,false,"unknown_city_landmark"); return false; };
+            if *queued {
+                if (pos.0.xy()-Vec2::new(x,y)).magnitude_squared() <= 25.0 {
+                    link.ack(command,true,"city_visited"); return false;
+                }
+                return true;
+            }
+            let Some(alt) = world.sim().get_alt_approx(Vec2::new(x as i32,y as i32)) else { link.ack(command,false,"city_no_ground"); return false; };
+            if let Some(z) = floor_for(&terrain,x.floor() as i32,y.floor() as i32,alt as i32,24,true) {
+                teleporter.emit(TeleportToPositionEvent { entity, position: Vec3::new(x,y,z+0.05) });
+                *queued = true;
+            } else if time.0-*last_request >= 2.0 {
+                // One configured destination chunk per online visitor, never raw coordinates.
+                chunk_requests.push(ChunkRequest { entity, key: TerrainGrid::chunk_key(Vec2::new(x as i32,y as i32)) });
+                *last_request = time.0;
+            }
+            true
+        });
+        let mut dirty = false;
+        for command in link.poll_commands(&["city_actor"]) {
+            let admission = (|| {
+                if command.player_uuid != city::PRINCIPAL { return Err("city_principal_required"); }
+                let plan = city::parse(&command.args)?;
+                if link.landmark_position(&plan.target).is_none() { return Err("unknown_city_landmark"); }
+                if !city::newer_revision(state.actors.get(&plan.id).map(|a| a.plan.revision), plan.revision) { return Err("stale_city_revision"); }
+                if !state.actors.contains_key(&plan.id) && state.actors.len() >= city::MAX_ACTORS { return Err("city_capacity"); }
+                Ok(plan)
+            })();
+            match admission {
+                Err(reason) => link.ack(&command,false,reason),
+                Ok(plan) => {
+                    let id = plan.id.clone();
+                    if let Some(actor) = state.actors.get_mut(&id) {
+                        if let Some(old) = actor.pending.take() { link.ack(&old,false,"city_superseded"); }
+                        // Identity prefix is stable; display and body scale update below.
+                        actor.plan = plan;
+                        actor.arrived = false;
+                        actor.pending = Some(command);
+                        actor.arrival = Arrival::default();
+                        actor.route.clear();
+                        actor.route_at = 0.0;
+                    } else {
+                        state.actors.insert(id, Actor { plan, pending: Some(command), position: None, body: Some(Body::Humanoid(common::comp::humanoid::Body::random())), observed_at: 0, restore_relocation: None, next_spawn_check: 0.0, arrived: false, entity: None, spawning: false, arrival: Arrival::default(), route: VecDeque::new(), route_at: 0.0 });
+                    }
+                    dirty = true;
+                }
+            }
+        }
+        // Persist intent before any spawn or motion. On failure do no new work this tick.
+        if dirty && save(&path,&state.actors).is_err() { state.persistence_blocked = true; tracing::error!("cannot persist city intent"); return; }
+        // Bootstrap only the configured arrival column, against an existing real player entity.
+        // This adds no client and stops after the first citizen can spawn.
+        if time.0 >= state.next_chunk_request && state.actors.values().any(|a| a.entity.is_none() && !a.spawning) {
+            if let (Some((x,y)),Some((entity,_))) = (link.landmark_position("city-arrival"),(&entities,&players).join().next()) {
+                let key = TerrainGrid::chunk_key(Vec2::new(x as i32,y as i32));
+                if terrain.get_key_real(key).is_none() { chunk_requests.push(ChunkRequest { entity, key }); }
+            }
+        }
+        let mut emitter = creates.emitter();
+        let mut workers = Vec::new();
+        let request_chunks = time.0 >= state.next_chunk_request;
+        if request_chunks { state.next_chunk_request = time.0 + 2.0; }
+        let mut requested_chunks = BTreeSet::new();
+        for actor in state.actors.values_mut() {
+            let expired = actor.pending.as_ref().is_some_and(|c| unix_ms() > c.expires_at);
+            if expired {
+                actor.arrived = false;
+                if let Some(command) = actor.pending.take() { link.ack(&command,false,"city_expired"); dirty = true; }
+                actor.arrival = Arrival::default();
+            }
+            // Only recover our own native NPC marker. A player's chosen alias is never eligible.
+            if actor.entity.is_none_or(|e| !entities.is_alive(e)) {
+                actor.entity = (&entities,&stats,&positions).join().find(|(e,s,_)| {
+                    players.get(*e).is_none() && matches!(&s.name, Content::Plain(n) if n.starts_with(&format!("[City:{}] ",actor.plan.id)))
+                }).map(|(e,_,_)| e);
+                if actor.entity.is_some() { actor.spawning = false; }
+            }
+            let target = link.landmark_position(&actor.plan.target);
+            let radius = actor.body.map_or(0.8,|body| body.max_radius()*stage_scale(&actor.plan.stage)+0.08).clamp(0.3,1.1);
+            if let Some(entity) = actor.entity {
+                if players.get(entity).is_some() { actor.entity = None; continue; }
+                let Some(pos) = positions.get(entity) else { continue; };
+                actor.position = Some([pos.0.x,pos.0.y,pos.0.z]);
+                actor.observed_at = unix_ms();
+                // Non-client presence retains only this native NPC's small neighbourhood.
+                // PresenceKind::Possessor carries no invented character/account ID.
+                if presences.get(entity).is_none() {
+                    let _ = presences.insert(entity, Presence::new(common::ViewDistances { terrain: 3, entity: 3 }, PresenceKind::Possessor));
+                }
+                if request_chunks {
+                    let center = TerrainGrid::chunk_key(Vec2::new(pos.0.x.floor() as i32,pos.0.y.floor() as i32));
+                    for (dx,dy) in city::chunk_offsets() {
+                        let key = center + Vec2::new(dx,dy);
+                        // Deduplicate overlapping citizens. Hard bound:16*9=144 requests/2s.
+                        if terrain.get_key_real(key).is_none() && requested_chunks.insert((key.x,key.y)) {
+                            chunk_requests.push(ChunkRequest { entity, key });
+                        }
+                    }
+                }
+                if let Some(mut s) = stats.get_mut(entity) { let desired = Content::Plain(label(&actor.plan)); if s.name != desired { s.name = desired; } }
+                if let Some(mut s) = scales.get_mut(entity) { let desired = stage_scale(&actor.plan.stage); if s.0 != desired { s.0 = desired; } }
+                let distance_squared = target.map_or(f32::INFINITY,|(x,y)| (pos.0.xy()-Vec2::new(x,y)).magnitude_squared());
+                let near = distance_squared <= ARRIVAL_RADIUS_SQUARED;
+                // Physics checks the whole capsule footprint. Sampling only the centre column
+                // falsely calls an NPC airborne when a neighbouring one-block step supports it.
+                let grounded = physics.get(entity).and_then(|p| p.on_ground.as_ref()).is_some_and(|b| b.is_solid() && !b.kind().is_liquid() && !matches!(b.kind(), BlockKind::Leaves | BlockKind::ArtLeaves | BlockKind::GlowingMushroom));
+                if actor.pending.is_some() && actor.arrival.observe(time.0, near && grounded) {
+                    if let Some(command) = actor.pending.take() { link.ack(&command,true,"city_arrived"); actor.arrived = true; dirty = true; }
+                }
+                if let Some(controller) = controllers.get_mut(entity) {
+                    let look = controller.inputs.look_dir;
+                    controller.reset();
+                    controller.inputs.look_dir = look;
+                    // Keep settling after ACK too, so small crowd pushes do not leave a worker on the outer edge.
+                    if (actor.pending.is_some() || actor.arrived) && approach_needed(distance_squared,grounded) {
+                        if let Some((x,y)) = target {
+                            if time.0 >= actor.route_at || actor.route.is_empty() {
+                                if time.0 >= actor.route_at {
+                                    if let Some(base) = if grounded { Some(pos.0.z.round()) } else { below(&terrain,pos.0) } {
+                                        actor.route = city::ground_route((pos.0.x.floor() as i32,pos.0.y.floor() as i32),base,(x.floor() as i32,y.floor() as i32),|nx,ny,z| walk_floor(&terrain,Vec2::new(nx as f32+0.5,ny as f32+0.5),radius,z as i32-1,2,false)).into();
+                                    }
+                                    actor.route_at = time.0+3.0;
+                                }
+                            }
+                            while actor.route.front().is_some_and(|&(nx,ny)| (pos.0.xy()-Vec2::new(nx as f32+0.5,ny as f32+0.5)).magnitude_squared() < 0.5) { actor.route.pop_front(); }
+                            let waypoint = actor.route.front().map_or(Vec2::new(x,y),|&(nx,ny)| Vec2::new(nx as f32+0.5,ny as f32+0.5));
+                            let (direction,jump) = steering(&terrain,pos.0,waypoint,grounded,radius);
+                            controller.inputs.move_dir = direction;
+                            if let Some(look) = common::util::Dir::from_unnormalized(direction.with_z(0.0)) { controller.inputs.look_dir = look; }
+                            if jump { controller.push_basic_input(InputKind::Jump); }
+                        }
+                    }
+                }
+                if actor.plan.activity == "build" && grounded && near && actor.arrived && !expired { workers.push(pos.0); }
+            } else if !actor.spawning && time.0 >= actor.next_spawn_check {
+                actor.next_spawn_check = time.0+2.0;
+                // Startup puts a citizen at the last saved location, or at the configured arrival
+                // gate. Never spawn at their requested work destination and pretend they walked.
+                let start = actor.position.map(|p| Vec3::new(p[0],p[1],p[2])).or_else(|| {
+                    let (x,y) = link.landmark_position("city-arrival")?;
+                    Some(Vec3::new(x,y,world.sim().get_alt_approx(Vec2::new(x as i32,y as i32))?))
+                });
+                if let Some(start) = start {
+                    let (estimate,range) = if actor.position.is_some() { (start.z.floor() as i32-1,2) } else { (start.z.floor() as i32,16) };
+                    let exact=walk_floor(&terrain,start.xy(),radius,estimate,range,actor.position.is_none()).map(|z| [start.x,start.y,z]);
+                    let spawn=exact.or_else(|| dressing.city_restore_geometry_ready().then(|| actor.position.and_then(|saved| local_restore(saved,|x,y,z| walk_floor(&terrain,Vec2::new(x,y),radius,z-1,1,true)))).flatten());
+                    if let Some(at) = spawn {
+                        let Some(body) = actor.body else { continue; };
+                        if exact.is_none() && let Some(from)=actor.position {
+                            let to=[at[0],at[1],at[2]+0.05];
+                            tracing::info!(actor_id=%actor.plan.id,?from,?to,reason="saved_footprint_unsupported","native city restore-relocation");
+                            actor.restore_relocation=Some(RestoreRelocation { from,to,at: unix_ms() });
+                            actor.position=Some(to);
+                            actor.arrived=false;
+                            actor.arrival=Arrival::default();
+                            actor.route.clear();
+                            dirty=true;
+                        }
+                        emitter.emit(CreateNpcEvent { pos: Pos(Vec3::new(at[0],at[1],at[2]+0.05)), ori: Ori::default(), npc: NpcBuilder::new(Stats::new(Content::Plain(label(&actor.plan)),body),body,Alignment::Npc).with_scale(Scale(stage_scale(&actor.plan.stage))) });
+                        actor.spawning = true;
+                    }
+                }
+            }
+        }
+        state.workers = workers;
+        if dirty || time.0-state.last_save >= 10.0 {
+            if let Err(err) = save(&path,&state.actors) { tracing::error!(?err,"city checkpoint failed"); }
+            else { state.last_save = time.0; }
+        }
+    }
+}
+
+#[cfg(test)]
+mod approach_tests {
+    use super::*;
+
+    #[test]
+    fn office_edge_observation_keeps_approaching_inside_ack_radius() {
+        let dx = 15159.545_f32 - 15159.0;
+        let dy = 16167.955_f32 - 16163.0;
+        let distance_squared = dx * dx + dy * dy;
+        assert!(distance_squared <= ARRIVAL_RADIUS_SQUARED);
+        assert!(approach_needed(distance_squared, true));
+    }
+
+    #[test]
+    fn movement_settles_within_two_blocks_and_keeps_ground_requirement() {
+        assert!(!approach_needed(4.0, true));
+        assert!(!approach_needed(0.0, true));
+        assert!(approach_needed(4.01, true));
+        assert!(approach_needed(0.0, false));
+        assert_eq!(ARRIVAL_RADIUS_SQUARED, 25.0);
+    }
+    #[test]
+    fn checked_wood_stairs_are_walkable_but_never_fresh_spawn_support() {
+        assert!(support_allowed(SupportMaterial::Wood, false));
+        assert!(!support_allowed(SupportMaterial::Wood, true));
+        assert!(!support_allowed(SupportMaterial::Foliage, false));
+        assert!(!support_allowed(SupportMaterial::Foliage, true));
+        assert!(support_allowed(SupportMaterial::Terrain, true));
+        assert_eq!(city::step_jump(433.0,432.0),Some(false));
+        assert_eq!(city::step_jump(432.0,431.0),Some(false));
+        assert_eq!(city::step_jump(433.0,431.0),None);
+    }
+    #[test]
+    fn clearance_checks_neighbouring_capsule_columns_with_a_hard_bound() {
+        let columns = footprint_columns(0.5,0.5,0.75);
+        assert!(columns.contains(&(1,0)));
+        assert!(columns.contains(&(-1,0)));
+        assert!(columns.contains(&(0,1)));
+        assert!(columns.contains(&(0,-1)));
+        assert!(footprint_columns(0.5,0.5,1000.0).len() <= 25);
+    }
+
+    #[test]
+    fn restore_prefers_local_ground_over_an_isolated_roof() {
+        let saved=[15193.653,16225.21,436.0];
+        let recover=local_restore(saved,|x,y,z| {
+            if z==436 && x==saved[0] && y==saved[1] { Some(436.0) }
+            else if z==430 && x==saved[0]-1.5 && y==saved[1] { Some(430.0) }
+            else { None }
+        });
+        assert_eq!(recover,Some([saved[0]-1.5,saved[1],430.0]));
+    }
+    #[test]
+    fn restore_search_is_deterministic_and_hard_bounded() {
+        let saved=[15199.352,16220.482,437.0];
+        let mut calls=0;
+        let result=local_restore(saved,|x,y,z| {
+            calls+=1;
+            assert!((x-saved[0]).powi(2)+(y-saved[1]).powi(2)<=16.0);
+            assert!((z as f32-saved[2]).abs()<=12.0);
+            None
+        });
+        assert_eq!(result,None);
+        assert!(calls>0 && calls<=197*25);
+        let run=|| local_restore(saved,|x,y,z| (z==431 && (x-saved[0]).abs()==1.0 && y==saved[1]).then_some(431.0));
+        assert_eq!(run(),Some([saved[0]-1.0,saved[1],431.0]));
+        assert_eq!(run(),run());
+    }
+    #[test]
+    fn restore_rejects_a_callback_floor_outside_vertical_bound() {
+        assert_eq!(local_restore([0.0,0.0,437.0],|_,_,_|Some(420.0)),None);
+    }
+
+    #[test]
+    fn old_world_record_timestamps_cannot_authorize_restore_relocation() {
+        let recorded=[("city-home-3-foundation",u64::MAX),("city-home-3-shell",u64::MAX),("city-home-3-complete",u64::MAX)];
+        let mut current=BTreeSet::new();
+        let ready=|current: &BTreeSet<String>|city_restore_ready(recorded.iter().map(|(id,_)|*id),current);
+        assert!(!ready(&current));
+        current.insert("city-home-3-foundation".into());
+        assert!(!ready(&current));
+        current.insert("city-home-3-shell".into());
+        assert!(ready(&current));
+        assert!(city_restore_ready(std::iter::empty(),&BTreeSet::new()));
+    }
+
