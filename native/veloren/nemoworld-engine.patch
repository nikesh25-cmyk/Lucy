--- /dev/null
+++ b/server/src/nemo/world/dress.rs
@@ -0,0 +1,807 @@
+//! NemoWorld world dressing: a manifest becomes real props and a furnished interior in Harr.
+//!
+//! NemoWorld writes a **manifest** (a file, never a command and never a coordinate) saying what a
+//! small part of a named Veloren site should contain: blocks, sprites, foundations, and which NemoWorld
+//! hour maps to which hour of the Veloren day. This system reads that manifest from the link config's
+//! `world` section, resolves every group's anchor from **world generation** (the site's origin, or the
+//! `nth` plot of a kind of it — the same rule the atlas and the home stream use), writes the blocks
+//! through `BlockChange`, and records what it applied next to the outbox.
+//!
+//! ```json
+//! "world": { "path": "<manifest.json>", "site": "Harr" }
+//! ```
+//!
+//! Off unless that section is there. `"enabled": false` turns it off again.
+//!
+//! Why it re-applies instead of relying on persistence: a block written into the live terrain is lost
+//! when its chunk is regenerated, and the experimental terrain-persistence store (off by default,
+//! `server/src/settings/mod.rs:234`) is written by `/make_block` and `/make_sprite`, not by
+//! `BlockChange` (grep `terrain_persistence.set_block` — only `server/src/cmd.rs`). So the record in
+//! `<outbox>.world.json` plus a cheap sentinel check every pass is what makes the world the same after
+//! a restart: a group whose sentinel cells no longer hold what the plan wants is written again, and a
+//! group that still stands is not touched at all (see `logic::decide`).
+//!
+//! What it will **not** do: undo. The record says where a group was applied, but not what was there
+//! before, so a group removed from the manifest leaves its blocks in the world and is reported
+//! (`logic::orphans`) instead of being "undone" by guessing. It also never sets the weather — weather
+//! zones are queued through the weather job the admin `/weather_zone` command owns
+//! (`server/src/weather/tick.rs`, `queue_zone`), which is a server object this system would have to
+//! hold a mutable ECS handle to, so the manifest's `weather` flag is recorded as *ignored* instead of
+//! silently pretending. The time of day **is** set, from NemoWorld's own published clock
+//! (`nemo-world-core::sky`), and because the absolute time is pinned to that clock every pass, an
+//! in-game day lasts NemoWorld's 120 real minutes rather than the settings' `day_length`.
+
+use super::logic::{self, Applied, Config, Decision, GroupRecord, Record, Voxel, RECORD_FORMAT};
+use crate::sys::nemo_link::NemoLinkState;
+use common::{
+    comp::{Player, Pos},
+    resources::{Time, TimeOfDay},
+    terrain::{Block, BlockKind, TerrainGrid},
+    vol::{FilledVox, ReadVol},
+};
+use common_ecs::{Job, Origin, Phase, System};
+use common_state::BlockChange;
+use nemo_world_core::{
+    manifest::{self, Planned, Resolver},
+    sky,
+};
+use specs::{Join, Read, ReadExpect, ReadStorage, Write};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+use tracing::{info, warn};
+use vek::{Vec2, Vec3};
+use world::{IndexOwned, World};
+
+/// The command kinds this system claims. `works_unlock` is research telling the works what the village has
+/// learned; it is allow-listed against the manifest's own `needs_tech` values.
+const KINDS: [&str; 1] = ["works_unlock"];
+
+/// How close (blocks) a person must stand to a work site to count toward its crew.
+const CREW_RADIUS: f32 = 20.0;
+
+/// The most visitors one stage can credit, so a crowd cannot make an unbounded number of facts.
+const MAX_HELPED_PER_STAGE: usize = 8;
+
+/// How long one visitor's help for one project is not recorded again. A stage is only ever built once,
+/// so this is a safety net for the case a changed manifest makes the same stage be written again while
+/// the same crew stands there; it is per (player, project), never per stage.
+const HELPED_COOLDOWN_SECS: u64 = 300;
+
+/// How often the system works, in seconds of game time.
+const EVERY: f64 = 0.5;
+
+/// Standing on the ground where a manifest puts a group: the terrain is ready.
+fn chunks_loaded(terrain: &TerrainGrid, plan: &Planned) -> bool {
+    let (mut x0, mut x1) = (plan.anchor.0, plan.anchor.0);
+    let (mut y0, mut y1) = (plan.anchor.1, plan.anchor.1);
+    for (x, y) in plan.columns() {
+        x0 = x0.min(x);
+        x1 = x1.max(x);
+        y0 = y0.min(y);
+        y1 = y1.max(y);
+    }
+    [(x0, y0), (x1, y0), (x0, y1), (x1, y1), plan.ground_at, plan.anchor]
+        .iter()
+        .all(|&(x, y)| terrain.get_key_real(TerrainGrid::chunk_key(Vec2::new(x, y))).is_some())
+}
+
+/// Foliage and trunks are not ground: a tree is cleared, not built on (`nemo_home.rs:211-213`).
+fn is_foliage(kind: BlockKind) -> bool {
+    matches!(kind, BlockKind::Leaves | BlockKind::ArtLeaves | BlockKind::Wood | BlockKind::GlowingMushroom)
+}
+
+/// The ground of one column: the highest solid non-foliage block near the world's own estimate of the
+/// altitude, exactly as the home stream measures it (`nemo_home.rs:224-236`). `Err` says why there is
+/// no ground to build on, and that group is refused rather than placed on water.
+fn ground_at(terrain: &TerrainGrid, world: &World, x: i32, y: i32) -> Result<i32, String> {
+    let estimate = world
+        .sim()
+        .get_alt_approx(Vec2::new(x, y))
+        .ok_or_else(|| format!("the world has no altitude at ({x}, {y})"))? as i32;
+    for z in ((estimate - 40)..=(estimate + 40)).rev() {
+        let Ok(block) = terrain.get(Vec3::new(x, y, z)) else { continue };
+        if block.kind().is_liquid() {
+            return Err(format!("the ground at ({x}, {y}) is liquid"));
+        }
+        if block.is_filled() && !is_foliage(block.kind()) {
+            return Ok(z);
+        }
+    }
+    Err(format!("no ground at ({x}, {y})"))
+}
+
+/// The terrain as `logic::stamp` wants it: reads from the live terrain, writes into this tick's
+/// `BlockChange` (the resource behind the admin `/make_block`, `server/src/cmd.rs:816-840`).
+struct Grid<'a> {
+    terrain: &'a TerrainGrid,
+    changes: &'a mut BlockChange,
+}
+
+impl Voxel for Grid<'_> {
+    fn get(&self, cell: [i32; 3]) -> Option<Block> {
+        self.terrain
+            .get(Vec3::new(cell[0], cell[1], cell[2]))
+            .ok()
+            .copied()
+    }
+
+    fn set(&mut self, cell: [i32; 3], block: Block) {
+        self.changes
+            .set(Vec3::new(cell[0], cell[1], cell[2]), block);
+    }
+}
+
+/// Where a named site and its plots are, asked of world generation — the same resolution the atlas
+/// (`server/src/nemo/atlas/mod.rs:195-207`) and the link's landmarks (`nemo_link.rs:214-230`) use:
+/// the site's origin, or the `nth` plot of a kind, nearest the origin first.
+struct Sites<'a>(&'a IndexOwned);
+
+impl Resolver for Sites<'_> {
+    fn site_origin(&self, site: &str) -> Option<(i32, i32)> {
+        let index = self.0.as_index_ref();
+        index
+            .sites
+            .values()
+            .find(|s| s.name() == Some(site))
+            .map(|s| (s.origin.x as i32, s.origin.y as i32))
+    }
+
+    fn plot_centre(&self, site: &str, plot: &str, nth: usize) -> Option<(i32, i32)> {
+        let index = self.0.as_index_ref();
+        let site = index.sites.values().find(|s| s.name() == Some(site))?;
+        let mut plots: Vec<_> = site
+            .plots()
+            .filter(|p| p.kind().to_string() == plot)
+            .map(|p| site.tile_center_wpos(p.root_tile()))
+            .collect();
+        plots.sort_by_key(|wpos| (wpos - site.origin).magnitude_squared());
+        plots.get(nth).map(|wpos| (wpos.x as i32, wpos.y as i32))
+    }
+}
+
+fn unix_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis() as u64)
+}
+
+fn write_atomically(path: &Path, text: &str) {
+    let tmp = path.with_extension("tmp");
+    if let Err(e) = fs::write(&tmp, text).and_then(|()| fs::rename(&tmp, path)) {
+        warn!("could not write {}: {e}", path.display());
+    }
+}
+
+#[derive(Default)]
+pub struct NemoWorldState {
+    loaded: bool,
+    cfg: Option<Config>,
+    /// Where the record goes (`<outbox>.world.json`). Kept separately from `cfg`, because the pass
+    /// takes the config out while it works and the record must still be written.
+    record_path: Option<PathBuf>,
+    /// The manifest, resolved against this world: one entry per group.
+    plans: Vec<Planned>,
+    surface_plans: BTreeMap<String, Planned>,
+    /// The site's origin from world generation, for the record.
+    origin: [i32; 2],
+    /// Group id -> the ground height it was measured at.
+    grounds: BTreeMap<String, i32>,
+    /// Group id -> the digest of what it writes. The plan and the ground never change once measured, and hashing
+    /// every cell of every group twice a second is wasted work on the tick thread.
+    digests: BTreeMap<String, String>,
+    /// Group id -> why it is not in the world yet, but may be later.
+    waiting: BTreeMap<String, String>,
+    /// Group id -> why it can never be placed here.
+    blocked: BTreeMap<String, String>,
+    /// (group id) -> cell -> how often that cell was written and found gone again.
+    misses: BTreeMap<String, BTreeMap<[i32; 3], u32>>,
+    /// Group id -> the cells the game removes again by itself (see `logic::GONE_AFTER`).
+    gone: BTreeMap<String, BTreeSet<[i32; 3]>>,
+    record: Record,
+    last_run: f64,
+    /// Wall-clock ms of the previous pass, and ms of works time not yet written to the record.
+    works_last_ms: u64,
+    works_unsaved_ms: u64,
+    /// The NemoWorld phase the log last mentioned, so each change is logged once.
+    logged_phase: Option<String>,
+    /// The manifest was refused, or the site does not exist here: nothing else will be tried.
+    given_up: bool,
+    /// `player uuid|project` -> wall-clock ms of the last `project.helped` made for that pair, so one
+    /// visitor's help for one project cannot be recorded twice in a row.
+    helped: BTreeMap<String, u64>,
+    /// Group id -> the crew size the last pass counted, so a change (and a crowd arriving) is logged once.
+    crew_seen: BTreeMap<String, usize>,
+    /// Actual stamps in this process; saved applied_at timestamps cannot authorize NPC relocation.
+    city_restore_stamps: BTreeSet<String>,
+    /// Stamped groups subsequently observed intact, after queued BlockChange reached terrain.
+    city_restore_verified: BTreeSet<String>,
+}
+
+impl NemoWorldState {
+    /// Exact NPC restores remain independent. Only fallback relocation waits for old house shells.
+    pub fn city_restore_geometry_ready(&self) -> bool {
+        self.loaded && !self.given_up && crate::sys::nemo_city::city_restore_ready(self.record.groups.keys().map(String::as_str), &self.city_restore_verified)
+    }
+
+    fn save(&self) {
+        let Some(path) = &self.record_path else { return };
+        match serde_json::to_string_pretty(&self.record) {
+            Ok(text) => write_atomically(path, &text),
+            Err(e) => warn!("could not serialise the world record: {e}"),
+        }
+    }
+
+    /// True when this visitor's help for this project has not been recorded recently, and records it.
+    fn helped_cooled(&mut self, key: &str, now_ms: u64, cooldown_ms: u64) -> bool {
+        if let Some(last) = self.helped.get(key) && now_ms.saturating_sub(*last) < cooldown_ms {
+            return false;
+        }
+        self.helped.insert(key.to_owned(), now_ms);
+        true
+    }
+
+    /// Plan the manifest against this world. One problem refuses the whole manifest, with every
+    /// reason in the log and in the record, and nothing is ever applied from it.
+    fn resolve(&mut self, index: &IndexOwned) -> bool {
+        let Some(cfg) = &self.cfg else { return false };
+        let sites = Sites(index);
+        match manifest::plan(&cfg.manifest, &sites) {
+            Ok(plans) => {
+                let summary = cfg.manifest.summary();
+                self.origin = sites.site_origin(&cfg.site).map_or([0, 0], |(x, y)| [x, y]);
+                self.record.site = cfg.site.clone();
+                self.record.manifest = cfg.manifest_path.display().to_string();
+                self.record.origin = self.origin;
+                info!(
+                    "NemoWorld world dressing is on: site {} at ({}, {}), {} groups, {} blocks, {} sprites ({} of them lit), {} foundation columns",
+                    cfg.site,
+                    self.origin[0],
+                    self.origin[1],
+                    summary.groups,
+                    summary.blocks,
+                    summary.sprites,
+                    summary.lit_sprites,
+                    summary.foundation_columns
+                );
+                for plan in &plans {
+                    info!(group = %plan.id, anchor = ?plan.anchor, "NemoWorld world dressing placed a group's anchor");
+                }
+                // Construction: every staged group, for the works board, with its project and release time.
+                self.record.schedule = cfg
+                    .manifest
+                    .groups
+                    .iter()
+                    .filter(|g| !g.project.is_empty())
+                    .map(|g| {
+                        // The previous stage of the same project, in the manifest's order.
+                        let after = cfg
+                            .manifest
+                            .groups
+                            .iter()
+                            .take_while(|other| other.id != g.id)
+                            .filter(|other| other.project == g.project)
+                            .last()
+                            .map(|other| other.id.clone())
+                            .unwrap_or_default();
+                        (g.id.clone(), logic::ScheduleEntry {
+                            project: g.project.clone(),
+                            title: g.title.clone(),
+                            site: g.site.clone(),
+                            needs_tech: g.needs_tech.clone(),
+                            release_after_minutes: g.release_after_minutes,
+                            crew: g.crew,
+                            after,
+                        })
+                    })
+                    .collect();
+                self.plans = plans;
+                true
+            },
+            Err(reasons) => {
+                for reason in &reasons {
+                    warn!("NemoWorld world dressing refused the manifest: {reason}");
+                }
+                self.record.refused = reasons;
+                self.given_up = true;
+                self.save();
+                false
+            },
+        }
+    }
+
+    /// NemoWorld's clock, written into the server's own time of day. The manifest's hours say which
+    /// Veloren hour each NemoWorld phase starts at; the absolute value is pinned every pass, so the
+    /// day is exactly as long as NemoWorld's published cycle (120 real minutes) and identical on every
+    /// server and client.
+    fn atmosphere(&mut self, cfg: &Config, time_of_day: &mut TimeOfDay) {
+        let now = unix_ms();
+        if cfg.manifest.atmosphere.time {
+            let hours = cfg.manifest.atmosphere.sky_hours();
+            let target = sky::day_seconds_at(now, &hours);
+            let wanted = sky::nearest_time_of_day(time_of_day.0, target);
+            if (wanted - time_of_day.0).abs() > 1.0 {
+                time_of_day.0 = wanted;
+            }
+        }
+        let phase = sky::phase_at(now);
+        if self.logged_phase.as_deref() != Some(phase.name()) {
+            self.logged_phase = Some(phase.name().to_owned());
+            let day = time_of_day.0.rem_euclid(86_400.0);
+            info!(
+                "NemoWorld world dressing: it is {} in NemoWorld; the Veloren clock is at {:02}:{:02}{}",
+                phase.name(),
+                (day / 3600.0) as u32,
+                ((day % 3600.0) / 60.0) as u32,
+                if cfg.manifest.atmosphere.time { "" } else { " (the manifest leaves the clock alone)" }
+            );
+        }
+    }
+}
+
+fn load(state: &mut NemoWorldState, index: &IndexOwned) {
+    let path = std::env::var("NEMO_LINK_CONFIG").unwrap_or_default();
+    match logic::load_config_from(&path) {
+        Ok(None) => info!("NemoWorld world dressing is off (no world section in {path})"),
+        Err(reason) => {
+            warn!("NemoWorld world dressing cannot start: {reason}");
+            state.given_up = true;
+        },
+        Ok(Some(cfg)) => {
+            state.record_path = Some(cfg.record_path.clone());
+            state.record = logic::load_record(&cfg.record_path).unwrap_or_else(|| Record {
+                format: RECORD_FORMAT.to_owned(),
+                site: cfg.site.clone(),
+                manifest: cfg.manifest_path.display().to_string(),
+                ..Record::default()
+            });
+            state.record.format = RECORD_FORMAT.to_owned();
+            state.record.refused.clear();
+            state.record.ignored.clear();
+            // What the manifest asks for that this server does not do is recorded, not hidden.
+            if cfg.manifest.atmosphere.weather {
+                state.record.ignored.push(
+                    "atmosphere.weather: this server sets the time of day, not the weather; weather \
+                     zones are queued through the weather job the admin /weather_zone command owns"
+                        .into(),
+                );
+                warn!(
+                    "the manifest asks for NemoWorld's weather, which this server cannot set from a \
+                     system; the time of day is set and the weather is left alone"
+                );
+            }
+            if !cfg.manifest.atmosphere.time {
+                state.record.ignored.push("atmosphere.time: false in the manifest".into());
+            }
+            let unplayable = logic::unplayable(&cfg.manifest);
+            if !unplayable.is_empty() {
+                for problem in &unplayable {
+                    warn!("NemoWorld world dressing refused the manifest: {problem}");
+                }
+                state.record.refused = unplayable;
+                state.given_up = true;
+                state.cfg = Some(cfg);
+                state.save();
+                return;
+            }
+            state.cfg = Some(cfg);
+            state.resolve(index);
+        },
+    }
+}
+
+/// What one pass did: whether the record changed, and the help it witnessed. Only the **first** time a
+/// crew-gated stage is built credits anyone — restoring the town after a restart (`not-standing`) or
+/// replacing a changed stage is not a new act of cooperation and must never re-earn a fact.
+#[derive(Default)]
+struct Pass {
+    changed: bool,
+    helped: Vec<Helped>,
+}
+
+/// A visitor who stood in a crew while a stage of a project was first built.
+struct Helped {
+    uuid: String,
+    alias: String,
+    project: String,
+    site: String,
+}
+
+/// One pass of the work: whatever is measurable is measured, at most one group is written, and the
+/// record is saved when something changed.
+fn pass(
+    state: &mut NemoWorldState,
+    terrain: &TerrainGrid,
+    world: &World,
+    changes: &mut BlockChange,
+    people: &[logic::Nearby],
+    city: &crate::sys::nemo_city::NemoCityState,
+) -> Pass {
+    let mut helped: Vec<Helped> = Vec::new();
+    // 1. Measure the ground of every group whose terrain is loaded. Nothing is written here.
+    for index in 0..state.plans.len() {
+        let id = state.plans[index].id.clone();
+        if state.grounds.contains_key(&id) {
+            continue;
+        }
+        let measured = {
+            let plan = &state.plans[index];
+            if !chunks_loaded(terrain, plan) {
+                Err("chunks_not_loaded".to_owned())
+            } else {
+                let prior = state.record.groups.get(&id).or_else(|| {
+                    let project = &state.record.schedule.get(&id)?.project;
+                    state.record.schedule.iter().find_map(|(other,entry)| {
+                        (entry.project == *project).then(|| state.record.groups.get(other)).flatten()
+                            .filter(|saved| saved.anchor == [plan.anchor.0,plan.anchor.1])
+                    })
+                });
+                let pinned = prior.and_then(|saved| world.sim().get_alt_approx(Vec2::new(plan.ground_at.0,plan.ground_at.1))
+                    .and_then(|estimate| nemo_world_core::surface::saved_ground(plan.anchor,saved.anchor,saved.ground,estimate as i32)));
+                pinned.map(Ok).unwrap_or_else(|| ground_at(terrain, world, plan.ground_at.0, plan.ground_at.1))
+            }
+        };
+        match measured {
+            Ok(z) => {
+                // The terrain is here now: "chunks_not_loaded" is no longer true of this group.
+                state.waiting.remove(&id);
+                state.grounds.insert(id, z);
+            },
+            // The terrain is not here yet: this group is written by a later pass.
+            Err(why) if why == "chunks_not_loaded" => {
+                state.waiting.insert(id, why);
+            },
+            // The terrain is here and there is nothing to build on: this group is refused for good.
+            Err(why) => {
+                warn!(group = %id, reason = %why, "NemoWorld world dressing cannot place a group");
+                state.blocked.insert(id, why);
+            },
+        }
+    }
+
+    // Construction: the works clock starts once and is kept in the record for good. It counts the time the world is
+    // really open, so a night with the server off builds nothing.
+    let now_ms = unix_ms();
+    let before = state.record.works_elapsed_ms;
+    state.record.works_elapsed_ms = logic::tick_clock(before, state.works_last_ms, now_ms, 5_000);
+    state.works_last_ms = now_ms;
+    state.works_unsaved_ms += state.record.works_elapsed_ms - before;
+    let mut clock_started = false;
+    if state.record.works_started_ms == 0 && !state.record.schedule.is_empty() {
+        state.record.works_started_ms = now_ms;
+        clock_started = true;
+        info!("NemoWorld construction: the works clock started; {} stages are scheduled", state.record.schedule.len());
+    }
+
+    // 2. One group per pass, in the manifest's own order, so a big manifest cannot stall a frame.
+    let mut changed = clock_started;
+    if state.works_unsaved_ms >= 30_000 {
+        state.works_unsaved_ms = 0;
+        changed = true;
+    }
+    let mut stamped: Option<(String, &'static str, Applied)> = None;
+    let mut gave_up: Vec<(String, Vec<[i32; 3]>)> = Vec::new();
+    for index in 0..state.plans.len() {
+        let plan = &state.plans[index];
+        let id = plan.id.clone();
+        let Some(&ground) = state.grounds.get(&id) else { continue };
+        if nemo_world_core::surface::is_city_surface(&id) && !state.surface_plans.contains_key(&id) {
+            let levels = if let Some(saved) = state.record.surface_levels.get(&id) { Ok(saved.clone()) } else {
+                nemo_world_core::surface::columns(plan).into_iter().map(|(dx,dy)| {
+                    let x=plan.anchor.0+dx; let y=plan.anchor.1+dy;
+                    if terrain.get_key_real(TerrainGrid::chunk_key(Vec2::new(x,y))).is_none() { return Err("chunks_not_loaded".to_owned()); }
+                    ground_at(terrain,world,x,y).map(|z| [dx,dy,z-ground])
+                }).collect::<Result<Vec<_>,_>>()
+            };
+            match levels.and_then(|levels| nemo_world_core::surface::project(plan,&levels).map(|projected| (levels,projected))) {
+                Ok((levels,projected)) => { state.record.surface_levels.insert(id.clone(),levels); state.surface_plans.insert(id.clone(),projected); changed=true; },
+                Err(reason) => { state.waiting.insert(id.clone(),format!("surface grade: {reason}")); continue; },
+            }
+        }
+        let plan=state.surface_plans.get(&id).unwrap_or(plan);
+        let applied_before = state.record.groups.contains_key(&id);
+        // A stage that was never built waits for its turn. A stage already built is restored at once after a
+        // restart: the town comes back as it was, and building carries on from the clock.
+        if !applied_before
+            && let Some(entry) = state.record.schedule.get(&id)
+            && !logic::due(entry.release_after_minutes, state.record.works_elapsed_ms)
+        {
+            let wait = logic::minutes_until(entry.release_after_minutes, state.record.works_elapsed_ms);
+            state.waiting.insert(id.clone(), format!("not due: builds in {wait} min"));
+            continue;
+        }
+        // Cooperation: a stage waits for the one before it, and for a crew standing at the site.
+        if !applied_before && let Some(entry) = state.record.schedule.get(&id) {
+            if !entry.after.is_empty() && !state.record.groups.contains_key(&entry.after) {
+                state.waiting.insert(id.clone(), "waiting for the previous stage".to_owned());
+                continue;
+            }
+            // Research gates works: until NemoWorld's signed `works_unlock` says the village learned the
+            // technology, the stage is only waiting — never built, and never shown as done.
+            if !logic::unlocked(&entry.needs_tech, &state.record.unlocked) {
+                state.waiting.insert(id.clone(), format!("waiting for research: {}", entry.needs_tech));
+                continue;
+            }
+            if entry.crew > 0 {
+                // `Planned::ground_at` is already absolute (the crate adds the anchor in `plan`), so the
+                // crew stands around the group's own anchor; adding it again would put the circle in an
+                // empty field two site-widths away and no crowd could ever count.
+                let at = logic::crew_centre(plan);
+                let here = if id.starts_with("city-") {
+                    city.workers_near(plan.ground_at.0 as f32, plan.ground_at.1 as f32, CREW_RADIUS)
+                } else { logic::crew_present(people, at, CREW_RADIUS) };
+                // One line per change, at most: who is standing here is an operational fact, not a log flood.
+                if state.crew_seen.insert(id.clone(), here) != Some(here) {
+                    info!(group = %id, here, need = entry.crew, people = people.len(), "NemoWorld construction: the crew at a stage changed");
+                }
+                if here < usize::from(entry.crew) {
+                    state.waiting.insert(id.clone(), format!("needs a crew: {here} of {} nearby", entry.crew));
+                    continue;
+                }
+            }
+        }
+        // Every gate has been passed: whatever this group was waiting for (a chunk, its turn, a crew) is no
+        // longer true. Without this a group that stands, or that was just built, keeps the reason from the
+        // pass that first held it for ever in the record (`waiting`), and the works board shows it.
+        state.waiting.remove(&id);
+        let gone = state.gone.get(&id).cloned().unwrap_or_default();
+        let absent = logic::missing(plan, ground, &Grid { terrain, changes: &mut *changes }, &gone);
+        // A sentinel whose chunk is not loaded says nothing either way: leave the group alone rather
+        // than write into a chunk that is not there, and never count "cannot tell" as a removal.
+        let unreadable = logic::unreadable(plan, ground, &Grid { terrain, changes: &mut *changes }, &gone);
+        if !unreadable.is_empty() {
+            state.waiting.insert(id.clone(), "chunks_not_loaded".to_owned());
+            continue;
+        }
+
+        // A cell this group was written with that is gone again was removed by the game itself. After
+        // `GONE_AFTER` tries it is not counted as part of the group any more (so a stubborn sprite
+        // cannot make the system rewrite the whole group for ever), and it is recorded as removed.
+        if applied_before {
+            let misses = state.misses.entry(id.clone()).or_default();
+            let newly_gone = logic::count_misses(misses, &absent);
+            if !newly_gone.is_empty() {
+                let at: Vec<[i32; 3]> = newly_gone
+                    .iter()
+                    .map(|cell| [plan.anchor.0 + cell[0], plan.anchor.1 + cell[1], ground + cell[2]])
+                    .collect();
+                state.gone.entry(id.clone()).or_default().extend(newly_gone.iter().copied());
+                gave_up.push((id.clone(), at));
+            }
+        }
+        let gone = state.gone.get(&id).cloned().unwrap_or_default();
+        let absent: Vec<[i32; 3]> = absent.into_iter().filter(|cell| !gone.contains(cell)).collect();
+
+        let fresh = state.digests.entry(id.clone()).or_insert_with(|| logic::digest(plan, ground)).clone();
+        let (decision, reason) = logic::decide(state.record.groups.get(&id), &fresh, absent.is_empty());
+        if decision == Decision::Keep {
+            if state.city_restore_stamps.contains(&id) { state.city_restore_verified.insert(id.clone()); }
+            continue;
+        }
+        // Who stood in the crew when this stage was first built. Only a first-time build credits anyone
+        // (a restart restoring the town, or a stage rewritten after a manifest change, is not new
+        // cooperation), and only a crew-gated stage that names its landmark has a fact to make.
+        let mut credited: Vec<Helped> = Vec::new();
+        if !applied_before
+            && !id.starts_with("city-")
+            && let Some(entry) = state.record.schedule.get(&id)
+            && entry.crew > 0
+            && !entry.site.is_empty()
+        {
+            let at = logic::crew_centre(plan);
+            credited = logic::helpers(people, at, CREW_RADIUS, MAX_HELPED_PER_STAGE)
+                .into_iter()
+                .map(|(uuid, alias)| Helped {
+                    uuid,
+                    alias,
+                    project: entry.project.clone(),
+                    site: entry.site.clone(),
+                })
+                .collect();
+        }
+        let applied = logic::stamp(plan, ground, &mut Grid { terrain, changes });
+        if id.starts_with("city-home-") && (id.ends_with("-foundation") || id.ends_with("-shell")) {
+            state.city_restore_stamps.insert(id.clone());
+        }
+        let removed: Vec<[i32; 3]> = gone
+            .iter()
+            .map(|cell| [plan.anchor.0 + cell[0], plan.anchor.1 + cell[1], ground + cell[2]])
+            .collect();
+        state.record.groups.insert(
+            id.clone(),
+            GroupRecord {
+                digest: fresh,
+                anchor: [plan.anchor.0, plan.anchor.1],
+                ground,
+                cells: applied.cells,
+                blocks: applied.blocks,
+                sprites: applied.sprites,
+                foundation_columns: applied.foundation_columns,
+                written: applied.written,
+                applied_at: unix_ms(),
+                removed,
+            },
+        );
+        state.waiting.remove(&id);
+        helped.extend(credited);
+        stamped = Some((id.clone(), reason, applied));
+        break;
+    }
+
+    // 3. The record: what is in the world, what is not, and why.
+    for (id, cells) in gave_up {
+        warn!(
+            group = %id,
+            cells = ?cells,
+            "the game removes these cells again after they are written (a sprite whose adjacency \
+             requirement is not met where the manifest puts it, common/src/terrain/sprite/mod.rs); \
+             the rest of the group is kept and the cells are recorded as removed"
+        );
+        if let Some(record) = state.record.groups.get_mut(&id) {
+            for cell in cells {
+                if !record.removed.contains(&cell) {
+                    record.removed.push(cell);
+                }
+            }
+        }
+        changed = true;
+    }
+    if let Some((id, reason, applied)) = stamped {
+        info!(
+            group = %id,
+            reason,
+            cells = applied.cells,
+            written = applied.written,
+            blocks = applied.blocks,
+            sprites = applied.sprites,
+            foundation_columns = applied.foundation_columns,
+            "NemoWorld world dressing wrote a group"
+        );
+        changed = true;
+    }
+    let mut waiting: BTreeMap<String, String> = state.waiting.clone();
+    waiting.extend(state.blocked.iter().map(|(id, why)| (id.clone(), why.clone())));
+    if state.record.waiting != waiting {
+        state.record.waiting = waiting;
+        changed = true;
+    }
+    Pass { changed, helped }
+}
+
+#[derive(Default)]
+pub struct Sys;
+
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Read<'a, Time>,
+        Read<'a, crate::sys::nemo_city::NemoCityState>,
+        Write<'a, TimeOfDay>,
+        Write<'a, NemoLinkState>,
+        Write<'a, NemoWorldState>,
+        Write<'a, BlockChange>,
+        ReadExpect<'a, TerrainGrid>,
+        ReadExpect<'a, Arc<World>>,
+        ReadExpect<'a, IndexOwned>,
+        ReadStorage<'a, Pos>,
+        ReadStorage<'a, Player>,
+    );
+
+    const NAME: &'static str = "nemo_world";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(
+        _job: &mut Job<Self>,
+        (time, city, mut time_of_day, mut link, mut state, mut changes, terrain, world, index, positions, players): Self::SystemData,
+    ) {
+        let state = &mut *state;
+        if !link.is_on() {
+            return;
+        }
+        let now = time.0;
+        if !state.loaded {
+            state.loaded = true;
+            load(state, &index);
+            // The first pass says what is on, even when there is nothing to do.
+            if let Some(cfg) = state.cfg.take() {
+                state.record.updated_at = unix_ms();
+                state.cfg = Some(cfg);
+                state.save();
+            }
+        }
+        let Some(cfg) = state.cfg.take() else { return };
+        if !state.given_up {
+            if now - state.last_run >= EVERY {
+                state.last_run = now;
+                let people: Vec<logic::Nearby> = (&positions, &players)
+                    .join()
+                    .map(|(pos, player)| logic::Nearby {
+                        uuid: player.uuid().to_string(),
+                        alias: player.alias.clone(),
+                        x: pos.0.x,
+                        y: pos.0.y,
+                        // A configured resident is the village's own crew, not a visitor who helped:
+                        // the same exact-alias test the link uses to tell residents from visitors.
+                        resident: link.is_resident(&player.alias),
+                    })
+                    .collect();
+                // Research gates works: NemoWorld says which technologies the village has learned. The
+                // allow-list is the manifest's own `needs_tech` values, so a command can never name
+                // anything this server does not build; the unlocked set lives in the record and survives
+                // a restart. Nothing is assumed from silence: an unacknowledged unlock leaves the stage
+                // waiting, not built.
+                let known: BTreeSet<String> = state
+                    .record
+                    .schedule
+                    .values()
+                    .map(|entry| entry.needs_tech.clone())
+                    .filter(|tech| !tech.is_empty())
+                    .collect();
+                let mut newly_unlocked = false;
+                for command in link.poll_commands(&KINDS) {
+                    match logic::unlock_tech(&command.args) {
+                        Some(tech) if known.contains(&tech) => {
+                            let fresh = state.record.unlocked.insert(tech.clone());
+                            link.ack(&command, true, if fresh { "unlocked" } else { "already_unlocked" });
+                            info!(tech = %tech, fresh, "NemoWorld works_unlock: research opened a project");
+                            newly_unlocked |= fresh;
+                        },
+                        Some(tech) => {
+                            warn!(tech = %tech, "NemoWorld works_unlock refused: not a technology this manifest gates");
+                            link.ack(&command, false, "unknown_tech");
+                        },
+                        None => {
+                            warn!("NemoWorld works_unlock refused: bad arguments");
+                            link.ack(&command, false, "bad_arguments");
+                        },
+                    }
+                }
+                if newly_unlocked {
+                    state.record.updated_at = unix_ms();
+                    state.save();
+                }
+                let done = pass(state, &terrain, world.as_ref(), &mut changes, &people, &city);
+                state.record.updated_at = unix_ms();
+                if done.changed {
+                    state.save();
+                }
+                // Cooperation as a recorded fact: the visitors who stood in a crew while a stage of a
+                // project was first built. Signed like every other fact, named for the stage's `site-*`
+                // landmark, under the same witness resident an unwitnessed fact already uses. Bounded
+                // (8 per stage) and cooled down per (player, project), so neither a crowd nor a
+                // re-application can flood it.
+                let witness = link.ack_resident();
+                for help in &done.helped {
+                    let key = format!("{}|{}", help.uuid, help.project);
+                    if state.helped_cooled(&key, unix_ms(), HELPED_COOLDOWN_SECS * 1_000) {
+                        link.emit_event("project.helped", &witness, &help.uuid, &help.alias, Some(&help.site));
+                        info!(
+                            player = %help.alias,
+                            project = %help.project,
+                            site = %help.site,
+                            "NemoWorld project.helped: a visitor stood in a crew while a stage was built"
+                        );
+                    }
+                }
+                // Groups the manifest no longer names: their blocks stay, and that is said out loud
+                // once per change of the set, because this system cannot undo what it cannot see.
+                let names: Vec<String> = state.plans.iter().map(|p| p.id.clone()).collect();
+                let orphans = logic::orphans(&state.record, &names);
+                if !orphans.is_empty() && state.record.orphans != orphans {
+                    warn!(
+                        "the manifest no longer names these groups, whose blocks are still in the \
+                         world: {}",
+                        orphans.join(", ")
+                    );
+                    state.record.orphans = orphans;
+                    state.save();
+                }
+            }
+            state.atmosphere(&cfg, &mut time_of_day);
+        }
+        state.cfg = Some(cfg);
+    }
+}
