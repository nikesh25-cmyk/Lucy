+struct Rng(u64);
+
+impl Rng {
+    fn new() -> Self {
+        let nanos = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_or(1, |d| d.as_nanos() as u64);
+        Self(nanos | 1)
+    }
+
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+
+    fn range(&mut self, lo: u64, hi: u64) -> u64 { lo + self.next() % (hi - lo + 1) }
+
+    /// A valid index into a non-empty slice of `len` items (`range` is inclusive at both ends).
+    fn pick_index(&mut self, len: usize) -> usize { self.next() as usize % len.max(1) }
+
+    fn pick<'a>(&mut self, items: &'a [String]) -> Option<&'a String> {
+        (!items.is_empty()).then(|| &items[self.next() as usize % items.len()])
+    }
+}
