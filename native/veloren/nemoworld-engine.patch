--- /dev/null
+++ b/server/src/nemo/world/logic.rs
@@ -0,0 +1,1231 @@
+//! The pure rules of NemoWorld's world dressing: what a manifest may ask for, what the game can
+//! really place, and what has already been applied.
+//!
+//! Nothing here touches a running server. `dress.rs` (the system) uses these functions and then does
+//! the one thing they allow. Keeping the rules pure is what makes the refusals and the idempotence
+//! testable — including the property the brief asks for, "applying a manifest twice, or again after a
+//! restart, converges on the same world", which the tests at the bottom of this file check over an
+//! in-memory terrain.
+//!
+//! Three layers of refusal, so a bad manifest can never half-apply:
+//!
+//! 1. `nemo_world_core::manifest::Manifest::parse` — the manifest's own vocabulary: format, site,
+//!    area, block kinds, sprite names, op sizes and the total budget. One problem refuses the whole
+//!    manifest, never just the offending group.
+//! 2. [`check_site`] and `nemo_world_core::manifest::plan` — is this the site this server dresses,
+//!    and is every single cell inside that site's allowed area? The anchors come from **world
+//!    generation** (see `dress.rs`), never from a coordinate in the file, and the crate refuses a
+//!    manifest naming a plot this world does not have.
+//! 3. [`block_for`] — can the *game* parse what the crate allowed? Every allowed kind and sprite name
+//!    is turned into a real `BlockKind`/`SpriteKind`/`StructureSprite` here, and a test at the bottom
+//!    of this file checks every name in the crate's allow-lists against the game's own parser. (The
+//!    crate's vocabulary and the game's are separate on purpose: the crate says what a manifest may
+//!    ask for, this module says what the game can do.)
+
+use common::terrain::{Block, BlockKind, SpriteKind, StructureSprite};
+use nemo_world_core::manifest::{Manifest, Piece, Planned};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs,
+    path::{Path, PathBuf},
+};
+use vek::Rgb;
+
+/// How many cells of a group are checked each pass to see whether it still stands.
+pub const SENTINELS: usize = 8;
+
+/// The format string of the record written next to the outbox (`<outbox>.world.json`).
+pub const RECORD_FORMAT: &str = "veloren-world-applied-v1";
+
+/// The link config's `world` section, once read and validated.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Config {
+    /// The manifest, already validated as a whole.
+    pub manifest: Manifest,
+    /// The site the manifest dresses (its own `site` field).
+    pub site: String,
+    /// The site this server dresses, when the config says so. A manifest for another site is refused.
+    pub expected_site: Option<String>,
+    pub manifest_path: PathBuf,
+    /// `<outbox>.world.json`: what this system has applied, for a human and for the next restart.
+    pub record_path: PathBuf,
+}
+
+/// Read the `world` section of the link config. `Ok(None)` = switched off (no section, or
+/// `"enabled": false`); `Err(reason)` = switched on but unusable, in which case **nothing** is
+/// applied and the reason is what the log says.
+pub fn load_config_from(path: &str) -> Result<Option<Config>, String> {
+    let text = fs::read_to_string(path).map_err(|e| format!("cannot read {path}: {e}"))?;
+    let value: serde_json::Value =
+        serde_json::from_str(&text).map_err(|e| format!("{path} is not JSON: {e}"))?;
+    let Some(world) = value.get("world") else {
+        return Ok(None);
+    };
+    if world.get("enabled").and_then(serde_json::Value::as_bool) == Some(false) {
+        return Ok(None);
+    }
+    let Some(manifest_path) = world.get("path").and_then(serde_json::Value::as_str) else {
+        return Err("the world section has no \"path\" naming a manifest".into());
+    };
+    let Some(outbox) = value.get("outbox").and_then(serde_json::Value::as_str) else {
+        return Err("the link config has no \"outbox\", so the world record has nowhere to go".into());
+    };
+    let expected_site = world.get("site").and_then(serde_json::Value::as_str).map(str::to_owned);
+    let manifest_text = fs::read_to_string(manifest_path)
+        .map_err(|e| format!("cannot read the manifest at {manifest_path}: {e}"))?;
+    let manifest = Manifest::parse(&manifest_text).map_err(|errors| {
+        format!("the manifest at {manifest_path} is unusable: {}", errors.join("; "))
+    })?;
+    check_site(&manifest.site, expected_site.as_deref())?;
+    Ok(Some(Config {
+        site: manifest.site.clone(),
+        manifest,
+        expected_site,
+        manifest_path: PathBuf::from(manifest_path),
+        record_path: PathBuf::from(format!("{outbox}.world.json")),
+    }))
+}
+
+/// A manifest for a site other than the one this server dresses is refused whole. Without an
+/// expected site the manifest's own `site` is the site, and whether this world *has* it is decided by
+/// `plan`, which asks world generation.
+pub fn check_site(manifest_site: &str, expected: Option<&str>) -> Result<(), String> {
+    match expected {
+        Some(want) if !want.eq_ignore_ascii_case(manifest_site) => Err(format!(
+            "the manifest is for site '{manifest_site}', but this server dresses '{want}'"
+        )),
+        Some(_) | None => Ok(()),
+    }
+}
+
+/// A block kind of the crate's allow-list, as the game names it. `None` = the game has no such kind,
+/// which refuses the whole manifest.
+pub fn kind_of(name: &str) -> Option<BlockKind> {
+    match name {
+        "Rock" => Some(BlockKind::Rock),
+        "Wood" => Some(BlockKind::Wood),
+        "Misc" => Some(BlockKind::Misc),
+        "Earth" => Some(BlockKind::Earth),
+        "Sand" => Some(BlockKind::Sand),
+        "Grass" => Some(BlockKind::Grass),
+        _ => None,
+    }
+}
+
+/// A sprite by the text a manifest writes (`Lantern`, `Lantern(Ori(2))`, `BenchWoodEnd(Ori(2),
+/// MirrorX(true))`), turned into the block the game would place — the same two steps the admin
+/// `/make_sprite` command takes (`server/src/cmd.rs:1020-1025`): the plain name first, then the
+/// attribute-carrying form through the game's own parser. `None` = neither parser knows it.
+pub fn sprite_block(text: &str) -> Option<Block> {
+    if let Ok(kind) = SpriteKind::try_from(text) {
+        return Some(Block::air(kind));
+    }
+    let sprite = ron::from_str::<StructureSprite>(text).ok()?;
+    sprite.apply_to_block(Block::empty()).ok()
+}
+
+/// One piece of a manifest, as a real block. `None` = the game cannot place it.
+pub fn block_for(piece: &Piece) -> Option<Block> {
+    match piece {
+        Piece::Air => Some(Block::empty()),
+        Piece::Block { kind, rgb } => {
+            kind_of(kind).map(|kind| Block::new(kind, Rgb::new(rgb[0], rgb[1], rgb[2])))
+        },
+        Piece::Sprite(text) => sprite_block(text),
+    }
+}
+
+/// Every problem with a manifest that only the *game* can find, so a manifest the crate accepts but
+/// the game cannot place is refused whole, with every reason, before anything is written.
+pub fn unplayable(manifest: &Manifest) -> Vec<String> {
+    let mut problems = Vec::new();
+    for group in &manifest.groups {
+        for (index, op) in group.ops.iter().enumerate() {
+            let at = format!("group '{}' ops[{index}]", group.id);
+            match op {
+                nemo_world_core::manifest::Op::Fill { kind, .. }
+                | nemo_world_core::manifest::Op::Foundation { kind, .. } => {
+                    if kind_of(kind).is_none() {
+                        problems.push(format!("{at}: the game has no block kind '{kind}'"));
+                    }
+                },
+                nemo_world_core::manifest::Op::Sprite { sprite, .. } => {
+                    if sprite_block(sprite).is_none() {
+                        problems.push(format!("{at}: the game cannot place the sprite '{sprite}'"));
+                    }
+                },
+                nemo_world_core::manifest::Op::Clear { .. } => {},
+            }
+        }
+    }
+    problems
+}
+
+/// A stable fingerprint of exactly what a group will write, given the ground it was measured at.
+/// Two runs of the same manifest in the same world produce the same digest; any change to a cell, a
+/// colour, a sprite, an anchor or the ground produces a different one. This is what makes "the same
+/// world after a restart" checkable: the digests in the record must not move.
+pub fn digest(plan: &Planned, ground: i32) -> String {
+    fn feed(mut hash: u64, text: &str) -> u64 {
+        for byte in text.as_bytes() {
+            hash ^= u64::from(*byte);
+            hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+        hash
+    }
+    let mut hash = 0xcbf2_9ce4_8422_2325;
+    hash = feed(hash, &format!("{}|{}|{}|{}", plan.id, plan.anchor.0, plan.anchor.1, ground));
+    for (cell, piece) in &plan.expanded.pieces {
+        let text = match piece {
+            Piece::Air => "air".to_owned(),
+            Piece::Block { kind, rgb } => format!("b:{kind}:{}:{}:{}", rgb[0], rgb[1], rgb[2]),
+            Piece::Sprite(sprite) => format!("s:{sprite}"),
+        };
+        hash = feed(hash, &format!("|{},{},{}={text}", cell[0], cell[1], cell[2]));
+    }
+    for column in &plan.expanded.foundation {
+        hash = feed(
+            hash,
+            &format!(
+                "|f:{},{}={}:{}:{}:{}:{}",
+                column.dx, column.dy, column.kind, column.rgb[0], column.rgb[1], column.rgb[2], column.depth
+            ),
+        );
+    }
+    format!("{hash:016x}")
+}
+
+/// What one application of a group did. `written` counts the cells this pass actually changed, so a
+/// pass over a group that already stands writes nothing and says so.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Applied {
+    pub blocks: usize,
+    pub sprites: usize,
+    pub foundation_columns: usize,
+    /// Cells the plan covers (blocks, sprites and air).
+    pub cells: usize,
+    /// Cells whose block was actually replaced by this application.
+    pub written: usize,
+}
+
+/// The terrain as world dressing sees it: what is there, and how to put something there. The system
+/// implements this over the live `TerrainGrid` and `BlockChange`; the tests implement it over a
+/// `BTreeMap`, which is how the idempotence property is checked without a server.
+pub trait Voxel {
+    /// The block at this absolute cell, or `None` when the chunk is not loaded.
+    fn get(&self, cell: [i32; 3]) -> Option<Block>;
+    fn set(&mut self, cell: [i32; 3], block: Block);
+}
+
+/// Put one planned group into the terrain.
+///
+/// * the foundation fills the air under the group's floor level, one cell below it and downwards, at
+///   most `depth` cells per column, and stops at the first block that is already solid — the same
+///   rule the home stream's cottage uses (`server/src/sys/nemo_home.rs:249-267`);
+/// * then every piece of the plan, in the crate's deterministic (sorted) order;
+/// * a cell whose block is already the one the plan wants is left alone, which is what makes a second
+///   application write nothing at all.
+pub fn stamp(plan: &Planned, ground: i32, voxel: &mut impl Voxel) -> Applied {
+    let mut applied = Applied::default();
+    for column in &plan.expanded.foundation {
+        let Some(kind) = kind_of(&column.kind) else { continue };
+        let want = Block::new(kind, Rgb::new(column.rgb[0], column.rgb[1], column.rgb[2]));
+        applied.foundation_columns += 1;
+        for depth in 1..=i32::from(column.depth) {
+            let cell = [plan.anchor.0 + column.dx, plan.anchor.1 + column.dy, ground - depth];
+            match voxel.get(cell) {
+                // Not loaded: leave it for a pass when the chunk is there.
+                None => break,
+                // The ground: the column has reached solid terrain.
+                Some(block) if block.is_filled() && !block.kind().is_liquid() => break,
+                // Already ours from an earlier pass.
+                Some(block) if block == want => continue,
+                Some(_) => {
+                    voxel.set(cell, want);
+                    applied.written += 1;
+                },
+            }
+        }
+    }
+    for (cell, piece) in &plan.expanded.pieces {
+        let Some(block) = block_for(piece) else { continue };
+        applied.cells += 1;
+        match piece {
+            Piece::Sprite(_) => applied.sprites += 1,
+            Piece::Block { .. } => applied.blocks += 1,
+            Piece::Air => {},
+        }
+        let at = [plan.anchor.0 + cell[0], plan.anchor.1 + cell[1], ground + cell[2]];
+        if voxel.get(at) == Some(block) {
+            continue;
+        }
+        voxel.set(at, block);
+        applied.written += 1;
+    }
+    applied
+}
+
+/// Up to `max` cells of a group, spread evenly over its pieces (sprites first, so a group that has
+/// sprites is judged by its sprites), used to notice that a group no longer stands — a chunk that
+/// regenerated, or another writer — without reading every cell of every group every pass. Cells in
+/// `gone` (see [`GONE_AFTER`]) are left out.
+///
+/// Cleared cells (`Piece::Air`) are only used when the group has nothing else: a staged building
+/// clears its whole footprint in its first stage, and the later stages (walls, roof, furniture)
+/// build inside that footprint. An air sentinel of the first stage would then find the later
+/// stages' blocks, call the first stage "not standing" and write it again, clearing the building,
+/// which the later stages then rebuild, until the cell had been "lost" `GONE_AFTER` times and was
+/// wrongly recorded as removed by the game. Air is not evidence that a group is missing.
+pub fn sentinel_without(plan: &Planned, max: usize, gone: &BTreeSet<[i32; 3]>) -> Vec<[i32; 3]> {
+    let sprites: Vec<[i32; 3]> = plan
+        .expanded
+        .pieces
+        .iter()
+        .filter(|(cell, piece)| matches!(piece, Piece::Sprite(_)) && !gone.contains(*cell))
+        .map(|(cell, _)| *cell)
+        .collect();
+    let rest: Vec<[i32; 3]> = plan
+        .expanded
+        .pieces
+        .iter()
+        .filter(|(cell, piece)| matches!(piece, Piece::Block { .. }) && !gone.contains(*cell))
+        .map(|(cell, _)| *cell)
+        .collect();
+    let mut candidates: Vec<[i32; 3]> = sprites.into_iter().chain(rest).collect();
+    if candidates.is_empty() {
+        candidates = plan
+            .expanded
+            .pieces
+            .iter()
+            .filter(|(cell, _)| !gone.contains(*cell))
+            .map(|(cell, _)| *cell)
+            .collect();
+    }
+    if candidates.is_empty() || max == 0 {
+        return Vec::new();
+    }
+    let count = max.min(candidates.len());
+    let mut picked = BTreeSet::new();
+    for index in 0..count {
+        let at = if count == 1 { 0 } else { index * (candidates.len() - 1) / (count - 1) };
+        picked.insert(candidates[at]);
+    }
+    picked.into_iter().collect()
+}
+
+/// [`sentinel_without`] with nothing excluded.
+pub fn sentinel(plan: &Planned, max: usize) -> Vec<[i32; 3]> {
+    sentinel_without(plan, max, &BTreeSet::new())
+}
+
+/// The sentinel cells of a group that are **loaded** and do not hold what the plan wants. Empty means
+/// every sentinel that could be read is right; use [`unreadable`] as well to decide whether the group
+/// stands (a cell whose chunk is not loaded says nothing either way).
+pub fn missing(plan: &Planned, ground: i32, voxel: &impl Voxel, gone: &BTreeSet<[i32; 3]>) -> Vec<[i32; 3]> {
+    sentinel_without(plan, SENTINELS, gone)
+        .into_iter()
+        .filter(|cell| match expected(plan, ground, *cell) {
+            // A cell the plan has no block for, or a chunk that is not loaded: not a "missing" cell.
+            None => false,
+            Some((at, block)) => voxel.get(at).is_some_and(|there| there != block),
+        })
+        .collect()
+}
+
+/// The sentinel cells whose chunk is not loaded, so nothing can be said about them this pass. A group
+/// with any of these is left alone: writing into a chunk that is not there does nothing, and treating
+/// "cannot tell" as "gone" would let a chunk that is briefly unloaded be recorded as a cell the game
+/// removed.
+pub fn unreadable(plan: &Planned, ground: i32, voxel: &impl Voxel, gone: &BTreeSet<[i32; 3]>) -> Vec<[i32; 3]> {
+    sentinel_without(plan, SENTINELS, gone)
+        .into_iter()
+        .filter(|cell| match expected(plan, ground, *cell) {
+            None => true,
+            Some((at, _)) => voxel.get(at).is_none(),
+        })
+        .collect()
+}
+
+/// The absolute cell a plan wants and the block it wants there.
+fn expected(plan: &Planned, ground: i32, cell: [i32; 3]) -> Option<([i32; 3], Block)> {
+    let piece = plan.expanded.pieces.get(&cell)?;
+    let block = block_for(piece)?;
+    Some(([plan.anchor.0 + cell[0], plan.anchor.1 + cell[1], ground + cell[2]], block))
+}
+
+/// Does this group still stand? Every sentinel cell is loaded and holds the block the plan wants.
+pub fn standing(plan: &Planned, ground: i32, voxel: &impl Voxel) -> bool {
+    standing_without(plan, ground, voxel, &BTreeSet::new())
+}
+
+/// Does this group still stand, ignoring the cells the game keeps removing?
+pub fn standing_without(plan: &Planned, ground: i32, voxel: &impl Voxel, gone: &BTreeSet<[i32; 3]>) -> bool {
+    missing(plan, ground, voxel, gone).is_empty() && unreadable(plan, ground, voxel, gone).is_empty()
+}
+
+/// How many times a cell may be written and found gone again before world dressing stops counting it
+/// as a cell of the group.
+///
+/// The game removes some blocks again by itself: a sprite whose adjacency requirement is not met is
+/// turned back into air the same tick it is written (`common/state/src/state.rs:765-815`, the
+/// "indirectly modified" pass). `Lantern`, `LanternpostWoodBase` and `LanternpostWoodUpper` need a
+/// solid block under them and `LanternpostWoodLantern` needs a wall beside it
+/// (`common/src/terrain/sprite/mod.rs:925-945`), so a lanternpost's lantern in open ground is written
+/// and removed for ever. Three tries is enough to tell that from a chunk that regenerated, and after
+/// that the cell is recorded as removed instead of being written on every pass.
+pub const GONE_AFTER: u32 = 3;
+
+/// What to do with one group, and why (the reason goes into the record and the log).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Decision {
+    /// Write the group now.
+    Write,
+    /// The record says the same thing is applied and it still stands: nothing to do.
+    Keep,
+}
+
+/// Account for the sentinel cells of one group that are gone again: bump each cell's miss count and
+/// return the cells that have now missed [`GONE_AFTER`] times — the ones the game keeps removing, so
+/// the system stops counting them as part of the group. Pure, so the rule itself is unit tested even
+/// though the writing happens in the running server.
+pub fn count_misses(misses: &mut BTreeMap<[i32; 3], u32>, absent: &[[i32; 3]]) -> Vec<[i32; 3]> {
+    let mut gone = Vec::new();
+    for cell in absent {
+        let count = misses.entry(*cell).or_insert(0);
+        *count += 1;
+        if *count == GONE_AFTER {
+            gone.push(*cell);
+        }
+    }
+    gone
+}
+
+/// The rule, in the order that matters: a manifest that changed is re-applied even if the old
+/// version still stands; a group the manifest still asks for that has been overwritten or lost with
+/// its chunk is re-applied; anything else is left alone.
+pub fn decide(recorded: Option<&GroupRecord>, digest: &str, still_standing: bool) -> (Decision, &'static str) {
+    match recorded {
+        None => (Decision::Write, "new"),
+        Some(record) if record.digest != digest => (Decision::Write, "changed"),
+        Some(_) if !still_standing => (Decision::Write, "not-standing"),
+        Some(_) => (Decision::Keep, "standing"),
+    }
+}
+
+/// What an earlier run (or an earlier pass) applied to one group.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct GroupRecord {
+    pub digest: String,
+    pub anchor: [i32; 2],
+    pub ground: i32,
+    pub cells: usize,
+    pub blocks: usize,
+    pub sprites: usize,
+    pub foundation_columns: usize,
+    /// Cells the last application actually wrote (0 when it found the group already standing).
+    pub written: usize,
+    /// Unix milliseconds of that application.
+    pub applied_at: u64,
+    /// Absolute cells this group asked for that the game removes again by itself, so they are not
+    /// part of the world: a sprite whose adjacency requirement is not met where the manifest put it
+    /// (`logic::GONE_AFTER`). Empty for every group the game keeps in full.
+    #[serde(default)]
+    pub removed: Vec<[i32; 3]>,
+}
+
+/// What world dressing has done to this world, written to `<outbox>.world.json`. This file is the
+/// acknowledgement: a group in `groups` is in the terrain, a group in `waiting` is not yet (with the
+/// reason), and `refused` means nothing at all was applied and says why.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+pub struct Record {
+    /// Saved per-column city path grade, reused on restart instead of resampling edited terrain.
+    #[serde(default)]
+    pub surface_levels: BTreeMap<String, Vec<[i32; 3]>>,
+    pub format: String,
+    pub site: String,
+    /// Origin of the site the groups were resolved against, from world generation.
+    pub origin: [i32; 2],
+    pub manifest: String,
+    pub updated_at: u64,
+    #[serde(default)]
+    pub groups: BTreeMap<String, GroupRecord>,
+    /// Group id -> why it is not in the world yet (chunks not loaded, no ground, water).
+    #[serde(default)]
+    pub waiting: BTreeMap<String, String>,
+    /// Every reason the manifest was refused, whole. When this is not empty, `groups` is empty.
+    #[serde(default)]
+    pub refused: Vec<String>,
+    /// What the manifest asked for that this server does not do (recorded, never pretended).
+    #[serde(default)]
+    pub ignored: Vec<String>,
+    /// Groups an earlier run applied that the manifest no longer names: their blocks stay, because
+    /// this system cannot tell what was there before it wrote.
+    #[serde(default)]
+    pub orphans: Vec<String>,
+    /// Research gates works: the technologies NemoWorld has unlocked through a signed `works_unlock`. Kept in
+    /// the record so a restart does not forget what the village has learned, and never re-granted.
+    #[serde(default)]
+    pub unlocked: BTreeSet<String>,
+    /// Construction: when the works clock started (unix ms, set once, kept for good). A staged group is due at
+    /// `works_started_ms + release_after_minutes`. Zero until the first pass.
+    #[serde(default)]
+    pub works_started_ms: u64,
+    /// Construction: milliseconds the world has really been open since the works began (the works clock).
+    #[serde(default)]
+    pub works_elapsed_ms: u64,
+    /// Construction: every staged group, for the works board: id -> project, title, release minutes.
+    #[serde(default)]
+    pub schedule: BTreeMap<String, ScheduleEntry>,
+}
+
+/// One stage of a public work, as the works board shows it.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct ScheduleEntry {
+    pub project: String,
+    pub title: String,
+    /// The `site-*` landmark the stage is built at: the place a helper's `project.helped` fact names.
+    #[serde(default)]
+    pub site: String,
+    /// A technology NemoWorld must have unlocked before this stage may be built ("" = no gate).
+    #[serde(default)]
+    pub needs_tech: String,
+    pub release_after_minutes: u32,
+    /// People who must stand near the site for the stage to be built (cooperation); 0 = none.
+    #[serde(default)]
+    pub crew: u8,
+    /// The stage of the same project that must be built first ("" for the first stage).
+    #[serde(default)]
+    pub after: String,
+}
+
+/// One person near a work site, with who they are. Residents are the crew the village sends; everyone
+/// else is a visitor, and only visitors earn a `project.helped` fact — a resident helping is the village
+/// doing its own work, which the stage itself already records.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Nearby {
+    pub uuid: String,
+    pub alias: String,
+    pub x: f32,
+    pub y: f32,
+    pub resident: bool,
+}
+
+/// Where a crew stands for a planned group: the group's own anchor. `Planned::ground_at` is already
+/// absolute (the crate adds the anchor in `plan`), so it must never be added a second time — doing so
+/// puts the circle two site-widths away, where no crowd could ever count.
+pub fn crew_centre(plan: &Planned) -> (i32, i32) { plan.anchor }
+
+/// How many people stand within `radius` blocks of `at` (residents and visitors both count for a crew).
+pub fn crew_present(people: &[Nearby], at: (i32, i32), radius: f32) -> usize {
+    let (ax, ay) = (at.0 as f32, at.1 as f32);
+    people.iter().filter(|p| (p.x - ax).powi(2) + (p.y - ay).powi(2) <= radius * radius).count()
+}
+
+/// The visitors who stood in a crew when a stage was built, at most `max` of them, in uuid order so the
+/// same crew always produces the same facts. Residents are not helpers: they are the village's own.
+pub fn helpers(people: &[Nearby], at: (i32, i32), radius: f32, max: usize) -> Vec<(String, String)> {
+    let (ax, ay) = (at.0 as f32, at.1 as f32);
+    let mut here: Vec<&Nearby> = people
+        .iter()
+        .filter(|p| !p.resident && (p.x - ax).powi(2) + (p.y - ay).powi(2) <= radius * radius)
+        .collect();
+    here.sort_by(|a, b| a.uuid.cmp(&b.uuid));
+    here.into_iter().take(max).map(|p| (p.uuid.clone(), p.alias.clone())).collect()
+}
+
+/// Research gates a stage: it may not be built until its technology is unlocked. Empty = no gate.
+pub fn unlocked(needs_tech: &str, learned: &BTreeSet<String>) -> bool {
+    needs_tech.is_empty() || learned.contains(needs_tech)
+}
+
+/// The technology a `works_unlock` command names, if its arguments are exactly `{"tech":"<plain id>"}`.
+/// Anything else is refused: the arguments are signed JSON, so the shape is checked like any other input.
+pub fn unlock_tech(args: &str) -> Option<String> {
+    let value: serde_json::Value = serde_json::from_str(args).ok()?;
+    let object = value.as_object()?;
+    if object.len() != 1 {
+        return None;
+    }
+    let tech = object.get("tech")?.as_str()?;
+    if tech.is_empty() || tech.len() > 48 {
+        return None;
+    }
+    tech.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-').then(|| tech.to_owned())
+}
+
+/// A stage that has never been built waits until its turn. The works clock is the time the world has really been
+/// open (`works_elapsed_ms`), not the calendar: a night with the server off, or a clock jump, never builds a
+/// town while nobody watches. Everything already built is never held back, so a restart restores the town at once.
+pub fn due(release_after_minutes: u32, elapsed_ms: u64) -> bool {
+    release_after_minutes == 0 || elapsed_ms >= u64::from(release_after_minutes) * 60_000
+}
+
+/// Whole minutes of open-world time until a stage is due (0 when it is).
+pub fn minutes_until(release_after_minutes: u32, elapsed_ms: u64) -> u64 {
+    (u64::from(release_after_minutes) * 60_000).saturating_sub(elapsed_ms).div_ceil(60_000)
+}
+
+/// Add the time that passed since the last pass to the works clock. A pause longer than `max_gap_ms` (a stall, a
+/// suspended laptop) counts only as `max_gap_ms`.
+pub fn tick_clock(elapsed_ms: u64, last_ms: u64, now_ms: u64, max_gap_ms: u64) -> u64 {
+    if last_ms == 0 { elapsed_ms } else { elapsed_ms.saturating_add(now_ms.saturating_sub(last_ms).min(max_gap_ms)) }
+}
+
+/// Read the record of an earlier run, if there is one and it is readable.
+pub fn load_record(path: &Path) -> Option<Record> {
+    let text = fs::read_to_string(path).ok()?;
+    match serde_json::from_str::<Record>(&text) {
+        Ok(record) if record.format == RECORD_FORMAT => Some(record),
+        Ok(other) => {
+            // A record from another version of this system: use nothing from it, but say so.
+            let _ = other;
+            None
+        },
+        Err(_) => None,
+    }
+}
+
+/// Groups the record says are in the world that the manifest no longer names. Their blocks **stay**:
+/// this system cannot tell what was there before it wrote, so undoing is not something it can do
+/// honestly. It reports them instead, and the log says so.
+pub fn orphans(record: &Record, planned: &[String]) -> Vec<String> {
+    record
+        .groups
+        .keys()
+        .filter(|id| !planned.iter().any(|kept| kept == *id))
+        .cloned()
+        .collect()
+}
