+                                let time_text = if on_now {
+                                    format!("ON NOW · {}m left", mins)
+                                } else {
+                                    format!("in {}m", mins)
+                                };
+                                let c = if on_now { Color::Rgba(0.3, 0.9, 0.5, 1.0) } else { TEXT_COLOR };
+                                display_lines.push((format!("• {} ({}) at {}", title, time_text, place), c, 13));
+                                if !blurb.is_empty() {
+                                    display_lines.push((format!("   {}", blurb), TEXT_COLOR_3, 12));
+                                }
+                            }
+                        }
+
+                        if let Some(apprenticeship) = overview.pointer("/gameplay/apprenticeship/guilds").and_then(|g| g.as_array()) {
+                            display_lines.push(("".into(), TEXT_COLOR, 6));
+                            display_lines.push(("APPRENTICESHIP GUILDS (Whisper Selene 'apprentice'):".into(), Color::Rgba(0.9, 0.8, 0.4, 1.0), 15));
+                            for g in apprenticeship {
+                                let title = g.get("title").and_then(|t| t.as_str()).unwrap_or("");
+                                let mentor = g.get("mentor_name").and_then(|m| m.as_str()).unwrap_or("");
+                                let active = g.get("apprentices").and_then(|a| a.as_u64()).unwrap_or(0);
+                                let completed = g.get("completed").and_then(|c| c.as_u64()).unwrap_or(0);
+                                display_lines.push((
+                                    format!("• {} (Mentor: {}) — {} learning, {} graduated", title, mentor, active, completed),
+                                    TEXT_COLOR,
+                                    12,
+                                ));
+                            }
+                        }
+
+                        if let Some(wall) = overview.pointer("/gameplay/gratitude/wall").and_then(|w| w.as_array()) {
+                            display_lines.push(("".into(), TEXT_COLOR, 6));
+                            display_lines.push(("THE GRATITUDE BOARD (Whisper Selene 'thanks <note>'):".into(), Color::Rgba(0.4, 0.85, 0.9, 1.0), 15));
+                            if wall.is_empty() {
+                                display_lines.push(("  No notes posted yet today. Share a kind word with 'thanks'!".into(), TEXT_COLOR_3, 12));
+                            } else {
+                                for item in wall.iter().take(6) {
+                                    let txt = item.get("text").and_then(|t| t.as_str()).unwrap_or("");
+                                    display_lines.push((format!("  \"{}\"", txt), Color::Rgba(0.85, 0.92, 0.85, 1.0), 12));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        // Render Text Lines inside Content Area
+        state.update(|s| {
+            s.ids.content_lines.resize(display_lines.len(), &mut ui.widget_id_generator());
+        });
+
+        let mut prev_line = None;
+        for (i, (text_content, text_color, font_sz)) in display_lines.iter().enumerate() {
+            let widget_id = state.ids.content_lines[i];
+            let mut line_widget = Text::new(text_content)
+                .font_id(self.fonts.cyri.conrod_id)
+                .font_size(self.fonts.cyri.scale(*font_sz))
+                .color(*text_color)
+                .w(555.0);
+
+            match prev_line {
+                None => {
+                    line_widget = line_widget.top_left_with_margins_on(state.ids.content_area, 8.0, 12.0);
+                }
+                Some(prev_id) => {
+                    line_widget = line_widget.down_from(prev_id, 3.0);
+                }
+            }
+
+            line_widget.set(widget_id, ui);
+            prev_line = Some(widget_id);
+        }
+
+        events
+    }
+}
