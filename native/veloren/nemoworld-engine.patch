--- /dev/null
+++ b/nemo-bridge/src/chat_hud.rs
@@ -0,0 +1,927 @@
+//! The in-game interface: a guide resident who answers short commands with private, paged text.
+//!
+//! A player says (or whispers) a command such as `passport`, `quests`, `next` or `karma` to the guide
+//! (Selene Dawnbringer). The guide asks NemoWorld for a small page of text about THAT player and
+//! whispers it back with `/tell`, a few lines at a time. No client change is needed: it is ordinary
+//! chat. Every number in an answer comes from NemoWorld, which reads the player's saved state; the
+//! guide never invents, calculates or promises anything.
+//!
+//! What this file defends against:
+//! * **Injection.** Nothing a player types ever reaches NemoWorld or the server except a whitelisted
+//!   page name and a page number. A player's name is used only after it passes Veloren's own alias
+//!   rule, and only as a `/tell` argument. Text coming back from NemoWorld is cleaned (no control or
+//!   hidden characters, no square brackets, one line, bounded) before it is spoken.
+//! * **Flooding.** A per-player gap and window, a global window, a cap on requests in flight and a
+//!   bounded outgoing queue. Drops are silent so a flood cannot make the guide noisy.
+//! * **Oversized replies.** At most [`MAX_REPLY_LINES`] lines of at most [`MAX_LINE_BYTES`] bytes.
+//! * **Leaking into public chat.** Veloren keeps the speaker's chat mode after `/tell`, so every
+//!   whisper is followed at once by `/say`, which puts the guide back in public chat.
+//! * **Overclaiming.** A map marker is announced as placed only when NemoWorld reports that the
+//!   Veloren server acknowledged it.
+//!
+//! The pure logic (parsing, limits, cleaning, composing) has unit tests; the network part is thin.
+
+use crate::nemo::Nemo;
+use serde::Deserialize;
+use std::{
+    collections::{HashMap, VecDeque},
+    sync::mpsc::{Receiver, Sender, channel},
+    thread,
+    time::{Duration, Instant},
+};
+
+/// The NemoWorld resident this behaviour belongs to.
+pub const GUIDE_RESIDENT: &str = "lw-selene";
+/// Where the guide stands: NemoWorld's "Meeting Hall", which at Harr is the plaza.
+pub const GUIDE_STAND: &str = "Meeting Hall";
+
+pub const MAX_REPLY_LINES: usize = 5;
+pub const MAX_LINE_BYTES: usize = 220;
+const MAX_BODY_BYTES: usize = 8 * 1024;
+const MAX_PAGE: u8 = 8;
+const MAX_TRACKED_PLAYERS: usize = 256;
+const MAX_QUEUE: usize = 40;
+const MAX_IN_FLIGHT: usize = 4;
+const PLAYER_GAP: Duration = Duration::from_secs(3);
+const PLAYER_WINDOW: Duration = Duration::from_secs(60);
+const PLAYER_PER_WINDOW: u32 = 10;
+const GLOBAL_PER_WINDOW: u32 = 40;
+const TELL_GAP: Duration = Duration::from_millis(900);
+const STATUS_POLLS: u32 = 8;
+const STATUS_EVERY: Duration = Duration::from_secs(2);
+
+/// The pages NemoWorld can show. The server whitelists the same names.
+pub const PAGES: [&str; 24] = [
+    "help", "start", "passport", "journal", "calling", "quests", "next", "community", "karma", "works", "library", "pantry", "today", "chronicle", "tasks", "purpose", "research", "city", "menu", "thanks", "apprentice", "survey", "season", "level",
+];
+
+// ---- words the guide understands ---------------------------------------------------------------
+
+/// What a player asked for.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Command {
+    /// Show this page (optionally a later page of it).
+    View(&'static str, Option<u8>),
+    /// The next page of the last answer.
+    More,
+    /// A given page of the last answer.
+    Page(u8),
+    /// Put the current objective on the map.
+    Track,
+    /// Take a little food from the village pantry (the item key is one of a fixed list).
+    Take(&'static str),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    /// Sent to the guide with `/tell`.
+    Whisper,
+    /// Said aloud near the guide.
+    Say,
+}
+
+fn command_word(word: &str) -> Option<Command> {
+    Some(match word {
+        "help" => Command::View("help", None),
+        "menu" | "commands" | "words" | "options" => Command::View("menu", None),
+        "gratitude" | "thanksboard" => Command::View("thanks", None),
+        "apprentice" | "apprenticeship" | "mentor" => Command::View("apprentice", None),
+        "expedition" | "expeditions" | "fieldsurvey" => Command::View("survey", None),
+        "season" | "seasons" => Command::View("season", None),
+        "level" | "growth" => Command::View("level", None),
+        "start" | "begin" | "tutorial" | "welcome" | "first" => Command::View("start", None),
+        "passport" | "profile" => Command::View("passport", None),
+        "journal" => Command::View("journal", None),
+        "calling" | "daily" | "objective" | "objectives" | "vocation" => Command::View("calling", None),
+        "quest" | "quests" => Command::View("quests", None),
+        "next" | "goal" | "todo" => Command::View("next", None),
+        "community" | "gatherings" | "gathering" | "events" | "circles" => Command::View("community", None),
+        "karma" | "balance" => Command::View("karma", None),
+        "works" | "building" | "construction" | "projects" | "progress" => Command::View("works", None),
+        "library" | "discoveries" | "discovery" | "explore" | "catalogue" => Command::View("library", None),
+        "today" | "schedule" | "timetable" | "market" | "festival" | "story" | "stories" => Command::View("today", None),
+        "tasks" | "task" | "checklist" | "missions" | "mission" | "goals" => Command::View("tasks", None),
+        "city" => Command::View("city", None),
+        "purpose" | "charter" => Command::View("purpose", None),
+        "research" | "innovate" | "innovation" | "learning" | "technology" => Command::View("research", None),
+        "chronicle" | "history" | "news" | "happened" => Command::View("chronicle", None),
+        "pantry" | "larder" | "commons" | "food" | "abundance" => Command::View("pantry", None),
+        "apple" | "apples" => Command::Take("apple"),
+        "carrot" | "carrots" => Command::Take("carrot"),
+        "cheese" => Command::Take("cheese"),
+        "lettuce" => Command::Take("lettuce"),
+        "track" | "marker" | "waypoint" | "mark" => Command::Track,
+        "more" | "continue" => Command::More,
+        _ => return None,
+    })
+}
+
+/// Words that may sit around a command without changing its meaning ("show me my passport").
+const FILLER: &[&str] = &[
+    "please", "me", "my", "show", "tell", "what", "whats", "is", "the", "a", "an", "about", "of", "for", "i", "can",
+    "you", "see", "check", "give", "list", "open", "ten", "minutes", "page", "it", "s", "take", "get", "grab", "some", "please", "from", "pantry",
+];
+const GREETING: &[&str] = &["hey", "hi", "hello", "hail", "dear", "good", "day", "morning", "evening"];
+/// Commands plain enough to answer when said aloud without the guide's name.
+const SAFE_BARE: &[&str] = &["help", "passport", "journal", "calling", "quests", "community", "karma", "works", "library", "pantry", "today", "chronicle", "tasks", "purpose", "research", "city", "menu", "apprentice", "season", "level"];
+
+/// The words of a message: lowercase letters and digits only, at most [`MAX_WORDS`].
+const MAX_WORDS: usize = 8;
+fn words(text: &str) -> Option<Vec<String>> {
+    let lowered = text.to_lowercase();
+    let parts: Vec<String> = lowered
+        .split(|c: char| !c.is_alphanumeric())
+        .filter(|w| !w.is_empty())
+        .map(str::to_owned)
+        .collect();
+    (!parts.is_empty() && parts.len() <= MAX_WORDS).then_some(parts)
+}
+
+/// Understand a short command, or return `None` for anything else.
+///
+/// * A whisper may be any recognised command, with filler words and an optional page number.
+/// * Something said aloud must start or end with the guide's name (`selene passport`), or be one of
+///   the plain commands on its own (`passport`), so ordinary conversation is left alone.
+/// * A number is a page between 1 and 99; longer numbers, zero and everything else are refused.
+pub fn parse_command(text: &str, kind: Kind, guide_first_name: &str) -> Option<Command> {
+    let name = guide_first_name.to_lowercase();
+    let mut parts = words(text)?;
+    let mut named = false;
+    // Leading greeting words and the guide's name.
+    while let Some(first) = parts.first() {
+        if *first == name {
+            named = true;
+        } else if !GREETING.contains(&first.as_str()) {
+            break;
+        }
+        parts.remove(0);
+    }
+    if parts.last().is_some_and(|last| *last == name) {
+        named = true;
+        parts.pop();
+    }
+    let mut command: Option<Command> = None;
+    let mut page: Option<u8> = None;
+    let mut other_words = 0usize;
+    for part in &parts {
+        if part.bytes().all(|b| b.is_ascii_digit()) {
+            // Page numbers only: 1 to 99, no more than one.
+            if part.len() > 2 || page.is_some() {
+                return None;
+            }
+            let value: u8 = part.parse().ok()?;
+            if value == 0 {
+                return None;
+            }
+            page = Some(value);
+        } else if let Some(found) = command_word(part) {
+            match command {
+                None => command = Some(found),
+                Some(existing) if existing == found => {},
+                Some(_) => return None,
+            }
+        } else if FILLER.contains(&part.as_str()) {
+            other_words += 1;
+        } else {
+            return None;
+        }
+    }
+    let command = match (command, page) {
+        (Some(Command::View(name, None)), page) => Command::View(name, page),
+        (Some(Command::Track), None) => Command::Track,
+        (Some(Command::Take(item)), None) => Command::Take(item),
+        (Some(Command::More), None) => Command::More,
+        (None, Some(n)) if kind == Kind::Whisper && other_words <= 1 => Command::Page(n),
+        _ => return None,
+    };
+    if kind == Kind::Say {
+        let bare = other_words == 0
+            && page.is_none()
+            && matches!(command, Command::View(name, None) if SAFE_BARE.contains(&name));
+        if !named && !bare {
+            return None;
+        }
+    }
+    Some(command)
+}
+
+// ---- safety checks -----------------------------------------------------------------------------
+
+/// Veloren's own rule for a character name: letters, digits, `_` and `-`, at most 32 bytes.
+pub fn valid_alias(alias: &str) -> bool {
+    !alias.is_empty() && alias.len() <= 32 && alias.chars().all(|c| c.is_alphanumeric() || c == '_' || c == '-')
+}
+
+/// A canonical lowercase hyphenated uuid, as Veloren prints one.
+pub fn valid_uuid(text: &str) -> bool {
+    text.len() == 36
+        && text.bytes().enumerate().all(|(i, b)| match i {
+            8 | 13 | 18 | 23 => b == b'-',
+            _ => b.is_ascii_digit() || (b'a'..=b'f').contains(&b),
+        })
+}
+
+fn hidden(c: char) -> bool {
+    c.is_control()
+        || matches!(c, '\u{ad}' | '\u{61c}' | '\u{180e}' | '\u{feff}')
+        || ('\u{200b}'..='\u{200f}').contains(&c)
+        || ('\u{2028}'..='\u{202e}').contains(&c)
+        || ('\u{2060}'..='\u{206f}').contains(&c)
+        || ('\u{fe00}'..='\u{fe0f}').contains(&c)
+        || ('\u{e0000}'..='\u{e007f}').contains(&c)
+}
+
+/// Make one line of text from NemoWorld safe to speak: no control or hidden characters, square
+/// brackets become round (so nothing can pose as an `[AI]` or system label), one line, collapsed
+/// spaces, and at most [`MAX_LINE_BYTES`] bytes. Returns `None` for an empty line.
+pub fn clean_line(raw: &str) -> Option<String> {
+    let mapped: String = raw
+        .chars()
+        .map(|c| match c {
+            '[' => '(',
+            ']' => ')',
+            c if hidden(c) => ' ',
+            c => c,
+        })
+        .collect();
+    let mut line = mapped.split_whitespace().collect::<Vec<_>>().join(" ");
+    if line.len() > MAX_LINE_BYTES {
+        let mut end = MAX_LINE_BYTES - 3;
+        while !line.is_char_boundary(end) {
+            end -= 1;
+        }
+        line.truncate(end);
+        line = line.trim_end().to_owned() + "…";
+    }
+    (!line.is_empty()).then_some(line)
+}
+
+/// The arguments of `/tell`: the player's name, then the words of the line.
+pub fn tell_args(alias: &str, line: &str) -> Vec<String> {
+    let mut args = vec![alias.to_owned()];
+    args.extend(line.split_whitespace().map(str::to_owned));
+    args
+}
+
+// ---- rate limits -------------------------------------------------------------------------------
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum Verdict {
+    Allow,
+    /// Too soon, or over the window: say nothing.
+    Drop,
+    /// Over the window for the first time: say one polite line.
+    Warn,
+}
+
+struct PlayerState {
+    last: Instant,
+    window_start: Instant,
+    count: u32,
+    warned: bool,
+}
+
+pub struct Limits {
+    players: HashMap<String, PlayerState>,
+    global_start: Option<Instant>,
+    global_count: u32,
+}
+
+impl Limits {
+    pub fn new() -> Self { Self { players: HashMap::new(), global_start: None, global_count: 0 } }
+
+    pub fn check(&mut self, uuid: &str, now: Instant) -> Verdict {
+        match self.global_start {
+            Some(start) if now.duration_since(start) < PLAYER_WINDOW => {},
+            _ => {
+                self.global_start = Some(now);
+                self.global_count = 0;
+            },
+        }
+        if self.global_count >= GLOBAL_PER_WINDOW {
+            return Verdict::Drop;
+        }
+        if self.players.len() >= MAX_TRACKED_PLAYERS && !self.players.contains_key(uuid) {
+            // Forget whoever has been quiet the longest.
+            if let Some(oldest) = self.players.iter().min_by_key(|(_, s)| s.last).map(|(k, _)| k.clone()) {
+                self.players.remove(&oldest);
+            }
+        }
+        let state = self.players.entry(uuid.to_owned()).or_insert(PlayerState {
+            last: now - PLAYER_GAP * 2,
+            window_start: now,
+            count: 0,
+            warned: false,
+        });
+        if now.duration_since(state.window_start) >= PLAYER_WINDOW {
+            state.window_start = now;
+            state.count = 0;
+            state.warned = false;
+        }
+        if now.duration_since(state.last) < PLAYER_GAP {
+            return Verdict::Drop;
+        }
+        if state.count >= PLAYER_PER_WINDOW {
+            return if std::mem::replace(&mut state.warned, true) { Verdict::Drop } else { Verdict::Warn };
+        }
+        state.last = now;
+        state.count += 1;
+        self.global_count += 1;
+        Verdict::Allow
+    }
+}
+
+impl Default for Limits {
+    fn default() -> Self { Self::new() }
+}
+
+// ---- composing answers -------------------------------------------------------------------------
+
+#[derive(Debug, Deserialize)]
+struct ViewReply {
+    #[serde(default)]
+    linked: bool,
+    #[serde(default)]
+    lines: Vec<String>,
+    #[serde(default)]
+    page: u32,
+    #[serde(default)]
+    pages: u32,
+    #[serde(default)]
+    more: bool,
+}
+
+#[derive(Debug, Deserialize)]
+struct TrackReply {
+    #[serde(default)]
+    issued: bool,
+    #[serde(default)]
+    lines: Vec<String>,
+    cmd_id: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct StatusReply {
+    status: String,
+}
+
+/// Turn a page into the lines to whisper: cleaned, bounded, plus our own page footer made from
+/// numbers (never from text NemoWorld sent).
+fn compose_view(reply: &ViewReply, command: &str) -> Vec<String> {
+    let mut lines: Vec<String> =
+        reply.lines.iter().filter_map(|l| clean_line(l)).take(MAX_REPLY_LINES - 1).collect();
+    if lines.is_empty() {
+        lines.push("I have nothing to show for that right now.".into());
+    }
+    if reply.linked && reply.more && (1..=99).contains(&reply.page) && (2..=99).contains(&reply.pages) {
+        lines.push(format!("Page {} of {}. Say more, or say {} {}.", reply.page, reply.pages, command, reply.page + 1));
+    }
+    lines
+}
+
+fn compose_marker_outcome(status: &str) -> &'static str {
+    match status {
+        "applied" => "Your map marker is placed. Open the map (M) and look for the quest flag.",
+        "rejected" => "The world could not place that marker, so nothing was added to your map.",
+        _ => "The world has not confirmed the marker, so it may not be on your map.",
+    }
+}
+
+/// Greeting spoken once on arrival (scripted, and says so).
+pub fn greeting(full_name: &str) -> String {
+    format!(
+        "Greetings. I am {full_name}, a NemoWorld host. My lines are scripted unless they start with [AI]. \
+         Whisper me help (/tell Selene help) and I will show you around."
+    )
+}
+
+/// Welcoming first-ten-minutes lines, spoken now and then when someone else is online.
+pub fn welcome_lines() -> Vec<String> {
+    [
+        "Welcome to Harr, traveller. Whisper me help and I will show you the way.",
+        "New to NemoWorld? Whisper me start for your first ten minutes.",
+        "Whisper passport, calling, quests or next, and I will tell you privately where you stand.",
+        "Lyra Scrollkeeper is nearby with a practice quest, the Quiet Survey. It awards nothing and is a gentle way to begin.",
+        "I only read and tell. Coins, approvals and progress are never given by chat; only the world records them.",
+    ]
+    .map(str::to_owned)
+    .to_vec()
+}
+
+// ---- the guide's state -------------------------------------------------------------------------
+
+/// A message the guide heard, already identified by the caller.
+pub struct Heard {
+    pub kind: Kind,
+    pub uuid: String,
+    pub alias: String,
+    pub text: String,
+}
+
+enum Reply {
+    View { uuid: String, alias: String, command: &'static str, page: u8, result: Result<ViewReply, String> },
+    Track { alias: String, result: Result<TrackReply, String> },
+    Marker { alias: String, status: String },
+}
+
+pub struct Hud {
+    nemo: Option<Nemo>,
+    first_name: String,
+    limits: Limits,
+    /// Last answer per player (for "more"): command and page.
+    last: HashMap<String, (&'static str, u8)>,
+    queue: VecDeque<(String, String)>,
+    tx: Sender<Reply>,
+    rx: Receiver<Reply>,
+    in_flight: usize,
+    last_tell: Instant,
+}
+
+impl Hud {
+    pub fn new(nemo: Option<Nemo>, full_name: &str) -> Self {
+        let (tx, rx) = channel();
+        Self {
+            nemo,
+            first_name: full_name.split_whitespace().next().unwrap_or(full_name).to_owned(),
+            limits: Limits::new(),
+            last: HashMap::new(),
+            queue: VecDeque::new(),
+            tx,
+            rx,
+            in_flight: 0,
+            last_tell: Instant::now() - TELL_GAP,
+        }
+    }
+
+    fn say(&mut self, alias: &str, lines: impl IntoIterator<Item = String>) {
+        for line in lines.into_iter().filter_map(|l| clean_line(&l)).take(MAX_REPLY_LINES) {
+            if self.queue.len() >= MAX_QUEUE {
+                break;
+            }
+            self.queue.push_back((alias.to_owned(), line));
+        }
+    }
+
+    /// Greet a player who has just arrived: four short private lines saying who she is, how to get started and what is
+    /// going on. The caller decides when (see main.rs); nothing here grants anything.
+    pub fn welcome(&mut self, alias: &str) {
+        if !valid_alias(alias) {
+            return;
+        }
+        self.say(alias, [
+            format!("Welcome to Harr, {alias}. I am {}, the village host: scripted, not a person, unless a line starts with [AI].", self.first_name),
+            format!("Everything here works by whispering. /tell {} start shows your first ten minutes, and /tell {} quests shows what you can do now.", self.first_name, self.first_name),
+            "To keep your progress in NemoWorld, whisper Lyra: /tell Lyra link my account. Lyra, at the house, also offers a gentle practice quest.".to_owned(),
+            format!("Harr is a place of study and building. /tell {} works shows what the village is raising now; /tell {} library lists places to discover and the finds the village has recorded; /tell {} pantry shares the village's food, free for everyone.", self.first_name, self.first_name, self.first_name),
+        ]);
+    }
+
+    /// Handle something said to or near the guide. Returns true when the guide dealt with it (so the
+    /// caller does not also give a free-form reply), false when it was not a command for the guide.
+    pub fn on_chat(&mut self, heard: Heard, now: Instant) -> bool {
+        if !valid_alias(&heard.alias) || !valid_uuid(&heard.uuid) {
+            return false;
+        }
+        let parsed = parse_command(&heard.text, heard.kind, &self.first_name);
+        let Some(command) = parsed else {
+            // A whisper that is not a command gets one friendly pointer, unless it is clearly
+            // conversation addressed to the guide by name, which the caller answers instead.
+            let named = heard.text.to_lowercase().contains(&self.first_name.to_lowercase());
+            if heard.kind == Kind::Whisper && !named {
+                if self.limits.check(&heard.uuid, now) == Verdict::Allow {
+                    self.say(&heard.alias, ["I did not catch that. Whisper help and I will list what I can show you.".to_owned()]);
+                }
+                return true;
+            }
+            return false;
+        };
+        match self.limits.check(&heard.uuid, now) {
+            Verdict::Allow => {},
+            Verdict::Drop => return true,
+            Verdict::Warn => {
+                self.say(&heard.alias, ["That is a lot of questions at once. Please wait a minute and ask again.".to_owned()]);
+                return true;
+            },
+        }
+        if self.nemo.is_none() {
+            self.say(&heard.alias, ["I cannot reach NemoWorld just now, so I cannot read your records.".to_owned()]);
+            return true;
+        }
+        if self.in_flight >= MAX_IN_FLIGHT {
+            self.say(&heard.alias, ["I am busy with other travellers. Please ask again in a moment.".to_owned()]);
+            return true;
+        }
+        match command {
+            Command::Track => self.spawn_track(&heard),
+            Command::Take(item) => self.spawn_take(&heard, item),
+            Command::View(name, page) => self.spawn_view(&heard, name, page.unwrap_or(1)),
+            Command::More | Command::Page(_) => {
+                let Some(&(name, page)) = self.last.get(&heard.uuid) else {
+                    self.say(&heard.alias, ["Ask me something first, like passport or quests, then say more.".to_owned()]);
+                    return true;
+                };
+                let wanted = match command {
+                    Command::Page(n) => n,
+                    _ => page.saturating_add(1),
+                };
+                self.spawn_view(&heard, name, wanted);
+            },
+        }
+        true
+    }
+
+    fn spawn_view(&mut self, heard: &Heard, name: &'static str, page: u8) {
+        if !PAGES.contains(&name) {
+            return;
+        }
+        if page > MAX_PAGE {
+            self.say(&heard.alias, ["There are not that many pages. Try a smaller number.".to_owned()]);
+            return;
+        }
+        let Some(nemo) = self.nemo.clone() else { return };
+        self.in_flight += 1;
+        let (tx, uuid, alias) = (self.tx.clone(), heard.uuid.clone(), heard.alias.clone());
+        thread::spawn(move || {
+            // The path is made only of a whitelisted word, a validated uuid and a number.
+            let path = format!("/api/v1/veloren/view/{name}?player_uuid={uuid}&page={page}");
+            let result = nemo.request("GET", &path, None).and_then(|(status, body)| {
+                if status != 200 {
+                    return Err(format!("status {status}"));
+                }
+                if body.len() > MAX_BODY_BYTES {
+                    return Err("reply too large".into());
+                }
+                serde_json::from_str::<ViewReply>(&body).map_err(|e| e.to_string())
+            });
+            let _ = tx.send(Reply::View { uuid, alias, command: name, page, result });
+        });
+    }
+
+    fn spawn_take(&mut self, heard: &Heard, item: &'static str) {
+        let Some(nemo) = self.nemo.clone() else { return };
+        self.in_flight += 1;
+        let (tx, uuid, alias) = (self.tx.clone(), heard.uuid.clone(), heard.alias.clone());
+        thread::spawn(move || {
+            // The body holds only a validated uuid and one word from a fixed list.
+            let body = serde_json::json!({ "player_uuid": uuid, "item": item }).to_string();
+            let result = nemo.request("POST", "/api/v1/veloren/pantry/take", Some(&body)).and_then(|(status, text)| {
+                if status != 200 {
+                    return Err(format!("status {status}"));
+                }
+                if text.len() > MAX_BODY_BYTES {
+                    return Err("reply too large".into());
+                }
+                serde_json::from_str::<TrackReply>(&text).map_err(|e| e.to_string())
+            });
+            let _ = tx.send(Reply::Track { alias, result });
+        });
+    }
+
+    fn spawn_track(&mut self, heard: &Heard) {
+        let Some(nemo) = self.nemo.clone() else { return };
+        self.in_flight += 1;
+        let (tx, uuid, alias) = (self.tx.clone(), heard.uuid.clone(), heard.alias.clone());
+        thread::spawn(move || {
+            let body = serde_json::json!({ "player_uuid": uuid }).to_string();
+            let result = nemo.request("POST", "/api/v1/veloren/hud/track", Some(&body)).and_then(|(status, text)| {
+                if status != 200 {
+                    return Err(format!("status {status}"));
+                }
+                if text.len() > MAX_BODY_BYTES {
+                    return Err("reply too large".into());
+                }
+                serde_json::from_str::<TrackReply>(&text).map_err(|e| e.to_string())
+            });
+            // When a marker was requested, keep asking whether the world confirmed it.
+            let confirm = result.as_ref().ok().filter(|r| r.issued).and_then(|r| r.cmd_id.clone());
+            let _ = tx.send(Reply::Track { alias: alias.clone(), result });
+            if let Some(cmd_id) = confirm.filter(|id| valid_uuid(id)) {
+                let path = format!("/api/v1/veloren/hud/status?player_uuid={uuid}&cmd_id={cmd_id}");
+                let mut status = "pending".to_owned();
+                for _ in 0..STATUS_POLLS {
+                    thread::sleep(STATUS_EVERY);
+                    if let Ok((200, text)) = nemo.request("GET", &path, None)
+                        && text.len() <= MAX_BODY_BYTES
+                        && let Ok(reply) = serde_json::from_str::<StatusReply>(&text)
+                    {
+                        status = reply.status;
+                        if status != "pending" {
+                            break;
+                        }
+                    }
+                }
+                let _ = tx.send(Reply::Marker { alias, status });
+            }
+        });
+    }
+
+    /// Move finished NemoWorld answers into the outgoing queue. Call once per game tick.
+    pub fn poll(&mut self) {
+        while let Ok(reply) = self.rx.try_recv() {
+            match reply {
+                Reply::View { uuid, alias, command, page, result } => {
+                    self.in_flight = self.in_flight.saturating_sub(1);
+                    match result {
+                        Ok(view) => {
+                            if view.linked {
+                                if self.last.len() >= MAX_TRACKED_PLAYERS && !self.last.contains_key(&uuid) {
+                                    if let Some(key) = self.last.keys().next().cloned() {
+                                        self.last.remove(&key);
+                                    }
+                                }
+                                self.last.insert(uuid, (command, page));
+                            }
+                            let lines = compose_view(&view, command);
+                            self.say(&alias, lines);
+                        },
+                        Err(e) => {
+                            tracing::warn!("NemoWorld view failed: {e}");
+                            self.say(&alias, [friendly_failure(&e).to_owned()]);
+                        },
+                    }
+                },
+                Reply::Track { alias, result, .. } => {
+                    // The marker thread sends its own reply when it finishes; free the slot now.
+                    self.in_flight = self.in_flight.saturating_sub(1);
+                    match result {
+                        Ok(track) => {
+                            let lines = track.lines.clone();
+                            self.say(&alias, lines);
+                        },
+                        Err(e) => {
+                            tracing::warn!("NemoWorld track failed: {e}");
+                            self.say(&alias, [friendly_failure(&e).to_owned()]);
+                        },
+                    }
+                },
+                Reply::Marker { alias, status } => {
+                    self.say(&alias, [compose_marker_outcome(&status).to_owned()]);
+                },
+            }
+        }
+    }
+
+    /// The next whisper to send, if one is due: (player name, line). The caller sends
+    /// `/tell <name> <line>` and then `/say` to leave whisper mode.
+    pub fn next_outgoing(&mut self, now: Instant) -> Option<(String, String)> {
+        if now.duration_since(self.last_tell) < TELL_GAP {
+            return None;
+        }
+        let item = self.queue.pop_front()?;
+        self.last_tell = now;
+        Some(item)
+    }
+
+    pub fn queued(&self) -> usize { self.queue.len() }
+}
+
+fn friendly_failure(error: &str) -> &'static str {
+    if error.contains("429") {
+        "Please wait a moment before asking again."
+    } else if error.contains("401") || error.contains("403") {
+        "My link to NemoWorld is not working at the moment. Please tell the host."
+    } else {
+        "NemoWorld is not answering right now. Please try again in a minute."
+    }
+}
