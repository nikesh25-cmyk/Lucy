+/// The terrain around a point as THIS client sees it (what the server sent), for choosing and for
+/// checking world dressing. Returns `None` until every chunk of the area has arrived.
+fn survey_report(client: &Client, spec: &[i32]) -> Option<Vec<String>> {
+    let (cx, cy, radius) = (spec[0], spec[1], spec[2].clamp(1, 80));
+    let step = spec.get(3).copied().unwrap_or(4).clamp(1, 16);
+    let z0 = client.position()?.z as i32;
+    let terrain = client.state().terrain();
+    for (x, y) in [(cx - radius, cy - radius), (cx + radius, cy - radius), (cx - radius, cy + radius), (cx + radius, cy + radius), (cx, cy)] {
+        terrain.get_key(TerrainGrid::chunk_key(Vec2::new(x, y)))?;
+    }
+    let mut out = vec![format!("PROBE_SURVEY centre=({cx},{cy}) radius={radius} step={step} viewer_z={z0}")];
+    let mut y = cy - radius;
+    while y <= cy + radius {
+        let mut row = format!("PROBE_SURVEY_ROW y={y}:");
+        let mut x = cx - radius;
+        while x <= cx + radius {
+            let top = terrain
+                .try_find_ground(Vec3::new(x, y, z0))
+                .map_or(String::from("  ?"), |g| format!("{:>3}", g.z));
+            row.push_str(&top);
+            x += step;
+        }
+        out.push(row);
+        y += step;
+    }
+    // Every sprite that is not a plant, in the whole box, with its position and orientation.
+    let mut found = 0usize;
+    for x in (cx - radius)..=(cx + radius) {
+        for y in (cy - radius)..=(cy + radius) {
+            for z in (z0 - 40)..=(z0 + 40) {
+                let Ok(block) = terrain.get(Vec3::new(x, y, z)) else { continue };
+                let Some(sprite) = block.get_sprite() else { continue };
+                if matches!(sprite.category(), Category::Plant | Category::Void) {
+                    continue;
+                }
+                found += 1;
+                if found <= 3000 {
+                    out.push(format!("PROBE_SPRITE {sprite:?} {x} {y} {z} glow={:?}", block.get_glow()));
+                }
+            }
+        }
+    }
+    out.push(format!("PROBE_SURVEY_END sprites={found}"));
+    Some(out)
+}
+
+/// Every non-air block in a box, as `x y z kind r g b sprite`. Capped so a typo cannot flood a log.
+fn dump_report(client: &Client, spec: &[i32]) -> Option<Vec<String>> {
+    let (lo, hi) = (
+        Vec3::new(spec[0].min(spec[3]), spec[1].min(spec[4]), spec[2].min(spec[5])),
+        Vec3::new(spec[0].max(spec[3]), spec[1].max(spec[4]), spec[2].max(spec[5])),
+    );
+    let terrain = client.state().terrain();
+    for (x, y) in [(lo.x, lo.y), (hi.x, lo.y), (lo.x, hi.y), (hi.x, hi.y)] {
+        terrain.get_key(TerrainGrid::chunk_key(Vec2::new(x, y)))?;
+    }
+    let mut out = vec![format!("PROBE_DUMP box=({},{},{})..({},{},{})", lo.x, lo.y, lo.z, hi.x, hi.y, hi.z)];
+    let mut count = 0usize;
+    for x in lo.x..=hi.x {
+        for y in lo.y..=hi.y {
+            for z in lo.z..=hi.z {
+                let Ok(block) = terrain.get(Vec3::new(x, y, z)) else { continue };
+                let sprite = block.get_sprite();
+                if block.kind() == BlockKind::Air && sprite.is_none_or(|s| matches!(s, SpriteKind::Empty)) {
+                    continue;
+                }
+                count += 1;
+                if count <= 30000 {
+                    let colour = block.get_color().unwrap_or_default();
+                    out.push(format!(
+                        "PROBE_BLOCK {x} {y} {z} {:?} {},{},{} {}",
+                        block.kind(),
+                        colour.r,
+                        colour.g,
+                        colour.b,
+                        sprite.map_or(String::from("-"), |s| format!("{s:?}"))
+                    ));
+                }
+            }
+        }
+    }
+    out.push(format!("PROBE_DUMP_END blocks={count}"));
+    Some(out)
+}
+
+fn site_text(label: &Option<comp::Content>) -> String {
+    match label {
+        Some(comp::Content::Plain(text)) => text.clone(),
+        Some(other) => format!("{other:?}"),
+        None => String::new(),
+    }
+}
