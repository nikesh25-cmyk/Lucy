+//! NemoWorld homes: a claimed plot becomes a visible, furnished cottage in the Veloren world.
+//!
+//! What Veloren permits, and what this uses: the server can change terrain at run time through
+//! `BlockChange` (the resource behind the admin `/make_block` and `/make_sprite` commands). Blocks
+//! only change in chunks that are loaded, and a chunk that unloads forgets them unless the experimental
+//! terrain persistence setting is on. So this system keeps a small registry of homes and re-checks a
+//! marker block every second: when a chunk has been reloaded without its cottage, the cottage is
+//! stamped again. The registry is written to `<outbox>.homes.json` and survives a restart.
+//!
+//! Trust: nothing here decides who may enter. NemoWorld decides (it knows the linked account, the
+//! land stewardship and the owner's guest list) and sends a signed, expiring, once-only command:
+//!   * `home_build`  {"plot":"plot:0:0:1:2","style":3}  put the cottage on this plot (owner = the command's player)
+//!   * `home_enter`  {"plot":"..."}                      move the player inside
+//!   * `home_leave`  {"plot":"..."}                      move the player (inside that room) to the doorstep
+//! Arguments are parsed by `nemo_link_proto::home::parse_args`, which accepts exactly those forms, so a
+//! command can never carry a coordinate. Where a plot lies comes from the server's own config. The room
+//! is a sealed shell (see the tests in `nemo-link-proto/src/home.rs`): walking in is impossible, so the
+//! signed teleport is the only way in. Leaving is always allowed: stand on the doormat. Anyone found
+//! inside who is not the owner and did not arrive through a signed `home_enter` is moved to the
+//! doorstep (for example a guest whose access was withdrawn while logged out).
+//!
+//! Off unless the link config has a `home` section: `"home": {"origin_x": 15300, "origin_y": 16100}`.
+
+use common::{
+    comp::{Player, Pos},
+    event::{EventBus, TeleportToPositionEvent},
+    resources::Time,
+    terrain::{Block, BlockKind, SpriteKind, TerrainGrid},
+    vol::{FilledVox, ReadVol},
+};
+use common_ecs::{Job, Origin, Phase, System};
+use common_state::BlockChange;
+use hashbrown::HashMap;
+use nemo_link_proto::home::{
+    self, Ground, Layout, Mat, Plot, Reject, Spr, blueprint, choose_base, on_mat, parse_args, sentinel,
+    to_local,
+};
+use serde::{Deserialize, Serialize};
+use specs::{Entities, Entity, Join, Read, ReadExpect, ReadStorage, Write};
+use std::{
+    collections::BTreeMap,
+    fs,
+    path::{Path, PathBuf},
+    sync::Arc,
+};
+use tracing::{info, warn};
+use vek::{Rgb, Vec2, Vec3};
+use world::World;
+
+use super::nemo_link::{Command, NemoLinkState};
+
+const KINDS: [&str; 3] = ["home_build", "home_enter", "home_leave"];
+/// How often the system works (seconds of game time).
+const EVERY: f64 = 0.5;
+/// Standing on the doormat this long leaves the room.
+const MAT_SECS: f64 = 1.5;
+/// A player moved in by a signed command is not judged a trespasser for this long.
+const ARRIVAL_GRACE: f64 = 5.0;
+/// At most this many people inside one home at once.
+const MAX_INSIDE: usize = 12;
+/// A player may be sent in again no sooner than this.
+const ENTER_GAP: f64 = 3.0;
+
+#[derive(Serialize, Deserialize, Clone, Debug)]
+struct HomeRec {
+    plot: String,
+    /// Veloren account of the steward when the cottage was last built (used to recognise the owner).
+    owner: String,
+    style: u8,
+    /// Floor level, fixed when the cottage was first stamped so a re-stamp lands in the same place.
+    base: Option<i32>,
+}
+
+struct Home {
+    rec: HomeRec,
+    plot: Plot,
+    cell: (i32, i32),
+    /// The cottage is known to stand (marker block verified).
+    stamped: bool,
+    /// A new build was requested: stamp even if the marker is already there (new style).
+    dirty: bool,
+    /// Time after which the marker is checked following a stamp.
+    verify_at: Option<f64>,
+    /// Build commands waiting for this home to stand.
+    builds: Vec<Command>,
+}
+
+struct Inside {
+    plot: String,
+    since: f64,
+}
+
+struct Config {
+    layout: Layout,
+    registry: PathBuf,
+    plots_file: PathBuf,
+}
+
+#[derive(Default)]
+pub struct NemoHomeState {
+    loaded: bool,
+    cfg: Option<Config>,
+    last_run: f64,
+    homes: BTreeMap<String, Home>,
+    /// Enter commands whose chunks are not loaded yet (kept until they expire).
+    waiting: Vec<Command>,
+    inside: HashMap<String, Inside>,
+    mat_since: HashMap<String, f64>,
+    last_enter: HashMap<String, f64>,
+}
+
+fn unix_ms() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |d| d.as_millis() as u64)
+}
+
+fn rgb((r, g, b): (u8, u8, u8)) -> Rgb<u8> { Rgb::new(r, g, b) }
+
+fn sprite_of(sprite: Spr) -> SpriteKind {
+    match sprite {
+        Spr::Lantern => SpriteKind::Lantern,
+        Spr::Candle => SpriteKind::Candle,
+        Spr::BedHead => SpriteKind::BedWoodWoodlandHead,
+        Spr::BedMiddle => SpriteKind::BedWoodWoodlandMiddle,
+        Spr::BedTail => SpriteKind::BedWoodWoodlandTail,
+        Spr::BookshelfMiddle => SpriteKind::BookshelfMiddle,
+        Spr::BookshelfEnd => SpriteKind::BookshelfEnd,
+        Spr::TableCorner => SpriteKind::TableWoodFancyWoodlandCorner,
+        Spr::TableBody => SpriteKind::TableWoodFancyWoodlandBody,
+        Spr::Bench => SpriteKind::BenchWoodWoodland,
+        Spr::Chair => SpriteKind::ChairWoodWoodland,
+        Spr::Hearth => SpriteKind::Hearth,
+        Spr::CookingPot => SpriteKind::CookingPot,
+        Spr::VaultChest => SpriteKind::ChestWoodDouble,
+        Spr::Flowerpot => SpriteKind::FlowerpotWoodWoodlandS,
+        Spr::Drawer => SpriteKind::DrawerWoodWoodlandM1,
+        Spr::Fence => SpriteKind::FenceWoodWoodland,
+        Spr::FencePost => SpriteKind::FencePost,
+        Spr::RedFlower => SpriteKind::RedFlower,
+        Spr::YellowFlower => SpriteKind::YellowFlower,
+        Spr::WhiteFlower => SpriteKind::WhiteFlower,
+    }
+}
+
+fn block_of(mat: Mat) -> Block {
+    let kind = match mat {
+        Mat::Air => return Block::empty(),
+        Mat::Spr(sprite) => return Block::air(sprite_of(sprite)),
+        Mat::Grass => BlockKind::Grass,
+        Mat::Earth | Mat::Path => BlockKind::Earth,
+        Mat::Floor | Mat::Trim | Mat::Door | Mat::Rug => BlockKind::Wood,
+        Mat::Wall | Mat::Roof(_) | Mat::Glass => BlockKind::Rock,
+        // The marker is a Misc block of a colour nothing else uses.
+        Mat::DoorMat => BlockKind::Misc,
+    };
+    Block::new(kind, rgb(mat.color().unwrap_or((128, 128, 128))))
+}
+
+fn load_config() -> Option<Config> {
+    let path = std::env::var("NEMO_LINK_CONFIG").ok()?;
+    let value: serde_json::Value = serde_json::from_str(&fs::read_to_string(&path).ok()?).ok()?;
+    let home = value.get("home")?;
+    if home.get("enabled").and_then(serde_json::Value::as_bool) == Some(false) {
+        return None;
+    }
+    let coordinate = |key: &str| home.get(key).and_then(serde_json::Value::as_i64).and_then(|v| i32::try_from(v).ok());
+    let layout = Layout::new(coordinate("origin_x")?, coordinate("origin_y")?)?;
+    let outbox = value.get("outbox")?.as_str()?.to_owned();
+    Some(Config {
+        layout,
+        registry: PathBuf::from(format!("{outbox}.homes.json")),
+        plots_file: PathBuf::from(format!("{outbox}.home_plots.json")),
+    })
+}
+
+fn write_atomically(path: &Path, text: &str) {
+    let tmp = path.with_extension("tmp");
+    if let Err(e) = fs::write(&tmp, text).and_then(|()| fs::rename(&tmp, path)) {
+        warn!("could not write {}: {e}", path.display());
+    }
+}
+
+impl NemoHomeState {
+    fn save(&self) {
+        let Some(cfg) = &self.cfg else { return };
+        let recs: Vec<&HomeRec> = self.homes.values().map(|h| &h.rec).collect();
+        match serde_json::to_string_pretty(&serde_json::json!({ "homes": recs })) {
+            Ok(text) => write_atomically(&cfg.registry, &text),
+            Err(e) => warn!("could not serialise the home registry: {e}"),
+        }
+    }
+
+    fn insert(&mut self, layout: &Layout, rec: HomeRec) -> Result<(), Reject> {
+        let plot = Plot::parse(&rec.plot)?;
+        let cell = layout.cell_origin(&plot)?;
+        self.homes.insert(rec.plot.clone(), Home {
+            plot,
+            cell,
+            stamped: false,
+            dirty: false,
+            verify_at: None,
+            builds: Vec::new(),
+            rec,
+        });
+        Ok(())
+    }
+}
+
+/// Foliage and trunks are not ground: a tree is cleared with the pad, not built on.
+fn is_foliage(kind: BlockKind) -> bool {
+    matches!(kind, BlockKind::Leaves | BlockKind::ArtLeaves | BlockKind::Wood | BlockKind::GlowingMushroom)
+}
+
+fn chunks_loaded(terrain: &TerrainGrid, cell: (i32, i32)) -> bool {
+    let (x0, y0) = (cell.0 + home::PAD_X.0, cell.1 + home::PAD_Y.0);
+    let (x1, y1) = (cell.0 + home::PAD_X.1, cell.1 + home::PAD_Y.1);
+    [(x0, y0), (x1, y0), (x0, y1), (x1, y1)]
+        .iter()
+        .all(|&(x, y)| terrain.get_key_real(TerrainGrid::chunk_key(Vec2::new(x, y))).is_some())
+}
+
+/// The ground in one column: the highest solid non-foliage block near the world's own estimate.
+fn ground_at(terrain: &TerrainGrid, world: &World, x: i32, y: i32) -> Option<Ground> {
+    let estimate = world.sim().get_alt_approx(Vec2::new(x, y))? as i32;
+    for z in ((estimate - 40)..=(estimate + 40)).rev() {
+        let Ok(block) = terrain.get(Vec3::new(x, y, z)) else { continue };
+        if block.kind().is_liquid() {
+            return Some(Ground { top: z, liquid: true });
+        }
+        if block.is_filled() && !is_foliage(block.kind()) {
+            return Some(Ground { top: z, liquid: false });
+        }
+    }
+    None
+}
+
+fn sample_base(terrain: &TerrainGrid, world: &World, cell: (i32, i32)) -> Result<i32, Reject> {
+    let mut samples = Vec::new();
+    for dx in [1, 4, 7, 10, 12] {
+        for dy in [1, 4, 7, 10, 12] {
+            samples.push(ground_at(terrain, world, cell.0 + dx, cell.1 + dy).ok_or(Reject::NoGround)?);
+        }
+    }
+    choose_base(&samples)
+}
+
+/// Apply the cottage: foundation under low ground, then every block of the blueprint.
+fn stamp(terrain: &TerrainGrid, changes: &mut BlockChange, home: &Home, base: i32) {
+    let earth = block_of(Mat::Earth);
+    for x in home::PAD_X.0..=home::PAD_X.1 {
+        for y in home::PAD_Y.0..=home::PAD_Y.1 {
+            for dz in (-home::FOUNDATION_DEPTH..=-2).rev() {
+                let pos = Vec3::new(home.cell.0 + x, home.cell.1 + y, base + dz);
+                let solid = terrain
+                    .get(pos)
+                    .is_ok_and(|b| b.is_filled() && b.get_sprite().is_none() && !is_foliage(b.kind()));
+                if !solid {
+                    changes.set(pos, earth);
+                }
+            }
+        }
+    }
+    for put in blueprint(home.rec.style) {
+        changes.set(Vec3::new(home.cell.0 + put.x, home.cell.1 + put.y, base + put.dz), block_of(put.mat));
+    }
+}
+
+fn marker_stands(terrain: &TerrainGrid, home: &Home, base: i32) -> bool {
+    let (x, y, dz, mat) = sentinel();
+    terrain
+        .get(Vec3::new(home.cell.0 + x, home.cell.1 + y, base + dz))
+        .is_ok_and(|b| *b == block_of(mat))
+}
+
+struct Online {
+    entity: Entity,
+    uuid: String,
+    pos: Vec3<f32>,
+}
+
+fn find_online<'a>(online: &'a [Online], uuid: &str) -> Option<&'a Online> {
+    online.iter().find(|p| p.uuid.eq_ignore_ascii_case(uuid))
+}
+
+/// A one-line report of every commons plot the world's own height map says is fit to build on,
+/// written for NemoWorld so it only offers plots that can really be built.
+fn write_plots(cfg: &Config, world: &World) {
+    let sea = world::config::CONFIG.sea_level;
+    let mut plots = Vec::new();
+    for py in 0..home::PLOT_GRID {
+        for px in 0..home::PLOT_GRID {
+            let plot = Plot { sx: 0, sy: 0, px, py };
+            let Ok(cell) = cfg.layout.cell_origin(&plot) else { continue };
+            let mut alts = Vec::new();
+            let mut wet = false;
+            for dx in [1, 4, 7, 10, 12] {
+                for dy in [1, 4, 7, 10, 12] {
+                    let at = Vec2::new(cell.0 + dx, cell.1 + dy);
+                    match world.sim().get_alt_approx(at) {
+                        Some(alt) => alts.push(alt),
+                        None => wet = true,
+                    }
+                    if let Some(chunk) = world.sim().get_wpos(at) {
+                        wet |= chunk.river.is_river() || chunk.river.is_lake() || chunk.river.is_ocean();
+                    }
+                }
+            }
+            let (lo, hi) = alts.iter().fold((f32::MAX, f32::MIN), |(lo, hi), &a| (lo.min(a), hi.max(a)));
+            let steep = hi - lo > home::MAX_RELIEF as f32 - 1.0;
+            wet |= lo <= sea + 1.0;
+            plots.push(serde_json::json!({
+                "plot": plot.id(), "x": cell.0, "y": cell.1,
+                "alt_min": lo.round(), "alt_max": hi.round(), "suitable": !(wet || steep || alts.is_empty()),
+                "why_not": if wet { "water" } else if steep { "steep" } else { "" },
+            }));
+        }
+    }
+    let ok = plots.iter().filter(|p| p["suitable"] == true).count();
+    info!("NemoWorld homes: {ok} of {} commons plots look buildable (origin {}, {})", plots.len(), cfg.layout.origin_x, cfg.layout.origin_y);
+    let text = serde_json::json!({
+        "origin_x": cfg.layout.origin_x, "origin_y": cfg.layout.origin_y, "spacing": home::SPACING, "plots": plots,
+    })
+    .to_string();
+    write_atomically(&cfg.plots_file, &text);
+}
+
+#[derive(Default)]
+pub struct Sys;
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Entities<'a>,
+        ReadStorage<'a, Pos>,
+        ReadStorage<'a, Player>,
+        Read<'a, Time>,
+        Write<'a, NemoLinkState>,
+        Write<'a, NemoHomeState>,
+        Write<'a, BlockChange>,
+        Read<'a, EventBus<TeleportToPositionEvent>>,
+        ReadExpect<'a, TerrainGrid>,
+        ReadExpect<'a, Arc<World>>,
+    );
+
+    const NAME: &'static str = "nemo_home";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(
+        _job: &mut Job<Self>,
+        (entities, positions, players, time, mut link, mut state, mut changes, teleports, terrain, world): Self::SystemData,
+    ) {
+        let state = &mut *state;
+        let now = time.0;
+        if !link.is_on() {
+            return;
+        }
+        if !state.loaded {
+            state.loaded = true;
+            state.cfg = load_config();
+            // Take what the load needs as owned values: `state` is mutated in the loop below, so a borrow
+            // of `state.cfg` cannot outlive it.
+            let Some((registry, layout)) = state.cfg.as_ref().map(|c| (c.registry.clone(), c.layout)) else { return };
+            if let Some(list) = fs::read_to_string(&registry).ok().and_then(|t| serde_json::from_str::<serde_json::Value>(&t).ok()) {
+                for rec in list["homes"].as_array().into_iter().flatten().filter_map(|v| serde_json::from_value::<HomeRec>(v.clone()).ok()) {
+                    let plot = rec.plot.clone();
+                    if state.insert(&layout, rec).is_err() {
+                        warn!("ignoring an invalid home record for {plot}");
+                    }
+                }
+            }
+            info!("NemoWorld homes are on: {} registered, commons origin ({}, {})", state.homes.len(), layout.origin_x, layout.origin_y);
+            if let Some(cfg) = state.cfg.as_ref() {
+                write_plots(cfg, &world);
+            }
+        }
+        let Some(layout) = state.cfg.as_ref().map(|c| c.layout) else { return };
+        if now - state.last_run < EVERY {
+            return;
+        }
+        state.last_run = now;
+
+        let online: Vec<Online> = (&entities, &positions, &players)
+            .join()
+            .map(|(entity, pos, player)| Online { entity, uuid: player.uuid().to_string(), pos: pos.0 })
+            .collect();
+        let mut teleporter = teleports.emitter();
+        let mut teleport = |entity: Entity, to: Vec3<f32>| {
+            teleporter.emit(TeleportToPositionEvent { entity, position: to });
+        };
+
+        // 1. New commands (each is handed out once by the link, after its signature has been checked).
+        let mut commands = link.poll_commands(&KINDS);
+        commands.extend(std::mem::take(&mut state.waiting));
+        let mut changed = false;
+        for cmd in commands {
+            if unix_ms() > cmd.expires_at {
+                link.ack(&cmd, false, "expired");
+                continue;
+            }
+            match cmd.kind.as_str() {
+                "home_build" => {
+                    let parsed = parse_args(&cmd.args, true).and_then(|(plot, style)| layout.cell_origin(&plot).map(|_| (plot, style)));
+                    let (plot, style) = match parsed {
+                        Ok(ok) => ok,
+                        Err(reject) => {
+                            link.ack(&cmd, false, reject.code());
+                            continue;
+                        },
+                    };
+                    if find_online(&online, &cmd.player_uuid).is_none() {
+                        link.ack(&cmd, false, "player_not_online");
+                        continue;
+                    }
+                    let id = plot.id();
+                    let base = state.homes.get(&id).and_then(|h| h.rec.base);
+                    let waiting = state.homes.get_mut(&id).map(|h| std::mem::take(&mut h.builds)).unwrap_or_default();
+                    if state.insert(&layout, HomeRec { plot: id.clone(), owner: cmd.player_uuid.clone(), style, base }).is_err() {
+                        link.ack(&cmd, false, "bad_plot");
+                        continue;
+                    }
+                    if let Some(home) = state.homes.get_mut(&id) {
+                        home.dirty = true;
+                        home.builds = waiting;
+                        home.builds.push(cmd);
+                    }
+                    changed = true;
+                },
+                "home_enter" | "home_leave" => {
+                    let entering = cmd.kind == "home_enter";
+                    let plot = match parse_args(&cmd.args, false).and_then(|(plot, _)| layout.cell_origin(&plot).map(|_| plot)) {
+                        Ok(plot) => plot,
+                        Err(reject) => {
+                            link.ack(&cmd, false, reject.code());
+                            continue;
+                        },
+                    };
+                    let Some(player) = find_online(&online, &cmd.player_uuid) else {
+                        link.ack(&cmd, false, "player_not_online");
+                        continue;
+                    };
+                    let Some(home) = state.homes.get(&plot.id()) else {
+                        link.ack(&cmd, false, "no_home");
+                        continue;
+                    };
+                    let Some(base) = home.rec.base.filter(|_| home.stamped) else {
+                        // Not standing yet (chunks not loaded or being rebuilt): keep it until it expires.
+                        if entering && unix_ms() + 1000 < cmd.expires_at {
+                            state.waiting.push(cmd);
+                        } else {
+                            link.ack(&cmd, false, "home_not_ready");
+                        }
+                        continue;
+                    };
+                    let uuid = player.uuid.to_lowercase();
+                    if entering {
+                        if state.last_enter.get(&uuid).is_some_and(|&t| now - t < ENTER_GAP) {
+                            link.ack(&cmd, false, "too_soon");
+                            continue;
+                        }
+                        if state.inside.values().filter(|i| i.plot == home.rec.plot).count() >= MAX_INSIDE {
+                            link.ack(&cmd, false, "full");
+                            continue;
+                        }
+                        let to = Vec3::new(home.cell.0 as f32 + home::SPAWN.0, home.cell.1 as f32 + home::SPAWN.1, base as f32 + 0.1);
+                        teleport(player.entity, to);
+                        state.inside.insert(uuid.clone(), Inside { plot: home.rec.plot.clone(), since: now });
+                        state.last_enter.insert(uuid, now);
+                        link.ack(&cmd, true, "entered");
+                    } else {
+                        let local = to_local(home.cell, player.pos.x, player.pos.y, player.pos.z, base);
+                        if !home::inside_room(local.0, local.1, local.2) {
+                            link.ack(&cmd, false, "not_inside");
+                            continue;
+                        }
+                        let to = Vec3::new(home.cell.0 as f32 + home::DOORSTEP.0, home.cell.1 as f32 + home::DOORSTEP.1, base as f32 + 0.1);
+                        teleport(player.entity, to);
+                        state.inside.remove(&uuid);
+                        state.mat_since.remove(&uuid);
+                        link.ack(&cmd, true, "left");
+                    }
+                },
+                other => link.ack(&cmd, false, &format!("unknown_kind_{}", other.len())),
+            }
+        }
+
+        // 2. Keep every cottage standing, one stamp per pass.
+        let mut stamped_one = false;
+        let mut failed: Vec<(String, Reject)> = Vec::new();
+        for (id, home) in &mut state.homes {
+            if !chunks_loaded(&terrain, home.cell) {
+                home.stamped = false;
+                continue;
+            }
+            let base = match home.rec.base {
+                Some(base) => base,
+                None => match sample_base(&terrain, &world, home.cell) {
+                    Ok(base) => {
+                        home.rec.base = Some(base);
+                        changed = true;
+                        base
+                    },
+                    Err(reject) => {
+                        failed.push((id.clone(), reject));
+                        continue;
+                    },
+                },
+            };
+            if let Some(at) = home.verify_at {
+                if now >= at {
+                    home.verify_at = None;
+                    if marker_stands(&terrain, home, base) {
+                        home.stamped = true;
+                        for cmd in std::mem::take(&mut home.builds) {
+                            link.ack(&cmd, true, "built");
+                        }
+                        info!(plot = %id, base, "NemoWorld cottage stands");
+                    }
+                }
+                continue;
+            }
+            let standing = !home.dirty && marker_stands(&terrain, home, base);
+            if standing {
+                if !home.stamped {
+                    home.stamped = true;
+                    for cmd in std::mem::take(&mut home.builds) {
+                        link.ack(&cmd, true, "built");
+                    }
+                }
+            } else if !stamped_one {
+                stamp(&terrain, &mut changes, home, base);
+                home.dirty = false;
+                home.stamped = false;
+                home.verify_at = Some(now + 1.0);
+                stamped_one = true;
+                info!(plot = %id, base, style = home.rec.style, "NemoWorld cottage stamped");
+            }
+        }
+        for (id, reject) in failed {
+            if let Some(home) = state.homes.remove(&id) {
+                for cmd in home.builds {
+                    link.ack(&cmd, false, reject.code());
+                }
+                warn!(plot = %id, reason = reject.code(), "NemoWorld cottage refused");
+                changed = true;
+            }
+        }
+        // Build commands that waited until they expired without the cottage standing.
+        let t = unix_ms();
+        for home in state.homes.values_mut() {
+            let (late, keep): (Vec<_>, Vec<_>) = std::mem::take(&mut home.builds).into_iter().partition(|c| t > c.expires_at);
+            home.builds = keep;
+            for cmd in late {
+                link.ack(&cmd, false, "chunks_not_loaded");
+            }
+        }
+        if changed {
+            state.save();
+        }
+
+        // 3. The people inside: the doormat leaves, strangers are moved out, stale records go.
+        let mut to_remove: Vec<String> = Vec::new();
+        for player in &online {
+            let uuid = player.uuid.to_lowercase();
+            let mut in_room: Option<&Home> = None;
+            for home in state.homes.values().filter(|h| h.stamped) {
+                let Some(base) = home.rec.base else { continue };
+                let local = to_local(home.cell, player.pos.x, player.pos.y, player.pos.z, base);
+                if home::inside_room(local.0, local.1, local.2) {
+                    in_room = Some(home);
+                    break;
+                }
+            }
+            let Some(home) = in_room else {
+                state.mat_since.remove(&uuid);
+                if state.inside.get(&uuid).is_some_and(|i| now - i.since > ARRIVAL_GRACE) {
+                    to_remove.push(uuid);
+                }
+                continue;
+            };
+            let base = home.rec.base.unwrap_or(0);
+            let doorstep = Vec3::new(home.cell.0 as f32 + home::DOORSTEP.0, home.cell.1 as f32 + home::DOORSTEP.1, base as f32 + 0.1);
+            let welcome = home.rec.owner.eq_ignore_ascii_case(&uuid) || state.inside.get(&uuid).is_some_and(|i| i.plot == home.rec.plot);
+            if !welcome {
+                info!(plot = %home.rec.plot, "NemoWorld cottage: moving an uninvited player out");
+                teleport(player.entity, doorstep);
+                continue;
+            }
+            let local = to_local(home.cell, player.pos.x, player.pos.y, player.pos.z, base);
+            if on_mat(local.0, local.1, local.2) {
+                let since = *state.mat_since.entry(uuid.clone()).or_insert(now);
+                if now - since >= MAT_SECS {
+                    teleport(player.entity, doorstep);
+                    state.mat_since.remove(&uuid);
+                    state.inside.remove(&uuid);
+                }
+            } else {
+                state.mat_since.remove(&uuid);
+            }
+        }
+        for uuid in to_remove {
+            state.inside.remove(&uuid);
+        }
+        // Forget people who logged out.
+        state.inside.retain(|uuid, _| online.iter().any(|p| p.uuid.eq_ignore_ascii_case(uuid)));
+        state.mat_since.retain(|uuid, _| online.iter().any(|p| p.uuid.eq_ignore_ascii_case(uuid)));
+    }
+}
diff --git a/server/src/sys/nemo_hud.rs b/server/src/sys/nemo_hud.rs
