+    #[test]
+    fn a_sentinel_whose_chunk_is_not_loaded_is_neither_missing_nor_standing() {
+        // `Voxel::get` returns `None` for a cell whose chunk is not loaded (the live grid returns
+        // `NoSuchChunk`), which is *not* the same as a cell that is there and wrong. If it were
+        // treated as missing, a chunk that was briefly unloaded would be recorded as cells the game
+        // removed, and the group would stop being repaired there.
+        let plan = planned();
+        let mut world = generated();
+        stamp(&plan, 100, &mut world);
+        assert!(standing(&plan, 100, &world), "it stands to begin with");
+        assert!(missing(&plan, 100, &world, &BTreeSet::new()).is_empty());
+        assert!(unreadable(&plan, 100, &world, &BTreeSet::new()).is_empty());
+
+        // The chunk that holds one sprite and one floor cell is unloaded.
+        let unloaded = [[0, 0, 1], [0, 0, 0]];
+        for cell in unloaded {
+            world.set([plan.anchor.0 + cell[0], plan.anchor.1 + cell[1], 100 + cell[2]], Block::empty());
+            world.blocks.remove(&[plan.anchor.0 + cell[0], plan.anchor.1 + cell[1], 100 + cell[2]]);
+        }
+        let mut unreadable_cells = unreadable(&plan, 100, &world, &BTreeSet::new());
+        unreadable_cells.sort();
+        let mut want = vec![unloaded[0], unloaded[1]];
+        want.sort();
+        assert_eq!(unreadable_cells, want, "only the cells that cannot be read");
+        assert!(missing(&plan, 100, &world, &BTreeSet::new()).is_empty(), "nothing is *known* to be wrong");
+        assert!(!standing(&plan, 100, &world), "and the group is not known to stand either");
+
+        // A loaded cell that is wrong is a missing cell, and the group is written again.
+        world.set([plan.anchor.0, plan.anchor.1, 101], Block::empty());
+        assert_eq!(missing(&plan, 100, &world, &BTreeSet::new()), vec![[0, 0, 1]]);
+        assert!(!standing(&plan, 100, &world));
+    }
