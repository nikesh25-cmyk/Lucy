+/// Walks a character with Veloren's own pathfinder (the one NPCs use).
+struct Navigator {
+    chaser: Chaser,
+    jump_release: Option<Instant>,
+    /// What the pathfinder last said, for the status log.
+    note: String,
+}
+
+impl Navigator {
+    fn new() -> Self {
+        Self {
+            chaser: Chaser::default(),
+            jump_release: None,
+            note: String::new(),
+        }
+    }
+
+    /// Returns the movement input towards `target`, or `None` when already within `arrive` blocks.
+    fn steer(
+        &mut self,
+        client: &mut Client,
+        target: Vec2<f32>,
+        arrive: f32,
+        body: &comp::Body,
+    ) -> Option<(Vec2<f32>, Dir)> {
+        let now = Instant::now();
+        if self.jump_release.is_some_and(|t| now >= t) {
+            client.handle_input(InputKind::Jump, false, None, None);
+            self.jump_release = None;
+        }
+        let pos = client.position()?;
+        if (target - pos.xy()).magnitude() <= arrive {
+            self.chaser = Chaser::default();
+            return None;
+        }
+        let (loaded, goal) = {
+            let terrain = client.state().terrain();
+            let (tx, ty) = (target.x as i32, target.y as i32);
+            match terrain.get_key(TerrainGrid::chunk_key(target.map(|e| e as i32))) {
+                // Look for ground near where we stand first (the target is usually at a similar
+                // height), then from the top of the target's chunk for a far-off height.
+                Some(chunk) => {
+                    let near = terrain.try_find_ground(Vec3::new(tx, ty, pos.z as i32));
+                    let high = || terrain.try_find_ground(Vec3::new(tx, ty, chunk.get_max_z()));
+                    let found = near.or_else(high).unwrap_or(Vec3::new(tx, ty, pos.z as i32));
+                    (true, found.map(|e| e as f32))
+                },
+                None => (false, Vec3::new(target.x, target.y, pos.z)),
+            }
+        };
+        let physics = client.current::<comp::PhysicsState>();
+        let vel = client.current::<comp::Vel>().map_or(Vec3::zero(), |v| v.0);
+        let in_liquid = physics.as_ref().is_some_and(|p| p.in_liquid().is_some());
+        let config = TraversalConfig {
+            node_tolerance: 1.25,
+            slow_factor: 0.0,
+            on_ground: physics.as_ref().is_none_or(|p| p.on_ground.is_some()),
+            in_liquid,
+            min_tgt_dist: 1.5,
+            moving_body: Some(body.clone()),
+            vectored_propulsion: false,
+            is_target_loaded: loaded,
+        };
+        let time = Time(client.state().get_time());
+        let step = {
+            let terrain = client.state().terrain();
+            self.chaser.chase(&*terrain, pos, vel, goal, config, &time)
+        };
+        self.note = format!("goal=({:.0},{:.0},{:.0}) route={:?}", goal.x, goal.y, goal.z, step);
+        let (bearing, speed, _stuck) =
+            step.unwrap_or_else(|| ((goal - pos).try_normalized().unwrap_or(Vec3::unit_x()), 1.0, false));
+        let direction = bearing.xy().try_normalized().unwrap_or_default();
+        if (bearing.z > 0.5 || in_liquid) && self.jump_release.is_none() {
+            client.handle_input(InputKind::Jump, true, None, None);
+            self.jump_release = Some(now + Duration::from_millis(250));
+        }
+        let look = Dir::from_unnormalized(Vec3::new(direction.x, direction.y, 0.0)).unwrap_or_default();
+        Some((direction * speed.clamp(0.0, 1.0), look))
+    }
+}
