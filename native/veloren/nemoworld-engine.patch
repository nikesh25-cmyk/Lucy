+//! Shop talk for a NemoWorld shopkeeper resident (Kael Hearthforge).
+//!
+//! The bridge is a messenger and nothing more. A player's words (a `/tell` to the shopkeeper, or a
+//! public line that names him) are forwarded to NemoWorld's `/veloren/shop/ask`; NemoWorld answers
+//! with the lines to speak, built from its own shop view. The bridge then speaks them back to that
+//! player with `/tell`. It also polls `/veloren/shop/notices` (delivered, refused, expired) and
+//! tells the player.
+//!
+//! What this file never does:
+//! * it never decides a price, a good, a balance or a purchase;
+//! * it never charges Karma or hands over an item (a purchase is confirmed by a signed-in human in
+//!   NemoWorld; the item is given by the Veloren server when NemoWorld's signed command arrives);
+//! * it never repeats what a player said as a command (the player's text is sent to NemoWorld as
+//!   data; the replies are lines to speak, spoken with `/tell <alias>` where the alias comes from
+//!   the server's player list, not from the text).
+//!
+//! The same file holds a scripted stand-in player (`--script`) so the whole loop can be driven in
+//! tests: it asks, waits for words, and reads its own inventory.
+
+use crate::nemo::Nemo;
+use common::comp::{self, ChatType};
+use serde::Deserialize;
+use std::{
+    collections::{HashMap, VecDeque},
+    sync::mpsc::{self, Receiver, Sender},
+    thread,
+    time::{Duration, Instant},
+};
+use tracing::{info, warn};
+use veloren_client::Client;
+
+/// A player may ask this often; faster asks are dropped here (NemoWorld has its own limit too).
+const ASK_GAP: Duration = Duration::from_secs(2);
+/// Private messages are exempt from Veloren's chat spam filter, but stay readable.
+const TELL_GAP: Duration = Duration::from_millis(1100);
+const NOTICE_EVERY: Duration = Duration::from_secs(3);
+/// Veloren refuses chat over 256 bytes; stay well under.
+pub const MAX_LINE_BYTES: usize = 200;
+/// Never hold more than this many lines to speak; the rest are dropped.
+const MAX_QUEUE: usize = 40;
+const MAX_ASK_BYTES: usize = 300;
+
+/// Where a heard line came from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Source {
+    /// A private message; `to_me` is whether the shopkeeper is its recipient.
+    Tell { to_me: bool },
+    /// Anything said in the open (say, region, world, group ...).
+    Public,
+}
+
+/// Is this line for the shopkeeper? Returns the text to forward.
+pub fn addressed_text(source: Source, text: &str, name: &str) -> Option<String> {
+    let text = text.trim();
+    if text.is_empty() {
+        return None;
+    }
+    let wanted = match source {
+        Source::Tell { to_me } => to_me,
+        Source::Public => text.to_lowercase().contains(&name.to_lowercase()),
+    };
+    wanted.then(|| clip(text, MAX_ASK_BYTES))
+}
+
+/// Cut text to at most `max` bytes without splitting a character.
+pub fn clip(text: &str, max: usize) -> String {
+    if text.len() <= max {
+        return text.to_owned();
+    }
+    let mut end = max;
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    text[..end].to_owned()
+}
+
+/// Break a reply line into chat-sized pieces at spaces. Control characters become spaces.
+pub fn split_for_chat(text: &str, max: usize) -> Vec<String> {
+    let cleaned: String = text.chars().map(|c| if c.is_control() { ' ' } else { c }).collect();
+    let mut lines = Vec::new();
+    let mut current = String::new();
+    for word in cleaned.split_whitespace() {
+        let word = clip(word, max);
+        if !current.is_empty() && current.len() + 1 + word.len() > max {
+            lines.push(std::mem::take(&mut current));
+        }
+        if !current.is_empty() {
+            current.push(' ');
+        }
+        current.push_str(&word);
+    }
+    if !current.is_empty() {
+        lines.push(current);
+    }
+    lines
+}
+
+#[derive(Debug, Deserialize)]
+struct AskReply {
+    lines: Vec<String>,
+}
+
+#[derive(Debug, Deserialize, Clone)]
+pub struct Notice {
+    pub id: String,
+    pub player_uuid: String,
+    pub text: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct NoticeList {
+    notices: Vec<Notice>,
+}
+
+enum Incoming {
+    Ask {
+        alias: String,
+        result: Result<Vec<String>, String>,
+    },
+    Notices(Result<Vec<Notice>, String>),
+}
+
+pub struct ShopChat {
+    nemo: Nemo,
+    resident_id: String,
+    /// The shopkeeper's first name, as players say it.
+    name: String,
+    tx: Sender<Incoming>,
+    rx: Receiver<Incoming>,
+    /// (alias, line) waiting to be spoken as a `/tell`.
+    outbox: VecDeque<(String, String)>,
+    last_tell: Instant,
+    last_notice_poll: Instant,
+    notices_in_flight: bool,
+    last_ask: HashMap<String, Instant>,
+    /// True after a tell, until the chat mode is put back to the open world chat.
+    mode_dirty: bool,
+}
+
+impl ShopChat {
+    pub fn new(nemo: Nemo, resident_id: &str, name: &str) -> Self {
+        let (tx, rx) = mpsc::channel();
+        Self {
+            nemo,
+            resident_id: resident_id.to_owned(),
+            name: name.to_owned(),
+            tx,
+            rx,
+            outbox: VecDeque::new(),
+            last_tell: Instant::now() - TELL_GAP,
+            last_notice_poll: Instant::now(),
+            notices_in_flight: false,
+            last_ask: HashMap::new(),
+            mode_dirty: false,
+        }
+    }
+
+    /// One public line, said after the greeting.
+    pub fn intro(&self) -> String {
+        format!(
+            "I keep the shop. Whisper me, e.g. /tell {} what is for sale. Karma is only ever \
+             spent by you in NemoWorld, never in chat.",
+            self.name
+        )
+    }
+
+    /// Look at one line of chat. If it is for the shopkeeper, forward it to NemoWorld.
+    pub fn on_chat(&mut self, client: &Client, msg: &comp::ChatMsg) {
+        let comp::Content::Plain(text) = msg.content() else {
+            return;
+        };
+        let (source, from) = match &msg.chat_type {
+            ChatType::Tell(from, to) => (Source::Tell { to_me: Some(*to) == client.uid() }, Some(*from)),
+            ChatType::Say(from)
+            | ChatType::Region(from)
+            | ChatType::World(from)
+            | ChatType::Group(from, _)
+            | ChatType::Faction(from, _) => (Source::Public, Some(*from)),
+            _ => return,
+        };
+        let Some(forward) = addressed_text(source, text, &self.name) else {
+            return;
+        };
+        // The speaker is whoever the SERVER says sent it; the name inside the text counts for nothing.
+        let Some((uuid, alias)) = from.and_then(|uid| {
+            client
+                .player_list()
+                .get(&uid)
+                .map(|info| (info.uuid.to_string(), info.player_alias.clone()))
+        }) else {
+            return;
+        };
+        let now = Instant::now();
+        if self.last_ask.get(&uuid).is_some_and(|at| now.duration_since(*at) < ASK_GAP) {
+            return;
+        }
+        self.last_ask.insert(uuid.clone(), now);
+        info!("HEARD from {alias}: {forward}");
+        let body = serde_json::json!({
+            "resident_id": self.resident_id,
+            "player_uuid": uuid,
+            "player_alias": alias,
+            "text": forward,
+        })
+        .to_string();
+        let nemo = self.nemo.clone();
+        let tx = self.tx.clone();
+        thread::spawn(move || {
+            let result = nemo
+                .request("POST", "/api/v1/veloren/shop/ask", Some(&body))
+                .and_then(|(status, body)| {
+                    if status == 200 {
+                        serde_json::from_str::<AskReply>(&body).map(|r| r.lines).map_err(|e| e.to_string())
+                    } else {
+                        Err(format!("shop answered {status}"))
+                    }
+                });
+            let _ = tx.send(Incoming::Ask { alias, result });
+        });
+    }
+
+    fn enqueue(&mut self, alias: &str, text: &str) {
+        for line in split_for_chat(text, MAX_LINE_BYTES) {
+            if self.outbox.len() >= MAX_QUEUE {
+                warn!("shop talk queue is full; dropping a line");
+                return;
+            }
+            self.outbox.push_back((alias.to_owned(), line));
+        }
+    }
+
+    /// Call every game tick: collect NemoWorld's answers, poll notices and speak queued lines.
+    pub fn tick(&mut self, client: &mut Client, in_world: bool) {
+        while let Ok(message) = self.rx.try_recv() {
+            match message {
+                Incoming::Ask { alias, result } => match result {
+                    Ok(lines) => {
+                        for line in lines.iter().take(12) {
+                            self.enqueue(&alias, line);
+                        }
+                    },
+                    Err(e) => {
+                        warn!("shop ask failed ({e})");
+                        self.enqueue(&alias, "I cannot reach the ledger just now. Please ask again in a moment.");
+                    },
+                },
+                Incoming::Notices(result) => {
+                    self.notices_in_flight = false;
+                    match result {
+                        Ok(notices) => self.deliver_notices(client, notices),
+                        Err(e) => warn!("shop notices unavailable ({e})"),
+                    }
+                },
+            }
+        }
+        if !in_world {
+            return;
+        }
+        if !self.notices_in_flight && self.last_notice_poll.elapsed() >= NOTICE_EVERY {
+            self.notices_in_flight = true;
+            self.last_notice_poll = Instant::now();
+            let nemo = self.nemo.clone();
+            let tx = self.tx.clone();
+            thread::spawn(move || {
+                let result = nemo
+                    .request("GET", "/api/v1/veloren/shop/notices", None)
+                    .and_then(|(status, body)| {
+                        if status == 200 {
+                            serde_json::from_str::<NoticeList>(&body).map(|r| r.notices).map_err(|e| e.to_string())
+                        } else {
+                            Err(format!("notices answered {status}"))
+                        }
+                    });
+                let _ = tx.send(Incoming::Notices(result));
+            });
+        }
+        if self.last_tell.elapsed() >= TELL_GAP {
+            if let Some((alias, line)) = self.outbox.pop_front() {
+                info!("TELLS {alias}: {line}");
+                client.send_command("tell".into(), vec![alias, line]);
+                self.last_tell = Instant::now();
+                self.mode_dirty = true;
+            } else if self.mode_dirty {
+                // `/tell` leaves the sender's chat mode on that player; put it back to the open chat.
+                client.send_command("world".into(), Vec::new());
+                self.mode_dirty = false;
+                self.last_tell = Instant::now();
+            }
+        }
+    }
+
+    /// Tell each notice to its player if he is online; acknowledge only those, so the rest are
+    /// offered again until they expire in NemoWorld.
+    fn deliver_notices(&mut self, client: &Client, notices: Vec<Notice>) {
+        let mut done = Vec::new();
+        for notice in notices.into_iter().take(10) {
+            let alias = client
+                .player_list()
+                .values()
+                .find(|info| info.is_online && info.uuid.to_string() == notice.player_uuid)
+                .map(|info| info.player_alias.clone());
+            if let Some(alias) = alias {
+                self.enqueue(&alias, &notice.text);
+                done.push(notice.id);
+            }
+        }
+        if done.is_empty() {
+            return;
+        }
+        let nemo = self.nemo.clone();
+        let body = serde_json::json!({ "ids": done }).to_string();
+        thread::spawn(move || {
+            if let Err(e) = nemo.request("POST", "/api/v1/veloren/shop/notices/ack", Some(&body)) {
+                warn!("could not acknowledge notices: {e}");
+            }
+        });
+    }
+}
+
+// ---- a scripted stand-in player, for tests -------------------------------------------------------
+
+/// One step of a test script. Steps are separated by `|` on the command line:
+/// `tell=<text>`, `say=<text>`, `wait=<seconds>`, `expect=<needle>@<seconds>`,
+/// `expect-item=<item id>@<seconds>`, `expect-no-item=<item id>@<seconds>`, `print-inv`.
+#[derive(Debug, PartialEq, Eq, Clone)]
+pub enum Step {
+    Tell(String),
+    Say(String),
+    Wait(u64),
+    Expect(String, u64),
+    ExpectItem(String, u64),
+    ExpectNoItem(String, u64),
+    PrintInventory,
+}
+
+pub fn parse_script(text: &str) -> Result<Vec<Step>, String> {
+    let mut steps = Vec::new();
+    for raw in text.split('|') {
+        let raw = raw.trim();
+        if raw.is_empty() {
+            continue;
+        }
+        let (name, value) = raw.split_once('=').unwrap_or((raw, ""));
+        let timed = |value: &str| -> Result<(String, u64), String> {
+            let (what, secs) = value.rsplit_once('@').ok_or_else(|| format!("{raw}: needs @seconds"))?;
+            Ok((what.trim().to_owned(), secs.trim().parse::<u64>().map_err(|e| format!("{raw}: {e}"))?))
+        };
+        steps.push(match name.trim() {
+            "tell" => Step::Tell(value.trim().to_owned()),
+            "say" => Step::Say(value.trim().to_owned()),
+            "wait" => Step::Wait(value.trim().parse().map_err(|e| format!("{raw}: {e}"))?),
+            "expect" => {
+                let (needle, secs) = timed(value)?;
+                Step::Expect(needle, secs)
+            },
+            "expect-item" => {
+                let (id, secs) = timed(value)?;
+                Step::ExpectItem(id, secs)
+            },
+            "expect-no-item" => {
+                let (id, secs) = timed(value)?;
+                Step::ExpectNoItem(id, secs)
+            },
+            "print-inv" => Step::PrintInventory,
+            other => return Err(format!("unknown step {other:?}")),
+        });
+    }
+    if steps.is_empty() {
+        return Err("the script has no steps".into());
+    }
+    Ok(steps)
+}
+
+pub struct Script {
+    steps: Vec<Step>,
+    index: usize,
+    step_started: Instant,
+    /// Lines heard since the current step started.
+    heard: Vec<String>,
+    target_alias: String,
+}
+
+pub enum ScriptState {
+    Running,
+    Passed,
+    Failed(String),
+}
+
+fn inventory_summary(client: &Client) -> Vec<(String, u32)> {
+    let inventories = client.inventories();
+    inventories
+        .get(client.entity())
+        .map(|inventory| {
+            inventory
+                .slots()
+                .flatten()
+                .map(|item| (item.persistence_item_id(), item.amount()))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+impl Script {
+    pub fn new(steps: Vec<Step>, target_alias: &str) -> Self {
+        Self {
+            steps,
+            index: 0,
+            step_started: Instant::now(),
+            heard: Vec::new(),
+            target_alias: target_alias.to_owned(),
+        }
+    }
+
+    pub fn on_heard(&mut self, text: &str) {
+        info!("PROBE heard: {text}");
+        self.heard.push(text.to_lowercase());
+    }
+
+    fn next(&mut self) {
+        self.index += 1;
+        self.step_started = Instant::now();
+        self.heard.clear();
+    }
+
+    pub fn tick(&mut self, client: &mut Client) -> ScriptState {
+        let Some(step) = self.steps.get(self.index).cloned() else {
+            return ScriptState::Passed;
+        };
+        let elapsed = self.step_started.elapsed();
+        match step {
+            Step::Tell(text) => {
+                info!("PROBE tells {}: {text}", self.target_alias);
+                client.send_command("tell".into(), vec![self.target_alias.clone(), text]);
+                self.next();
+            },
+            Step::Say(text) => {
+                info!("PROBE says: {text}");
+                client.send_chat(text);
+                self.next();
+            },
+            Step::Wait(secs) => {
+                if elapsed >= Duration::from_secs(secs) {
+                    self.next();
+                }
+            },
+            Step::Expect(needle, secs) => {
+                let needle_lc = needle.to_lowercase();
+                if self.heard.iter().any(|line| line.contains(&needle_lc)) {
+                    info!("PROBE ok: heard {needle:?}");
+                    self.next();
+                } else if elapsed >= Duration::from_secs(secs) {
+                    return ScriptState::Failed(format!("did not hear {needle:?} within {secs}s"));
+                }
+            },
+            Step::ExpectItem(id, secs) => {
+                let have: u32 = inventory_summary(client).iter().filter(|(i, _)| *i == id).map(|(_, n)| *n).sum();
+                if have > 0 {
+                    info!("PROBE ok: inventory holds {have} x {id}");
+                    self.next();
+                } else if elapsed >= Duration::from_secs(secs) {
+                    return ScriptState::Failed(format!("{id} did not arrive within {secs}s"));
+                }
+            },
+            Step::ExpectNoItem(id, secs) => {
+                let have: u32 = inventory_summary(client).iter().filter(|(i, _)| *i == id).map(|(_, n)| *n).sum();
+                if have > 0 {
+                    return ScriptState::Failed(format!("{id} arrived but should not have ({have})"));
+                }
+                if elapsed >= Duration::from_secs(secs) {
+                    info!("PROBE ok: no {id} in the inventory after {secs}s");
+                    self.next();
+                }
+            },
+            Step::PrintInventory => {
+                let mut items = inventory_summary(client);
+                items.sort();
+                info!("PROBE inventory: {items:?}");
+                self.next();
+            },
+        }
+        if self.index >= self.steps.len() {
+            ScriptState::Passed
+        } else {
+            ScriptState::Running
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn whispers_to_the_shopkeeper_are_forwarded_and_other_whispers_are_not() {
+        assert_eq!(
+            addressed_text(Source::Tell { to_me: true }, "  what is for sale?  ", "Kael"),
+            Some("what is for sale?".into())
+        );
+        assert_eq!(addressed_text(Source::Tell { to_me: false }, "Kael what is for sale?", "Kael"), None);
+        assert_eq!(addressed_text(Source::Tell { to_me: true }, "   ", "Kael"), None);
+    }
+
+    #[test]
+    fn public_lines_count_only_when_they_name_the_shopkeeper() {
+        assert!(addressed_text(Source::Public, "Hey KAEL, what do you sell", "Kael").is_some());
+        assert!(addressed_text(Source::Public, "anyone selling herbs?", "Kael").is_none());
+    }
+
+    #[test]
+    fn what_is_forwarded_is_bounded() {
+        let long = "kael ".repeat(500);
+        let forwarded = addressed_text(Source::Public, &long, "Kael").unwrap();
+        assert!(forwarded.len() <= MAX_ASK_BYTES);
+        let accented = "é".repeat(400);
+        let clipped = clip(&accented, 301);
+        assert!(clipped.len() <= 301 && clipped.chars().all(|c| c == 'é'));
+    }
+
+    #[test]
+    fn replies_are_split_to_chat_size_without_losing_words() {
+        let text = "Herb bundle 8 Karma, Fiber bundle 9 Karma, Wood bundle 10 Karma, Herb crate 18 Karma, Flower crown 20 Karma, Herbal wreath 24 Karma, Woven banner 28 Karma, Festival banner 40 Karma.";
+        let lines = split_for_chat(text, 60);
+        assert!(lines.len() > 1);
+        assert!(lines.iter().all(|line| line.len() <= 60));
+        assert_eq!(lines.join(" "), text);
+        // A control character or newline cannot smuggle a second command or line.
+        let nasty = split_for_chat("hello\n/kill everyone\r\u{0007}x", 200);
+        assert_eq!(nasty, vec!["hello /kill everyone x".to_owned()]);
+        // A single word longer than the limit is cut rather than overflowing.
+        assert!(split_for_chat(&"a".repeat(500), 200).iter().all(|l| l.len() <= 200));
+        assert!(split_for_chat("   ", 200).is_empty());
+    }
+
+    #[test]
+    fn scripts_parse_and_refuse_nonsense() {
+        let steps = parse_script("tell=what is for sale | expect=Herb bundle@20 | wait=2 | expect-item=common.items.food.sage@90 | print-inv").unwrap();
+        assert_eq!(
+            steps,
+            vec![
+                Step::Tell("what is for sale".into()),
+                Step::Expect("Herb bundle".into(), 20),
+                Step::Wait(2),
+                Step::ExpectItem("common.items.food.sage".into(), 90),
+                Step::PrintInventory,
+            ]
+        );
+        assert!(parse_script("").is_err());
+        assert!(parse_script("fly=away").is_err());
+        assert!(parse_script("expect=hello").is_err());
+        assert!(parse_script("wait=soon").is_err());
+    }
+}
