@@ -0,0 +1,9 @@
+//! NemoWorld shop delivery: the Veloren side of "Karma Coins and an in-world shop".
+//!
+//! * `logic`: the pure rules (allow-list manifest, strict arguments, quantity bound, once per order).
+//! * `grant`: the server system that applies a signed `grant_item` command to an online player.
+//!
+//! Registered with one `#[path]` module line and one `dispatch` line in `sys/mod.rs`.
+
+pub mod grant;
+pub mod logic;
