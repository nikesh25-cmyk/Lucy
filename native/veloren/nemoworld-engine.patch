diff --git a/server/src/nemo/shop/grant.rs b/server/src/nemo/shop/grant.rs
new file mode 100644
index 0000000..a0be49b
--- /dev/null
+++ b/server/src/nemo/shop/grant.rs
@@ -0,0 +1,206 @@
+//! Delivers what a NemoWorld shop purchase bought: the `grant_item` command.
+//!
+//! The command reaches this system only after `NemoLinkState` has verified its HMAC signature,
+//! checked it has not expired and claimed its id (so the same command can never run twice). This
+//! system adds the shop's own rules (`logic.rs`) and the facts only the game server can check:
+//!
+//! * the player is online, in the world, with a character that has an inventory;
+//! * the whole grant fits: it is tried on a copy of the inventory first, so a full inventory
+//!   gives nothing at all (never half of an order);
+//! * the order was not delivered before (persisted next to the outbox, so a restart or a second
+//!   command for the same order cannot give it twice).
+//!
+//! Every command is answered with a signed `command.applied` or `command.rejected`. A `dry_run`
+//! command does all the checks and gives nothing; NemoWorld uses it before it charges Karma.
+//!
+//! This system never reads chat and never accepts anything a player typed.
+
+use super::logic::{self, GrantArgs, Reject};
+use common::{
+    comp::{Inventory, InventoryUpdateBuffer, InventoryUpdateEvent, Item, Player},
+    resources::Time,
+};
+use common_ecs::{Job, Origin, Phase, System};
+use hashbrown::HashSet;
+use specs::{Entities, Join, Read, ReadStorage, Write, WriteStorage};
+use std::{
+    fs::{self, File, OpenOptions},
+    io::Write as _,
+};
+use tracing::{info, warn};
+
+/// How many grant commands one pass will act on; the rest are refused as `busy` (and NemoWorld
+/// shows them as rejected, so a human can try again).
+const MAX_PER_PASS: usize = 16;
+
+/// Orders already delivered, remembered across restarts.
+#[derive(Default)]
+pub struct NemoShopState {
+    loaded: bool,
+    last_run: f64,
+    delivered: HashSet<String>,
+    file: Option<File>,
+}
+
+impl NemoShopState {
+    fn load(&mut self, path: &str) {
+        self.delivered = fs::read_to_string(path)
+            .unwrap_or_default()
+            .lines()
+            .filter(|line| logic::is_uuid(line))
+            .map(str::to_owned)
+            .collect();
+        self.file = match OpenOptions::new().create(true).append(true).open(path) {
+            Ok(file) => Some(file),
+            Err(e) => {
+                warn!("cannot open {path}: {e}; shop deliveries will be refused");
+                None
+            },
+        };
+        info!(delivered = self.delivered.len(), "NemoWorld shop deliveries are on (manifest: {})", logic::manifest().fingerprint());
+    }
+
+    /// Remember that an order was delivered. Returns false if it could not be written down, in
+    /// which case the caller must not give the items.
+    fn record(&mut self, order: &str) -> bool {
+        let Some(file) = self.file.as_mut() else {
+            return false;
+        };
+        let line = format!("{order}\n");
+        if file.write_all(line.as_bytes()).and_then(|()| file.flush()).is_err() {
+            return false;
+        }
+        self.delivered.insert(order.to_owned());
+        true
+    }
+}
+
+/// Everything the game must do for one grant, once the rules allow it.
+fn items_for(entry: &logic::ManifestEntry) -> Result<Vec<Item>, Reject> {
+    let mut first = Item::new_from_asset(&entry.item).map_err(|_| Reject::ItemUnavailable)?;
+    if first.is_stackable() {
+        first.set_amount(entry.qty).map_err(|_| Reject::QuantityMismatch)?;
+        Ok(vec![first])
+    } else {
+        let mut items = vec![first];
+        for _ in 1..entry.qty {
+            items.push(Item::new_from_asset(&entry.item).map_err(|_| Reject::ItemUnavailable)?);
+        }
+        Ok(items)
+    }
+}
+
+/// Try the whole grant on a copy of the inventory, with items made only for this test (an item
+/// must never be cloned into the game, so the real items are made again afterwards).
+fn fits(inventory: &Inventory, items: Vec<Item>) -> bool {
+    let mut copy = inventory.clone();
+    items.into_iter().all(|item| copy.push(item).is_ok())
+}
+
+#[derive(Default)]
+pub struct Sys;
+
+impl<'a> System<'a> for Sys {
+    type SystemData = (
+        Entities<'a>,
+        ReadStorage<'a, Player>,
+        WriteStorage<'a, Inventory>,
+        WriteStorage<'a, InventoryUpdateBuffer>,
+        Read<'a, Time>,
+        Write<'a, crate::sys::nemo_link::NemoLinkState>,
+        Write<'a, NemoShopState>,
+    );
+
+    const NAME: &'static str = "nemo_shop_grant";
+    const ORIGIN: Origin = Origin::Server;
+    const PHASE: Phase = Phase::Create;
+
+    fn run(
+        _job: &mut Job<Self>,
+        (entities, players, mut inventories, mut buffers, time, mut link, mut shop): Self::SystemData,
+    ) {
+        if !link.is_on() {
+            return;
+        }
+        // Twice a second is plenty for a purchase.
+        if time.0 - shop.last_run < 0.5 {
+            return;
+        }
+        shop.last_run = time.0;
+        if !shop.loaded {
+            shop.loaded = true;
+            if let Some(path) = link.sidecar_path("shop-delivered") {
+                shop.load(&path);
+            }
+        }
+
+        let commands = link.poll_commands(&["grant_item"]);
+        for (index, command) in commands.iter().enumerate() {
+            if index >= MAX_PER_PASS {
+                warn!(cmd_id = %command.cmd_id, reason = Reject::Busy.reason(), "shop grant refused");
+                link.ack(command, false, Reject::Busy.reason());
+                continue;
+            }
+            let outcome = grant(command, &entities, &players, &mut inventories, &mut buffers, &mut shop);
+            match outcome {
+                Ok(note) => {
+                    info!(cmd_id = %command.cmd_id, note, "shop grant applied");
+                    link.ack(command, true, note);
+                },
+                Err(reject) => {
+                    warn!(cmd_id = %command.cmd_id, reason = reject.reason(), "shop grant refused");
+                    link.ack(command, false, reject.reason());
+                },
+            }
+        }
+    }
+}
+
+fn grant(
+    command: &crate::sys::nemo_link::Command,
+    entities: &Entities,
+    players: &ReadStorage<Player>,
+    inventories: &mut WriteStorage<Inventory>,
+    buffers: &mut WriteStorage<InventoryUpdateBuffer>,
+    shop: &mut NemoShopState,
+) -> Result<&'static str, Reject> {
+    let args: GrantArgs = logic::parse_args(&command.args)?;
+    let entry = logic::plan(logic::manifest(), &args, &shop.delivered)?;
+
+    // The one player the (signed) command names, online, in the world.
+    let mut target = None;
+    for (entity, player) in (entities, players).join() {
+        if player.uuid().to_string() == command.player_uuid {
+            target = Some(entity);
+            break;
+        }
+    }
+    let entity = target.ok_or(Reject::PlayerNotOnline)?;
+    // A read first: touching the inventory mutably marks it changed and makes the server resend it,
+    // which a dry run must not do.
+    let inventory = inventories.get(entity).ok_or(Reject::NoInventory)?;
+    if !fits(inventory, items_for(entry)?) {
+        return Err(Reject::InventoryFull);
+    }
+    if args.dry_run {
+        return Ok("dry_run_would_deliver");
+    }
+    let items = items_for(entry)?;
+    // Write the order down BEFORE the items change hands: if the game dies right after, the order
+    // is reported unconfirmed and a human retries, but it can never be delivered twice.
+    if !shop.record(&args.order) {
+        return Err(Reject::Busy);
+    }
+    let mut inventory = inventories.get_mut(entity).ok_or(Reject::NoInventory)?;
+    for item in items {
+        // `fits` proved this works; if the inventory changed in between, nothing more can happen
+        // in this single-threaded pass.
+        if inventory.push(item).is_err() {
+            warn!(order = %args.order, "inventory changed during a grant; the order is recorded as delivered");
+        }
+    }
+    if let Some(buffer) = buffers.get_mut(entity) {
+        buffer.push(InventoryUpdateEvent::Given);
+    }
+    Ok("delivered")
+}
diff --git a/server/src/nemo/shop/logic.rs b/server/src/nemo/shop/logic.rs
new file mode 100644
index 0000000..33e238c
--- /dev/null
+++ b/server/src/nemo/shop/logic.rs
@@ -0,0 +1,429 @@
+//! The pure rules of the NemoWorld shop delivery: what a `grant_item` command may ask for.
+//!
+//! Nothing here touches the game. The server system in `grant.rs` calls these functions and then
+//! does the one thing they allow. Keeping the rules pure makes the adversarial cases testable
+//! without a running server.
+//!
+//! The command arrives already verified (HMAC over the exact `args` text, unexpired, claimed once)
+//! by `NemoLinkState`. This module adds the shop's own allow-list:
+//!
+//! * the arguments are a strict, tiny JSON object: `order`, `good`, `qty` and an optional
+//!   `dry_run`; any other field is refused;
+//! * the item that is given is chosen by the server from the manifest, by good id. NemoWorld (and
+//!   therefore a player's chat) never names an item definition;
+//! * the quantity must equal the manifest quantity and the manifest quantity is capped, so neither
+//!   a bug nor a leaked key can ask for a pile of items;
+//! * one order is delivered at most once, even if NemoWorld sends a second command for it.
+
+use hashbrown::HashSet;
+use serde::Deserialize;
+use std::sync::OnceLock;
+
+/// The allow-list file, compiled in so it cannot be swapped at run time.
+pub const MANIFEST_JSON: &str = include_str!("manifest.json");
+
+/// No manifest entry, and no command, may ask for more than this many of an item.
+pub const HARD_MAX_QTY: u32 = 10;
+
+/// Arguments longer than this are refused before they are parsed.
+pub const MAX_ARGS_BYTES: usize = 256;
+
+#[derive(Debug, Deserialize)]
+struct ManifestFile {
+    format: String,
+    max_qty: u32,
+    goods: Vec<ManifestEntry>,
+}
+
+#[derive(Debug, Deserialize, Clone, PartialEq, Eq)]
+pub struct ManifestEntry {
+    pub good: String,
+    /// An existing Veloren item definition id, e.g. `common.items.food.sage`.
+    pub item: String,
+    pub qty: u32,
+}
+
+#[derive(Debug)]
+pub struct Manifest {
+    pub entries: Vec<ManifestEntry>,
+}
+
+impl Manifest {
+    pub fn find(&self, good: &str) -> Option<&ManifestEntry> {
+        self.entries.iter().find(|entry| entry.good == good)
+    }
+
+    /// A single line that changes whenever the allow-list changes. NemoWorld's tests pin the same
+    /// line for its copy of the manifest, so the two files cannot drift apart unnoticed.
+    pub fn fingerprint(&self) -> String {
+        let mut parts: Vec<String> = self
+            .entries
+            .iter()
+            .map(|e| format!("{}={}*{}", e.good, e.item, e.qty))
+            .collect();
+        parts.sort();
+        parts.join(";")
+    }
+}
+
+/// Parse and check a manifest text. Returns why it is unusable.
+pub fn parse_manifest(text: &str) -> Result<Manifest, String> {
+    let file: ManifestFile = serde_json::from_str(text).map_err(|e| e.to_string())?;
+    if file.format != "nemo-shop-manifest-v1" {
+        return Err("unsupported manifest format".into());
+    }
+    if file.max_qty == 0 || file.max_qty > HARD_MAX_QTY {
+        return Err(format!("max_qty must be 1..={HARD_MAX_QTY}"));
+    }
+    if file.goods.is_empty() {
+        return Err("the manifest lists no goods".into());
+    }
+    let mut seen = HashSet::new();
+    for entry in &file.goods {
+        if !is_identifier(&entry.good) {
+            return Err(format!("bad good id {:?}", entry.good));
+        }
+        if !seen.insert(entry.good.clone()) {
+            return Err(format!("good {:?} is listed twice", entry.good));
+        }
+        if !is_item_definition_id(&entry.item) {
+            return Err(format!("bad item definition id {:?}", entry.item));
+        }
+        if entry.qty == 0 || entry.qty > file.max_qty {
+            return Err(format!("good {:?}: qty must be 1..={}", entry.good, file.max_qty));
+        }
+    }
+    Ok(Manifest { entries: file.goods })
+}
+
+/// The compiled-in manifest. A broken manifest is a build-time mistake, so it panics at first use
+/// (the test suite exercises it) rather than silently allowing everything or nothing.
+pub fn manifest() -> &'static Manifest {
+    static MANIFEST: OnceLock<Manifest> = OnceLock::new();
+    MANIFEST.get_or_init(|| parse_manifest(MANIFEST_JSON).expect("server/src/nemo/shop/manifest.json is invalid"))
+}
+
+/// `[a-z][a-z0-9_]{0,39}`: the same shape NemoWorld uses for good ids.
+pub fn is_identifier(text: &str) -> bool {
+    let mut bytes = text.bytes();
+    matches!(bytes.next(), Some(b'a'..=b'z'))
+        && text.len() <= 40
+        && bytes.all(|b| matches!(b, b'a'..=b'z' | b'0'..=b'9' | b'_'))
+}
+
+/// A Veloren asset path made of lower-case segments joined by dots (`common.items.food.sage`).
+/// No slashes, no `..`, no empty segment.
+pub fn is_item_definition_id(text: &str) -> bool {
+    !text.is_empty()
+        && text.len() <= 120
+        && text.starts_with("common.items.")
+        && text.split('.').all(|segment| {
+            !segment.is_empty()
+                && segment
+                    .bytes()
+                    .all(|b| matches!(b, b'a'..=b'z' | b'0'..=b'9' | b'_'))
+        })
+}
+
+/// Lower-case canonical UUID text (8-4-4-4-12).
+pub fn is_uuid(text: &str) -> bool {
+    let b = text.as_bytes();
+    b.len() == 36
+        && b.iter().enumerate().all(|(i, c)| match i {
+            8 | 13 | 18 | 23 => *c == b'-',
+            _ => matches!(c, b'0'..=b'9' | b'a'..=b'f'),
+        })
+}
+
+/// Why a grant was refused. The text is logged on the server; the acknowledgement NemoWorld
+/// receives carries only "rejected", so nothing here can be used to probe the server.
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum Reject {
+    ArgsTooLong,
+    BadArgs,
+    BadOrder,
+    BadGood,
+    UnknownGood,
+    QuantityTooLarge,
+    QuantityMismatch,
+    AlreadyDelivered,
+    PlayerNotOnline,
+    NoInventory,
+    InventoryFull,
+    ItemUnavailable,
+    Busy,
+}
+
+impl Reject {
+    pub fn reason(self) -> &'static str {
+        match self {
+            Reject::ArgsTooLong => "arguments_too_long",
+            Reject::BadArgs => "bad_arguments",
+            Reject::BadOrder => "bad_order_id",
+            Reject::BadGood => "bad_good_id",
+            Reject::UnknownGood => "good_not_on_allow_list",
+            Reject::QuantityTooLarge => "quantity_too_large",
+            Reject::QuantityMismatch => "quantity_does_not_match_manifest",
+            Reject::AlreadyDelivered => "order_already_delivered",
+            Reject::PlayerNotOnline => "player_not_online",
+            Reject::NoInventory => "player_has_no_character_in_the_world",
+            Reject::InventoryFull => "inventory_full",
+            Reject::ItemUnavailable => "item_definition_unavailable",
+            Reject::Busy => "too_many_grants_this_second",
+        }
+    }
+}
+
+/// The arguments of a `grant_item` command.
+#[derive(Debug, PartialEq, Eq)]
+pub struct GrantArgs {
+    pub order: String,
+    pub good: String,
+    pub qty: u32,
+    /// Check everything (player, allow-list, room) but give nothing and remember nothing.
+    pub dry_run: bool,
+}
+
+/// Parse the signed argument text strictly: an object with exactly the known fields.
+pub fn parse_args(text: &str) -> Result<GrantArgs, Reject> {
+    if text.len() > MAX_ARGS_BYTES {
+        return Err(Reject::ArgsTooLong);
+    }
+    let value: serde_json::Value = serde_json::from_str(text).map_err(|_| Reject::BadArgs)?;
+    let object = value.as_object().ok_or(Reject::BadArgs)?;
+    if object
+        .keys()
+        .any(|key| !matches!(key.as_str(), "order" | "good" | "qty" | "dry_run"))
+    {
+        return Err(Reject::BadArgs);
+    }
+    let order = object
+        .get("order")
+        .and_then(|v| v.as_str())
+        .filter(|s| is_uuid(s))
+        .ok_or(Reject::BadOrder)?
+        .to_owned();
+    let good = object
+        .get("good")
+        .and_then(|v| v.as_str())
+        .filter(|s| is_identifier(s))
+        .ok_or(Reject::BadGood)?
+        .to_owned();
+    let qty = object.get("qty").ok_or(Reject::BadArgs)?;
+    // Only a plain non-negative integer; no floats, no strings, no huge numbers.
+    let qty = qty.as_u64().ok_or(Reject::BadArgs)?;
+    if qty > u64::from(HARD_MAX_QTY) {
+        return Err(Reject::QuantityTooLarge);
+    }
+    let dry_run = match object.get("dry_run") {
+        None => false,
+        Some(serde_json::Value::Bool(flag)) => *flag,
+        Some(_) => return Err(Reject::BadArgs),
+    };
+    Ok(GrantArgs {
+        order,
+        good,
+        qty: qty as u32,
+        dry_run,
+    })
+}
+
+/// Decide what, if anything, may be given. `delivered` is the set of orders already delivered.
+pub fn plan<'a>(
+    manifest: &'a Manifest,
+    args: &GrantArgs,
+    delivered: &HashSet<String>,
+) -> Result<&'a ManifestEntry, Reject> {
+    let entry = manifest.find(&args.good).ok_or(Reject::UnknownGood)?;
+    if args.qty == 0 || args.qty != entry.qty {
+        return Err(Reject::QuantityMismatch);
+    }
+    if !args.dry_run && delivered.contains(&args.order) {
+        return Err(Reject::AlreadyDelivered);
+    }
+    Ok(entry)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ORDER: &str = "0b6f4f0e-2d5a-4c1a-9a53-6a3a1d2b7c10";
+
+    fn args(good: &str, qty: u32) -> String {
+        format!(r#"{{"order":"{ORDER}","good":"{good}","qty":{qty}}}"#)
+    }
+
+    fn run(text: &str, delivered: &HashSet<String>) -> Result<(String, u32, bool), Reject> {
+        let parsed = parse_args(text)?;
+        let entry = plan(manifest(), &parsed, delivered)?;
+        Ok((entry.item.clone(), entry.qty, parsed.dry_run))
+    }
+
+    #[test]
+    fn the_compiled_in_manifest_is_valid() {
+        let m = manifest();
+        assert!(!m.entries.is_empty());
+        assert!(m.entries.iter().all(|e| e.qty >= 1 && e.qty <= HARD_MAX_QTY));
+    }
+
+    /// Pinned together with NemoWorld's `tests/shop-manifest.test.js`: both sides must list the
+    /// same goods, items and quantities.
+    #[test]
+    fn manifest_fingerprint_is_pinned_with_nemoworld() {
+        assert_eq!(
+            manifest().fingerprint(),
+            "festival_banner=common.items.crafting_ing.cloth.linen_red*1;\
+             fiber=common.items.flowers.plant_fiber*2;\
+             flower_crown=common.items.armor.misc.head.headband*1;\
+             herb_crate=common.items.food.sage*5;\
+             herbal_wreath=common.items.flowers.sunflower*1;\
+             herbs=common.items.food.sage*2;\
+             wood=common.items.log.wood*2;\
+             woven_banner=common.items.crafting_ing.cloth.linen*1"
+        );
+    }
+
+    /// Every item the manifest can hand out is a real asset file in this repository.
+    #[test]
+    fn every_manifest_item_is_a_real_item_definition() {
+        let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../assets");
+        for entry in &manifest().entries {
+            let path = root.join(format!("{}.ron", entry.item.replace('.', "/")));
+            assert!(path.is_file(), "{} -> {} does not exist", entry.good, path.display());
+            // Keepsakes must never carry stats: an item with a power effect is not a keepsake.
+            let text = std::fs::read_to_string(&path).unwrap();
+            for forbidden in ["protection:", "poise_resilience:", "energy_max:", "power:", "Tool("] {
+                assert!(
+                    !text.contains(forbidden),
+                    "{} grants an item with game stats ({forbidden})",
+                    entry.good
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn a_well_formed_grant_is_planned_from_the_manifest_only() {
+        let none = HashSet::new();
+        assert_eq!(
+            run(&args("herbs", 2), &none),
+            Ok(("common.items.food.sage".into(), 2, false))
+        );
+        assert_eq!(run(&args("herb_crate", 5), &none).unwrap().1, 5);
+        let dry = format!(r#"{{"order":"{ORDER}","good":"wood","qty":2,"dry_run":true}}"#);
+        assert_eq!(run(&dry, &none).unwrap().2, true);
+    }
+
+    #[test]
+    fn a_good_that_is_not_on_the_allow_list_is_refused() {
+        let none = HashSet::new();
+        for good in ["sword", "gold", "admin", "furniture", "herbs2", "HERBS", ""] {
+            assert!(run(&args(good, 1), &none).is_err(), "{good} must not be deliverable");
+        }
+        assert_eq!(run(&args("sword", 1), &none), Err(Reject::UnknownGood));
+    }
+
+    #[test]
+    fn an_item_path_can_never_be_named_by_the_command() {
+        let none = HashSet::new();
+        // The good id must be a plain identifier; an asset path or traversal is refused outright.
+        for good in [
+            "common.items.weapons.sword.starter",
+            "../../etc/passwd",
+            "herbs;wood",
+            "herbs wood",
+        ] {
+            assert_eq!(run(&args(good, 1), &none), Err(Reject::BadGood), "{good:?}");
+        }
+        // A newline cannot be written into the signed JSON at all, so it is refused before the allow-list
+        // is even consulted (and certainly never reaches an item path).
+        assert_eq!(run(&args("herbs\nwood", 1), &none), Err(Reject::BadArgs));
+        // An `item` field is not part of the protocol at all.
+        let with_item = format!(
+            r#"{{"order":"{ORDER}","good":"herbs","qty":2,"item":"common.items.weapons.sword.starter"}}"#
+        );
+        assert_eq!(run(&with_item, &none), Err(Reject::BadArgs));
+    }
+
+    #[test]
+    fn quantity_abuse_is_refused() {
+        let none = HashSet::new();
+        assert_eq!(run(&args("herbs", 3), &none), Err(Reject::QuantityMismatch));
+        assert_eq!(run(&args("herbs", 1), &none), Err(Reject::QuantityMismatch));
+        assert_eq!(run(&args("herbs", 0), &none), Err(Reject::QuantityMismatch));
+        assert_eq!(run(&args("herbs", 11), &none), Err(Reject::QuantityTooLarge));
+        assert_eq!(run(&args("herbs", 9999), &none), Err(Reject::QuantityTooLarge));
+        for bad in [
+            format!(r#"{{"order":"{ORDER}","good":"herbs","qty":-2}}"#),
+            format!(r#"{{"order":"{ORDER}","good":"herbs","qty":2.0}}"#),
+            format!(r#"{{"order":"{ORDER}","good":"herbs","qty":"2"}}"#),
+            format!(r#"{{"order":"{ORDER}","good":"herbs","qty":18446744073709551616}}"#),
+            format!(r#"{{"order":"{ORDER}","good":"herbs"}}"#),
+        ] {
+            assert!(run(&bad, &none).is_err(), "{bad}");
+        }
+    }
+
+    #[test]
+    fn malformed_arguments_are_refused() {
+        let none = HashSet::new();
+        for bad in [
+            "",
+            "null",
+            "[]",
+            "\"herbs\"",
+            "{}",
+            "{\"order\":\"x\",\"good\":\"herbs\",\"qty\":2}",
+            &format!(r#"{{"order":"{ORDER}","good":"herbs","qty":2,"dry_run":"yes"}}"#),
+            &format!(r#"{{"order":"{}","good":"herbs","qty":2}}"#, ORDER.to_uppercase()),
+            &format!(r#"{{"order":"{ORDER}","good":"herbs","qty":2,"to":"someone"}}"#),
+        ] {
+            assert!(run(bad, &none).is_err(), "{bad}");
+        }
+        let long = format!(r#"{{"order":"{ORDER}","good":"herbs","qty":2,"pad":"{}"}}"#, "x".repeat(400));
+        assert_eq!(parse_args(&long), Err(Reject::ArgsTooLong));
+    }
+
+    #[test]
+    fn one_order_is_delivered_at_most_once() {
+        let mut delivered = HashSet::new();
+        assert!(run(&args("herbs", 2), &delivered).is_ok());
+        delivered.insert(ORDER.to_owned());
+        assert_eq!(run(&args("herbs", 2), &delivered), Err(Reject::AlreadyDelivered));
+        // A dry run only looks; it is allowed and changes nothing.
+        let dry = format!(r#"{{"order":"{ORDER}","good":"herbs","qty":2,"dry_run":true}}"#);
+        assert!(run(&dry, &delivered).is_ok());
+    }
+
+    #[test]
+    fn a_broken_manifest_is_rejected_at_load() {
+        let good = |entry: &str| {
+            format!(r#"{{"format":"nemo-shop-manifest-v1","max_qty":10,"goods":[{entry}]}}"#)
+        };
+        assert!(parse_manifest(&good(r#"{"good":"a","item":"common.items.food.sage","qty":1}"#)).is_ok());
+        for entry in [
+            r#"{"good":"a","item":"common.items.food.sage","qty":0}"#,
+            r#"{"good":"a","item":"common.items.food.sage","qty":11}"#,
+            r#"{"good":"A","item":"common.items.food.sage","qty":1}"#,
+            r#"{"good":"a","item":"common/items/food/sage","qty":1}"#,
+            r#"{"good":"a","item":"common.items..sage","qty":1}"#,
+            r#"{"good":"a","item":"common.items.food.sage/../x","qty":1}"#,
+            r#"{"good":"a","item":"world.sites.x","qty":1}"#,
+            r#"{"good":"a","item":"common.items.food.sage","qty":1},{"good":"a","item":"common.items.food.sage","qty":1}"#,
+        ] {
+            assert!(parse_manifest(&good(entry)).is_err(), "{entry}");
+        }
+        assert!(parse_manifest(r#"{"format":"x","max_qty":10,"goods":[]}"#).is_err());
+        assert!(parse_manifest(r#"{"format":"nemo-shop-manifest-v1","max_qty":99,"goods":[{"good":"a","item":"common.items.food.sage","qty":1}]}"#).is_err());
+    }
+
+    #[test]
+    fn uuid_and_identifier_shapes() {
+        assert!(is_uuid(ORDER));
+        assert!(!is_uuid("0B6F4F0E-2D5A-4C1A-9A53-6A3A1D2B7C10"));
+        assert!(!is_uuid("0b6f4f0e2d5a4c1a9a536a3a1d2b7c10"));
+        assert!(is_identifier("herb_crate"));
+        assert!(!is_identifier("_x") && !is_identifier("9x") && !is_identifier(&"a".repeat(41)));
+    }
+}
