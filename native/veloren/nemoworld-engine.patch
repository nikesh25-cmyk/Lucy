+    #[test]
+    fn a_restart_converges_on_the_same_world() {
+        let plan = planned();
+        let digest_before = digest(&plan, 100);
+
+        // The first run.
+        let mut world = generated();
+        let first = stamp(&plan, 100, &mut world);
+        let applied_world = world.blocks.clone();
+        let record = GroupRecord {
+            digest: digest_before.clone(),
+            anchor: [plan.anchor.0, plan.anchor.1],
+            ground: 100,
+            cells: first.cells,
+            blocks: first.blocks,
+            sprites: first.sprites,
+            foundation_columns: first.foundation_columns,
+            written: first.written,
+            applied_at: 1,
+            removed: Vec::new(),
+        };
+
+        // A restart: the process is new, terrain persistence is off, so the world is generation
+        // again. The record survives on disk, so the group is *known* — but it is not there.
+        let mut world = generated();
+        let again = planned();
+        let digest_after = digest(&again, 100);
+        assert_eq!(digest_before, digest_after, "the manifest plans the same thing after a restart");
+        let still_standing = standing(&again, 100, &world);
+        assert!(!still_standing, "the regenerated world has no props");
+        assert_eq!(decide(Some(&record), &digest_after, still_standing), (Decision::Write, "not-standing"));
+        let second = stamp(&again, 100, &mut world);
+
+        assert_eq!(second.written, first.written, "the same cells are written again");
+        assert_eq!(world.blocks, applied_world, "and the world is the same world");
+        assert_eq!(
+            decide(Some(&record), &digest_after, standing(&again, 100, &world)),
+            (Decision::Keep, "standing"),
+            "the next pass has nothing to do"
+        );
+    }
