+fn parse_args() -> Args {
+    let mut args = Args {
+        server: "localhost:14004".into(),
+        resident: "lw-lyra".into(),
+        roster: "nemo-bridge/roster.json".into(),
+        landmarks: "nemo-bridge/landmarks.json".into(),
+        nemo_url: None,
+        probe: None,
+        quest: false,
+        list_sites: false,
+        say: None,
+        phase: None,
+        tps: TPS,
+        tell: false,
+        code_file: None,
+        shop: false,
+        script: None,
+        guide: false,
+        home: false,
+        atlas: false,
+        survey: None,
+        dump: None,
+        goto: None,
+    };
+    let mut it = std::env::args().skip(1);
+    while let Some(flag) = it.next() {
+        match flag.as_str() {
+            "--quest" => args.quest = true,
+            "--list-sites" => args.list_sites = true,
+            "--tell" => args.tell = true,
+            "--shop" => args.shop = true,
+            "--guide" => args.guide = true,
+            "--home" => args.home = true,
+            "--atlas" => args.atlas = true,
+            _ => {
+                let value = it.next().unwrap_or_else(|| panic!("{flag} needs a value"));
+                match flag.as_str() {
+                    "--server" => args.server = value,
+                    "--resident" => args.resident = value,
+                    "--roster" => args.roster = value,
+                    "--landmarks" => args.landmarks = value,
+                    "--nemo-url" => args.nemo_url = Some(value),
+                    "--probe" => args.probe = Some(value),
+                    "--say" => args.say = Some(value),
+                    "--phase" => args.phase = Some(value),
+                    "--tps" => args.tps = value.parse::<f64>().expect("--tps must be a number").clamp(MIN_TPS, MAX_TPS),
+                    "--code-file" => args.code_file = Some(value),
+                    "--script" => args.script = Some(value),
+                    "--survey" => args.survey = Some(numbers(&value, &[3, 4])),
+                    "--dump" => args.dump = Some(numbers(&value, &[6])),
+                    "--goto" => {
+                        let v = numbers(&value, &[2]);
+                        args.goto = Some((v[0] as f32, v[1] as f32));
+                    },
+                    other => panic!("unknown argument {other}"),
+                }
+            },
+        }
+    }
+    args
+}
+
+fn numbers(text: &str, counts: &[usize]) -> Vec<i32> {
+    let values: Vec<i32> = text
+        .split(',')
+        .map(|part| part.trim().parse::<i32>().unwrap_or_else(|_| panic!("'{part}' is not a whole number")))
+        .collect();
+    assert!(counts.contains(&values.len()), "expected {counts:?} comma separated numbers, got {}", values.len());
+    values
+}
