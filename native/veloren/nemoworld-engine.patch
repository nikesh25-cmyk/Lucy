+        // A group whose anchor is fine but whose OP reaches out of the circle.
+        let reach = base(r#"{"id":"r","anchor":{"dx":50,"dy":0},"ops":[{"op":"fill","from":[0,0,0],"to":[20,0,0],"kind":"Rock","rgb":[1,1,1]}]}"#);
+        assert!(plan(&Manifest::parse(&reach).unwrap(), &Fake).is_err());
+        // Ground reference outside.
+        let ground = base(r#"{"id":"g","anchor":{"dx":55,"dy":0},"ground_at":[20,0],"ops":[{"op":"sprite","at":[0,0,0],"sprite":"Lantern"}]}"#);
+        assert!(plan(&Manifest::parse(&ground).unwrap(), &Fake).is_err());
+        // The additive city district may be anchored north of Harr, with local operation budgets unchanged.
+        let city = base(&lamp("")).replace("\"dx\":3,\"dy\":4", "\"dx\":0,\"dy\":220").replace("\"radius\":60", "\"radius\":400");
+        assert!(Manifest::parse(&city).is_ok());
+        // The area itself is capped.
+        assert!(errors(&base(&lamp("")).replace("\"radius\":60", "\"radius\":401")).iter().any(|e| e.contains("radius")));
+        assert!(errors(&base(&lamp("")).replace("\"radius\":60", "\"radius\":-3")).iter().any(|e| e.contains("radius")));
+    }
+
+    #[test]
+    fn unknown_site_or_plot_is_refused() {
+        let m = Manifest::parse(&base(&lamp("")).replace("\"site\":\"Harr\"", "\"site\":\"Nowhere\"")).unwrap();
+        assert!(plan(&m, &Fake).unwrap_err()[0].contains("no site"));
+        let m = Manifest::parse(&base(&lamp("")).replace("Plaza", "Tavern")).unwrap();
+        assert!(plan(&m, &Fake).unwrap_err()[0].contains("no Tavern plot"));
+        let m = Manifest::parse(&base(&lamp("")).replace("\"dx\":3", "\"nth\":3,\"dx\":3")).unwrap();
+        assert!(plan(&m, &Fake).is_err());
+    }
+
+    #[test]
+    fn foundations_are_bounded() {
+        let f = |depth: u32, to: &str| base(&format!(r#"{{"id":"f","ops":[{{"op":"foundation","from":[0,0],"to":{to},"kind":"Rock","rgb":[1,1,1],"depth":{depth}}}]}}"#));
+        assert!(Manifest::parse(&f(6, "[10,8]")).is_ok());
+        assert!(!errors(&f(0, "[10,8]")).is_empty());
+        assert!(!errors(&f(13, "[10,8]")).is_empty());
+        assert!(!errors(&f(6, "[48,48]")).is_empty(), "too many columns");
+        assert!(!errors(&f(6, "[49,0]")).is_empty());
+    }
+
+    #[test]
+    fn colours_are_bytes() {
+        let text = base(&lamp(r#",{"op":"fill","from":[0,0,0],"to":[0,0,0],"kind":"Rock","rgb":[300,0,0]}"#));
+        assert!(!errors(&text).is_empty());
+    }
+
+    #[test]
+    fn allowed_lists_have_no_duplicates_and_lights_are_allowed() {
+        let mut seen = BTreeSet::new();
+        for name in ALLOWED_SPRITES {
+            assert!(seen.insert(*name), "duplicate {name}");
+            assert!(name.bytes().all(|b| b.is_ascii_alphanumeric()));
+        }
+        for light in LIGHT_SPRITES {
+            assert!(ALLOWED_SPRITES.contains(light), "{light} is a light but not allowed");
+        }
+    }
+}
diff --git a/nemo-world-core/src/sky.rs b/nemo-world-core/src/sky.rs
new file mode 100644
index 0000000..33c1da8
--- /dev/null
+++ b/nemo-world-core/src/sky.rs
@@ -0,0 +1,279 @@
+//! NemoWorld's shared sky and weather, expressed for Veloren.
+//!
+//! NemoWorld publishes one clock for everybody (`src/atmosphere.js`): a 120 minute cycle of four
+//! phases of 30 minutes (dawn, day, dusk, night), measured from the Unix epoch, so every client and
+//! every server computes the same phase without talking to each other. `src/scene/weather.js` adds a
+//! deterministic weather per 20 minute slot of the same clock. This module is the Rust twin of both;
+//! the tests pin it to values produced by the JavaScript.
+
+/// Length of NemoWorld's cycle in milliseconds.
+pub const CYCLE_MS: u64 = 120 * 60_000;
+/// Length of one weather slot in milliseconds.
+pub const WEATHER_SLOT_MS: u64 = 20 * 60_000;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Phase {
+    Dawn,
+    Day,
+    Dusk,
+    Night,
+}
+
+impl Phase {
+    pub const ALL: [Phase; 4] = [Phase::Dawn, Phase::Day, Phase::Dusk, Phase::Night];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Phase::Dawn => "dawn",
+            Phase::Day => "day",
+            Phase::Dusk => "dusk",
+            Phase::Night => "night",
+        }
+    }
+
+    pub fn from_name(name: &str) -> Option<Phase> {
+        Phase::ALL.into_iter().find(|p| p.name() == name)
+    }
+
+    fn index(self) -> usize {
+        match self {
+            Phase::Dawn => 0,
+            Phase::Day => 1,
+            Phase::Dusk => 2,
+            Phase::Night => 3,
+        }
+    }
+}
+
+/// Where in NemoWorld's cycle a moment falls, from 0.0 (start of dawn) to just under 1.0.
+pub fn progress_at(unix_ms: u64) -> f64 { (unix_ms % CYCLE_MS) as f64 / CYCLE_MS as f64 }
+
+/// The published phase at a moment. Identical to `worldAtmosphere(ts).phase` in NemoWorld.
+pub fn phase_at(unix_ms: u64) -> Phase {
+    let span = CYCLE_MS / 4;
+    Phase::ALL[((unix_ms % CYCLE_MS) / span) as usize]
+}
+
+/// Hour of the Veloren day at which each NemoWorld phase begins.
+///
+/// The four phases always last a quarter of the cycle each, but Veloren's day is a continuous 24
+/// hours, so the hours are stretched: the long bright "day" and the long dark "night" cover more
+/// Veloren hours than dawn and dusk. Defaults: dawn 05:00, day 09:00, dusk 16:00, night 20:00.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SkyHours {
+    pub dawn: f64,
+    pub day: f64,
+    pub dusk: f64,
+    pub night: f64,
+}
+
+impl Default for SkyHours {
+    fn default() -> Self {
+        Self {
+            dawn: 5.0,
+            day: 9.0,
+            dusk: 16.0,
+            night: 20.0,
+        }
+    }
+}
+
+impl SkyHours {
+    pub fn validate(&self) -> Result<(), String> {
+        let all = [self.dawn, self.day, self.dusk, self.night];
+        if all.iter().any(|h| !h.is_finite() || *h < 0.0 || *h >= 24.0) {
+            return Err("sky hours must be numbers from 0 up to (not including) 24".into());
+        }
+        if !(self.dawn < self.day && self.day < self.dusk && self.dusk < self.night) {
+            return Err("sky hours must increase: dawn < day < dusk < night".into());
+        }
+        Ok(())
+    }
+
+    fn start_hour(&self, phase: Phase) -> f64 {
+        match phase {
+            Phase::Dawn => self.dawn,
+            Phase::Day => self.day,
+            Phase::Dusk => self.dusk,
+            Phase::Night => self.night,
+        }
+    }
+}
+
+/// Seconds since midnight of the Veloren day that corresponds to a moment of NemoWorld's cycle.
+/// Piecewise linear through the four phase starts, so a phase boundary in NemoWorld is exactly the
+/// matching hour in Veloren and the sun never jumps.
+pub fn day_seconds_at(unix_ms: u64, hours: &SkyHours) -> f64 {
+    let scaled = progress_at(unix_ms) * 4.0;
+    let index = (scaled.floor() as usize).min(3);
+    let within = scaled - index as f64;
+    let phase = Phase::ALL[index];
+    let start = hours.start_hour(phase);
+    let end = if phase.index() == 3 { hours.dawn + 24.0 } else { hours.start_hour(Phase::ALL[index + 1]) };
+    ((start + within * (end - start)) % 24.0) * 3600.0
+}
+
+/// Choose the absolute Veloren time of day (seconds since day 0) for a target time of the day, as
+/// close to the current absolute value as possible, so that crossing midnight moves forward and the
+/// moon phase (which counts whole days) is not disturbed.
+pub fn nearest_time_of_day(current: f64, day_seconds: f64) -> f64 {
+    const DAY: f64 = 86_400.0;
+    let base = (current / DAY).floor() * DAY;
+    let mut target = base + day_seconds;
+    if target < current - DAY / 2.0 {
+        target += DAY;
+    } else if target > current + DAY / 2.0 {
+        target -= DAY;
+    }
+    target.max(0.0)
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Weather {
+    Clear,
+    Mist,
+    Rain,
+}
+
+impl Weather {
+    pub fn name(self) -> &'static str {
+        match self {
+            Weather::Clear => "clear",
+            Weather::Mist => "mist",
+            Weather::Rain => "rain",
+        }
+    }
+
+    /// Veloren weather values for a zone: (cloud 0..1, rain 0..1, wind x, wind y).
+    /// Veloren's own `/weather_zone rain` uses cloud 0.1 and rain 0.15; mist is low cloud without rain.
+    pub fn veloren(self) -> (f32, f32, f32, f32) {
+        match self {
+            Weather::Clear => (0.0, 0.0, 0.0, 0.0),
+            Weather::Mist => (0.5, 0.0, 0.0, 0.0),
+            Weather::Rain => (0.4, 0.2, 1.0, -1.0),
+        }
+    }
+}
+
+/// JavaScript's `hash()` from `src/scene/batch.js`: FNV-style, 32 bit, over the UTF-16 code of the
+/// first unit of every code point (identical to byte values for the ASCII keys used here).
+pub fn nemo_hash(text: &str) -> u32 {
+    let mut result: u32 = 0;
+    for ch in text.chars() {
+        let mut units = [0u16; 2];
+        let first = ch.encode_utf16(&mut units)[0];
+        result = (result ^ u32::from(first)).wrapping_mul(16_777_619);
+    }
+    result
+}
+
+/// The weather of a moment. Identical to `weatherAt(ts)` in NemoWorld's `src/scene/weather.js`.
+pub fn weather_at(unix_ms: u64) -> Weather {
+    let slot = unix_ms / WEATHER_SLOT_MS;
+    match nemo_hash(&format!("weather:{slot}")) % 100 {
+        0..=13 => Weather::Rain,
+        14..=29 => Weather::Mist,
+        _ => Weather::Clear,
+    }
+}
+
+/// Milliseconds left in the weather slot that contains this moment.
+pub fn slot_remaining_ms(unix_ms: u64) -> u64 { WEATHER_SLOT_MS - unix_ms % WEATHER_SLOT_MS }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const T0: u64 = 1_760_572_800_000;
+
+    #[test]
+    fn phases_match_the_javascript_clock() {
+        // Values printed by `worldAtmosphere(ts).phase` in NemoWorld.
+        assert_eq!(phase_at(0), Phase::Dawn);
+        assert_eq!(phase_at(T0), Phase::Dawn);
+        assert_eq!(phase_at(T0 + 7 * 60_000), Phase::Dawn);
+        assert_eq!(phase_at(T0 + 31 * 60_000), Phase::Day);
+        assert_eq!(phase_at(T0 + 61 * 60_000), Phase::Dusk);
+        assert_eq!(phase_at(T0 + 91 * 60_000), Phase::Night);
+        assert_eq!(phase_at(1_800_000_123_456), Phase::Dawn);
+        assert_eq!(phase_at(1_234_567_890_123), Phase::Night);
+        // The exact boundaries belong to the phase that starts there.
+        assert_eq!(phase_at(T0 + 30 * 60_000 - 1), Phase::Dawn);
+        assert_eq!(phase_at(T0 + 30 * 60_000), Phase::Day);
+        assert_eq!(phase_at(T0 + 120 * 60_000 - 1), Phase::Night);
+        assert_eq!(phase_at(T0 + 120 * 60_000), Phase::Dawn);
+    }
+
+    #[test]
+    fn weather_matches_the_javascript_hash() {
+        // 72 consecutive slots from T0, printed by `weatherAt` (c = clear, m = mist, r = rain).
+        let expected = "ccmrccrmccmccrcccccccccrcmcccrmcccrmcmccccrccccmcccccccccrccrmccccmrcccc";
+        let got: String = (0..72)
+            .map(|i| match weather_at(T0 + i * WEATHER_SLOT_MS) {
+                Weather::Clear => 'c',
+                Weather::Mist => 'm',
+                Weather::Rain => 'r',
+            })
+            .collect();
+        assert_eq!(got, expected);
+        // A slot has one weather from its first millisecond to its last.
+        assert_eq!(weather_at(T0 + 3 * WEATHER_SLOT_MS), weather_at(T0 + 4 * WEATHER_SLOT_MS - 1));
+        assert_eq!(weather_at(1_234_567_890_123), Weather::Mist);
+        assert_eq!(weather_at(T0 + 61 * 60_000), Weather::Rain);
+    }
+
+    #[test]
+    fn day_seconds_are_continuous_and_hit_the_phase_hours() {
+        let hours = SkyHours::default();
+        hours.validate().unwrap();
+        let at = |minutes: f64| day_seconds_at(T0 + (minutes * 60_000.0) as u64, &hours) / 3600.0;
+        assert!((at(0.0) - 5.0).abs() < 1e-9);
+        assert!((at(30.0) - 9.0).abs() < 1e-9);
+        assert!((at(60.0) - 16.0).abs() < 1e-9);
+        assert!((at(90.0) - 20.0).abs() < 1e-9);
+        assert!((at(15.0) - 7.0).abs() < 1e-9, "middle of dawn is 07:00");
+        assert!((at(105.0) - 0.5).abs() < 1e-9, "middle of night wraps past midnight to 00:30");
+        // The sun never jumps: neighbouring seconds differ by a small, positive step (mod 24h).
+        let mut previous = day_seconds_at(T0, &hours);
+        for second in 1..(120 * 60) {
+            let now = day_seconds_at(T0 + second * 1000, &hours);
+            let step = (now - previous).rem_euclid(86_400.0);
+            assert!(step > 0.0 && step < 40.0, "step {step} at second {second}");
+            previous = now;
+        }
+    }
+
+    #[test]
+    fn bad_sky_hours_are_refused() {
+        let bad = |h: SkyHours| h.validate().is_err();
+        assert!(bad(SkyHours { dawn: 9.0, day: 5.0, dusk: 16.0, night: 20.0 }));
+        assert!(bad(SkyHours { dawn: 5.0, day: 9.0, dusk: 16.0, night: 24.0 }));
+        assert!(bad(SkyHours { dawn: -1.0, day: 9.0, dusk: 16.0, night: 20.0 }));
+        assert!(bad(SkyHours { dawn: f64::NAN, day: 9.0, dusk: 16.0, night: 20.0 }));
+    }
+
+    #[test]
+    fn time_of_day_moves_forward_across_midnight() {
+        let day = 86_400.0;
+        // Current: day 3, 23:59:50. Target: 00:00:10 -> must be day 4, not day 3.
+        let current = 3.0 * day + 86_390.0;
+        assert_eq!(nearest_time_of_day(current, 10.0), 4.0 * day + 10.0);
+        // Current: day 4, 00:00:05. Target: 23:59:55 (slightly behind) -> stays on day 3.
+        let current = 4.0 * day + 5.0;
+        assert_eq!(nearest_time_of_day(current, 86_395.0), 3.0 * day + 86_395.0);
+        // Ordinary case.
+        assert_eq!(nearest_time_of_day(2.0 * day + 3600.0, 7200.0), 2.0 * day + 7200.0);
+        // Never negative.
+        assert_eq!(nearest_time_of_day(100.0, 86_390.0), 0.0f64.max(86_390.0 - day));
+    }
+
+    #[test]
+    fn weather_values_are_bounded() {
+        for weather in [Weather::Clear, Weather::Mist, Weather::Rain] {
+            let (cloud, rain, wx, wy) = weather.veloren();
+            assert!((0.0..=1.0).contains(&cloud) && (0.0..=1.0).contains(&rain));
+            assert!(wx.abs() <= 20.0 && wy.abs() <= 20.0);
+        }
+        assert!(slot_remaining_ms(T0) == WEATHER_SLOT_MS && slot_remaining_ms(T0 + 1) == WEATHER_SLOT_MS - 1);
+    }
+}
