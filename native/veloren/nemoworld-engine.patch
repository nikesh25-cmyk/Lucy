index 0000000..3d5d2b4
--- /dev/null
+++ b/nemo-bridge/src/chat_atlas.rs
@@ -0,0 +1,334 @@
+//! Map talk for the atlas keeper resident (Vaelen Kindred).
+//!
+//! The bridge is a courier and nothing more. A player's line — whispered to the keeper, or said aloud
+//! naming him — is forwarded to NemoWorld's `/veloren/atlas/ask`; NemoWorld answers with the lines to
+//! speak, built from its own atlas file and the player's own signed record. The bridge speaks them back
+//! privately and polls `/veloren/atlas/notices` (arrived, refused) to pass those on too.
+//!
+//! What this file never does:
+//! * it never decides a place: the allow-list is NemoWorld's atlas file, and the Veloren server resolves a
+//!   place to a position itself — a command never carries a coordinate;
+//! * it never sends a command of its own: a `teleport` is signed by NemoWorld, after its own checks;
+//! * it never treats a player's words as anything but text, and never whispers a name it did not read from
+//!   the server's own player list.
+
+use crate::nemo::Nemo;
+use common::comp::{self, ChatType};
+use serde::Deserialize;
+use std::{
+    collections::{HashMap, VecDeque},
+    sync::mpsc::{self, Receiver, Sender},
+    thread,
+    time::{Duration, Instant},
+};
+use tracing::{info, warn};
+use veloren_client::Client;
+
+/// A player may ask this often; faster asks are dropped here (NemoWorld enforces its own limit too).
+const ASK_GAP: Duration = Duration::from_secs(2);
+/// Private messages are exempt from Veloren's chat spam filter, but stay readable.
+const TELL_GAP: Duration = Duration::from_millis(1100);
+const NOTICE_EVERY: Duration = Duration::from_secs(3);
+/// Veloren refuses chat over 256 bytes; stay well under.
+pub const MAX_LINE_BYTES: usize = 200;
+const MAX_QUEUE: usize = 40;
+const MAX_ASK_BYTES: usize = 300;
+
+/// Cut text to at most `max` bytes without splitting a character.
+pub fn clip(text: &str, max: usize) -> String {
+    if text.len() <= max {
+        return text.to_owned();
+    }
+    let mut end = max;
+    while !text.is_char_boundary(end) {
+        end -= 1;
+    }
+    text[..end].to_owned()
+}
+
+/// Is this line for the keeper? Returns the text to forward. A whisper must be to him; something said
+/// aloud must name him, so ordinary conversation is left to the caller.
+pub fn addressed_text(private_to_me: bool, text: &str, name: &str) -> Option<String> {
+    let text = text.trim();
+    if text.is_empty() {
+        return None;
+    }
+    (private_to_me || text.to_lowercase().contains(&name.to_lowercase())).then(|| clip(text, MAX_ASK_BYTES))
+}
+
+/// Break a reply into chat-sized pieces at spaces. Control characters become spaces, so nothing can
+/// smuggle a second line or a command into one whisper.
+pub fn split_for_chat(text: &str, max: usize) -> Vec<String> {
+    let cleaned: String = text.chars().map(|c| if c.is_control() { ' ' } else { c }).collect();
+    let mut lines = Vec::new();
+    let mut current = String::new();
+    for word in cleaned.split_whitespace() {
+        let word = clip(word, max);
+        if !current.is_empty() && current.len() + 1 + word.len() > max {
+            lines.push(std::mem::take(&mut current));
+        }
+        if !current.is_empty() {
+            current.push(' ');
+        }
+        current.push_str(&word);
+    }
+    if !current.is_empty() {
+        lines.push(current);
+    }
+    lines
+}
+
+#[derive(Debug, Deserialize)]
+struct AskReply {
+    lines: Vec<String>,
+}
+
+#[derive(Debug, Deserialize, Clone)]
+pub struct Notice {
+    pub id: String,
+    pub player_uuid: String,
+    pub text: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct NoticeList {
+    notices: Vec<Notice>,
+}
+
+enum Incoming {
+    Ask { alias: String, result: Result<Vec<String>, String> },
+    Notices(Result<Vec<Notice>, String>),
+}
+
+pub struct AtlasChat {
+    nemo: Nemo,
+    resident_id: String,
+    /// The keeper's first name, as players say it.
+    name: String,
+    tx: Sender<Incoming>,
+    rx: Receiver<Incoming>,
+    /// (alias, line) waiting to be spoken as a `/tell`.
+    outbox: VecDeque<(String, String)>,
+    last_tell: Instant,
+    last_notice_poll: Instant,
+    notices_in_flight: bool,
+    last_ask: HashMap<String, Instant>,
+    /// True after a tell, until the chat mode is put back to the open world chat.
+    mode_dirty: bool,
+}
+
+impl AtlasChat {
+    pub fn new(nemo: Nemo, resident_id: &str, name: &str) -> Self {
+        let (tx, rx) = mpsc::channel();
+        Self {
+            nemo,
+            resident_id: resident_id.to_owned(),
+            name: name.to_owned(),
+            tx,
+            rx,
+            outbox: VecDeque::new(),
+            last_tell: Instant::now() - TELL_GAP,
+            last_notice_poll: Instant::now(),
+            notices_in_flight: false,
+            last_ask: HashMap::new(),
+            mode_dirty: false,
+        }
+    }
+
+    /// One public line, said after the greeting.
+    pub fn intro(&self) -> String {
+        format!(
+            "I keep the map. Whisper me, e.g. /tell {} where am I, or ask me to take you to a place on it.",
+            self.name
+        )
+    }
+
+    /// Look at one line of chat. If it is for the keeper, forward it to NemoWorld and return true, so the
+    /// caller does not also answer it with the ordinary talk path.
+    pub fn on_chat(&mut self, client: &Client, msg: &comp::ChatMsg) -> bool {
+        let comp::Content::Plain(text) = msg.content() else {
+            return false;
+        };
+        let (private_to_me, from) = match &msg.chat_type {
+            ChatType::Tell(from, to) => (Some(*to) == client.uid(), Some(*from)),
+            ChatType::Say(from) | ChatType::Region(from) | ChatType::World(from) | ChatType::Group(from, _) | ChatType::Faction(from, _) => (false, Some(*from)),
+            _ => return false,
+        };
+        let Some(forward) = addressed_text(private_to_me, text, &self.name) else {
+            return false;
+        };
+        // The speaker is whoever the SERVER says sent it; the name inside the text counts for nothing.
+        let Some((uuid, alias)) = from.and_then(|uid| {
+            client
+                .player_list()
+                .get(&uid)
+                .map(|info| (info.uuid.to_string(), info.player_alias.clone()))
+        }) else {
+            return false;
+        };
+        let now = Instant::now();
+        if self.last_ask.get(&uuid).is_some_and(|at| now.duration_since(*at) < ASK_GAP) {
+            return true;
+        }
+        self.last_ask.insert(uuid.clone(), now);
+        if self.last_ask.len() > 512 {
+            self.last_ask.retain(|_, at| now.duration_since(*at) < Duration::from_secs(60));
+        }
+        info!("HEARD from {alias}: {forward}");
+        let body = serde_json::json!({
+            "resident_id": self.resident_id,
+            "player_uuid": uuid,
+            "player_alias": alias,
+            "text": forward,
+        })
+        .to_string();
+        let nemo = self.nemo.clone();
+        let tx = self.tx.clone();
+        thread::spawn(move || {
+            let result = nemo
+                .request("POST", "/api/v1/veloren/atlas/ask", Some(&body))
+                .and_then(|(status, body)| {
+                    if status == 200 {
+                        serde_json::from_str::<AskReply>(&body).map(|r| r.lines).map_err(|e| e.to_string())
+                    } else {
+                        Err(format!("the map answered {status}"))
+                    }
+                });
+            let _ = tx.send(Incoming::Ask { alias, result });
+        });
+        true
+    }
+
+    fn enqueue(&mut self, alias: &str, text: &str) {
+        for line in split_for_chat(text, MAX_LINE_BYTES) {
+            if self.outbox.len() >= MAX_QUEUE {
+                warn!("map talk queue is full; dropping a line");
+                return;
+            }
+            self.outbox.push_back((alias.to_owned(), line));
+        }
+    }
+
+    /// Call every game tick: collect NemoWorld's answers, poll notices and speak queued lines.
+    pub fn tick(&mut self, client: &mut Client, in_world: bool) {
+        while let Ok(message) = self.rx.try_recv() {
+            match message {
+                Incoming::Ask { alias, result } => match result {
+                    Ok(lines) => {
+                        for line in lines.iter().take(12) {
+                            self.enqueue(&alias, line);
+                        }
+                    },
+                    Err(e) => {
+                        warn!("map ask failed ({e})");
+                        self.enqueue(&alias, "I cannot reach NemoWorld just now, so I cannot tell where you are. Please ask again in a moment.");
+                    },
+                },
+                Incoming::Notices(result) => {
+                    self.notices_in_flight = false;
+                    match result {
+                        Ok(notices) => self.deliver_notices(client, notices),
+                        Err(e) => warn!("map notices unavailable ({e})"),
+                    }
+                },
+            }
+        }
+        if !in_world {
+            return;
+        }
+        if !self.notices_in_flight && self.last_notice_poll.elapsed() >= NOTICE_EVERY {
+            self.notices_in_flight = true;
+            self.last_notice_poll = Instant::now();
+            let nemo = self.nemo.clone();
+            let tx = self.tx.clone();
+            thread::spawn(move || {
+                let result = nemo
+                    .request("GET", "/api/v1/veloren/atlas/notices", None)
+                    .and_then(|(status, body)| {
+                        if status == 200 {
+                            serde_json::from_str::<NoticeList>(&body).map(|r| r.notices).map_err(|e| e.to_string())
+                        } else {
+                            Err(format!("notices answered {status}"))
+                        }
+                    });
+                let _ = tx.send(Incoming::Notices(result));
+            });
+        }
+        if self.last_tell.elapsed() >= TELL_GAP {
+            if let Some((alias, line)) = self.outbox.pop_front() {
+                info!("TELLS {alias}: {line}");
+                client.send_command("tell".into(), vec![alias, line]);
+                self.last_tell = Instant::now();
+                self.mode_dirty = true;
+            } else if self.mode_dirty {
+                // `/tell` leaves the sender's chat mode on that player; put it back to the open chat.
+                client.send_command("world".into(), Vec::new());
+                self.mode_dirty = false;
+                self.last_tell = Instant::now();
+            }
+        }
+    }
+
+    /// Tell each notice to its player if he is online, and acknowledge only those, so the rest are
+    /// offered again until they expire in NemoWorld.
+    fn deliver_notices(&mut self, client: &Client, notices: Vec<Notice>) {
+        let mut done = Vec::new();
+        for notice in notices.into_iter().take(10) {
+            let alias = client
+                .player_list()
+                .values()
+                .find(|info| info.is_online && info.uuid.to_string() == notice.player_uuid)
+                .map(|info| info.player_alias.clone());
+            if let Some(alias) = alias {
+                self.enqueue(&alias, &notice.text);
+                done.push(notice.id);
+            }
+        }
+        if done.is_empty() {
+            return;
+        }
+        let nemo = self.nemo.clone();
+        let body = serde_json::json!({ "ids": done }).to_string();
+        thread::spawn(move || {
+            if let Err(e) = nemo.request("POST", "/api/v1/veloren/atlas/notices/ack", Some(&body)) {
+                warn!("could not acknowledge map notices: {e}");
+            }
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_a_line_for_the_keeper_is_forwarded() {
+        // The same rule the caller relies on to decide whether to answer with the ordinary talk path.
+        assert!(addressed_text(true, "  where am I?  ", "Vaelen").is_some());
+        assert!(addressed_text(false, "Vaelen, travel to the commons", "Vaelen").is_some());
+        assert!(addressed_text(false, "vaelen take me to ajakkuq", "Vaelen").is_some());
+        assert!(addressed_text(false, "anyone know the way?", "Vaelen").is_none());
+        assert!(addressed_text(true, "   ", "Vaelen").is_none());
+    }
+
+    #[test]
+    fn what_is_forwarded_is_bounded() {
+        let long = "vaelen ".repeat(200);
+        assert!(addressed_text(false, &long, "Vaelen").unwrap().len() <= MAX_ASK_BYTES);
+        let accented = "é".repeat(400);
+        assert!(clip(&accented, 301).len() <= 301);
+        assert!(clip(&accented, 301).chars().all(|c| c == 'é'));
+    }
+
+    #[test]
+    fn replies_are_split_to_chat_size_without_losing_words_or_gaining_a_line() {
+        let text = "The last place the world saw you at is The Lantern Library. I only repeat what the game server signed; I cannot see a player who has never been observed here.";
+        let lines = split_for_chat(text, 60);
+        assert!(lines.len() > 1);
+        assert!(lines.iter().all(|line| line.len() <= 60));
+        assert_eq!(lines.join(" "), text);
+        let nasty = split_for_chat("hello\n/tell someone else\r\u{0007}x", 200);
+        assert_eq!(nasty, vec!["hello /tell someone else x".to_owned()]);
+        assert!(split_for_chat("   ", 200).is_empty());
+    }
+}
