+//! The wire format shared with NemoWorld's `src/veloren-link.js`.
+//!
+//! An event is signed over a fixed canonical text so that neither side depends on JSON key order
+//! or number formatting. The test vector below is the same one NemoWorld's tests pin.
+
+pub mod home;
+pub mod city;
+pub mod atlas;
+
+use hmac::{Hmac, KeyInit, Mac};
+use sha2::Sha256;
+
+pub const VERSION: u32 = 1;
+
+/// Fields are joined by `\n`. Empty alias and landmark are the empty string.
+#[expect(clippy::too_many_arguments, reason = "mirrors the fixed wire format")]
+pub fn canonical(
+    server_id: &str,
+    seq: u64,
+    kind: &str,
+    resident_id: &str,
+    player_uuid: &str,
+    player_alias: &str,
+    landmark_id: &str,
+    occurred_at: u64,
+) -> String {
+    format!(
+        "{VERSION}\n{server_id}\n{seq}\n{kind}\n{resident_id}\n{player_uuid}\n{player_alias}\n\
+         {landmark_id}\n{occurred_at}"
+    )
+}
+
+/// Canonical text of a NemoWorld -> Veloren command. `args` is the exact JSON text that was signed.
+pub fn canonical_command(
+    cmd_id: &str,
+    kind: &str,
+    player_uuid: &str,
+    args: &str,
+    issued_at: u64,
+    expires_at: u64,
+) -> String {
+    format!("{VERSION}\n{cmd_id}\n{kind}\n{player_uuid}\n{args}\n{issued_at}\n{expires_at}")
+}
+
+/// Constant-time check of a hex HMAC-SHA256 signature.
+pub fn verify(key: &[u8], canonical: &str, signature_hex: &str) -> bool {
+    if signature_hex.len() != 64 || !signature_hex.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return false;
+    }
+    let bytes: Vec<u8> = (0..64)
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&signature_hex[i..i + 2], 16).expect("checked hex"))
+        .collect();
+    let mut mac = <Hmac<Sha256> as KeyInit>::new_from_slice(key).expect("HMAC accepts any key length");
+    mac.update(canonical.as_bytes());
+    mac.verify_slice(&bytes).is_ok()
+}
+
+/// HMAC-SHA256 as lowercase hex.
+pub fn sign(key: &[u8], canonical: &str) -> String {
+    let mut mac = <Hmac<Sha256> as KeyInit>::new_from_slice(key).expect("HMAC accepts any key length");
+    mac.update(canonical.as_bytes());
+    mac.finalize()
+        .into_bytes()
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect()
+}
+
+/// Same rule as NemoWorld: 64 or more hex characters are hex bytes, anything else is UTF-8 text.
+pub fn parse_key(text: &str) -> Vec<u8> {
+    let is_hex = text.len() >= 64
+        && text.len() % 2 == 0
+        && text.bytes().all(|b| b.is_ascii_hexdigit());
+    if is_hex {
+        (0..text.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&text[i..i + 2], 16).expect("checked hex"))
+            .collect()
+    } else {
+        text.as_bytes().to_vec()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
