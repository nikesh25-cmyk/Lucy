<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily snapshot of the Harr world and data (play/backup.sh make; the newest ten are kept). Runs at 04:30 local time;
     if the Mac was asleep, launchd runs it once when it wakes. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.harr.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__OPS_DIR__/launchd/harr-backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HARR_ROOT</key><string>__ROOT__</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__ROOT__/play/logs/launchd-backup.out.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/play/logs/launchd-backup.err.log</string>
</dict>
</plist>
