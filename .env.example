# NemoWorld environment template — copy to .env and fill in. NEVER commit the filled-in file.
#
# `node server.js` does not read .env by itself. Use one of:
#   node --env-file=.env server.js          # Node 20+, local runs
#   export $(grep -v '^#' .env | xargs)     # shell export, local runs only
# Hosted deployments set these in the host's environment settings (Render reads render.yaml).
#
# .env is gitignored. Every value below is a placeholder: this file contains no real secret, and no
# real setup code, token, contact address or password may ever be written into a committed file.
#
# Required for a public deployment are marked [required]. Everything else is optional and states the
# behaviour when it is unset. The authoritative behaviour is src/hosting.js and server.js — if this
# file and the code disagree, the code wins and this file is the bug.

# ---------------------------------------------------------------------------------------------
# Hosting and origin
# ---------------------------------------------------------------------------------------------
# [required for a public deployment — set this OR let the host supply RENDER_EXTERNAL_URL]
# Canonical public HTTPS origin: scheme + host only. No path, port, query, fragment or credentials,
# and not a loopback host. It defines the Host header ordinary routes accept, the Origin browser
# writes must match, and (with it set) Secure cookies and HSTS. Forwarded host/proto headers are
# never trusted. Example: LUCY_PUBLIC_ORIGIN=https://world.example.org
LUCY_PUBLIC_ORIGIN=

# [required on Render — set automatically by Render; leave empty elsewhere]
# Render's own service URL, used as the public origin when LUCY_PUBLIC_ORIGIN is empty.
RENDER_EXTERNAL_URL=

# [optional — defaults to 0.0.0.0 when an origin is set, 127.0.0.1 otherwise]
# Interface to bind. Allowed values: 127.0.0.1, ::1, 0.0.0.0. The server REFUSES TO START when it
# binds 0.0.0.0 without a public origin, so it is never exposed by accident.
LUCY_BIND_HOST=127.0.0.1

# [optional — defaults to 3000]
# Listening port. Render and most hosts inject PORT themselves; do not set it there.
PORT=3000

# [optional — local convenience only]
# 1 makes the local launcher walk to the next port when the chosen one is busy. Never set in
# production: a public service must not silently move ports behind its health check.
# LUCY_LOCAL_PORT_FALLBACK=1

# ---------------------------------------------------------------------------------------------
# Private setup code and administrator
# ---------------------------------------------------------------------------------------------
# [required once, before the first public start with an empty database]
# 24–256 characters. The first account on a public installation becomes the administrator ONLY with
# this exact code, compared in constant time. With no code, a public server over an empty database
# refuses to start. There is no default administrator and no default password. Generate your own,
# for example:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it private: not in chat, logs, screenshots, tickets, commits or shared URLs.
LUCY_SETUP_CODE=

# ---------------------------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------------------------
# [optional — defaults to ./data/world.sqlite]
# SQLite database path. Put it on persistent storage. One file, one process: never point two
# instances at the same file, and never mount one file from two machines.
LUCY_DATABASE=./data/world.sqlite

# [optional — for a fresh public pilot set closed; local default is open]
# Applied only when the database is first created. Later changes must be made by an administrator.
# LUCY_INITIAL_REGISTRATION=closed

# There is no backup-directory variable: backups are always written to `backups/` beside the
# database file (data/backups locally, /var/data/backups on Render). They contain credential hashes,
# contact addresses and private data: keep them private and never commit or publish one.

# ---------------------------------------------------------------------------------------------
# Local model (optional; not installed by this repository)
# ---------------------------------------------------------------------------------------------
# [optional — with NONE of these set, no model is configured: resident runs are refused and country
# conversations answer from published rules, marked mode "rules" with model_fallback true]
# A model endpoint MUST be local loopback HTTP; remote endpoints and redirects are rejected.
# Default adapter is Ollama; LUCY_MODEL_BACKEND=llama.cpp selects a separately run llama server.
# LUCY_MODEL_NAME=lucy-local
# LUCY_MODEL_URL=http://127.0.0.1:11434
# LUCY_MODEL_BACKEND=llama.cpp
# LUCY_MODEL_KEY=

# ---------------------------------------------------------------------------------------------
# Resident vault (private notes, schema 25)
# ---------------------------------------------------------------------------------------------
# Server-sealed vault notes are AES-256-GCM ciphertext. Their per-resident data keys are wrapped under
# one 32-byte master key kept in an owner-only (0600) file OUTSIDE the database. By default that file
# is `vault.key` beside the database and is created on first use. Back it up separately from the
# database: without it every server-sealed note is unrecoverable, and the server refuses to mint a
# replacement for an existing sealed vault. Resident-held (agent) vaults never use this key.
# LUCY_VAULT_KEY_FILE=/private/off-host/vault.key

# ---------------------------------------------------------------------------------------------
# External agent runtime (used by `npm run agent`; not by the server)
# ---------------------------------------------------------------------------------------------
# [optional — only for a separately run agent process]
# WORLD_AGENT_TOKEN is a runtime credential minted in Characters → Connect an independent AI agent.
# It is shown once; store it privately and never commit it.
# WORLD_URL=https://world.example.org
# WORLD_AGENT_TOKEN=
# WORLD_TASK_ID=
# WORLD_SOURCE_URLS=["https://approved.example/source"]

# ---------------------------------------------------------------------------------------------
# Test/rehearsal switches (never set in production)
# ---------------------------------------------------------------------------------------------
# LUCY_BROWSER_KEEP=1        keep the browser suite's temporary workspace on failure
# LUCY_BROWSER_ONLY=first-person-controls    run named browser scenarios only
# LUCY_BROWSER_CHANNEL=chrome|msedge         choose another installed browser channel
# LUCY_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# LUCY_E2E_KEEP=1            keep the isolated HTTP acceptance workspace
# LUCY_LOAD_KEEP=1           keep the load harness workspace
